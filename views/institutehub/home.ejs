    @keyframes swipeNudge {
        0%, 100% { transform: translateX(0); opacity: 1; }
        50% { transform: translateX(4px); opacity: 0.6; }
    }
    .swipe-hint-arrow { animation: swipeNudge 1.2s ease-in-out infinite; }

    @keyframes savePop {
        0% { transform: scale(1); }
        40% { transform: scale(1.25); }
        100% { transform: scale(1); }
    }
    .save-pop i { animation: savePop 0.35s ease; }

    @media (prefers-reduced-motion: reduce) {
        .swipe-hint-arrow, .save-pop i, .marquee, .pulse-dot { animation: none !important; }
