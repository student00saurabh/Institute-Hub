<% layout("/layouts/boilerplate") %>

<%
  // ============================================================
  // ✅ HELPER FUNCTIONS
  // ============================================================
  function getTimeAgo(date) {
      const now = new Date();
      const diff = now - new Date(date);
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor(diff / (1000 * 60));
      
      if (days > 7) return `${Math.floor(days / 7)} weeks ago`;
      if (days > 0) return `${days} days ago`;
      if (hours > 0) return `${hours} hours ago`;
      if (minutes > 0) return `${minutes} minutes ago`;
      return 'Just now';
  }
%>

<!-- ============================================================ -->
<!-- HERO SECTION WITH OFFER SLIDER                               -->
<!-- ============================================================ -->
<section class="relative overflow-hidden bg-[#F8FAFC] dark:bg-[#0B1120] transition-colors duration-300">

    <!-- Background blobs -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -top-32 -left-24 w-[420px] h-[420px] rounded-full bg-[#2563EB]/10 dark:bg-[#2563EB]/20 blur-3xl"></div>
        <div class="absolute top-40 -right-24 w-[380px] h-[380px] rounded-full bg-[#C9A227]/10 dark:bg-[#C9A227]/20 blur-3xl"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,#0F172A08_1px,transparent_0)] dark:bg-[radial-gradient(circle_at_1px_1px,#ffffff08_1px,transparent_0)] [background-size:26px_26px]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-20 lg:pt-24 lg:pb-28">
        <div class="grid lg:grid-cols-2 gap-14 items-start">

            <!-- Left: Content -->
            <div class="reveal-up">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide bg-[#2563EB]/10 text-[#2563EB] dark:bg-[#2563EB]/15 border border-[#2563EB]/20">
                    <i class="fas fa-graduation-cap"></i> #1 Learning Platform
                </span>

                <h1 class="mt-6 text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold leading-[1.08] tracking-tight text-[#0F172A] dark:text-white">
                    Learn Skills That
                    <span class="relative inline-block whitespace-nowrap">
                        <span class="relative z-10 bg-gradient-to-r from-[#2563EB] to-[#C9A227] bg-clip-text text-transparent">Actually Matter</span>
                    </span>
                    — Taught by Experts
                </h1>

                <p class="mt-6 text-base sm:text-lg text-[#334155] dark:text-[#94A3B8] max-w-xl leading-relaxed">
                    Master in-demand skills with structured, project-based courses in tech, design and business — built for real careers, not just certificates.
                </p>

                <!-- Search Bar -->
                <!-- <form action="/api/search" method="GET" class="mt-8 flex flex-col sm:flex-row gap-3 max-w-xl">
                    <div class="relative flex-1">
                        <i class="fas fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-[#94A3B8]"></i>
                        <input type="text" name="q" placeholder="Search for courses, e.g. 'React'"
                               class="w-full pl-11 pr-4 py-3.5 rounded-2xl border border-[#E2E8F0] dark:border-[#1E293B] bg-white dark:bg-[#111827] text-[#0F172A] dark:text-white placeholder:text-[#94A3B8] focus:outline-none focus:ring-2 focus:ring-[#2563EB]/40 focus:border-[#2563EB] transition-all duration-300 shadow-sm">
                    </div>
                    <button type="submit" class="btn-shine relative overflow-hidden px-7 py-3.5 rounded-2xl bg-gradient-to-r from-[#2563EB] to-[#1D4ED8] text-white font-semibold shadow-lg shadow-[#2563EB]/25 hover:shadow-xl hover:shadow-[#2563EB]/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300">
                        Explore Courses
                    </button>
                </form> -->

                <!-- Trust Row -->
                <div class="mt-8 flex items-center gap-4">
                    <div class="flex -space-x-3">
                        <% const initials = ["A","P","K","R","S"]; %>
                        <% initials.forEach((letter, i) => { %>
                            <div class="w-9 h-9 rounded-full border-2 border-white dark:border-[#0B1120] flex items-center justify-center text-xs font-bold text-white shadow-sm"
                                 style="background: linear-gradient(135deg, <%= i % 2 === 0 ? '#2563EB, #1D4ED8' : '#C9A227, #B8901E' %>);">
                                <%= letter %>
                            </div>
                        <% }) %>
                    </div>
                    <div class="text-sm">
                        <div class="flex items-center gap-1 text-[#C9A227]">
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star text-xs"></i>
                            <i class="fas fa-star-half-stroke text-xs"></i>
                            <span class="ml-1.5 font-semibold text-[#0F172A] dark:text-white">4.8/5</span>
                        </div>
                        <p class="text-[#64748B] dark:text-[#94A3B8]">from <%= (stats.find(s => s.label === 'Students')?.value || 0).toLocaleString() %>+ learners</p>
                    </div>
                </div>
            </div>

            <!-- Right: Offer Slider -->
            <div class="relative reveal-up reveal-delay-1">
                <div class="relative rounded-2xl overflow-hidden border border-[#E2E8F0] dark:border-[#1E293B] shadow-2xl shadow-[#2563EB]/10 bg-white dark:bg-[#111827]">
                    
                    <!-- Slider Container -->
                    <div id="offerSlider" class="relative overflow-hidden">
                        <div id="offerTrack" class="flex transition-transform duration-700 ease-in-out">
                            <% if (offers && offers.length > 0) { %>
                                <% offers.forEach((offer, index) => { %>
                                    <div class="min-w-full relative">
                                        <img src="<%= offer.img %>" alt="<%= offer.title %>" class="w-full h-[300px] sm:h-[380px] object-cover" loading="lazy">
                                        <div class="absolute inset-0 bg-gradient-to-t from-[#0F172A]/90 via-[#0F172A]/40 to-transparent"></div>
                                        
                                        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
                                            <div class="flex items-center gap-2 mb-2 flex-wrap">
                                                <span class="px-2.5 py-0.5 bg-[#C9A227] text-white text-[10px] font-bold rounded-full">
                                                    <%= offer.tag || 'Featured' %>
                                                </span>
                                                <span class="px-2.5 py-0.5 bg-[#EF4444] text-white text-[10px] font-bold rounded-full animate-pulse">
                                                    <%= offer.discount || 'OFFER' %>
                                                </span>
                                            </div>
                                            <h3 class="text-xl sm:text-2xl font-bold text-white"><%= offer.title %></h3>
                                            <div class="flex items-center gap-3 mt-2">
                                                <span class="text-2xl font-extrabold text-[#C9A227]"><%= offer.original %></span>
                                                <span class="text-sm text-white/60 line-through"><%= offer.price %></span>
                                            </div>
                                            <div class="mt-4 flex items-center gap-3 flex-wrap">
                                                <a href="/enroll?courseId=<%= offer.courseId || '' %>" 
                                                   class="px-6 py-2.5 bg-[#2563EB] text-white text-sm font-semibold rounded-xl hover:bg-[#1D4ED8] transition-all duration-300 hover:scale-105 shadow-lg shadow-[#2563EB]/30">
                                                    Enroll Now
                                                </a>
                                                <span class="text-white/60 text-sm"><i class="fas fa-users mr-1"></i> <%= (offer.enrolled || 0).toLocaleString() %>+ enrolled</span>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <!-- Fallback if no offers -->
                                <div class="min-w-full relative">
                                    <div class="w-full h-[300px] sm:h-[380px] bg-gradient-to-r from-[#2563EB]/20 to-[#C9A227]/20 flex items-center justify-center">
                                        <p class="text-white/60 text-lg">No featured courses right now</p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Slider Controls -->
                        <% if (offers && offers.length > 1) { %>
                            <button onclick="changeOffer(-1)" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm text-white hover:bg-white/40 transition-all duration-300 flex items-center justify-center">
                                <i class="fas fa-chevron-left text-sm"></i>
                            </button>
                            <button onclick="changeOffer(1)" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm text-white hover:bg-white/40 transition-all duration-300 flex items-center justify-center">
                                <i class="fas fa-chevron-right text-sm"></i>
                            </button>
                            
                            <!-- Dots -->
                            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-1.5">
                                <% offers.forEach((_, index) => { %>
                                    <button onclick="goToOffer(<%= index %>)" 
                                            class="offer-dot w-2 h-2 rounded-full transition-all duration-300 <%= index === 0 ? 'w-6 bg-[#C9A227]' : 'bg-white/50 hover:bg-white/80' %>">
                                    </button>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
                
                <!-- Floating Stats Card -->
                <div class="absolute -bottom-4 -left-4 bg-white/95 dark:bg-[#111827]/95 backdrop-blur-xl rounded-2xl px-4 py-3 shadow-xl border border-[#E2E8F0]/60 dark:border-[#1E293B]/60 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E]">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-[#0F172A] dark:text-white">Limited Time</p>
                        <p class="text-xs text-[#64748B] dark:text-[#94A3B8]">Offers ending soon</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Bar - DYNAMIC -->
        <div class="mt-16 lg:mt-20 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 reveal-up reveal-delay-2">
            <% stats.forEach(s => { %>
                <div class="text-center p-5 rounded-2xl bg-white/70 dark:bg-[#111827]/60 border border-[#E2E8F0]/60 dark:border-[#1E293B]/60 backdrop-blur-sm">
                    <p class="counter text-2xl sm:text-3xl font-extrabold text-[#0F172A] dark:text-white" data-target="<%= s.value %>" data-suffix="<%= s.suffix %>">0<%= s.suffix %></p>
                    <p class="mt-1 text-xs sm:text-sm text-[#64748B] dark:text-[#94A3B8] font-medium"><%= s.label %></p>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- CATEGORIES — DYNAMIC                                         -->
<!-- ============================================================ -->
<section class="py-16 lg:py-20 bg-white dark:bg-[#0F172A]/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-6 sm:mb-8 reveal-up">
            <div>
                <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">Browse</span>
                <h2 class="mt-2 text-xl sm:text-3xl font-extrabold text-[#0F172A] dark:text-white">Popular Categories</h2>
                <p class="mt-1 text-sm text-[#64748B] dark:text-[#94A3B8]"><%= categories.length %> categories available</p>
            </div>
            <div id="catSwipeHint" class="sm:hidden inline-flex items-center gap-1.5 text-[10px] font-semibold text-[#2563EB] bg-[#2563EB]/10 px-2.5 py-1.5 rounded-full">
                <span>Swipe</span>
                <i class="fas fa-arrow-right swipe-hint-arrow"></i>
            </div>
            <div class="hidden sm:flex items-center gap-2">
                <button onclick="scrollByAmount('catScroll', -320)" class="scroll-btn w-10 h-10 rounded-full border border-[#E2E8F0] dark:border-[#1E293B] flex items-center justify-center text-[#0F172A] dark:text-white hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB] transition-all duration-300">
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
                <button onclick="scrollByAmount('catScroll', 320)" class="scroll-btn w-10 h-10 rounded-full border border-[#E2E8F0] dark:border-[#1E293B] flex items-center justify-center text-[#0F172A] dark:text-white hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB] transition-all duration-300">
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            </div>
        </div>

        <div class="relative -mx-4 px-4 sm:mx-0 sm:px-0">
            <div class="pointer-events-none absolute left-0 top-0 bottom-2 w-8 sm:w-14 bg-gradient-to-r from-white dark:from-[#0F172A] to-transparent z-10"></div>
            <div class="pointer-events-none absolute right-0 top-0 bottom-2 w-10 sm:w-14 bg-gradient-to-l from-white dark:from-[#0F172A] to-transparent z-10"></div>

            <div id="catScroll" class="flex gap-2.5 sm:gap-4 overflow-x-auto overflow-y-hidden no-scrollbar scroll-smooth snap-x snap-mandatory pb-2">
                <% if (categories && categories.length > 0) { %>
                    <% categories.forEach((cat, i) => { %>
                        <a href="/courses?category=<%= encodeURIComponent(cat.name) %>"
                           class="reveal-up snap-start shrink-0 w-[104px] sm:w-[190px] group rounded-xl sm:rounded-2xl border border-[#E2E8F0] dark:border-[#1E293B] bg-[#F8FAFC] dark:bg-[#111827] p-3 sm:p-5 hover:border-[#2563EB]/40 hover:shadow-lg hover:shadow-[#2563EB]/10 hover:-translate-y-1.5 active:scale-95 transition-all duration-300"
                           style="transition-delay: <%= i * 40 %>ms">
                            <div class="w-8 h-8 sm:w-12 sm:h-12 rounded-lg sm:rounded-xl bg-gradient-to-br from-[#2563EB]/10 to-[#C9A227]/10 flex items-center justify-center text-[#2563EB] group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                                <i class="fas <%= cat.icon || 'fa-shield-alt' %> text-xs sm:text-lg"></i>
                            </div>
                            <h3 class="mt-2 sm:mt-4 font-semibold text-[11px] sm:text-sm text-[#0F172A] dark:text-white leading-snug line-clamp-2"><%= cat.name %></h3>
                            <p class="mt-0.5 sm:mt-1 text-[9px] sm:text-xs text-[#64748B] dark:text-[#94A3B8]"><%= cat.count || 0 %> courses</p>
                        </a>
                    <% }) %>
                <% } else { %>
                    <p class="text-[#64748B] dark:text-[#94A3B8] py-4">No categories available yet</p>
                <% } %>
                <div class="shrink-0 w-1 sm:hidden" aria-hidden="true"></div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- POPULAR COURSES - DYNAMIC                                    -->
<!-- ============================================================ -->
<% if (popularCourses && popularCourses.length > 0) { %>
<section class="py-16 lg:py-20 bg-[#F8FAFC] dark:bg-[#0B1120]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-10 reveal-up">
            <div>
                <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">Handpicked</span>
                <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#0F172A] dark:text-white">Popular Courses</h2>
                <p class="mt-2 text-sm text-[#64748B] dark:text-[#94A3B8] max-w-md">Courses loved most by our learners.</p>
            </div>
            <a href="/courses" class="inline-flex items-center gap-2 text-sm font-semibold text-[#2563EB] hover:gap-3 transition-all duration-300">
                View all <i class="fas fa-arrow-right text-xs"></i>
            </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% popularCourses.forEach((c, i) => { %>
                <div class="group reveal-up rounded-2xl overflow-hidden bg-white dark:bg-[#111827] border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 hover:shadow-xl hover:shadow-[#2563EB]/10 hover:-translate-y-2 transition-all duration-400"
                     style="transition-delay: <%= (i % 4) * 60 %>ms">
                    <div class="relative overflow-hidden h-44">
                        <img src="<%= c.img %>" alt="<%= c.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy">
                        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white/90 dark:bg-[#0B1120]/90 text-[#0F172A] dark:text-white backdrop-blur">
                            <%= c.level || 'Beginner' %>
                        </span>
                        <% if (c.oldPrice > c.price) { %>
                            <span class="absolute top-3 right-3 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-[#C9A227] text-white shadow">
                                <%= Math.round((1 - c.price / c.oldPrice) * 100) %>% OFF
                            </span>
                        <% } %>
                        <div class="absolute bottom-3 left-3 flex items-center gap-2 text-white text-[10px] bg-black/40 backdrop-blur px-2.5 py-1 rounded-lg">
                            <span><i class="fas fa-play-circle mr-1"></i><%= c.lessons || 0 %> lessons</span>
                            <span class="w-px h-3 bg-white/30"></span>
                            <span><i class="fas fa-clock mr-1"></i><%= c.duration || '0h' %></span>
                            <span class="w-px h-3 bg-white/30"></span>
                            <span><i class="fas fa-users mr-1"></i><%= (c.students || 0).toLocaleString() %></span>
                        </div>
                    </div>
                    <div class="p-5">
                        <span class="text-[10px] font-bold tracking-wider text-[#2563EB] uppercase"><%= c.category || 'Course' %></span>
                        <h3 class="mt-1.5 text-sm font-bold text-[#0F172A] dark:text-white leading-snug line-clamp-2 min-h-[2.5rem]"><%= c.title %></h3>
                        <p class="mt-1.5 text-xs text-[#64748B] dark:text-[#94A3B8]">by <%= c.instructor || 'Expert' %></p>

                        <div class="mt-3 flex items-center gap-1.5 text-xs">
                            <span class="font-bold text-[#C9A227]"><%= c.rating || 0 %></span>
                            <div class="flex text-[#C9A227] text-[10px]">
                                <% for (let s = 0; s < 5; s++) { %>
                                    <i class="fa-star <%= s < Math.round(c.rating || 0) ? 'fas' : 'far' %>"></i>
                                <% } %>
                            </div>
                            <span class="text-[#94A3B8]">(<%= (c.reviews || 0).toLocaleString() %>)</span>
                        </div>

                        <div class="mt-3 flex items-baseline gap-2">
                            <span class="text-base font-extrabold text-[#0F172A] dark:text-white">₹<%= (c.oldPrice || 0).toLocaleString() %></span>
                            <% if (c.oldPrice && c.price > c.oldPrice) { %>
                                <span class="text-xs text-[#94A3B8] line-through">₹<%= (c.price || 0).toLocaleString() %></span>
                            <% } %>
                        </div>

                        <div class="mt-4 pt-4 border-t border-[#E2E8F0] dark:border-[#1E293B] flex items-center gap-2">
                            <a href="/courses/<%= c._id %>"
                               class="flex-1 text-center px-3 py-2 rounded-xl text-xs font-semibold border border-[#E2E8F0] dark:border-[#1E293B] text-[#0F172A] dark:text-white hover:border-[#2563EB]/50 hover:text-[#2563EB] transition-all duration-300">
                                View Details
                            </a>
                            <% if (c.isEnrolled) { %>
                                <a href="/courses/<%= c._id %>/access"
                                   class="flex-1 text-center px-3 py-2 rounded-xl text-xs font-bold bg-[#22C55E] text-white hover:bg-[#16A34A] shadow-md shadow-[#22C55E]/25 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300">
                                    <i class="fas fa-play-circle mr-1"></i> Continue
                                </a>
                            <% } else { %>
                                <a href="/enroll?courseId=<%= c._id %>"
                                   class="flex-1 text-center px-3 py-2 rounded-xl text-xs font-bold bg-[#2563EB] text-white hover:bg-[#1D4ED8] shadow-md shadow-[#2563EB]/25 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300">
                                    Enroll Now
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<!-- ============================================================ -->
<!-- NEWLY LAUNCHED COURSES - DYNAMIC (max 10)                   -->
<!-- ============================================================ -->
<% if (newCourses && newCourses.length > 0) { %>
<section class="py-16 lg:py-20 bg-white dark:bg-[#0F172A]/40 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-10 reveal-up">
            <div>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold tracking-widest text-[#2563EB] uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#2563EB] pulse-dot"></span> Fresh Drop
                </span>
                <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#0F172A] dark:text-white">Newly Launched</h2>
                <p class="mt-1 text-sm text-[#64748B] dark:text-[#94A3B8]">Latest additions to our course library</p>
            </div>
            <div class="hidden sm:flex items-center gap-2">
                <button onclick="scrollByAmount('newScroll', -340)" class="scroll-btn w-10 h-10 rounded-full border border-[#E2E8F0] dark:border-[#1E293B] flex items-center justify-center text-[#0F172A] dark:text-white hover:bg-[#C9A227] hover:text-white hover:border-[#C9A227] transition-all duration-300">
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
                <button onclick="scrollByAmount('newScroll', 340)" class="scroll-btn w-10 h-10 rounded-full border border-[#E2E8F0] dark:border-[#1E293B] flex items-center justify-center text-[#0F172A] dark:text-white hover:bg-[#C9A227] hover:text-white hover:border-[#C9A227] transition-all duration-300">
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            </div>
        </div>

        <div id="newScroll" class="flex gap-6 overflow-x-auto overflow-y-hidden no-scrollbar scroll-smooth snap-x snap-mandatory pb-2">
            <% newCourses.forEach((c, i) => { %>
                <div class="group reveal-up shrink-0 w-[280px] sm:w-[320px] snap-start rounded-2xl overflow-hidden bg-[#F8FAFC] dark:bg-[#111827] border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 hover:shadow-xl hover:shadow-[#2563EB]/10 hover:-translate-y-2 transition-all duration-400"
                     style="transition-delay: <%= i * 50 %>ms">
                    <div class="relative h-44 overflow-hidden">
                        <img src="<%= c.img %>" alt="<%= c.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy">
                        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-[#2563EB] text-white shadow">NEW</span>
                        <span class="absolute top-3 right-3 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-[#22C55E] text-white shadow"><%= c.launched || 'New' %></span>
