<!-- ============================================================ -->
<!-- SCRIPTS                                                       -->
<!-- ============================================================ -->
<script>
    // ============================================================
    // SCROLL FUNCTIONS
    // ============================================================
    function scrollByAmount(id, amount) {
        const el = document.getElementById(id);
        if (el) el.scrollBy({ left: amount, behavior: 'smooth' });
    }

    // ============================================================
    // OFFER SLIDER
    // ============================================================
    let currentOffer = 0;
    const totalOffers = <%= offers ? offers.length : 1 %>;

    function updateOfferSlider() {
        const track = document.getElementById('offerTrack');
        const dots = document.querySelectorAll('.offer-dot');
        if (!track || totalOffers <= 1) return;
        
        track.style.transform = `translateX(-${currentOffer * 100}%)`;
        
        dots.forEach((dot, index) => {
            if (index === currentOffer) {
                dot.classList.add('w-6', 'bg-[#C9A227]');
                dot.classList.remove('w-2', 'bg-white/50');
            } else {
                dot.classList.remove('w-6', 'bg-[#C9A227]');
                dot.classList.add('w-2', 'bg-white/50');
            }
        });
    }

    function changeOffer(direction) {
        if (totalOffers <= 1) return;
        currentOffer = (currentOffer + direction + totalOffers) % totalOffers;
        updateOfferSlider();
        resetAutoSlide();
    }

    function goToOffer(index) {
        if (totalOffers <= 1) return;
        currentOffer = index;
        updateOfferSlider();
        resetAutoSlide();
    }

    let autoSlideInterval;

    function startAutoSlide() {
        if (totalOffers <= 1) return;
        autoSlideInterval = setInterval(() => {
            currentOffer = (currentOffer + 1) % totalOffers;
            updateOfferSlider();
        }, 5000);
    }

    function resetAutoSlide() {
        clearInterval(autoSlideInterval);
        startAutoSlide();
    }

    // ============================================================
    // TESTIMONIAL PAGINATION
    // ============================================================
    const reviewTrack = document.getElementById('reviewTrack');
    const totalReviews = <%= testimonials ? testimonials.length : 0 %>;
    let reviewCardWidth = 0;

    function computeCardWidth() {
        const firstCard = reviewTrack?.children[0];
        if (firstCard) {
            const style = getComputedStyle(reviewTrack);
            const gap = parseFloat(style.columnGap || style.gap || 24);
            reviewCardWidth = firstCard.getBoundingClientRect().width + gap;
        }
    }
    window.addEventListener('load', computeCardWidth);
    window.addEventListener('resize', computeCardWidth);

    function jumpToReview(index) {
        if (!reviewTrack || totalReviews <= 1) return;
        reviewTrack.style.animation = 'none';
        reviewTrack.style.transform = `translateX(-${index * reviewCardWidth}px)`;

        document.querySelectorAll('.review-dot').forEach((dot, i) => {
            if (i === index) {
                dot.classList.add('w-8', 'bg-[#2563EB]');
                dot.classList.remove('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
            } else {
                dot.classList.remove('w-8', 'bg-[#2563EB]');
                dot.classList.add('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
            }
        });

        clearTimeout(window.__reviewResume);
        window.__reviewResume = setTimeout(() => {
            reviewTrack.style.transform = '';
            reviewTrack.style.animation = '';
        }, 3500);
    }

    // ============================================================
    // AUTO CYCLE DOTS
    // ============================================================
    (function autoCycleDots() {
        if (totalReviews <= 1) return;
        let current = 0;
        setInterval(() => {
            current = (current + 1) % totalReviews;
            document.querySelectorAll('.review-dot').forEach((dot, i) => {
                if (i === current) {
                    dot.classList.add('w-8', 'bg-[#2563EB]');
                    dot.classList.remove('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
                } else {
                    dot.classList.remove('w-8', 'bg-[#2563EB]');
                    dot.classList.add('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
                }
            });
        }, 38000 / totalReviews);
    })();

    // ============================================================
    // DOM CONTENT LOADED
    // ============================================================
    document.addEventListener('DOMContentLoaded', () => {
        // Start auto-slide for offers
        startAutoSlide();

        // Hide mobile swipe hint after scroll
        const catScroll = document.getElementById('catScroll');
        const swipeHint = document.getElementById('catSwipeHint');
        if (catScroll && swipeHint) {
            catScroll.addEventListener('scroll', () => {
                swipeHint.style.opacity = '0';
                swipeHint.style.pointerEvents = 'none';
            }, { once: true, passive: true });
        }

        // Reveal on scroll
        const revealEls = document.querySelectorAll('.reveal-up');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        revealEls.forEach(el => observer.observe(el));

        // Counters
        const counters = document.querySelectorAll('.counter');
        const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                const target = parseInt(el.dataset.target, 10);
                const suffix = el.dataset.suffix || '';
                const duration = 1400;
                const start = performance.now();
                function tick(now) {
                    const progress = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.floor(eased * target) + suffix;
                    if (progress < 1) requestAnimationFrame(tick);
                    else el.textContent = target + suffix;
                }
                requestAnimationFrame(tick);
                counterObserver.unobserve(el);
            });
        }, { threshold: 0.4 });
        counters.forEach(el => counterObserver.observe(el));
    });
</script>