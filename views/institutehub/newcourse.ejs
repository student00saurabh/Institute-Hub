<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                        </div>
                        Create New Course
                    </h1>
                    <p class="mt-1 text-gray-600 dark:text-gray-400">
                        Design and launch your new educational content
                    </p>
                </div>
                <div class="mt-4 md:mt-0">
                    <a href="/courses" 
                       class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                        <i class="fas fa-arrow-left mr-2"></i> Back to Courses
                    </a>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6 sm:p-8" data-aos="fade-up" data-aos-duration="600">
            <form action="/courses" method="POST" enctype="multipart/form-data" class="space-y-8" id="courseForm">
                
                <!-- Progress Steps -->
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 flex items-center justify-center text-white text-xs font-bold">1</div>
                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Basic Info</span>
                    </div>
                    <div class="flex-1 h-0.5 bg-gray-200 dark:bg-gray-700 mx-4"></div>
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400 text-xs font-bold">2</div>
                        <span class="text-sm font-medium text-gray-400 dark:text-gray-500">Pricing</span>
                    </div>
                    <div class="flex-1 h-0.5 bg-gray-200 dark:bg-gray-700 mx-4"></div>
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400 text-xs font-bold">3</div>
                        <span class="text-sm font-medium text-gray-400 dark:text-gray-500">Media</span>
                    </div>
                </div>

                <!-- Basic Information -->
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 rounded-full bg-gradient-to-b from-blue-600 to-indigo-600"></span>
                        Basic Information
                    </h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Essential details about your course</p>

                    <div class="space-y-5">
                        <!-- Title -->
                        <div>
                            <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Course Title <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="title" name="title" required
                                placeholder="Enter course title (e.g., Advanced Penetration Testing)"
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                            <div class="mt-1.5 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                                <span><i class="fas fa-info-circle mr-1"></i> Clear, descriptive title</span>
                                <span id="title-counter">0/120 characters</span>
                            </div>
                        </div>

                        <!-- Short Description -->
                        <div>
                            <label for="shortDescription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Short Description <span class="text-red-500">*</span>
                            </label>
                            <textarea id="shortDescription" name="shortDescription" required rows="3"
                                placeholder="Brief overview for course listings (2-3 sentences)"
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 resize-none"></textarea>
                            <div class="mt-1.5 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                                <span><i class="fas fa-info-circle mr-1"></i> 150-200 characters recommended</span>
                                <span id="shortDesc-counter">0/250 characters</span>
                            </div>
                        </div>

                        <!-- Full Description -->
                        <div>
                            <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Detailed Description
                            </label>
                            <textarea id="description" name="description" rows="6"
                                placeholder="Comprehensive course description including objectives and outcomes"
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 resize-none"></textarea>
                            <div class="mt-1.5 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                                <span><i class="fas fa-info-circle mr-1"></i> Detailed description for course page</span>
                                <span id="desc-counter">0/5000 characters</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pricing & Details -->
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 rounded-full bg-gradient-to-b from-blue-600 to-indigo-600"></span>
                        Pricing & Details
                    </h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Set pricing and course specifications</p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Price -->
                        <div>
                            <label for="price" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Price <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500">₹</span>
                                <input type="number" id="price" name="price" min="0" step="0.01" required
                                    placeholder="99.99"
                                    class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                            </div>
                        </div>

                        <!-- Actual Price -->
                        <div>
                            <label for="actualPrice" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Discounted Price <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500">₹</span>
                                <input type="number" id="actualPrice" name="actualPrice" min="0" step="0.01" required
                                    placeholder="79.99"
                                    class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                            </div>
                        </div>

                        <!-- Discount -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Discount</label>
                            <div class="px-4 py-3 rounded-xl bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 border border-green-200 dark:border-green-800">
                                <span id="discountPercentage" class="text-2xl font-bold text-green-600 dark:text-green-400">0%</span>
                                <span class="text-gray-500 dark:text-gray-400 text-sm ml-2">off</span>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                        <!-- Course Type -->
                        <div>
                            <label for="courceType" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Course Type <span class="text-red-500">*</span>
                            </label>
                            <select id="courceType" name="courceType" required
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 appearance-none">
                                <option value="">Select Category</option>
                                <option value="CYBERSECURITY">🔒 Cybersecurity</option>
                                <option value="PENETRATION TESTING">🎯 Penetration Testing</option>
                                <option value="RED TEAMING">🛡️ Red Teaming</option>
                                <option value="WEB SECURITY">💻 Web Security</option>
                                <option value="NETWORK SECURITY">🌐 Network Security</option>
                                <option value="CLOUD SECURITY">☁️ Cloud Security</option>
                                <option value="OSCP">📜 OSCP Preparation</option>
                                <option value="CEH">🔐 CEH Certification</option>
                                <option value="RHCSA">🐧 RHCSA Certification</option>
                                <option value="OTHER">✨ Other</option>
                            </select>
                        </div>

                        <!-- Course Level -->
                        <div>
                            <label for="courseLevel" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Course Level <span class="text-red-500">*</span>
                            </label>
                            <select id="courseLevel" name="courseLevel" required
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 appearance-none">
                                <option value="">Select Level</option>
                                <option value="beginner">🌱 Beginner</option>
                                <option value="intermediate">📘 Intermediate</option>
                                <option value="advanced">🚀 Advanced</option>
                                <option value="expert">🏆 Expert</option>
                            </select>
                        </div>

                        <!-- Duration -->
                        <div>
                            <label for="duration" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Duration (Days)
                            </label>
                            <input type="number" id="duration" name="duration" min="1"
                                placeholder="e.g., 8"
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                        </div>
                    </div>
                </div>

                <!-- Teacher Selection -->
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 rounded-full bg-gradient-to-b from-blue-600 to-indigo-600"></span>
                        Instructor
                    </h2>
                    <div>
                        <label for="teacher" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Course Mentor/Teacher <span class="text-red-500">*</span>
                        </label>
                        <select id="teacher" name="teacher" required
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 appearance-none">
                            <option value="">Select Teacher/Mentor</option>
                            <% if(teachers && teachers.length > 0) { %>
                                <% teachers.forEach(teacher => { %>
                                    <option value="<%= teacher._id %>">👨‍🏫 <%= teacher.name %> (<%= teacher.email %>)</option>
                                <% }) %>
                            <% } else { %>
                                <option value="" disabled>No teachers available. Please add teachers first.</option>
                            <% } %>
                        </select>
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Select the instructor who will teach this course
                        </p>
                    </div>
                </div>

                <!-- Display Settings -->
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 rounded-full bg-gradient-to-b from-blue-600 to-indigo-600"></span>
                        Display Settings
                    </h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Control where and how the course appears</p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-700 transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30">
                            <input type="checkbox" name="addInHomePage" class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:focus:ring-blue-400">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white">Show on Homepage</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Display course on the main landing page</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-700 transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30">
                            <input type="checkbox" name="isPopular" class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-yellow-500 focus:ring-yellow-500">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white">Mark as Popular</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Featured as a popular course</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-700 transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30">
                            <input type="checkbox" name="isActive" checked class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-green-500 focus:ring-green-500">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white">Active Course</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Make course available to students</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-700 transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30">
                            <input type="checkbox" id="showInNavbar" name="showInNavbar" class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:focus:ring-blue-400">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white">Show in Navigation</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Add direct link in navbar</p>
                            </div>
                        </label>
                    </div>

                    <!-- Navbar Settings -->
                    <div id="navbarSettings" class="hidden mt-4 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="navbarButtonText" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Navbar Button Text
                                </label>
                                <input type="text" id="navbarButtonText" name="navbarButtonText" 
                                    placeholder="e.g., OSCP Certification"
                                    class="w-full px-4 py-2.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                            </div>
                            <div>
                                <label for="navbarButtonColor" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Button Color
                                </label>
                                <select id="navbarButtonColor" name="navbarButtonColor"
                                    class="w-full px-4 py-2.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                                    <option value="blue">Blue</option>
                                    <option value="cyan">Cyan</option>
                                    <option value="purple">Purple</option>
                                    <option value="green">Green</option>
                                    <option value="red">Red</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Course Category -->
<div class="group">
  <label for="category" class="block mb-3 font-semibold text-gray-900 dark:text-gray-200 group-hover:text-cyan-400 transition-colors">
    Course Category
  </label>
  <div class="relative">
    <select id="category" name="category"
      class="w-full px-5 py-3.5 rounded-xl bg-gray-200 dark:bg-gray-800/70 border border-gray-700 text-white 
             focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 
             appearance-none transition-all duration-300">
      <option value="" class="text-gray-800 dark:text-gray-200 bg-gray-100 dark:bg-gray-800">Select Category</option>
      <% if(categories && categories.length > 0) { %>
        <% categories.forEach(cat => { %>
          <option value="<%= cat._id %>" class="bg-gray-200 text-gray-800 dark:text-gray-200 dark:bg-gray-800">
            <i class="fas <%= cat.icon || 'fa-shield-alt' %>"></i> <%= cat.name %>
          </option>
        <% }) %>
      <% } else { %>
        <option value="" disabled class="bg-gray-800">No categories available. Please create categories first.</option>
      <% } %>
    </select>
    <div class="absolute right-4 top-1/2 transform -translate-y-1/2 pointer-events-none">
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>
  </div>
  <p class="mt-2 text-sm text-gray-400">Select a category for this course</p>
</div>

                <!-- Course Image -->
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 rounded-full bg-gradient-to-b from-blue-600 to-indigo-600"></span>
                        Course Image
                    </h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Upload a thumbnail for your course</p>

                    <div>
                        <label for="image" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Course Thumbnail <span class="text-red-500">*</span>
                        </label>
                        <div class="relative border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl p-8 hover:border-blue-400 dark:hover:border-blue-500 transition-colors bg-gray-50 dark:bg-gray-700/30">
                            <input type="file" id="image" name="image" accept="image/*" required
                                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                                onchange="previewImage(this)">
                            <div class="text-center">
                                <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <p class="text-sm text-gray-600 dark:text-gray-400">
                                    <span class="font-medium text-blue-600 dark:text-blue-400">Click to upload</span> or drag and drop
                                </p>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                    PNG, JPG, WebP up to 5MB (Recommended: 1280×720px)
                                </p>
                            </div>
                        </div>
                        <div id="imagePreviewContainer" class="mt-3 hidden">
                            <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-4 border border-green-200 dark:border-green-800">
                                <div class="flex items-center gap-4">
                                    <div class="w-24 h-24 rounded-lg overflow-hidden border border-green-300 dark:border-green-700 bg-white dark:bg-gray-800 flex-shrink-0">
                                        <img id="imagePreview" src="#" alt="Preview" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm text-green-800 dark:text-green-300">
                                            <strong id="fileName"></strong><br>
                                            <span id="fileSize"></span>
                                        </p>
                                    </div>
                                    <button type="button" onclick="removePreview()" class="text-green-700 dark:text-green-400 hover:text-green-900 dark:hover:text-green-300">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Course PDF Drive Link -->
<div>
    <label for="pdfDetails" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
        Course Details PDF (Drive Link)
    </label>
    <input type="url" id="pdfDetails" name="pdfDetails" 
        placeholder="https://drive.google.com/file/d/xxxxx/view"
        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
        <i class="fas fa-link mr-1"></i> Paste Google Drive shareable link
    </p>
</div>

                <!-- Form Actions -->
                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <button type="submit" id="submitBtn"
                        class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-medium py-3.5 px-6 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        Create Course
                    </button>
                    <a href="/courses"
                        class="flex-1 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 font-medium py-3.5 px-6 rounded-xl transition-colors duration-200 text-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Help Tips -->
        <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 rounded-xl p-6 border border-blue-100 dark:border-blue-800" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-blue-900 dark:text-blue-300">Course Creation Tips</h3>
                    <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Clear Title</p>
                            <p class="mt-0.5 text-xs opacity-80">Use descriptive, search-friendly titles</p>
                        </div>
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Quality Image</p>
                            <p class="mt-0.5 text-xs opacity-80">High-quality thumbnails increase engagement</p>
                        </div>
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Pricing Strategy</p>
                            <p class="mt-0.5 text-xs opacity-80">Set competitive pricing with discounts</p>
                        </div>
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Display Options</p>
                            <p class="mt-0.5 text-xs opacity-80">Choose visibility settings wisely</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Character counters
    const titleInput = document.getElementById('title');
    const shortDescInput = document.getElementById('shortDescription');
    const descInput = document.getElementById('description');
    const priceInput = document.getElementById('price');
    const actualPriceInput = document.getElementById('actualPrice');
    const discountElement = document.getElementById('discountPercentage');
    const showInNavbar = document.getElementById('showInNavbar');
    const navbarSettings = document.getElementById('navbarSettings');

    // Title counter
    if (titleInput) {
        titleInput.addEventListener('input', function() {
            document.getElementById('title-counter').textContent = `${this.value.length}/120 characters`;
        });
    }

    // Short description counter
    if (shortDescInput) {
        shortDescInput.addEventListener('input', function() {
            document.getElementById('shortDesc-counter').textContent = `${this.value.length}/250 characters`;
        });
    }

    // Description counter
    if (descInput) {
        descInput.addEventListener('input', function() {
            document.getElementById('desc-counter').textContent = `${this.value.length}/5000 characters`;
        });
    }

    // Calculate discount
    function calculateDiscount() {
        const price = parseFloat(priceInput?.value) || 0;
        const actualPrice = parseFloat(actualPriceInput?.value) || 0;
        
        if (price > 0 && actualPrice < price) {
            const discount = ((price - actualPrice) / price * 100).toFixed(1);
            if (discountElement) {
                discountElement.textContent = `${discount}%`;
            }
        } else if (discountElement) {
            discountElement.textContent = '0%';
        }
    }

    if (priceInput && actualPriceInput) {
        priceInput.addEventListener('input', calculateDiscount);
        actualPriceInput.addEventListener('input', calculateDiscount);
    }

    // Image preview
    window.previewImage = function(input) {
        const previewContainer = document.getElementById('imagePreviewContainer');
        const preview = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        
        if (input.files && input.files[0]) {
            const file = input.files[0];
            
            if (file.size > 5 * 1024 * 1024) {
                alert('File size should be less than 5MB');
                input.value = '';
                previewContainer.classList.add('hidden');
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                fileName.textContent = file.name;
                fileSize.textContent = (file.size / 1024).toFixed(2) + ' KB';
                previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add('hidden');
        }
    };

    window.removePreview = function() {
        const fileInput = document.getElementById('image');
        const previewContainer = document.getElementById('imagePreviewContainer');
        fileInput.value = '';
        previewContainer.classList.add('hidden');
    };

    // Show/hide navbar settings
    if (showInNavbar && navbarSettings) {
        showInNavbar.addEventListener('change', function() {
            navbarSettings.classList.toggle('hidden');
        });
    }

    // Form validation
    const form = document.getElementById('courseForm');
    const submitBtn = document.getElementById('submitBtn');
    
    if (form && submitBtn) {
        form.addEventListener('submit', function(e) {
            const price = parseFloat(priceInput?.value) || 0;
            const actualPrice = parseFloat(actualPriceInput?.value) || 0;
            
            if (actualPrice > price) {
                e.preventDefault();
                alert('Discounted price cannot be higher than original price');
                actualPriceInput?.focus();
            }
            
            const imageFile = document.getElementById('image')?.files[0];
            if (!imageFile) {
                e.preventDefault();
                alert('Please upload a course thumbnail image');
                document.getElementById('image')?.focus();
            }
        });
    }

    // Set default launch date to tomorrow
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const launchDateInput = document.getElementById('lounchedDate');
    if (launchDateInput) {
        launchDateInput.value = tomorrow.toISOString().split('T')[0];
    }
});
</script>