<% layout("/layouts/boilerplate") %>

<%
  // ✅ Safe access - currUser from app.js
  const userEmail = currUser?.email || '';
  const userName = currUser?.name || 'Student';
  const userInitial = userName.charAt(0).toUpperCase() || 'S';
%>

<div class="min-h-screen bg-[#F8FAFC] dark:bg-[#0B1120]" id="courseContentRoot"
     data-course-id="<%= course._id %>"
     data-user-email="<%= userEmail %>"
     data-user-name="<%= userName %>">

    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- Breadcrumb -->
        <nav class="flex mb-5 text-sm" aria-label="Breadcrumb">
            <ol class="inline-flex items-center flex-wrap gap-2">
                <li><a href="/" class="text-[#64748B] dark:text-[#94A3B8] hover:text-[#2563EB] transition-colors"><i class="fas fa-home mr-1"></i> Home</a></li>
                <li class="flex items-center"><i class="fas fa-chevron-right text-[#CBD5E1] dark:text-[#334155] mx-2 text-xs"></i>
                    <a href="/courses" class="text-[#64748B] dark:text-[#94A3B8] hover:text-[#2563EB] transition-colors">Courses</a>
                </li>
                <li class="flex items-center"><i class="fas fa-chevron-right text-[#CBD5E1] dark:text-[#334155] mx-2 text-xs"></i>
                    <a href="/courses/<%= course._id %>" class="text-[#64748B] dark:text-[#94A3B8] hover:text-[#2563EB] transition-colors truncate max-w-[200px]"><%= course.title %></a>
                </li>
                <li class="flex items-center"><i class="fas fa-chevron-right text-[#CBD5E1] dark:text-[#334155] mx-2 text-xs"></i>
                    <span class="text-[#0F172A] dark:text-white font-medium">Learning</span>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- ============================================================ -->
            <!-- LEFT — Player                                                 -->
            <!-- ============================================================ -->
            <div class="lg:col-span-2 space-y-5">

                <!-- Course header -->
                <div class="bg-white dark:bg-[#111827] rounded-2xl border border-[#E2E8F0] dark:border-[#1E293B] p-5">
                    <h1 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] dark:text-white"><%= course.title %></h1>
                    <div class="flex flex-wrap items-center gap-4 mt-2.5 text-sm text-[#64748B] dark:text-[#94A3B8]">
                        <span><i class="fas fa-user mr-1 text-[#2563EB]"></i> <%= course.teacher ? course.teacher.name : 'Instructor' %></span>
                        <span><i class="fas fa-play-circle mr-1 text-[#2563EB]"></i> <%= totalLectures || 0 %> Lectures</span>
                        <span><i class="fas fa-check-circle mr-1 text-[#22C55E]"></i> <%= completedLectures || 0 %> Completed</span>
                    </div>
                </div>

                <!-- Video player -->
                <div class="relative bg-black rounded-2xl overflow-hidden border border-[#E2E8F0] dark:border-[#1E293B] select-none" id="playerWrapper">

                    <!-- Loading state -->
                    <div id="playerLoading" class="aspect-video flex flex-col items-center justify-center gap-3 text-white/70 bg-[#0F172A]">
                        <i class="fas fa-circle-notch fa-spin text-3xl text-[#2563EB]"></i>
                        <span class="text-sm">Loading secure video…</span>
                    </div>

                    <!-- Native video element -->
                    <video id="lectureVideo"
                           class="w-full aspect-video hidden"
                           controlsList="nodownload noremoteplayback"
                           disablePictureInPicture
                           playsinline
                           controls></video>

                    <!-- Embed fallback -->
                    <iframe id="lectureEmbed"
                            class="w-full aspect-video hidden"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>

                    <!-- Moving watermark -->
                    <div id="videoWatermark" class="pointer-events-none absolute text-white/25 text-xs font-semibold tracking-wide select-none transition-all duration-1000 ease-linear hidden">
                        <%= userEmail || 'Student' %>
                    </div>

                    <!-- Security overlay -->
                    <div id="securityOverlay" class="hidden absolute inset-0 bg-[#0F172A]/95 backdrop-blur-sm flex-col items-center justify-center gap-3 text-white text-center px-6 z-20">
                        <i class="fas fa-shield-halved text-3xl text-[#C9A227]"></i>
                        <p class="font-semibold">Playback paused</p>
                        <p class="text-sm text-white/70 max-w-xs">For content security, playback pauses when developer tools are open or the tab loses focus. Return here to resume.</p>
                    </div>
                </div>

                <!-- Current lecture info -->
                <div class="bg-white dark:bg-[#111827] rounded-2xl border border-[#E2E8F0] dark:border-[#1E293B] p-5">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 id="currentLectureTitle" class="text-lg font-bold text-[#0F172A] dark:text-white">Select a lecture to begin</h3>
                            <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-1">
                                <i class="far fa-clock mr-1"></i> <span id="currentLectureDuration">--:--</span>
                            </p>
                        </div>
                        <span id="completionBadge" class="hidden shrink-0 px-3 py-1.5 rounded-full text-xs font-bold bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/20">
                            <i class="fas fa-check-circle mr-1"></i> Completed
                        </span>
                    </div>

                    <div class="mt-4 pt-4 border-t border-[#E2E8F0] dark:border-[#1E293B]">
                        <div class="flex items-center justify-between text-xs text-[#64748B] dark:text-[#94A3B8] mb-1.5">
                            <span>Watch progress</span>
                            <span id="watchPercentageLabel">0%</span>
                        </div>
                        <div class="w-full h-1.5 bg-[#E2E8F0] dark:bg-[#334155] rounded-full overflow-hidden">
                            <div id="watchProgressBar" class="h-full bg-gradient-to-r from-[#2563EB] to-[#C9A227] rounded-full transition-all duration-500" style="width:0%"></div>
                        </div>
                        <p class="mt-2 text-xs text-[#94A3B8]">
                            <i class="fas fa-info-circle mr-1"></i>
                            The lecture is marked complete automatically once you watch it through to the end.
                        </p>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- RIGHT — Progress + lecture list                               -->
            <!-- ============================================================ -->
            <div class="lg:col-span-1">
                <div class="sticky top-24 space-y-5">

                    <!-- Overall progress -->
                    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-[#E2E8F0] dark:border-[#1E293B] p-5">
                        <h3 class="font-semibold text-[#0F172A] dark:text-white mb-3">Your Progress</h3>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm text-[#64748B] dark:text-[#94A3B8]">Completion</span>
                            <span class="text-sm font-bold text-[#2563EB]" id="overallProgressPercentage"><%= progress || 0 %>%</span>
                        </div>
                        <div class="w-full bg-[#E2E8F0] dark:bg-[#334155] rounded-full h-2.5 mb-3">
                            <div class="bg-gradient-to-r from-[#2563EB] to-[#C9A227] h-2.5 rounded-full transition-all duration-500" id="overallProgressBar" style="width: <%= progress || 0 %>%"></div>
                        </div>
                        <div class="flex items-center justify-between text-sm text-[#64748B] dark:text-[#94A3B8]">
                            <span><i class="fas fa-check-circle mr-1 text-[#22C55E]"></i> <span id="completedCount"><%= completedLectures || 0 %></span> Completed</span>
                            <span><i class="fas fa-circle mr-1 text-[#CBD5E1] dark:text-[#334155]"></i> <span id="remainingCount"><%= (totalLectures || 0) - (completedLectures || 0) %></span> Remaining</span>
                        </div>
                    </div>

                    <!-- Lecture list -->
                    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-[#E2E8F0] dark:border-[#1E293B] overflow-hidden">
                        <div class="p-4 border-b border-[#E2E8F0] dark:border-[#1E293B]">
                            <h3 class="font-semibold text-[#0F172A] dark:text-white">Course Content</h3>
                            <p class="text-xs text-[#64748B] dark:text-[#94A3B8]"><%= totalLectures || 0 %> lectures</p>
                        </div>
                        <div class="max-h-[560px] overflow-y-auto lecture-scroll">
                            <% if (sections && Object.keys(sections).length > 0) { %>
                                <% let globalIndex = 0; %>
                                <% Object.keys(sections).forEach((sectionName) => { %>
                                    <div class="px-4 py-2.5 bg-[#F8FAFC] dark:bg-[#0B1120] text-xs font-bold uppercase tracking-wide text-[#64748B] dark:text-[#94A3B8] border-b border-[#E2E8F0] dark:border-[#1E293B]">
                                        <%= sectionName %>
                                    </div>
                                    <div class="divide-y divide-[#E2E8F0] dark:divide-[#1E293B]">
                                        <% sections[sectionName].forEach((lecture) => { globalIndex++; %>
                                            <button type="button"
                                                    class="lecture-item w-full text-left p-4 hover:bg-[#F8FAFC] dark:hover:bg-[#1E293B]/40 transition-colors flex items-start gap-3"
                                                    data-lecture-id="<%= lecture._id %>"
                                                    data-title="<%= lecture.title %>"
                                                    data-duration="<%= lecture.video && lecture.video.duration ? lecture.video.duration : 0 %>"
                                                    data-completed="<%= lecture.isCompleted || false %>">
                                                <span class="mt-0.5 shrink-0 lecture-status-icon">
                                                    <% if (lecture.isCompleted) { %>
                                                        <i class="fas fa-check-circle text-[#22C55E] text-lg"></i>
                                                    <% } else { %>
                                                        <i class="fas fa-play-circle text-[#94A3B8] text-lg"></i>
                                                    <% } %>
                                                </span>
                                                <span class="flex-1 min-w-0">
                                                    <span class="block text-sm font-medium text-[#0F172A] dark:text-white truncate lecture-title-text"><%= lecture.title %></span>
                                                    <span class="flex items-center gap-2 mt-0.5">
                                                        <span class="text-xs text-[#64748B] dark:text-[#94A3B8]">
                                                            <i class="far fa-clock mr-1"></i><%= lecture.video && lecture.video.duration ? Math.ceil(lecture.video.duration / 60) + ' min' : '—' %>
                                                        </span>
                                                        <span class="text-xs lecture-status-text <%= lecture.isCompleted ? 'text-[#22C55E] font-medium' : 'text-[#94A3B8]' %>">
                                                            <%= lecture.isCompleted ? 'Completed' : 'Pending' %>
                                                        </span>
                                                    </span>
                                                </span>
                                                <span class="text-xs text-[#94A3B8] shrink-0">#<%= globalIndex %></span>
                                            </button>
                                        <% }) %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="p-6 text-center text-[#64748B] dark:text-[#94A3B8]">
                                    <i class="fas fa-book-open text-2xl mb-2 block"></i>
                                    <p>No lectures available yet.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- SCRIPTS                                                       -->
<!-- ============================================================ -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    'use strict';

    const root = document.getElementById('courseContentRoot');
    if (!root) {
        console.error('Course content root not found');
        return;
    }

    const COURSE_ID = root.dataset.courseId;
    const USER_EMAIL = root.dataset.userEmail || '';
    const USER_NAME = root.dataset.userName || 'Student';

    const videoEl = document.getElementById('lectureVideo');
    const embedEl = document.getElementById('lectureEmbed');
    const loadingEl = document.getElementById('playerLoading');
    const watermarkEl = document.getElementById('videoWatermark');
    const securityOverlay = document.getElementById('securityOverlay');
    const titleEl = document.getElementById('currentLectureTitle');
    const durationEl = document.getElementById('currentLectureDuration');
    const completionBadge = document.getElementById('completionBadge');
    const watchBar = document.getElementById('watchProgressBar');
    const watchLabel = document.getElementById('watchPercentageLabel');

    let currentLectureId = null;
    let progressPingTimer = null;
    let watermarkTimer = null;
    let hasSentEnded = false;

    // ========== WATERMARK ==========
    function startWatermarkDrift() {
        stopWatermarkDrift();
        watermarkEl.textContent = USER_EMAIL || USER_NAME;
        watermarkEl.classList.remove('hidden');
        const place = () => {
            const top = 10 + Math.random() * 70;
            const left = 10 + Math.random() * 70;
            watermarkEl.style.top = top + '%';
            watermarkEl.style.left = left + '%';
        };
        place();
        watermarkTimer = setInterval(place, 6000);
    }

    function stopWatermarkDrift() {
        if (watermarkTimer) clearInterval(watermarkTimer);
        watermarkEl.classList.add('hidden');
    }

    // ========== DETERRENTS ==========
    const playerWrapper = document.getElementById('playerWrapper');
    if (playerWrapper) {
        playerWrapper.addEventListener('contextmenu', (e) => e.preventDefault());
    }

    document.addEventListener('keydown', (e) => {
        const key = e.key?.toLowerCase();
        const blocked = key === 'f12' ||
            (e.ctrlKey && e.shiftKey && ['i', 'j', 'c'].includes(key)) ||
            (e.ctrlKey && key === 'u') ||
            (e.metaKey && e.altKey && key === 'i');
        if (blocked) e.preventDefault();
    });

    let devtoolsWarned = false;
    setInterval(() => {
        if (!videoEl) return;
        const widthDelta = window.outerWidth - window.innerWidth > 160;
        const heightDelta = window.outerHeight - window.innerHeight > 160;
        if ((widthDelta || heightDelta) && !videoEl.paused) {
            videoEl.pause();
            securityOverlay.classList.remove('hidden');
            securityOverlay.classList.add('flex');
            devtoolsWarned = true;
        } else if (!widthDelta && !heightDelta && devtoolsWarned) {
            securityOverlay.classList.add('hidden');
            securityOverlay.classList.remove('flex');
            devtoolsWarned = false;
        }
    }, 1500);

    document.addEventListener('visibilitychange', () => {
        if (document.hidden && videoEl && !videoEl.paused) {
            videoEl.pause();
        }
    });

    // ========== LOAD A LECTURE ==========
    async function loadLecture(lectureId) {
        currentLectureId = lectureId;
        hasSentEnded = false;

        loadingEl.classList.remove('hidden');
        videoEl.classList.add('hidden');
        embedEl.classList.add('hidden');
        videoEl.pause();
        stopWatermarkDrift();

        // Highlight active item
        document.querySelectorAll('.lecture-item').forEach((el) => {
            el.classList.remove('bg-[#2563EB]/5');
            el.querySelector('.lecture-title-text')?.classList.remove('text-[#2563EB]');
        });
        const activeEl = document.querySelector(`.lecture-item[data-lecture-id="${lectureId}"]`);
        if (activeEl) {
            activeEl.classList.add('bg-[#2563EB]/5');
            activeEl.querySelector('.lecture-title-text')?.classList.add('text-[#2563EB]');
            titleEl.textContent = activeEl.dataset.title || 'Lecture';
        }

        try {
            const res = await fetch(`/courses/${COURSE_ID}/lecture/${lectureId}/secure-url`);
            const data = await res.json();

            loadingEl.classList.add('hidden');

            if (!data.success) {
                showToast(data.message || 'Unable to load this lecture', 'error');
                return;
            }

            durationEl.textContent = formatDuration(data.duration || 0);
            updateWatchUI(data.isCompleted || false, data.duration ? Math.round((data.resumeAt / data.duration) * 100) : 0);

            if (data.playerType === 'embed-unprotected') {
                embedEl.src = data.playbackUrl;
                embedEl.classList.remove('hidden');
                showToast('This lecture uses an external player — some protections are limited.', 'info');
                return;
            }

            videoEl.src = data.playbackUrl;
            videoEl.classList.remove('hidden');

            if (data.resumeAt && data.resumeAt > 2) {
                videoEl.addEventListener('loadedmetadata', function resume() {
                    videoEl.currentTime = data.resumeAt;
                    videoEl.removeEventListener('loadedmetadata', resume);
                });
            }

            startWatermarkDrift();
            videoEl.play().catch(() => {});
        } catch (err) {
            console.error('Load lecture error:', err);
            loadingEl.classList.add('hidden');
            showToast('Something went wrong loading the video.', 'error');
        }
    }

    // ========== PROGRESS TRACKING ==========
    if (videoEl) {
        videoEl.addEventListener('timeupdate', () => {
            if (progressPingTimer) return;
            progressPingTimer = setTimeout(() => {
                progressPingTimer = null;
                sendProgress(false);
            }, 8000);
        });

        videoEl.addEventListener('ended', () => {
            if (hasSentEnded) return;
            hasSentEnded = true;
            sendProgress(true);
        });
    }

    async function sendProgress(ended) {
        if (!currentLectureId || !videoEl || !videoEl.duration) return;
        try {
            const res = await fetch(`/courses/${COURSE_ID}/lecture/${currentLectureId}/progress`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    currentTime: videoEl.currentTime,
                    duration: videoEl.duration,
                    ended: ended || false
                })
            });
            const data = await res.json();
            if (data.success) {
                updateWatchUI(data.isCompleted || false, data.watchPercentage || 0);
                if (data.isCompleted && !data.wasCompleted) {
                    showToast('Lecture completed! 🎉', 'success');
                    reflectCompletionInList(currentLectureId);
                }
            }
        } catch (err) {
            console.error('Progress ping failed:', err);
        }
    }

    function updateWatchUI(isCompleted, percentage) {
        watchLabel.textContent = (percentage || 0) + '%';
        watchBar.style.width = (percentage || 0) + '%';
        completionBadge.classList.toggle('hidden', !isCompleted);
    }

    function reflectCompletionInList(lectureId) {
        const el = document.querySelector(`.lecture-item[data-lecture-id="${lectureId}"]`);
        if (!el) return;
        if (el.dataset.completed === 'true') return;

        el.dataset.completed = 'true';
        const icon = el.querySelector('.lecture-status-icon i');
        if (icon) icon.className = 'fas fa-check-circle text-[#22C55E] text-lg';
        const statusText = el.querySelector('.lecture-status-text');
        if (statusText) {
            statusText.textContent = 'Completed';
            statusText.className = 'text-xs lecture-status-text text-[#22C55E] font-medium';
        }

        // Update counters
        const completedCountEl = document.getElementById('completedCount');
        const remainingCountEl = document.getElementById('remainingCount');
        const overallBar = document.getElementById('overallProgressBar');
        const overallLabel = document.getElementById('overallProgressPercentage');

        if (completedCountEl && remainingCountEl) {
            const completed = parseInt(completedCountEl.textContent, 10) + 1;
            const remaining = Math.max(parseInt(remainingCountEl.textContent, 10) - 1, 0);
            const total = completed + remaining;
            const pct = total > 0 ? Math.round((completed / total) * 100) : 0;

            completedCountEl.textContent = completed;
            remainingCountEl.textContent = remaining;
            if (overallBar) overallBar.style.width = pct + '%';
            if (overallLabel) overallLabel.textContent = pct + '%';
        }
    }

    function formatDuration(seconds) {
        if (!seconds || seconds <= 0) return '--:--';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
    }

    // ========== TOASTS ==========
    function showToast(message, type = 'success') {
        const colors = {
            success: 'bg-[#22C55E]',
            error: 'bg-[#EF4444]',
            info: 'bg-[#2563EB]',
            warning: 'bg-[#F59E0B]'
        };
        const toast = document.createElement('div');
        toast.className = `fixed bottom-4 right-4 ${colors[type] || 'bg-[#2563EB]'} text-white px-5 py-3 rounded-xl shadow-lg z-50 transition-all duration-300 text-sm font-medium max-w-sm`;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(8px)';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    // ========== WIRE UP LECTURE LIST ==========
    document.querySelectorAll('.lecture-item').forEach((el) => {
        el.addEventListener('click', function() {
            loadLecture(this.dataset.lectureId);
        });
    });

    // ========== AUTO-LOAD FIRST LECTURE ==========
    const firstLecture = document.querySelector('.lecture-item');
    if (firstLecture) {
        loadLecture(firstLecture.dataset.lectureId);
    } else {
        // No lectures - show message
        loadingEl.classList.add('hidden');
        titleEl.textContent = 'No lectures available';
    }
});
</script>

<style>
    #lectureVideo::-webkit-media-controls-download-button { display: none !important; }

    .lecture-scroll::-webkit-scrollbar { width: 4px; }
    .lecture-scroll::-webkit-scrollbar-track { background: transparent; }
    .lecture-scroll::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 2px; }
    .dark .lecture-scroll::-webkit-scrollbar-thumb { background: #475569; }

    #videoWatermark { user-select: none; -webkit-user-select: none; }
    #lectureVideo, #playerWrapper img { -webkit-user-drag: none; }

    /* Loading spinner animation */
    .fa-spin {
        animation: fa-spin 2s infinite linear;
    }
    @keyframes fa-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>