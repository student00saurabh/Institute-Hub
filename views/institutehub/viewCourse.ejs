<% layout("/layouts/boilerplate") %>

<!-- Course Detail Page - Modern with Floating Enroll Button -->
<div class="course-detail-wrapper min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800">
    <div class="max-w-7xl mx-auto">
        
        <!-- ==================== BREADCRUMB ==================== -->
        <nav class="flex mb-8 text-sm" data-aos="fade-up">
            <ol class="inline-flex items-center flex-wrap gap-2">
                <li class="inline-flex items-center">
                    <a href="/" class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-300">
                        <i class="fas fa-home mr-1.5"></i> Home
                    </a>
                </li>
                <li>
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-300 dark:text-gray-600 mx-2 text-[10px]"></i>
                        <a href="/courses" class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-300">Courses</a>
                    </div>
                </li>
                <li>
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-300 dark:text-gray-600 mx-2 text-[10px]"></i>
                        <span class="text-gray-700 dark:text-gray-300 font-medium truncate max-w-[150px] sm:max-w-[200px]"><%= course.title %></span>
                    </div>
                </li>
            </ol>
        </nav>

        <!-- ==================== MAIN GRID ==================== -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 pb-24 lg:pb-0">
            
            <!-- ==================== LEFT COLUMN ==================== -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Course Hero Card -->
                <div class="bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700/50 hover:shadow-2xl transition-all duration-500 course-hero-card">
                    
                    <!-- Image -->
                    <% if(course.image && course.image.url) { %>
                        <div class="relative h-56 sm:h-64 md:h-80 lg:h-96 overflow-hidden course-hero-image">
                            <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/10 to-black/60 z-10"></div>
                            <img src="<%= course.image.url %>" alt="<%= course.title %>" 
                                 class="w-full h-full object-cover transition-transform duration-700 ease-out course-hero-img">
                            
                            <!-- Badges -->
                            <div class="absolute top-4 left-4 z-20 flex flex-wrap gap-2">
                                <% if(course.isPopular) { %>
                                    <span class="px-3 py-1.5 bg-gradient-to-r from-amber-400 to-orange-500 text-white text-[10px] sm:text-xs font-bold rounded-full shadow-lg flex items-center gap-1.5 animate-pulse">
                                        <i class="fas fa-fire text-[10px] sm:text-xs"></i> Most Popular
                                    </span>
                                <% } %>
                                <% if(course.courseLevel) { %>
                                    <span class="px-3 py-1.5 bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-[10px] sm:text-xs font-bold rounded-full shadow-lg flex items-center gap-1.5">
                                        <i class="fas fa-signal text-[10px] sm:text-xs"></i> <%= course.courseLevel.charAt(0).toUpperCase() + course.courseLevel.slice(1) %>
                                    </span>
                                <% } %>
                                <% if(course.isActive) { %>
                                    <span class="px-3 py-1.5 bg-gradient-to-r from-emerald-400 to-green-600 text-white text-[10px] sm:text-xs font-bold rounded-full shadow-lg flex items-center gap-1.5">
                                        <i class="fas fa-check-circle text-[10px] sm:text-xs"></i> Active
                                    </span>
                                <% } else { %>
                                    <span class="px-3 py-1.5 bg-gradient-to-r from-rose-400 to-red-600 text-white text-[10px] sm:text-xs font-bold rounded-full shadow-lg flex items-center gap-1.5">
                                        <i class="fas fa-clock text-[10px] sm:text-xs"></i> Coming Soon
                                    </span>
                                <% } %>
                            </div>
                            
                            <!-- Price Badge -->
                            <div class="absolute bottom-4 right-4 z-20">
                                <div class="bg-black/60 backdrop-blur-xl rounded-2xl px-4 py-2.5 sm:px-5 sm:py-3 border border-white/10 shadow-2xl">
                                    <% if (course.actualPrice && course.actualPrice < course.price) { %>
                                        <div class="flex items-center gap-2 sm:gap-3">
                                            <span class="text-xl sm:text-2xl font-bold text-white">₹<%= course.actualPrice %></span>
                                            <span class="text-xs sm:text-sm text-gray-300 line-through">₹<%= course.price %></span>
                                            <span class="px-1.5 py-0.5 sm:px-2 sm:py-0.5 bg-gradient-to-r from-emerald-400 to-green-500 text-white text-[10px] sm:text-xs font-bold rounded-full">
                                                Save ₹<%= course.price - course.actualPrice %>
                                            </span>
                                        </div>
                                    <% } else if(course.price > 0 ) { %>
                                        <span class="text-xl sm:text-2xl font-bold text-white">₹<%= course.price %></span>
                                    <% } else { %>
                                        <span class="text-base sm:text-lg font-bold text-white">Free</span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    
                    <div class="p-4 sm:p-6 md:p-8">
                        <!-- Meta Chips -->
                        <div class="flex flex-wrap items-center gap-2 mb-4">
                            <span class="px-2.5 py-1 sm:px-3 sm:py-1.5 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-[10px] sm:text-xs font-semibold rounded-full border border-indigo-200 dark:border-indigo-800/50">
                                <i class="fas fa-tag mr-1"></i> <%= course.courceType || 'Course' %>
                            </span>
                            <span class="px-2.5 py-1 sm:px-3 sm:py-1.5 bg-gray-100 dark:bg-gray-700/50 text-gray-600 dark:text-gray-400 text-[10px] sm:text-xs font-medium rounded-full flex items-center gap-1">
                                <i class="far fa-clock"></i> <%= course.duration ? course.duration + 'h' : 'Self-paced' %>
                            </span>
                            <span class="px-2.5 py-1 sm:px-3 sm:py-1.5 bg-gray-100 dark:bg-gray-700/50 text-gray-600 dark:text-gray-400 text-[10px] sm:text-xs font-medium rounded-full flex items-center gap-1">
                                <i class="fas fa-users"></i> <%= (course.preStudents || 0) + (course.students?.length || 0) %>
                            </span>
                            <% if(course.rating) { %>
                                <span class="px-2.5 py-1 sm:px-3 sm:py-1.5 bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 text-[10px] sm:text-xs font-medium rounded-full flex items-center gap-1">
                                    <i class="fas fa-star text-amber-400"></i> <%= course.rating %>
                                </span>
                            <% } %>
                        </div>
                        
                        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white mb-3 leading-tight">
                            <%= course.title %>
                        </h1>
                        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
                            <%= course.shortDescription %>
                        </p>
                        
                        <!-- Instructor -->
                        <% if(course.teacher) { %>
                            <div class="mt-6 flex items-center gap-4 p-3 sm:p-4 bg-gradient-to-r from-gray-50 to-gray-100/50 dark:from-gray-700/30 dark:to-gray-800/30 rounded-xl border border-gray-200 dark:border-gray-700/50 hover:border-indigo-200 dark:hover:border-indigo-700/50 transition-all duration-300">
                                <div class="relative">
                                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg sm:text-xl shadow-lg ring-4 ring-white dark:ring-gray-800">
                                        <%= course.teacher.name ? course.teacher.name.charAt(0).toUpperCase() : 'T' %>
                                    </div>
                                    <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 sm:w-5 sm:h-5 bg-emerald-400 rounded-full border-2 border-white dark:border-gray-800 flex items-center justify-center">
                                        <i class="fas fa-check text-[6px] sm:text-[8px] text-white"></i>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400 font-medium uppercase tracking-wider">Instructor</p>
                                    <p class="font-bold text-gray-900 dark:text-white text-base sm:text-lg"><%= course.teacher.name %></p>
                                    <p class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400 truncate max-w-[150px] sm:max-w-none"><%= course.teacher.email %></p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- What You'll Learn -->
                <% if(course.learningOutcomes && course.learningOutcomes.length > 0) { %>
                    <div class="bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 p-4 sm:p-6 md:p-8 hover:shadow-xl transition-all duration-500">
                        <div class="flex items-center gap-3 mb-4 sm:mb-6">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-green-600 flex items-center justify-center shadow-lg shadow-emerald-500/25 flex-shrink-0">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">What You'll Learn</h2>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3">
                            <% course.learningOutcomes.forEach((outcome) => { %>
                                <div class="flex items-start gap-2 sm:gap-3 p-2 sm:p-3 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-all duration-300 group">
                                    <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform duration-300">
                                        <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                        </svg>
                                    </div>
                                    <span class="text-sm sm:text-base text-gray-700 dark:text-gray-300"><%= outcome %></span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Prerequisites -->
                <% if(course.prerequisites && course.prerequisites.length > 0) { %>
                    <div class="bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 p-4 sm:p-6 md:p-8 hover:shadow-xl transition-all duration-500">
                        <div class="flex items-center gap-3 mb-4 sm:mb-6">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg shadow-amber-500/25 flex-shrink-0">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Prerequisites</h2>
                        </div>
                        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1 sm:gap-2">
                            <% course.prerequisites.forEach((prereq) => { %>
                                <li class="flex items-center gap-2 sm:gap-3 p-1.5 sm:p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors duration-300">
                                    <span class="w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full bg-amber-400 dark:bg-amber-500 flex-shrink-0"></span>
                                    <span class="text-sm sm:text-base text-gray-600 dark:text-gray-300"><%= prereq %></span>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <!-- Description -->
                <% if(course.discription) { %>
                    <div class="bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 p-4 sm:p-6 md:p-8 hover:shadow-xl transition-all duration-500">
                        <div class="flex items-center gap-3 mb-4 sm:mb-6">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/25 flex-shrink-0">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Course Description</h2>
                        </div>
                        <div class="course-description-content prose prose-sm sm:prose-lg max-w-none dark:prose-invert">
                            <%- course.discription %>
                        </div>
                    </div>
                <% } %>

                <!-- What's Included -->
                <% if(course.includes && course.includes.length > 0) { %>
                    <div class="bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 p-4 sm:p-6 md:p-8 hover:shadow-xl transition-all duration-500">
                        <div class="flex items-center gap-3 mb-4 sm:mb-6">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center shadow-lg shadow-purple-500/25 flex-shrink-0">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">What's Included</h2>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3">
                            <% course.includes.forEach((item) => { %>
                                <div class="flex items-center gap-2 sm:gap-3 p-2 sm:p-3 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-all duration-300 group">
                                    <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                                        <i class="fas fa-check text-purple-600 dark:text-purple-400 text-[10px] sm:text-xs"></i>
                                    </div>
                                    <span class="text-sm sm:text-base text-gray-700 dark:text-gray-300"><%= item %></span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- PDF -->
                <% if(course.pdfDetails && course.pdfDetails.trim().length > 0) { %>
                    <div class="bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 p-4 sm:p-6 md:p-8 hover:shadow-xl transition-all duration-500">
                        <div class="flex items-center gap-3 mb-4 sm:mb-6">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-rose-500 to-red-600 flex items-center justify-center shadow-lg shadow-rose-500/25 flex-shrink-0">
                                <i class="fas fa-file-pdf text-white text-base sm:text-lg"></i>
                            </div>
                            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Course Details</h2>
                        </div>
                        <div class="flex flex-wrap items-center justify-between gap-3 sm:gap-4 p-3 sm:p-4 bg-gradient-to-r from-rose-50 to-red-50/50 dark:from-rose-900/20 dark:to-red-900/10 rounded-xl border border-rose-200 dark:border-rose-800/50">
                            <div class="flex items-center gap-3 sm:gap-4">
                                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-rose-100 dark:bg-rose-900/30 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-file-pdf text-rose-600 dark:text-rose-400 text-lg sm:text-xl"></i>
                                </div>
                                <div>
                                    <p class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">Course Details PDF</p>
                                    <p class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400">View or download complete details</p>
                                </div>
                            </div>
                            <div class="flex gap-1.5 sm:gap-2 flex-wrap">
                                <a href="<%= course.pdfDetails %>" target="_blank" 
                                   class="inline-flex items-center gap-1 sm:gap-2 px-3 py-1.5 sm:px-4 sm:py-2.5 bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-200 dark:hover:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-xs sm:text-sm font-medium rounded-lg sm:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-md">
                                    <i class="fas fa-eye"></i> <span class="hidden xs:inline">View</span>
                                </a>
                                <a href="<%= course.pdfDetails %>" download
                                   class="inline-flex items-center gap-1 sm:gap-2 px-3 py-1.5 sm:px-4 sm:py-2.5 bg-emerald-100 dark:bg-emerald-900/30 hover:bg-emerald-200 dark:hover:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 text-xs sm:text-sm font-medium rounded-lg sm:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-md">
                                    <i class="fas fa-download"></i> <span class="hidden xs:inline">Download</span>
                                </a>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- ==================== RIGHT COLUMN - DESKTOP ==================== -->
            <div class="hidden lg:block">
                <div class="sticky top-24 space-y-6">
                    
                    <!-- Enrollment Card -->
                    <div class="bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700/50 overflow-hidden hover:shadow-3xl transition-all duration-500">
                        
                        <!-- Price Header -->
                        <% if(course.price > 0) { %>
                            <div class="relative bg-gradient-to-br from-indigo-600 via-blue-600 to-purple-600 p-6 text-white overflow-hidden">
                                <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                                <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
                                <p class="text-sm opacity-80 mb-1 relative z-10">Course Price</p>
                                <div class="relative z-10">
                                    <% if (course.actualPrice && course.actualPrice < course.price) { %>
                                        <div class="flex items-baseline gap-3">
                                            <span class="text-4xl font-bold">₹<%= course.actualPrice %></span>
                                            <span class="text-lg line-through opacity-60">₹<%= course.price %></span>
                                            <span class="px-2.5 py-0.5 bg-yellow-400 text-gray-900 text-xs font-bold rounded-full">
                                                <%= Math.round(((course.price - course.actualPrice) / course.price) * 100) %>% OFF
                                            </span>
                                        </div>
                                    <% } else { %>
                                        <span class="text-4xl font-bold">₹<%= course.price %></span>
                                    <% } %>
                                </div>
                                <p class="text-xs opacity-70 mt-1 relative z-10">Inclusive of all taxes</p>
                            </div>
                        <% } else { %>
                            <div class="bg-gradient-to-br from-emerald-500 via-green-500 to-teal-500 p-6 text-white text-center">
                                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/20 mb-3">
                                    <i class="fas fa-graduation-cap text-2xl"></i>
                                </div>
                                <h3 class="text-2xl font-bold mb-2">Free Course</h3>
                                <p class="text-sm text-white/90">Enroll now and start learning for free</p>
                            </div>
                        <% } %>
                        
                        <div class="p-6">
                            <% if(isEnrolled) { %>
                                <div class="mb-5 p-4 bg-gradient-to-r from-emerald-50 to-green-50 dark:from-emerald-900/20 dark:to-green-900/20 rounded-xl border border-emerald-200 dark:border-emerald-800">
                                    <div class="flex items-center gap-2 text-emerald-800 dark:text-emerald-400 font-semibold">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        You're Enrolled! 🎉
                                    </div>
                                    <p class="text-sm text-emerald-600 dark:text-emerald-400 mt-1.5">
                                        <i class="far fa-calendar-alt mr-1.5"></i> 
                                        Enrolled: <%= new Date(userEnrollment.enrolledAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                    </p>
                                </div>
                                <a href="/courses/<%= course._id %>/access" 
                                   class="group block w-full text-center px-4 py-3.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95">
                                    <i class="fas fa-play-circle mr-2"></i> Continue Learning
                                    <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                                </a>
                            <% } else { %>
                                <% if(currentUser) { %>
                                    <button onclick="openEnrollmentModal()" 
                                            class="group w-full px-4 py-3.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95">
                                        <i class="fas fa-shopping-cart mr-2"></i> Enroll Now
                                        <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                                    </button>
                                <% } else { %>
                                    <a href="/login?redirect=/courses/<%= course._id %>" 
                                       class="group block w-full text-center px-4 py-3.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95">
                                        <i class="fas fa-sign-in-alt mr-2"></i> Login to Enroll
                                    </a>
                                <% } %>
                            <% } %>
                            
                            <!-- Course Includes -->
                            <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
