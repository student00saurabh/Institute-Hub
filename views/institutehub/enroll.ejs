<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8 text-center" data-aos="fade-up">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">
                <span class="w-2 h-2 rounded-full bg-blue-600 dark:bg-blue-400 animate-pulse"></span>
                Enroll Now
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
                Start Your <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Learning Journey</span>
            </h1>
            <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
                Choose from our premium cybersecurity courses and kickstart your career today
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Left Column - Course Selection -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Course Selection Card -->
                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6" data-aos="fade-up" data-aos-duration="600">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center">
                                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                </svg>
                            </div>
                            Available Courses
                        </h2>
                        <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-semibold">
                            <%= courses.length %> Courses
                        </span>
                    </div>

                    <!-- Search Bar -->
                    <div class="relative mb-6">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input 
                            type="text" 
                            id="courseSearch" 
                            placeholder="Search courses by name or category..." 
                            class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200"
                        >
                    </div>

                    <!-- Course Grid -->
                    <div id="coursesGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[500px] overflow-y-auto pr-2">
                        <% if (courses && courses.length > 0) { %>
                            <% courses.forEach(course => { %>
                                <div 
                                    class="course-card bg-gray-50 dark:bg-gray-700/30 border-2 border-gray-200 dark:border-gray-700 rounded-xl p-4 cursor-pointer transition-all duration-300 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-lg hover:-translate-y-1 group"
                                    data-course-id="<%= course._id %>"
                                    data-course-title="<%= course.title %>"
                                    data-course-price="<%= course.actualPrice || course.price %>"
                                    data-course-original-price="<%= course.price %>"
                                    data-course-type="<%= course.courceType %>"
                                    data-course-image="<%= course.image?.url %>"
                                    data-course-duration="<%= course.duration %>"
                                    data-course-level="<%= course.courseLevel %>"
                                >
                                    <div class="flex items-start gap-4">
                                        <div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden bg-gray-200 dark:bg-gray-700">
                                            <img src="<%= course.image?.url || 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=100&auto=format&fit=crop' %>" 
                                                 alt="<%= course.title %>" 
                                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-bold text-sm text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
                                                <%= course.title %>
                                            </h3>
                                            <span class="inline-block px-2 py-0.5 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-full text-xs font-medium mt-1">
                                                <%= course.courceType || 'Course' %>
                                            </span>
                                            <div class="mt-2 flex items-center justify-between">
                                                <span class="text-lg font-bold text-gray-900 dark:text-white">
                                                    ₹<%= course.actualPrice || course.price %>
                                                </span>
                                                <% if (course.price && course.actualPrice && course.price > course.actualPrice) { %>
                                                    <span class="text-xs text-gray-400 dark:text-gray-500 line-through">
                                                        ₹<%= course.price %>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                                        <div class="flex items-center gap-3">
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                                <%= course.duration || 'Self-paced' %>
                                            </span>
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                                <%= course.courseLevel || 'Beginner' %>
                                            </span>
                                        </div>
                                        <button 
                                            type="button" 
                                            class="select-course-btn px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 rounded-lg text-xs font-medium transition-all duration-200"
                                            data-course-id="<%= course._id %>"
                                        >
                                            Select
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-span-2 text-center py-12">
                                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                                    <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-300">No courses available</h3>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Please check back later for new courses</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- No Results -->
                    <div id="noResults" class="hidden text-center py-10">
                        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">No courses found</h3>
                        <p class="text-gray-500 dark:text-gray-500">Try adjusting your search criteria</p>
                    </div>
                </div>

                <!-- Support Options -->
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl p-6 text-white shadow-lg" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
                    <h3 class="text-xl font-bold mb-2 flex items-center gap-2">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0a9 9 0 01-12.728 0m12.728 0L21 21M5.636 5.636a9 9 0 00-12.728 0m12.728 0L3 3"></path>
                        </svg>
                        Need Assistance?
                    </h3>
                    <p class="text-blue-100 mb-4">Our team is here to help you choose the right course and answer all your questions.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <a href="https://wa.me/919310643303?text=Hello%20CyberKavach%2C%20I%20need%20assistance%20with%20course%20enrollment." 
                           target="_blank" 
                           class="flex items-center gap-3 bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl p-3 transition-all duration-300 group">
                            <div class="w-10 h-10 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.074-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.76.982.998-3.677-.236-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.9 6.994c-.004 5.45-4.438 9.88-9.888 9.88m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.333.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.333 11.893-11.893 0-3.18-1.24-6.162-3.495-8.411"/>
                                </svg>
                            </div>
                            <div>
                                <p class="font-semibold text-sm">WhatsApp Chat</p>
                                <p class="text-xs text-blue-100">Quick response</p>
                            </div>
                        </a>
                        
                        <a href="/contact" 
                           class="flex items-center gap-3 bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl p-3 transition-all duration-300 group">
                            <div class="w-10 h-10 rounded-full bg-blue-400 flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-semibold text-sm">Contact Support</p>
                                <p class="text-xs text-blue-100">We're here to help</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Column - Enrollment Form -->
            <div class="lg:col-span-1" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
                <div class="sticky top-24">
                    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                        
                        <!-- Selected Course -->
                        <div id="selectedCourseInfo" class="mb-6 p-4 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-xl border border-blue-200 dark:border-blue-800/50">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="font-bold text-gray-900 dark:text-white text-sm flex items-center gap-2">
                                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    Selected Course
                                </h3>
                            </div>
                            <div id="courseTitleDisplay" class="text-lg font-bold text-gray-900 dark:text-white mb-1">
                                Select a course
                            </div>
                            <div class="flex items-center justify-between">
                                <span id="courseTypeDisplay" class="text-sm text-gray-600 dark:text-gray-400">-</span>
                                <span id="coursePriceDisplay" class="text-2xl font-bold text-blue-600 dark:text-blue-400">₹0</span>
                            </div>
                            <div id="courseDetailsDisplay" class="text-xs text-gray-500 dark:text-gray-500 mt-2 hidden">
                                <span id="courseDurationDisplay"></span>
                                <span class="mx-2">•</span>
                                <span id="courseLevelDisplay"></span>
                            </div>
                        </div>

                        <!-- Enrollment Form -->
                        <form id="enrollmentForm" method="POST" action="/enroll" class="space-y-4">
                            <input type="hidden" name="courseId" id="courseId">
                            <input type="hidden" name="paidPrice" id="paidPrice">

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Full Name <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="text"
                                    name="name"
                                    value="<%= currUser ? currUser.name : '' %>"
                                    required
                                    placeholder="Enter your full name"
                                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200"
                                />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Email Address <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="email"
                                    name="email"
                                    value="<%= currUser ? currUser.email : '' %>"
                                    required
                                    placeholder="your@email.com"
                                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200"
                                />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Mobile Number <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="tel"
                                    name="mobile"
                                    value="<%= currUser && currUser.mobile ? currUser.mobile : '' %>"
                                    required
                                    placeholder="9876543210"
                                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200"
                                />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Questions or Requirements
                                </label>
                                <textarea
                                    name="description"
                                    placeholder="Any questions about the course, schedule preferences, or special requirements..."
                                    rows="3"
                                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 resize-none"
                                ></textarea>
                            </div>

                            <!-- Terms -->
                            <div class="flex items-start gap-2">
                                <input type="checkbox" id="terms" required class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:focus:ring-blue-400">
                                <label for="terms" class="text-xs text-gray-600 dark:text-gray-400">
                                    I agree to the <a href="/terms" class="text-blue-600 dark:text-blue-400 hover:underline">Terms of Service</a> and 
                                    <a href="/privacy" class="text-blue-600 dark:text-blue-400 hover:underline">Privacy Policy</a>
                                </label>
                            </div>

                            <button
                                type="submit"
                                id="submitBtn"
                                disabled
                                class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold text-base transition-all duration-200 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 flex items-center justify-center gap-2"
                            >
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                                Complete Enrollment
                            </button>
                        </form>

                        <!-- Trust Badges -->
                        <div class="mt-4 flex flex-wrap items-center justify-center gap-3 text-xs text-gray-500 dark:text-gray-400">
                            <span class="flex items-center gap-1">
                                <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                </svg>
                                Secure Enrollment
                            </span>
                            <span class="flex items-center gap-1">
                                <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                                Data Protected
                            </span>
                            <span class="flex items-center gap-1">
                                <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                </svg>
                                24/7 Support
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const courseCards = document.querySelectorAll('.course-card');
    const courseSearch = document.getElementById('courseSearch');
    const coursesGrid = document.getElementById('coursesGrid');
    const noResults = document.getElementById('noResults');
    const submitBtn = document.getElementById('submitBtn');
    const enrollmentForm = document.getElementById('enrollmentForm');
    
    // Form fields
    const courseIdInput = document.getElementById('courseId');
    const paidPriceInput = document.getElementById('paidPrice');
    
    // Display elements
    const courseTitleDisplay = document.getElementById('courseTitleDisplay');
    const courseTypeDisplay = document.getElementById('courseTypeDisplay');
    const coursePriceDisplay = document.getElementById('coursePriceDisplay');
    const courseDurationDisplay = document.getElementById('courseDurationDisplay');
    const courseLevelDisplay = document.getElementById('courseLevelDisplay');
    const courseDetailsDisplay = document.getElementById('courseDetailsDisplay');

    let selectedCourseId = null;

    // Course selection
    courseCards.forEach(card => {
        const selectBtn = card.querySelector('.select-course-btn');
        
        card.addEventListener('click', (e) => {
            if (!e.target.closest('.select-course-btn')) {
                selectCourse(card);
            }
        });
        
        if (selectBtn) {
            selectBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                selectCourse(card);
            });
        }
    });

    function selectCourse(card) {
        // Remove selection from all cards
        courseCards.forEach(c => {
            c.classList.remove('border-blue-500', 'bg-blue-50', 'dark:border-blue-500', 'dark:bg-blue-900/20');
        });
        
        // Add selection to clicked card
        card.classList.add('border-blue-500', 'bg-blue-50', 'dark:border-blue-500', 'dark:bg-blue-900/20');
        
        // Get course data
        selectedCourseId = card.dataset.courseId;
        const courseTitle = card.dataset.courseTitle;
        const coursePrice = card.dataset.coursePrice;
        const courseType = card.dataset.courseType;
        const courseDuration = card.dataset.courseDuration;
        const courseLevel = card.dataset.courseLevel;
        
        // Update form
        courseIdInput.value = selectedCourseId;
        paidPriceInput.value = coursePrice;
        enrollmentForm.action = `/enroll/${selectedCourseId}`;
        
        // Update display
        courseTitleDisplay.textContent = courseTitle;
        courseTypeDisplay.textContent = courseType;
        coursePriceDisplay.textContent = `₹${coursePrice}`;
        
        if (courseDuration || courseLevel) {
            courseDetailsDisplay.classList.remove('hidden');
            courseDurationDisplay.textContent = courseDuration || 'Self-paced';
            courseLevelDisplay.textContent = courseLevel || 'Beginner';
        }
        
        // Enable submit
        submitBtn.disabled = false;
        
        // Scroll to form on mobile
        if (window.innerWidth < 1024) {
            document.querySelector('#enrollmentForm').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }

    // Search functionality
    courseSearch.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        let visibleCount = 0;
        
        courseCards.forEach(card => {
            const title = card.dataset.courseTitle?.toLowerCase() || '';
            const type = card.dataset.courseType?.toLowerCase() || '';
            
            if (title.includes(searchTerm) || type.includes(searchTerm)) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
        
        if (visibleCount === 0) {
            noResults.classList.remove('hidden');
            coursesGrid.classList.add('hidden');
        } else {
            noResults.classList.add('hidden');
            coursesGrid.classList.remove('hidden');
        }
    });

    // Form validation
    enrollmentForm.addEventListener('submit', function(e) {
        if (!selectedCourseId) {
            e.preventDefault();
            alert('Please select a course before submitting');
            return;
        }
        
        const name = this.querySelector('input[name="name"]').value.trim();
        const email = this.querySelector('input[name="email"]').value.trim();
        const mobile = this.querySelector('input[name="mobile"]').value.trim();
        const terms = document.getElementById('terms');
        
        if (!name) {
            e.preventDefault();
            alert('Please enter your full name');
            return;
        }
        
        if (!email || !email.includes('@')) {
            e.preventDefault();
            alert('Please enter a valid email address');
            return;
        }
        
        if (!mobile || mobile.length < 10) {
            e.preventDefault();
            alert('Please enter a valid 10-digit mobile number');
            return;
        }
        
        if (!terms.checked) {
            e.preventDefault();
            alert('Please agree to the Terms of Service and Privacy Policy');
            return;
        }
        
        // Show loading
        submitBtn.innerHTML = `
            <svg class="animate-spin h-5 w-5 mr-2 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Processing...
        `;
        submitBtn.disabled = true;
    });

    // Auto-select first course if available
    if (courseCards.length > 0) {
        // Check if any course is already selected (from URL params)
        const urlParams = new URLSearchParams(window.location.search);
        const courseParam = urlParams.get('course');
        
        if (courseParam) {
            const matchedCard = document.querySelector(`.course-card[data-course-id="${courseParam}"]`);
            if (matchedCard) {
                selectCourse(matchedCard);
            } else {
                selectCourse(courseCards[0]);
            }
        } else {
            selectCourse(courseCards[0]);
        }
    }

    // Keyboard shortcut: Escape to clear selection
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && selectedCourseId) {
            courseCards.forEach(c => c.classList.remove('border-blue-500', 'bg-blue-50', 'dark:border-blue-500', 'dark:bg-blue-900/20'));
            selectedCourseId = null;
            courseIdInput.value = '';
            paidPriceInput.value = '';
            courseTitleDisplay.textContent = 'Select a course';
            courseTypeDisplay.textContent = '-';
            coursePriceDisplay.textContent = '₹0';
            courseDetailsDisplay.classList.add('hidden');
            submitBtn.disabled = true;
        }
    });
});
</script>

<style>
    /* Course card styles */
    .course-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .course-card:hover {
        border-color: #3b82f6;
    }
    
    /* Line clamp */
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    /* Custom scrollbar */
    #coursesGrid::-webkit-scrollbar {
        width: 6px;
    }
    
    #coursesGrid::-webkit-scrollbar-track {
        background: transparent;
    }
    
    #coursesGrid::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    
    .dark #coursesGrid::-webkit-scrollbar-thumb {
        background: #475569;
    }
    
    /* Loading spinner */
    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin {
        animation: spin 1s linear infinite;
    }
</style>