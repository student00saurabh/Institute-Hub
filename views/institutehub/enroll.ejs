<% layout("/layouts/boilerplate") %>

<%
  // ============================================================
  // PRICE HELPER
  // ============================================================
  function getCoursePrice(course) {
      const payPrice = course.actualPrice || course.price || 0;
      const marketPrice = course.price || course.actualPrice || 0;
      const discount = marketPrice > payPrice ? Math.round(((marketPrice - payPrice) / marketPrice) * 100) : 0;
      return { payPrice, marketPrice, discount, hasDiscount: discount > 0 };
  }

  // ============================================================
  // REUSABLE COURSE CARD (used for Related / Latest / Browse grids)
  // isSelected -> highlights the card if it's the currently selected course
  // ============================================================
  function courseCardHTML(course, isSelected) {
      const price = getCoursePrice(course);
      const img = (course.image && course.image.url) || 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=400&auto=format&fit=crop';
      const teacherName = (course.teacher && course.teacher.name) || 'Expert';
      const selectedClasses = isSelected
          ? 'border-blue-500 bg-blue-50 dark:border-blue-500 dark:bg-blue-900/20 shadow-md'
          : 'border-gray-200 dark:border-gray-700';

      return `
        <a href="/enroll?courseId=${course._id}"
           class="course-card group block bg-gray-50/80 dark:bg-gray-700/30 border-2 rounded-xl p-3 transition-all duration-300 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-lg hover:-translate-y-1 ${selectedClasses}">
            <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-14 h-14 rounded-lg overflow-hidden bg-gray-200 dark:bg-gray-700 shadow-sm">
                    <img src="${img}" alt="${course.title}" loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                         onerror="this.src='https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=400&auto=format&fit=crop'">
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-sm text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
                        ${course.title}
                    </h3>
                    <div class="flex flex-wrap items-center gap-1 mt-1">
                        <span class="inline-block px-2 py-0.5 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-full text-[10px] font-medium">
                            ${course.courceType || 'Course'}
                        </span>
                        <span class="inline-block px-2 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-[10px] font-medium">
                            ${course.courseLevel || 'Beginner'}
                        </span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2 flex-wrap">
                        <span class="text-base font-extrabold text-gray-900 dark:text-white">₹${price.payPrice.toLocaleString()}</span>
                        ${price.hasDiscount ? `
                            <span class="text-xs text-gray-400 dark:text-gray-500 line-through">₹${price.marketPrice.toLocaleString()}</span>
                            <span class="text-[10px] font-bold text-[#22C55E] bg-[#22C55E]/10 px-1.5 py-0.5 rounded-full border border-[#22C55E]/20">${price.discount}% OFF</span>
                        ` : ''}
                    </div>
                </div>
            </div>
            <div class="mt-2.5 pt-2.5 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
                    <span class="flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        ${course.duration || 'Self-paced'}
                    </span>
                    <span class="flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        ${teacherName}
                    </span>
                </div>
                <span class="px-3 py-1 rounded-lg text-xs font-medium ${isSelected ? 'bg-blue-600 text-white shadow-md' : 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 group-hover:bg-blue-600 group-hover:text-white dark:group-hover:bg-blue-600'}">
                    ${isSelected ? '✓ Selected' : 'Select'}
                </span>
            </div>
        </a>`;
  }

  const price = selectedCourse ? getCoursePrice(selectedCourse) : { payPrice: 0, marketPrice: 0, discount: 0, hasDiscount: false };
%>

<!-- ============================================================ -->
<!-- PAGE HEADER                                                   -->
<!-- ============================================================ -->
<section class="relative overflow-hidden bg-gradient-to-br from-[#0F172A] via-[#0F172A] to-[#2563EB] py-16 lg:py-20 -mt-6">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#C9A227] rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#2563EB] rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/10 text-sm font-medium mb-4">
            <span class="w-2 h-2 rounded-full bg-[#22C55E] animate-pulse"></span>
            Secure Enrollment
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-4">
            Enroll in <span class="text-[#C9A227]">Premium Courses</span>
        </h1>
        <p class="text-lg sm:text-xl text-white/80 max-w-2xl mx-auto">
            Choose your course, complete payment securely, and start learning today
        </p>
    </div>
</section>

<div class="py-10 lg:py-14 bg-[#F8FAFC] dark:bg-[#0B1120]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

        <!-- ============================================================ -->
        <!-- SELECTED COURSE DETAILS  +  ENROLLMENT FORM                   -->
        <!-- ============================================================ -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

            <!-- ==================== LEFT - SELECTED COURSE DETAILS ==================== -->
            <div class="lg:col-span-7">
                <% if (selectedCourse) { %>
                <div class="bg-white dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 overflow-hidden">

                    <!-- Cover image -->
                    <div class="relative h-52 sm:h-64 overflow-hidden bg-gradient-to-r from-[#2563EB] to-[#4F46E5]">
                        <img src="<%= selectedCourse.image?.url || 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&auto=format&fit=crop' %>"
                             alt="<%= selectedCourse.title %>"
                             class="w-full h-full object-cover opacity-90"
                             onerror="this.style.display='none'">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6 text-white">
                            <div class="flex flex-wrap items-center gap-2 mb-2">
                                <span class="px-2.5 py-1 bg-white/15 backdrop-blur-sm rounded-full text-xs font-semibold border border-white/20">
                                    <%= selectedCourse.courceType || 'Course' %>
                                </span>
                                <span class="px-2.5 py-1 bg-white/15 backdrop-blur-sm rounded-full text-xs font-semibold border border-white/20">
                                    <%= selectedCourse.courseLevel || 'Beginner' %>
                                </span>
                            </div>
                            <h2 class="text-2xl sm:text-3xl font-extrabold line-clamp-2"><%= selectedCourse.title %></h2>
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="p-5 sm:p-6 space-y-5">
                        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
                            <%= selectedCourse.shortDescription %>
                        </p>

                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
                                <svg class="w-4 h-4 text-[#2563EB] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <%= selectedCourse.duration || 'Self-paced' %>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
                                <svg class="w-4 h-4 text-[#2563EB] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                <%= selectedCourse.teacher?.name || 'Expert' %>
                            </div>
                            <% if (selectedCourse.rating) { %>
                            <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
                                <svg class="w-4 h-4 text-[#C9A227] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.447a1 1 0 00-.363 1.118l1.287 3.957c.3.922-.755 1.688-1.539 1.118l-3.367-2.446a1 1 0 00-1.176 0l-3.367 2.446c-.784.57-1.838-.196-1.539-1.118l1.286-3.957a1 1 0 00-.362-1.118L2.98 9.385c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 00.95-.69l1.286-3.958z"></path>
                                </svg>
                                <%= selectedCourse.rating %> (<%= selectedCourse.reviewCount || 0 %> reviews)
                            </div>
                            <% } %>
                        </div>

                        <% if (selectedCourse.learningOutcomes && selectedCourse.learningOutcomes.length) { %>
                        <div>
                            <h4 class="font-bold text-sm text-gray-900 dark:text-white mb-2">What you'll learn</h4>
                            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5">
                                <% selectedCourse.learningOutcomes.forEach(item => { %>
                                <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
                                    <svg class="w-4 h-4 text-[#22C55E] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    <%= item %>
                                </li>
                                <% }) %>
                            </ul>
                        </div>
                        <% } %>

                        <% if (selectedCourse.prerequisites && selectedCourse.prerequisites.length) { %>
                        <div>
                            <h4 class="font-bold text-sm text-gray-900 dark:text-white mb-2">Prerequisites</h4>
                            <div class="flex flex-wrap gap-2">
                                <% selectedCourse.prerequisites.forEach(item => { %>
                                <span class="px-2.5 py-1 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-full text-xs"><%= item %></span>
                                <% }) %>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } else { %>
                <div class="bg-white dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 p-10 text-center">
                    <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-300">No courses available right now</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Please check back later</p>
                </div>
                <% } %>
            </div>

            <!-- ==================== RIGHT - ENROLLMENT FORM WITH PAYMENT ==================== -->
            <div class="lg:col-span-5">
                <div class="lg:sticky lg:top-24">
                    <div class="bg-white dark:bg-gray-800/90 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700/50 overflow-hidden">

                        <!-- Course Preview -->
                        <div class="relative h-40 sm:h-48 overflow-hidden bg-gradient-to-r from-[#2563EB] to-[#4F46E5]">
                            <div class="absolute inset-0 opacity-20">
                                <div class="absolute top-0 right-0 w-40 h-40 bg-[#C9A227] rounded-full blur-2xl"></div>
                                <div class="absolute bottom-0 left-0 w-40 h-40 bg-white rounded-full blur-2xl"></div>
                            </div>
                            <div class="relative z-10 p-5 sm:p-6 text-white h-full flex flex-col justify-end">
                                <span class="text-xs font-medium text-white/70 uppercase tracking-wider">Enrolling In</span>
                                <h3 class="text-xl sm:text-2xl font-bold line-clamp-1">
                                    <%= selectedCourse ? selectedCourse.title : 'Select a Course' %>
                                </h3>
                                <div class="flex flex-wrap items-center gap-3 mt-2">
                                    <span class="text-sm text-white/80"><%= selectedCourse ? selectedCourse.courceType : '-' %></span>
                                    <span class="w-px h-4 bg-white/30"></span>
                                    <span class="text-sm text-white/80">
                                        <i class="fas fa-user-tie mr-1"></i> <%= selectedCourse?.teacher?.name || 'Expert' %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Price Summary -->
                        <div class="px-5 sm:px-6 py-4 border-b border-gray-100 dark:border-gray-700/50 bg-gray-50/50 dark:bg-gray-700/20">
                            <div class="flex items-center justify-between">
                                <div>
                                    <span class="text-sm text-gray-500 dark:text-gray-400">Course Price</span>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-2xl font-extrabold text-gray-900 dark:text-white">₹<%= price.payPrice.toLocaleString() %></span>
                                        <% if (price.hasDiscount) { %>
                                            <span class="text-sm text-gray-400 dark:text-gray-500 line-through">₹<%= price.marketPrice.toLocaleString() %></span>
                                            <span class="px-2 py-0.5 bg-[#22C55E]/10 text-[#22C55E] text-xs font-bold rounded-full border border-[#22C55E]/20"><%= price.discount %>% OFF</span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="px-3 py-1 rounded-full text-xs font-semibold <%= selectedCourse ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' : 'bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400' %>">
                                    <%= selectedCourse ? '✅ Ready' : '⏳ Select Course' %>
                                </div>
                            </div>
                        </div>

                        <!-- Enrollment Form -->
                        <form id="enrollmentForm" class="px-5 sm:px-6 py-5 space-y-4">
                            <input type="hidden" name="courseId" id="courseId" value="<%= selectedCourse ? selectedCourse._id : '' %>">
                            <input type="hidden" name="paidPrice" id="paidPrice" value="<%= price.payPrice %>">

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Full Name <span class="text-red-500">*</span></label>
                                <input type="text" id="studentName" value="<%= currentUser ? currentUser.name : '' %>" required
                                    placeholder="Enter your full name"
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 focus:bg-white dark:focus:bg-gray-800 transition-all duration-300">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Email Address <span class="text-red-500">*</span></label>
                                <input type="email" id="studentEmail" value="<%= currentUser ? currentUser.email : '' %>" required
                                    placeholder="your@email.com"
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 focus:bg-white dark:focus:bg-gray-800 transition-all duration-300">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Mobile Number <span class="text-red-500">*</span></label>
                                <input type="tel" id="studentMobile" value="<%= currentUser && currentUser.mobile ? currentUser.mobile : '' %>" required
                                    placeholder="9876543210"
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 focus:bg-white dark:focus:bg-gray-800 transition-all duration-300">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Questions or Requirements</label>
                                <textarea id="studentDescription" rows="2" placeholder="Any questions about the course..."
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 focus:bg-white dark:focus:bg-gray-800 transition-all duration-300 resize-none"></textarea>
                            </div>

                            <div class="flex items-start gap-2.5">
                                <input type="checkbox" id="terms" required class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:focus:ring-blue-400">
                                <label for="terms" class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
                                    I agree to the <a href="/terms" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">Terms of Service</a> and
                                    <a href="/privacy" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">Privacy Policy</a>
                                </label>
                            </div>

                            <button type="button" id="payBtn" <%= selectedCourse ? '' : 'disabled' %>
                                class="w-full py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-base transition-all duration-300 shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-3 group">
                                <svg class="w-5 h-5 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                                </svg>
                                <span id="payBtnText">Pay Now & Enroll</span>
                            </button>

                            <div class="flex flex-wrap items-center justify-center gap-4 pt-2 text-xs text-gray-500 dark:text-gray-400">
                                <span class="flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                    </svg>
                                    Secure Payment
                                </span>
                                <span class="flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                    </svg>
                                    Data Protected
                                </span>
                                <span class="flex items-center gap-1.5"><i class="fas fa-credit-card text-blue-500"></i> Razorpay Secured</span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- RELATED COURSES                                               -->
        <!-- ============================================================ -->
        <% if (relatedCourses && relatedCourses.length > 0) { %>
        <div>
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Related Courses</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">More from <%= selectedCourse.courceType %></p>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <% relatedCourses.forEach(course => { %>
                    <%- courseCardHTML(course, false) %>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- ============================================================ -->
        <!-- LATEST / SUGGESTED COURSES                                    -->
        <!-- ============================================================ -->
        <% if (latestCourses && latestCourses.length > 0) { %>
        <div>
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Latest Courses</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Freshly added, worth a look</p>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <% latestCourses.forEach(course => { %>
                    <%- courseCardHTML(course, false) %>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- ============================================================ -->
        <!-- BROWSE ALL COURSES (search + filter + PAGINATION)             -->
        <!-- ============================================================ -->
        <div>
            <div class="bg-white dark:bg-gray-800/90 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700/50 overflow-hidden">
                <div class="px-5 sm:px-6 py-4 sm:py-5 border-b border-gray-100 dark:border-gray-700/50 flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white">Browse All Courses</h2>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Find exactly what you're looking for</p>
                    </div>
                    <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-xs font-semibold border border-blue-200 dark:border-blue-800/50">
                        <span id="browseTotalCount"><%= pagination.totalCourses %></span> Courses
                    </span>
                </div>

                <!-- Search & Filter -->
                <div class="px-5 sm:px-6 pt-4 pb-3 flex flex-col sm:flex-row gap-3">
                    <div class="relative flex-1">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input type="text" id="browseSearch" placeholder="Search courses..."
                            class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 transition-all duration-300">
                    </div>
                    <select id="browseCategory" class="px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 text-gray-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 transition-all duration-300 cursor-pointer min-w-[160px]">
                        <option value="all">All Categories</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Grid -->
                <div class="px-5 sm:px-6 pb-3 relative">
                    <div id="browseLoading" class="hidden absolute inset-0 bg-white/60 dark:bg-gray-800/60 z-10 flex items-center justify-center rounded-xl">
                        <i class="fas fa-spinner fa-spin text-2xl text-blue-600"></i>
                    </div>
                    <div id="browseGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <% browseCourses.forEach(course => { %>
                            <%- courseCardHTML(course, selectedCourse && course._id.toString() === selectedCourse._id.toString()) %>
                        <% }) %>
                    </div>
                    <div id="browseNoResults" class="hidden text-center py-12">
                        <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h3 class="text-base font-semibold text-gray-600 dark:text-gray-400">No courses found</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-500">Try adjusting your search or filter</p>
                    </div>
                </div>

                <!-- Pagination -->
                <div id="browsePagination" class="px-5 sm:px-6 py-4 border-t border-gray-100 dark:border-gray-700/50 flex items-center justify-between gap-3 flex-wrap">
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                        Page <span id="pageCurrentLabel"><%= pagination.page %></span> of <span id="pageTotalLabel"><%= pagination.totalPages %></span>
                    </p>
                    <div class="flex items-center gap-2">
                        <button id="prevPageBtn" type="button" <%= pagination.page <= 1 ? 'disabled' : '' %>
                            class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                            <i class="fas fa-chevron-left mr-1"></i> Prev
                        </button>
                        <button id="nextPageBtn" type="button" <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>
                            class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                            Next <i class="fas fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ============================================================ -->
<!-- RAZORPAY SCRIPT                                              -->
<!-- ============================================================ -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    'use strict';

    // ============================================================
    // SELECTED COURSE (rendered server-side, no dataset scraping)
    // ============================================================
    const selectedCourseId = <%- JSON.stringify(selectedCourse ? selectedCourse._id.toString() : null) %>;
    const selectedCourseTitle = <%- JSON.stringify(selectedCourse ? selectedCourse.title : '') %>;
    const paidPrice = <%- JSON.stringify(price.payPrice) %>;
    const razorpayKey = <%- JSON.stringify(razorpayKey || '') %>;

    const payBtn = document.getElementById('payBtn');
    const payBtnText = document.getElementById('payBtnText');
    const enrollmentForm = document.getElementById('enrollmentForm');
    const courseIdInput = document.getElementById('courseId');
    const paidPriceInput = document.getElementById('paidPrice');
    const studentName = document.getElementById('studentName');
    const studentEmail = document.getElementById('studentEmail');
    const studentMobile = document.getElementById('studentMobile');
    const studentDescription = document.getElementById('studentDescription');
    const termsCheckbox = document.getElementById('terms');

    // ========== RAZORPAY PAYMENT ==========
    async function initiatePayment() {
        const name = studentName.value.trim();
        const email = studentEmail.value.trim();
        const mobile = studentMobile.value.trim();

        if (!selectedCourseId) { alert('Please select a course first'); return; }
        if (!name) { alert('Please enter your full name'); studentName.focus(); return; }
        if (!email || !email.includes('@') || !email.includes('.')) { alert('Please enter a valid email address'); studentEmail.focus(); return; }
        if (!mobile || mobile.length < 10) { alert('Please enter a valid 10-digit mobile number'); studentMobile.focus(); return; }
        if (!termsCheckbox.checked) { alert('Please agree to the Terms of Service and Privacy Policy'); termsCheckbox.focus(); return; }

        if (paidPrice === 0) {
            alert('This course is free! You can enroll directly.');
            enrollmentForm.action = `/enroll/${selectedCourseId}`;
            enrollmentForm.submit();
            return;
        }

        payBtn.disabled = true;
        payBtnText.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Creating Order...';

        try {
            const response = await fetch('/create-enrollment-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courseId: selectedCourseId })
            });
            const data = await response.json();

            if (!data.success) {
                if (data.isFree) {
                    alert('This is a free course! You can enroll directly.');
                    enrollmentForm.action = `/enroll/${selectedCourseId}`;
                    enrollmentForm.submit();
                    return;
                }
                throw new Error(data.message || 'Failed to create order');
            }

            const options = {
                key: data.key || razorpayKey,
                amount: data.amount,
                currency: data.currency,
                name: 'InstituteHub',
                description: `Enrollment: ${selectedCourseTitle}`,
                image: '/images/logo.png',
                order_id: data.orderId,
                handler: function(response) { verifyPayment(response); },
                prefill: { name, email, contact: mobile },
                theme: { color: '#2563EB' },
                modal: {
                    ondismiss: function() {
                        payBtn.disabled = false;
                        payBtnText.innerHTML = 'Pay Now & Enroll';
                    }
                }
            };

            const razorpay = new Razorpay(options);
            razorpay.open();
        } catch (error) {
            console.error('Payment error:', error);
            alert(error.message || 'Failed to initiate payment. Please try again.');
            payBtn.disabled = false;
            payBtnText.innerHTML = 'Pay Now & Enroll';
        }
    }

    async function verifyPayment(response) {
        payBtnText.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Verifying...';
        try {
            const result = await fetch('/verify-enrollment-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    razorpay_order_id: response.razorpay_order_id,
                    razorpay_payment_id: response.razorpay_payment_id,
                    razorpay_signature: response.razorpay_signature,
                    courseId: selectedCourseId,
                    name: studentName.value.trim(),
                    email: studentEmail.value.trim(),
                    mobile: studentMobile.value.trim(),
                    description: studentDescription.value.trim()
                })
            });
            const data = await result.json();

            if (data.success) {
                alert('🎉 Enrollment successful! You now have access to this course.');
                window.location.href = data.redirectUrl || `/courses/${selectedCourseId}/access`;
            } else if (data.alreadyEnrolled) {
                alert('You are already enrolled in this course!');
                window.location.href = `/courses/${selectedCourseId}/access`;
            } else {
                alert(data.message || 'Payment verification failed. Please contact support.');
            }
        } catch (error) {
            console.error('Verification error:', error);
            alert('Payment verification failed. Please contact support.');
        } finally {
            payBtn.disabled = false;
            payBtnText.innerHTML = 'Pay Now & Enroll';
        }
    }

    payBtn.addEventListener('click', initiatePayment);

    // ============================================================
    // BROWSE ALL COURSES — AJAX search + filter + pagination
    // (this is what keeps the page fast even with hundreds of
    // courses instead of rendering them all at once)
    // ============================================================
    const browseSearch = document.getElementById('browseSearch');
    const browseCategory = document.getElementById('browseCategory');
    const browseGrid = document.getElementById('browseGrid');
    const browseLoading = document.getElementById('browseLoading');
    const browseNoResults = document.getElementById('browseNoResults');
    const browseTotalCount = document.getElementById('browseTotalCount');
    const prevPageBtn = document.getElementById('prevPageBtn');
    const nextPageBtn = document.getElementById('nextPageBtn');
    const pageCurrentLabel = document.getElementById('pageCurrentLabel');
    const pageTotalLabel = document.getElementById('pageTotalLabel');

    let currentPage = <%- pagination.page %>;
    let searchDebounceTimer = null;

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function renderCourseCard(course, isSelected) {
        const payPrice = course.actualPrice || course.price || 0;
        const marketPrice = course.price || course.actualPrice || 0;
        const discount = marketPrice > payPrice ? Math.round(((marketPrice - payPrice) / marketPrice) * 100) : 0;
        const hasDiscount = discount > 0;
        const img = (course.image && course.image.url) || 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=400&auto=format&fit=crop';
        const teacherName = (course.teacher && course.teacher.name) || 'Expert';
        const selectedClasses = isSelected
            ? 'border-blue-500 bg-blue-50 dark:border-blue-500 dark:bg-blue-900/20 shadow-md'
            : 'border-gray-200 dark:border-gray-700';
        const title = escapeHtml(course.title || '');

        return `
        <a href="/enroll?courseId=${course._id}"
           class="course-card group block bg-gray-50/80 dark:bg-gray-700/30 border-2 rounded-xl p-3 transition-all duration-300 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-lg hover:-translate-y-1 ${selectedClasses}">
            <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-14 h-14 rounded-lg overflow-hidden bg-gray-200 dark:bg-gray-700 shadow-sm">
                    <img src="${img}" alt="${title}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=400&auto=format&fit=crop'">
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-sm text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">${title}</h3>
                    <div class="flex flex-wrap items-center gap-1 mt-1">
                        <span class="inline-block px-2 py-0.5 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-full text-[10px] font-medium">${escapeHtml(course.courceType || 'Course')}</span>
                        <span class="inline-block px-2 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-[10px] font-medium">${escapeHtml(course.courseLevel || 'Beginner')}</span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2 flex-wrap">
                        <span class="text-base font-extrabold text-gray-900 dark:text-white">₹${payPrice.toLocaleString()}</span>
                        ${hasDiscount ? `<span class="text-xs text-gray-400 dark:text-gray-500 line-through">₹${marketPrice.toLocaleString()}</span><span class="text-[10px] font-bold text-[#22C55E] bg-[#22C55E]/10 px-1.5 py-0.5 rounded-full border border-[#22C55E]/20">${discount}% OFF</span>` : ''}
                    </div>
                </div>
            </div>
            <div class="mt-2.5 pt-2.5 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
                    <span class="flex items-center gap-1"><i class="far fa-clock"></i> ${escapeHtml(course.duration || 'Self-paced')}</span>
                    <span class="flex items-center gap-1"><i class="far fa-user"></i> ${escapeHtml(teacherName)}</span>
                </div>
                <span class="px-3 py-1 rounded-lg text-xs font-medium ${isSelected ? 'bg-blue-600 text-white shadow-md' : 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 group-hover:bg-blue-600 group-hover:text-white dark:group-hover:bg-blue-600'}">${isSelected ? '✓ Selected' : 'Select'}</span>
            </div>
        </a>`;
    }

    async function loadBrowseCourses(page) {
        browseLoading.classList.remove('hidden');
        try {
            const params = new URLSearchParams({
                page: page,
                search: browseSearch.value.trim(),
                category: browseCategory.value
            });
            const res = await fetch(`/enroll/api/browse-courses?${params.toString()}`);
            const data = await res.json();

            if (!data.success) throw new Error(data.message || 'Failed to load courses');

            currentPage = data.pagination.page;

            if (data.courses.length === 0) {
                browseGrid.classList.add('hidden');
                browseNoResults.classList.remove('hidden');
            } else {
                browseGrid.classList.remove('hidden');
                browseNoResults.classList.add('hidden');
                browseGrid.innerHTML = data.courses
                    .map(c => renderCourseCard(c, selectedCourseId && c._id === selectedCourseId))
                    .join('');
            }

            browseTotalCount.textContent = data.pagination.totalCourses;
            pageCurrentLabel.textContent = data.pagination.page;
            pageTotalLabel.textContent = data.pagination.totalPages;
            prevPageBtn.disabled = data.pagination.page <= 1;
            nextPageBtn.disabled = data.pagination.page >= data.pagination.totalPages;

        } catch (error) {
            console.error('Browse courses error:', error);
        } finally {
            browseLoading.classList.add('hidden');
        }
    }

    browseSearch.addEventListener('input', function() {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => loadBrowseCourses(1), 400);
    });

    browseCategory.addEventListener('change', function() { loadBrowseCourses(1); });

    prevPageBtn.addEventListener('click', function() {
        if (currentPage > 1) loadBrowseCourses(currentPage - 1);
    });

    nextPageBtn.addEventListener('click', function() {
        loadBrowseCourses(currentPage + 1);
    });
});
</script>

<style>
    .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .course-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .fa-spin { animation: spin 1s linear infinite; }

    @media (min-width: 1024px) {
        .lg\:sticky { position: sticky; top: 100px; }
    }
    @media (max-width: 640px) {
        .lg\:sticky { position: relative !important; top: 0 !important; }
    }
</style>
