<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800">
    <div class="max-w-6xl mx-auto">
        
        <!-- ============================================================ -->
        <!-- PAGE HEADER                                                   -->
        <!-- ============================================================ -->
        <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#C9A227] to-[#B8901E] flex items-center justify-center shadow-lg shadow-[#C9A227]/25">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Edit Course</h1>
                            <p class="mt-1 text-gray-600 dark:text-gray-400">Update your course information and settings</p>
                        </div>
                    </div>
                </div>
                <div class="mt-4 md:mt-0 flex gap-3">
                    <a href="/courses/<%= course._id %>" 
                       class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium hover:border-[#C9A227] hover:text-[#C9A227]">
                        <i class="fas fa-eye"></i> View Course
                    </a>
                    <a href="/admin/courses" 
                       class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-[#C9A227] to-[#B8901E] hover:from-[#B8901E] hover:to-[#A07A1A] text-white font-medium rounded-xl transition-all duration-300 shadow-md hover:shadow-lg">
                        <i class="fas fa-arrow-left"></i> Back to Courses
                    </a>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- FORM CARD                                                    -->
        <!-- ============================================================ -->
        <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg hover:shadow-xl transition-all duration-500 p-6 sm:p-8" data-aos="fade-up" data-aos-duration="600">
            <form action="/courses/<%= course._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="space-y-8" id="courseForm">
                
                <!-- ========================================================== -->
                <!-- PROGRESS STEPS                                              -->
                <!-- ========================================================== -->
                <div class="flex items-center justify-between mb-8 px-2">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-r from-[#C9A227] to-[#B8901E] flex items-center justify-center text-white text-xs font-bold shadow-lg shadow-[#C9A227]/25">1</div>
                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Basic Info</span>
                    </div>
                    <div class="flex-1 h-0.5 bg-gradient-to-r from-[#C9A227] to-gray-200 dark:from-[#C9A227] dark:to-gray-700 mx-4"></div>
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400 text-xs font-bold">2</div>
                        <span class="text-sm font-medium text-gray-400 dark:text-gray-500">Pricing</span>
                    </div>
                    <div class="flex-1 h-0.5 bg-gray-200 dark:bg-gray-700 mx-4"></div>
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400 text-xs font-bold">3</div>
                        <span class="text-sm font-medium text-gray-400 dark:text-gray-500">Content</span>
                    </div>
                    <div class="flex-1 h-0.5 bg-gray-200 dark:bg-gray-700 mx-4"></div>
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400 text-xs font-bold">4</div>
                        <span class="text-sm font-medium text-gray-400 dark:text-gray-500">Settings</span>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 1. BASIC INFORMATION                                        -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Basic Information</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Required</span>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Essential details about your course</p>

                    <div class="space-y-5">
                        <!-- Title -->
                        <div>
                            <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Course Title <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <i class="fas fa-heading absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                                <input type="text" id="title" name="title" value="<%= course.title %>" required
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                            </div>
                            <div class="mt-1.5 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                                <span><i class="fas fa-info-circle mr-1"></i> Clear, descriptive title</span>
                                <span id="title-counter"><%= course.title?.length || 0 %>/120 characters</span>
                            </div>
                        </div>

                        <!-- Short Description -->
                        <div>
                            <label for="shortDescription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Short Description <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <i class="fas fa-align-left absolute left-3.5 top-4 text-gray-400 dark:text-gray-500"></i>
                                <textarea id="shortDescription" name="shortDescription" required rows="3"
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"><%= course.shortDescription %></textarea>
                            </div>
                            <div class="mt-1.5 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                                <span><i class="fas fa-info-circle mr-1"></i> 150-200 characters recommended</span>
                                <span id="shortDesc-counter"><%= course.shortDescription?.length || 0 %>/250 characters</span>
                            </div>
                        </div>

                        <!-- Full Description -->
                        <div>
                            <label for="discription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Detailed Description
                            </label>
                            <div class="relative">
                                <i class="fas fa-file-alt absolute left-3.5 top-4 text-gray-400 dark:text-gray-500"></i>
                                <textarea id="discription" name="discription" rows="6"
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"><%= course.discription %></textarea>
                            </div>
                            <div class="mt-1.5 flex justify-between text-xs text-gray-500 dark:text-gray-400">
                                <span><i class="fas fa-info-circle mr-1"></i> Detailed description for course page</span>
                                <span id="desc-counter"><%= course.discription?.length || 0 %>/5000 characters</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 2. PRICING & DETAILS                                        -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Pricing & Details</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Required</span>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Set pricing and course specifications</p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Price -->
                        <div>
                            <label for="price" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Original Price <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 font-bold">₹</span>
                                <input type="number" id="price" name="price" value="<%= course.price %>" min="0" step="0.01" required
                                    class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                            </div>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Original market price</p>
                        </div>

                        <!-- Actual Price -->
                        <div>
                            <label for="actualPrice" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Selling Price <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 font-bold">₹</span>
                                <input type="number" id="actualPrice" name="actualPrice" value="<%= course.actualPrice %>" min="0" step="0.01" required
                                    class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                            </div>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Discounted price (what user pays)</p>
                        </div>

                        <!-- Discount -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Discount</label>
                            <div class="px-4 py-3 rounded-xl bg-gradient-to-r from-[#C9A227]/10 to-[#B8901E]/10 dark:from-[#C9A227]/20 dark:to-[#B8901E]/20 border border-[#C9A227]/30">
                                <div class="flex items-center gap-3">
                                    <i class="fas fa-tag text-[#C9A227] text-lg"></i>
                                    <div>
                                        <span id="discountPercentage" class="text-2xl font-bold text-[#C9A227]">
                                            <%= Math.round(((course.price - course.actualPrice) / course.price) * 100) || 0 %>% off
                                        </span>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Auto-calculated from prices</p>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                        <!-- Course Type -->
                        <div>
                            <label for="courceType" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Course Category <span class="text-red-500">*</span>
                            </label>
                            <select id="courceType" name="courceType" required
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none">
                                <option value="Web Development" <%= course.courceType === 'Web Development' ? 'selected' : '' %>>💻 Web Development</option>
                                <option value="Data Science" <%= course.courceType === 'Data Science' ? 'selected' : '' %>>📊 Data Science</option>
                                <option value="Cybersecurity" <%= course.courceType === 'Cybersecurity' ? 'selected' : '' %>>🔒 Cybersecurity</option>
                                <option value="Cloud & DevOps" <%= course.courceType === 'Cloud & DevOps' ? 'selected' : '' %>>☁️ Cloud & DevOps</option>
                                <option value="UI/UX Design" <%= course.courceType === 'UI/UX Design' ? 'selected' : '' %>>🎨 UI/UX Design</option>
                                <option value="Mobile Apps" <%= course.courceType === 'Mobile Apps' ? 'selected' : '' %>>📱 Mobile Apps</option>
                                <option value="AI & ML" <%= course.courceType === 'AI & ML' ? 'selected' : '' %>>🤖 AI & ML</option>
                                <option value="Marketing" <%= course.courceType === 'Marketing' ? 'selected' : '' %>>📈 Marketing</option>
                                <option value="Business" <%= course.courceType === 'Business' ? 'selected' : '' %>>💼 Business</option>
                                <option value="Finance" <%= course.courceType === 'Finance' ? 'selected' : '' %>>💰 Finance</option>
                                <option value="Health & Wellness" <%= course.courceType === 'Health & Wellness' ? 'selected' : '' %>>🏥 Health & Wellness</option>
                                <option value="Teaching & Education" <%= course.courceType === 'Teaching & Education' ? 'selected' : '' %>>📚 Teaching & Education</option>
                                <option value="Other" <%= course.courceType === 'Other' ? 'selected' : '' %>>✨ Other</option>
                            </select>
                        </div>

                        <!-- Course Level -->
                        <div>
                            <label for="courseLevel" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Course Level <span class="text-red-500">*</span>
                            </label>
                            <select id="courseLevel" name="courseLevel" required
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none">
                                <option value="beginner" <%= course.courseLevel === 'beginner' ? 'selected' : '' %>>🌱 Beginner</option>
                                <option value="intermediate" <%= course.courseLevel === 'intermediate' ? 'selected' : '' %>>📘 Intermediate</option>
                                <option value="advanced" <%= course.courseLevel === 'advanced' ? 'selected' : '' %>>🚀 Advanced</option>
                                <option value="expert" <%= course.courseLevel === 'expert' ? 'selected' : '' %>>🏆 Expert</option>
                            </select>
                        </div>

                        <!-- Duration -->
                        <div>
                            <label for="duration" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Duration <span class="text-gray-400 font-normal">(Hours)</span>
                            </label>
                            <div class="relative">
                                <i class="fas fa-clock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                                <input type="number" id="duration" name="duration" value="<%= course.duration %>" min="1"
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                            </div>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Total course duration in hours</p>
                        </div>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 3. COURSE CONTENT                                           -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Course Content</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Optional</span>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Add course structure and learning outcomes</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Prerequisites -->
                        <div>
                            <label for="prerequisites" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Prerequisites
                            </label>
                            <textarea id="prerequisites" name="prerequisites" rows="3"
                                placeholder="Enter prerequisites (comma separated)"
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"><%= course.prerequisites ? course.prerequisites.join(', ') : '' %></textarea>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Separate with commas</p>
                        </div>

                        <!-- Learning Outcomes -->
                        <div>
                            <label for="learningOutcomes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Learning Outcomes
                            </label>
                            <textarea id="learningOutcomes" name="learningOutcomes" rows="3"
                                placeholder="Enter learning outcomes (comma separated)"
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"><%= course.learningOutcomes ? course.learningOutcomes.join(', ') : '' %></textarea>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">What students will learn</p>
                        </div>
                    </div>

                    <!-- Includes -->
                    <div class="mt-4">
                        <label for="includes" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            What's Included
                        </label>
                        <textarea id="includes" name="includes" rows="2"
                            placeholder="Enter included items (comma separated)"
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"><%= course.includes ? course.includes.join(', ') : '' %></textarea>
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">What students get with this course</p>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 4. INSTRUCTOR                                               -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Instructor</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Required</span>
                    </div>
                    <div>
                        <label for="teacher" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Course Instructor <span class="text-red-500">*</span>
                        </label>
                        <select id="teacher" name="teacher" required
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none">
                            <option value="">Select Instructor</option>
                            <% if(teachers && teachers.length > 0) { %>
                                <% teachers.forEach(teacher => { %>
                                    <option value="<%= teacher._id %>" 
                                        <%= course.teacher && course.teacher.toString() === teacher._id.toString() ? 'selected' : '' %>>
                                        👨‍🏫 <%= teacher.name %> (<%= teacher.email %>)
                                    </option>
                                <% }) %>
                            <% } else { %>
                                <option value="" disabled>⚠️ No instructors available. Please add instructors first.</option>
                            <% } %>
                        </select>
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Select the instructor who will teach this course
                        </p>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 5. PRE-REGISTERED STUDENTS                                  -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Student Enrollment</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Optional</span>
                    </div>
                    <div>
                        <label for="preStudents" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Pre-Registered Students
                        </label>
                        <div class="relative">
                            <i class="fas fa-users absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                            <input type="number" id="preStudents" name="preStudents" value="<%= course.preStudents || 0 %>" min="0"
                                class="w-[200px] pl-10 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                        </div>
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Number of students already pre-registered for this course
                        </p>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 6. CATEGORY & PDF                                           -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Category & Resources</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Optional</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Category -->
                        <div>
                            <label for="category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                Course Category
                            </label>
                            <select id="category" name="category"
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none">
                                <option value="">Select Category</option>
                                <% if(categories && categories.length > 0) { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat._id %>" 
                                            <%= course.category && course.category.toString() === cat._id.toString() ? 'selected' : '' %>>
                                            <i class="fas <%= cat.icon || 'fa-shield-alt' %>"></i> <%= cat.name %>
                                        </option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="" disabled>⚠️ No categories available</option>
                                <% } %>
                            </select>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Select a category for this course</p>
                        </div>

                        <!-- PDF Details -->
                        <div>
                            <label for="pdfDetails" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                <i class="fas fa-file-pdf text-red-500 mr-2"></i> Course Details PDF
                                <span class="text-gray-400 font-normal">(Google Drive Link)</span>
                            </label>
                            <div class="relative">
                                <i class="fas fa-link absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                                <input type="url" id="pdfDetails" name="pdfDetails" 
                                    value="<%= course.pdfDetails || '' %>"
                                    placeholder="https://drive.google.com/file/d/xxxxx/view"
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                            </div>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                                <i class="fas fa-info-circle mr-1"></i> Paste Google Drive shareable link for course brochure
                            </p>
                            <% if (course.pdfDetails) { %>
                                <div class="mt-2 p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
                                    <a href="<%= course.pdfDetails %>" target="_blank" 
                                       class="text-blue-600 dark:text-blue-400 hover:underline text-sm flex items-center gap-2">
                                        <i class="fas fa-external-link-alt"></i>
                                        View Current PDF
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 7. DISPLAY SETTINGS                                         -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Display Settings</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Optional</span>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Control where and how the course appears</p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#C9A227] dark:hover:border-[#C9A227] transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30 group">
                            <input type="checkbox" name="addInHomePage" <%= course.addInHomePage ? "checked" : "" %> class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-[#C9A227] focus:ring-[#C9A227] dark:focus:ring-[#C9A227]">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white group-hover:text-[#C9A227] transition-colors">Show on Homepage</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Display course on the main landing page</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#C9A227] dark:hover:border-[#C9A227] transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30 group">
                            <input type="checkbox" name="isPopular" <%= course.isPopular ? "checked" : "" %> class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-[#C9A227] focus:ring-[#C9A227] dark:focus:ring-[#C9A227]">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white group-hover:text-[#C9A227] transition-colors">Mark as Popular</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Featured as a popular course</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#C9A227] dark:hover:border-[#C9A227] transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30 group">
                            <input type="checkbox" name="isActive" <%= course.isActive ? "checked" : "" %> class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-[#C9A227] focus:ring-[#C9A227] dark:focus:ring-[#C9A227]">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white group-hover:text-[#C9A227] transition-colors">Active Course</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Make course available to students</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#C9A227] dark:hover:border-[#C9A227] transition-all cursor-pointer bg-gray-50 dark:bg-gray-700/30 group">
                            <input type="checkbox" id="showInNavbar" name="showInNavbar" <%= course.showInNavbar ? "checked" : "" %> class="mt-1 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-[#C9A227] focus:ring-[#C9A227] dark:focus:ring-[#C9A227]">
                            <div>
                                <span class="font-medium text-gray-900 dark:text-white group-hover:text-[#C9A227] transition-colors">Show in Navigation</span>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Add direct link in navbar</p>
                            </div>
                        </label>
                    </div>

                    <!-- Navbar Settings -->
                    <div id="navbarSettings" class="<%= course.showInNavbar ? '' : 'hidden' %> mt-4 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="navbarButtonText" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Navbar Button Text
                                </label>
                                <input type="text" id="navbarButtonText" name="navbarButtonText" 
                                    value="<%= course.navbarButtonText || '' %>"
                                    placeholder="e.g., OSCP Certification"
                                    class="w-full px-4 py-2.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                            </div>
                            <div>
                                <label for="navbarButtonColor" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    Button Color
                                </label>
                                <select id="navbarButtonColor" name="navbarButtonColor"
                                    class="w-full px-4 py-2.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                                    <option value="blue" <%= course.navbarButtonColor === 'blue' ? 'selected' : '' %>>🔵 Blue</option>
                                    <option value="cyan" <%= course.navbarButtonColor === 'cyan' ? 'selected' : '' %>>🟦 Cyan</option>
                                    <option value="purple" <%= course.navbarButtonColor === 'purple' ? 'selected' : '' %>>🟣 Purple</option>
                                    <option value="green" <%= course.navbarButtonColor === 'green' ? 'selected' : '' %>>🟢 Green</option>
                                    <option value="red" <%= course.navbarButtonColor === 'red' ? 'selected' : '' %>>🔴 Red</option>
                                    <option value="yellow" <%= course.navbarButtonColor === 'yellow' ? 'selected' : '' %>>🟡 Yellow</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- 8. COURSE IMAGE                                             -->
                <!-- ========================================================== -->
                <div class="bg-gray-50/50 dark:bg-gray-700/20 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-1 h-8 rounded-full bg-gradient-to-b from-[#C9A227] to-[#B8901E]"></div>
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Course Image</h2>
                        <span class="px-2.5 py-0.5 text-[10px] font-bold text-[#C9A227] bg-[#C9A227]/10 rounded-full border border-[#C9A227]/30">Optional</span>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Update course thumbnail</p>

                    <div>
                        <label for="image" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Course Thumbnail
                        </label>
                        <% if(course.image && course.image.url) { %>
                            <div class="mb-4 p-4 bg-gray-50 dark:bg-gray-700/30 rounded-xl border border-gray-200 dark:border-gray-700">
                                <div class="flex items-center gap-4 flex-wrap sm:flex-nowrap">
                                    <div class="w-32 h-20 rounded-lg overflow-hidden border border-gray-200 dark:border-gray-600 flex-shrink-0">
                                        <img src="<%= course.image.url %>" alt="<%= course.title %>" class="w-full h-full object-cover"/>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Current Image</p>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">Upload a new image below to replace it</p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                        
                        <div class="relative border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl p-8 hover:border-[#C9A227] dark:hover:border-[#C9A227] transition-colors bg-gray-50 dark:bg-gray-700/30 group">
                            <input type="file" id="image" name="image" accept="image/*"
                                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                                onchange="previewImage(this)">
                            <div class="text-center">
                                <div class="w-16 h-16 mx-auto rounded-full bg-[#C9A227]/10 flex items-center justify-center text-[#C9A227] group-hover:scale-110 transition-transform duration-300">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
                                    <span class="font-medium text-[#C9A227] group-hover:text-[#B8901E] transition-colors">Click to upload</span> or drag and drop
                                </p>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                    PNG, JPG, WebP up to 5MB (Leave empty to keep current)
                                </p>
                            </div>
                        </div>
                        <div id="imagePreviewContainer" class="mt-3 hidden">
                            <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-xl p-4 border border-emerald-200 dark:border-emerald-800">
                                <div class="flex items-center gap-4 flex-wrap sm:flex-nowrap">
                                    <div class="w-24 h-24 rounded-lg overflow-hidden border border-emerald-300 dark:border-emerald-700 bg-white dark:bg-gray-800 flex-shrink-0">
                                        <img id="imagePreview" src="#" alt="Preview" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm text-emerald-800 dark:text-emerald-300 font-medium truncate" id="fileName"></p>
                                        <p class="text-xs text-emerald-600 dark:text-emerald-400" id="fileSize"></p>
                                        <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-1">
                                            <i class="fas fa-check-circle mr-1"></i> New image will replace current
                                        </p>
                                    </div>
                                    <button type="button" onclick="removePreview()" class="text-emerald-700 dark:text-emerald-400 hover:text-emerald-900 dark:hover:text-emerald-300 transition-colors flex-shrink-0">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================== -->
                <!-- FORM ACTIONS                                                -->
                <!-- ========================================================== -->
                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <button type="submit" id="submitBtn"
                        class="flex-1 bg-gradient-to-r from-[#C9A227] to-[#B8901E] hover:from-[#B8901E] hover:to-[#A07A1A] text-white font-medium py-3.5 px-6 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl flex items-center justify-center gap-2 hover:-translate-y-0.5 active:translate-y-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        Update Course
                    </button>
                    <a href="/admin/courses"
                        class="flex-1 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 font-medium py-3.5 px-6 rounded-xl transition-colors duration-200 text-center flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- ============================================================ -->
        <!-- HELP TIPS                                                     -->
        <!-- ============================================================ -->
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
            <div class="bg-[#C9A227]/10 dark:bg-[#C9A227]/20 rounded-xl p-6 border border-[#C9A227]/30">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[#C9A227]/20 dark:bg-[#C9A227]/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-[#C9A227]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-gray-900 dark:text-white">Course Update Tips</h3>
                        <div class="mt-2 grid grid-cols-1 gap-2">
                            <div class="text-sm text-gray-700 dark:text-gray-300">
                                <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-[#C9A227]"></i> Review Content</p>
                                <p class="mt-0.5 text-xs opacity-70">Keep course content updated and relevant</p>
                            </div>
                            <div class="text-sm text-gray-700 dark:text-gray-300">
                                <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-[#C9A227]"></i> Pricing Strategy</p>
                                <p class="mt-0.5 text-xs opacity-70">Review pricing and discounts periodically</p>
                            </div>
                            <div class="text-sm text-gray-700 dark:text-gray-300">
                                <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-[#C9A227]"></i> Visibility Settings</p>
                                <p class="mt-0.5 text-xs opacity-70">Adjust display settings for maximum reach</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-6 border border-blue-100 dark:border-blue-800">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-blue-900 dark:text-blue-300">Quick Checklist</h3>
                        <div class="mt-2 space-y-1.5 text-sm text-blue-800 dark:text-blue-300">
                            <p><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Course title & description updated</p>
                            <p><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Pricing reviewed (Original & Discounted)</p>
                            <p><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Instructor assignment verified</p>
                            <p><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Learning outcomes & prerequisites checked</p>
                            <p><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Display settings configured</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ================================================================
    // CHARACTER COUNTERS
    // ================================================================
    const titleInput = document.getElementById('title');
    const shortDescInput = document.getElementById('shortDescription');
    const descInput = document.getElementById('discription');

    if (titleInput) {
        titleInput.addEventListener('input', function() {
            document.getElementById('title-counter').textContent = `${this.value.length}/120 characters`;
        });
    }

    if (shortDescInput) {
        shortDescInput.addEventListener('input', function() {
            document.getElementById('shortDesc-counter').textContent = `${this.value.length}/250 characters`;
        });
    }

    if (descInput) {
        descInput.addEventListener('input', function() {
            document.getElementById('desc-counter').textContent = `${this.value.length}/5000 characters`;
        });
    }

    // ================================================================
    // DISCOUNT CALCULATOR
    // ================================================================
    const priceInput = document.getElementById('price');
    const actualPriceInput = document.getElementById('actualPrice');
    const discountElement = document.getElementById('discountPercentage');

    function calculateDiscount() {
        const price = parseFloat(priceInput?.value) || 0;
        const actualPrice = parseFloat(actualPriceInput?.value) || 0;
        
        if (price > 0 && actualPrice < price) {
            const discount = ((price - actualPrice) / price * 100).toFixed(1);
            if (discountElement) {
                discountElement.textContent = `${discount}% off`;
            }
        } else if (discountElement) {
            discountElement.textContent = '0% off';
        }
    }

    if (priceInput && actualPriceInput) {
        priceInput.addEventListener('input', calculateDiscount);
        actualPriceInput.addEventListener('input', calculateDiscount);
    }

    // ================================================================
    // IMAGE PREVIEW
    // ================================================================
    window.previewImage = function(input) {
        const previewContainer = document.getElementById('imagePreviewContainer');
        const preview = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        
        if (input.files && input.files[0]) {
            const file = input.files[0];
            
            if (file.size > 5 * 1024 * 1024) {
                alert('File size should be less than 5MB');
                input.value = '';
                previewContainer.classList.add('hidden');
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                fileName.textContent = file.name;
                fileSize.textContent = (file.size / 1024).toFixed(2) + ' KB';
                previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add('hidden');
        }
    };

    window.removePreview = function() {
        const fileInput = document.getElementById('image');
        const previewContainer = document.getElementById('imagePreviewContainer');
        fileInput.value = '';
        previewContainer.classList.add('hidden');
    };

    // ================================================================
    // NAVBAR SETTINGS TOGGLE
    // ================================================================
    const showInNavbar = document.getElementById('showInNavbar');
    const navbarSettings = document.getElementById('navbarSettings');

    if (showInNavbar && navbarSettings) {
        showInNavbar.addEventListener('change', function() {
            navbarSettings.classList.toggle('hidden', !this.checked);
        });
    }

    // ================================================================
    // FORM VALIDATION
    // ================================================================
    const form = document.getElementById('courseForm');
    const submitBtn = document.getElementById('submitBtn');
    
    if (form && submitBtn) {
        form.addEventListener('submit', function(e) {
            const price = parseFloat(priceInput?.value) || 0;
            const actualPrice = parseFloat(actualPriceInput?.value) || 0;
            
            if (actualPrice > price) {
                e.preventDefault();
                alert('⚠️ Selling price cannot be higher than original price');
                actualPriceInput?.focus();
                return;
            }

            // Show loading state
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
                <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                Updating Course...
            `;
            submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
        });
    }
});
</script>