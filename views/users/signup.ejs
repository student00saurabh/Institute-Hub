<% layout("/layouts/boilerplate") -%>

<!-- ============================================================ -->
<!--  SIGNUP — Split-screen, image bg + glassmorphic form card    -->
<!--  Theme: #2563EB blue / #C9A227 gold / #0F172A navy           -->
<!-- ============================================================ -->

<section class="min-h-screen flex bg-[#F8FAFC] dark:bg-[#0B1120] relative overflow-hidden">

    <!-- ============================================================ -->
    <!-- LEFT — Brand / Visual Panel (hidden on mobile)                -->
    <!-- ============================================================ -->
    <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden">
        <img src="https://picsum.photos/seed/signupclass/1200/1600" alt="Students learning" class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-br from-[#0F172A]/95 via-[#0F172A]/85 to-[#2563EB]/70"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,#ffffff10_1px,transparent_0)] [background-size:26px_26px]"></div>

        <!-- Ambient blobs -->
        <div class="pointer-events-none absolute -top-20 -left-20 w-80 h-80 rounded-full bg-[#2563EB]/30 blur-[100px] signup-blob"></div>
        <div class="pointer-events-none absolute bottom-0 right-0 w-96 h-96 rounded-full bg-[#C9A227]/20 blur-[100px] signup-blob signup-blob-delay"></div>

        <div class="relative z-10 flex flex-col justify-between w-full p-12 xl:p-16">
        

            <!-- Headline + features -->
            <div class="signup-fade-up signup-fade-delay-1">
                <h1 class="text-3xl xl:text-4xl font-extrabold text-white leading-tight max-w-md">
                    Start Learning Skills That
                    <span class="bg-gradient-to-r from-[#93C5FD] to-[#C9A227] bg-clip-text text-transparent">Actually Matter</span>
                </h1>
                <p class="mt-4 text-sm text-[#CBD5E1] max-w-sm leading-relaxed">
                    Create your free account and get instant access to industry-ready courses, mentor support and certificates.
                </p>

                <ul class="mt-8 space-y-3.5">
                    <li class="flex items-center gap-3 text-sm text-white/90">
                        <span class="w-6 h-6 rounded-full bg-[#22C55E]/20 border border-[#22C55E]/40 flex items-center justify-center shrink-0">
                            <i class="fas fa-check text-[10px] text-[#22C55E]"></i>
                        </span>
                        500+ courses across 10+ categories
                    </li>
                    <li class="flex items-center gap-3 text-sm text-white/90">
                        <span class="w-6 h-6 rounded-full bg-[#22C55E]/20 border border-[#22C55E]/40 flex items-center justify-center shrink-0">
                            <i class="fas fa-check text-[10px] text-[#22C55E]"></i>
                        </span>
                        Verified certificates recognized by employers
                    </li>
                    <li class="flex items-center gap-3 text-sm text-white/90">
                        <span class="w-6 h-6 rounded-full bg-[#22C55E]/20 border border-[#22C55E]/40 flex items-center justify-center shrink-0">
                            <i class="fas fa-check text-[10px] text-[#22C55E]"></i>
                        </span>
                        Lifetime access, learn at your own pace
                    </li>
                </ul>
            </div>

            <!-- Testimonial + stats -->
            <div class="signup-fade-up signup-fade-delay-2 space-y-6">
               

                <div class="flex items-center gap-6">
                    <div>
                        <p class="text-xl font-extrabold text-white">120K+</p>
                        <p class="text-[11px] text-[#94A3B8]">Learners</p>
                    </div>
                    <div class="w-px h-8 bg-white/15"></div>
                    <div>
                        <p class="text-xl font-extrabold text-white">4.8/5</p>
                        <p class="text-[11px] text-[#94A3B8]">Avg. Rating</p>
                    </div>
                    <div class="w-px h-8 bg-white/15"></div>
                    <div>
                        <p class="text-xl font-extrabold text-white">340+</p>
                        <p class="text-[11px] text-[#94A3B8]">Mentors</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- RIGHT — Form Panel                                             -->
    <!-- ============================================================ -->
    <div class="w-full lg:w-1/2 flex items-center justify-center px-4 sm:px-8 py-12 relative">

        <!-- Ambient background for the form side (visible on mobile too) -->
        <div class="pointer-events-none absolute inset-0 overflow-hidden lg:hidden">
            <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-[#2563EB]/10 dark:bg-[#2563EB]/15 blur-3xl"></div>
            <div class="absolute bottom-0 -left-16 w-64 h-64 rounded-full bg-[#C9A227]/10 dark:bg-[#C9A227]/15 blur-3xl"></div>
        </div>

        <div class="relative w-full max-w-md">

            <!-- Signup Card -->
            <div class="signup-fade-up signup-fade-delay-1 bg-white/90 dark:bg-[#111827]/90 backdrop-blur-xl rounded-3xl shadow-2xl shadow-[#2563EB]/10 border border-[#E2E8F0] dark:border-[#1E293B] p-7 sm:p-9">

                <div class="mb-7">
                    <h2 class="text-2xl font-extrabold text-[#0F172A] dark:text-white">Create Account</h2>
                    <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-1.5">Join us and start learning today</p>
                </div>

                <form action="/signup" method="POST" class="space-y-5" id="signupForm">

                    <!-- Full Name -->
                    <div>
                        <label for="name" class="block text-sm font-medium text-[#0F172A] dark:text-white mb-1.5">
                            Full Name
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#94A3B8] signup-input-icon">
                                <i class="fas fa-user text-sm"></i>
                            </div>
                            <input type="text"
                                   id="name"
                                   name="name"
                                   required
                                   placeholder="John Doe"
                                   class="signup-input w-full pl-10 pr-4 py-3 rounded-xl border border-[#E2E8F0] dark:border-[#334155] bg-[#F8FAFC] dark:bg-[#1E293B] text-[#0F172A] dark:text-white placeholder-[#94A3B8] dark:placeholder-[#64748B] focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:border-transparent transition-all duration-300">
                        </div>
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-[#0F172A] dark:text-white mb-1.5">
                            Email Address
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#94A3B8] signup-input-icon">
                                <i class="fas fa-envelope text-sm"></i>
                            </div>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   required
                                   placeholder="you@example.com"
                                   class="signup-input w-full pl-10 pr-4 py-3 rounded-xl border border-[#E2E8F0] dark:border-[#334155] bg-[#F8FAFC] dark:bg-[#1E293B] text-[#0F172A] dark:text-white placeholder-[#94A3B8] dark:placeholder-[#64748B] focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:border-transparent transition-all duration-300">
                        </div>
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="password" class="block text-sm font-medium text-[#0F172A] dark:text-white mb-1.5">
                            Password
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#94A3B8] signup-input-icon">
                                <i class="fas fa-lock text-sm"></i>
                            </div>
                            <input type="password"
                                   id="password"
                                   name="password"
                                   required
                                   placeholder="••••••••"
                                   autocomplete="new-password"
                                   class="signup-input w-full pl-10 pr-12 py-3 rounded-xl border border-[#E2E8F0] dark:border-[#334155] bg-[#F8FAFC] dark:bg-[#1E293B] text-[#0F172A] dark:text-white placeholder-[#94A3B8] dark:placeholder-[#64748B] focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:border-transparent transition-all duration-300">
                            <button type="button"
                                    id="togglePassword"
                                    aria-label="Toggle password visibility"
                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-[#94A3B8] hover:text-[#2563EB] transition-colors">
                                <i class="fas fa-eye text-sm"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Terms -->
                    <div class="flex items-start gap-2.5">
                        <input type="checkbox"
                               id="terms"
                               name="terms"
                               required
                               class="mt-0.5 w-4 h-4 rounded border-[#E2E8F0] dark:border-[#334155] text-[#2563EB] focus:ring-[#2563EB] focus:ring-offset-0">
                        <label for="terms" class="text-sm text-[#64748B] dark:text-[#94A3B8]">
                            I agree to the
                            <a href="/terms" class="text-[#2563EB] hover:underline font-semibold">Terms of Service</a>
                            and
                            <a href="/privacy" class="text-[#2563EB] hover:underline font-semibold">Privacy Policy</a>
                        </label>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            id="signupSubmitBtn"
                            class="signup-btn-shine relative overflow-hidden w-full py-3.5 px-4 bg-gradient-to-r from-[#2563EB] to-[#1D4ED8] hover:from-[#3B82F6] hover:to-[#2563EB] text-white font-semibold rounded-xl shadow-lg shadow-[#2563EB]/30 transition-all duration-300 transform hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2">
                        <i class="fas fa-user-plus"></i>
                        Create Account
                    </button>
                </form>

                <!-- Divider -->
                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-[#E2E8F0] dark:border-[#334155]"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-4 bg-white/90 dark:bg-[#111827]/90 text-[#94A3B8] dark:text-[#64748B]">
                            Or continue with
                        </span>
                    </div>
                </div>

                <!-- Google Signup -->
                <a href="/auth/google"
                   class="w-full flex items-center justify-center gap-3 py-3.5 px-4 bg-white dark:bg-[#1E293B] hover:bg-[#F8FAFC] dark:hover:bg-[#273449] border border-[#E2E8F0] dark:border-[#334155] rounded-xl text-[#0F172A] dark:text-white font-medium transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Sign up with Google
                </a>

                <!-- Login Link -->
                <p class="mt-6 text-center text-sm text-[#64748B] dark:text-[#94A3B8]">
                    Already have an account?
                    <a href="/login" class="text-[#2563EB] font-semibold hover:underline">
                        Log in
                    </a>
                </p>
            </div>

            <!-- Footer Note -->
            <div class="signup-fade-up signup-fade-delay-2 mt-7 text-center text-xs text-[#94A3B8] dark:text-[#64748B]">
                <i class="fas fa-shield-halved text-[#2563EB] mr-1"></i>
                By creating an account, you agree to our
                <a href="/terms" class="text-[#2563EB] hover:underline">Terms of Service</a>
                and
                <a href="/privacy" class="text-[#2563EB] hover:underline">Privacy Policy</a>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- STYLES                                                         -->
<!-- ============================================================ -->
<style>
    /* Panel blobs */
    @keyframes signupBlobFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(24px, -20px) scale(1.08); }
    }
    .signup-blob { animation: signupBlobFloat 12s ease-in-out infinite; }
    .signup-blob-delay { animation-delay: 4s; }

    /* Entrance animation */
    .signup-fade-up {
        opacity: 0;
        transform: translateY(18px);
        animation: signupFadeUp 0.7s cubic-bezier(0.4,0,0.2,1) forwards;
    }
    .signup-fade-delay-1 { animation-delay: 0.12s; }
    .signup-fade-delay-2 { animation-delay: 0.24s; }
    @keyframes signupFadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    /* Input focus micro-interaction: icon shifts color with the field */
    .signup-input:focus { box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }
    .signup-input:focus ~ .signup-input-icon,
    .relative:focus-within .signup-input-icon { color: #2563EB; }

    /* Submit button shine sweep */
    .signup-btn-shine::after {
        content: '';
        position: absolute; top: 0; left: -75%;
        width: 50%; height: 100%;
        background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
        transform: skewX(-20deg);
        transition: left 0.6s ease;
    }
    .signup-btn-shine:hover::after { left: 130%; }

    /* Custom scrollbar (page-wide, matches rest of site) */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 3px; }
    .dark ::-webkit-scrollbar-thumb { background: #475569; }

    @media (prefers-reduced-motion: reduce) {
        .signup-blob, .signup-fade-up { animation: none !important; opacity: 1 !important; transform: none !important; }
    }
</style>

<!-- ============================================================ -->
<!-- SCRIPTS                                                        -->
<!-- ============================================================ -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // ========== TOGGLE PASSWORD VISIBILITY ==========
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');

    if (togglePassword && passwordInput) {
        togglePassword.addEventListener('click', function() {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);

            const icon = this.querySelector('i');
            icon.classList.toggle('fa-eye', type === 'password');
            icon.classList.toggle('fa-eye-slash', type === 'text');
        });
    }

    // ========== AUTO-FOCUS ON NAME ==========
    const nameInput = document.getElementById('name');
    if (nameInput) {
        setTimeout(() => nameInput.focus(), 500);
    }

    // ========== PRE-FILL EMAIL FROM QUERY PARAM ==========
    const urlParams = new URLSearchParams(window.location.search);
    const emailParam = urlParams.get('email');
    const emailInput = document.getElementById('email');
    if (emailParam && emailInput) {
        emailInput.value = emailParam;
    }

    // ========== SHOW LOADING ON SUBMIT ==========
    const form = document.getElementById('signupForm');
    const submitBtn = document.getElementById('signupSubmitBtn');

    if (form && submitBtn) {
        form.addEventListener('submit', function() {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating account...';
            submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
        });
    }
});
</script>
