<style>
    /* Filter button active state */
    .filter-btn.active {
        background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
        color: white !important;
        border-color: transparent !important;
    }
    
    .filter-btn {
        transition: all 0.2s ease;
        cursor: pointer;
    }
    
    .filter-btn:hover:not(.active) {
        background: rgba(37, 99, 235, 0.05);
        border-color: #2563eb;
    }
    
    /* Line clamp */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    /* Course card */
    .course-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    /* Modal */
    #ratingModal {
        animation: modalFadeIn 0.3s ease forwards;
    }
    
    @keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    /* Modal stars */
    .modal-star {
        transition: all 0.2s ease;
        cursor: pointer;
        background: transparent;
        border: none;
        padding: 4px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }
    
    .modal-star:hover {
        transform: scale(1.15);
        background: rgba(250, 204, 21, 0.1);
    }
    
    .modal-star:active {
        transform: scale(0.9);
    }
    
    .modal-star.text-yellow-400 {
        text-shadow: 0 0 30px rgba(250, 204, 21, 0.3);
    }
    
    /* Rate button */
    .rate-course-btn {
        transition: all 0.2s ease;
        cursor: pointer;
    }
    
    .rate-course-btn:hover {
        transform: scale(1.05);
    }
    
    .rate-course-btn:active {
        transform: scale(0.95);
    }
    
    /* Modal response */
    #modalResponse {
        animation: responseSlideDown 0.3s ease forwards;
    }
    
    @keyframes responseSlideDown {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 6px;
    }
    ::-webkit-scrollbar-track {
        background: transparent;
    }
    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    .dark ::-webkit-scrollbar-thumb {
        background: #475569;
    }
    
    /* Modal max-height for small screens */
    @media (max-height: 700px) {
        #modalReview {
            min-height: 60px;
            max-height: 80px;
        }
    }
    
    @media (max-width: 480px) {
        .modal-star {
            width: 32px;
            height: 32px;
            font-size: 1.5rem;
        }
    }

    /* Flash message fade out animation */
    @keyframes fadeOut {
        0% { opacity: 1; transform: translateY(0) scale(1); }
        100% { opacity: 0; transform: translateY(-10px) scale(0.95); }
    }
    
    .flash-message.fade-out {
        animation: fadeOut 0.5s ease-in forwards;
    }
</style>