<!-- ============================================================ -->
<!-- PAGE HEADER                                                   -->
<!-- ============================================================ -->
<section class="privacy-page relative overflow-hidden bg-gradient-to-br from-[#0F172A] via-[#0F172A] to-[#2563EB] py-16 lg:py-20 -mt-6">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#C9A227] rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#2563EB] rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <span class="inline-block px-4 py-1.5 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white/90 mb-4 border border-white/20">
            <i class="fas fa-shield-alt mr-2"></i> Privacy Policy
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-4">
            Your <span class="text-[#C9A227]">Privacy</span> Matters
        </h1>
        <p class="text-lg sm:text-xl text-white/80 max-w-2xl mx-auto">
            We are committed to protecting your personal information and being transparent about how we use it.
        </p>
        <div class="mt-4 inline-flex items-center gap-2 text-sm text-white/60">
            <i class="fas fa-clock"></i>
            <span>Last Updated: <%= lastUpdated %></span>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- HORIZONTAL SCROLLABLE TOC                                     -->
<!-- ============================================================ -->
<section class="privacy-toc-wrapper py-3 bg-white dark:bg-[#0B1120] border-b border-[#E2E8F0] dark:border-[#1E293B] sticky top-16 z-30 backdrop-blur-lg bg-white/95 dark:bg-[#0B1120]/95">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="privacy-toc-container relative">
            <!-- Left Gradient Fade -->
            <div class="privacy-toc-fade-left absolute left-0 top-0 bottom-0 w-8 z-10 pointer-events-none"></div>
            
            <!-- Right Gradient Fade -->
            <div class="privacy-toc-fade-right absolute right-0 top-0 bottom-0 w-8 z-10 pointer-events-none"></div>
            
            <!-- Scrollable Container -->
            <div id="privacyTocScroll" class="privacy-toc-scroll flex gap-2 overflow-x-auto scroll-smooth py-2">
                <% sections.forEach((section, i) => { %>
                    <a href="#privacy-<%= section.id %>" 
                       class="privacy-toc-link flex-shrink-0 flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 whitespace-nowrap
                              bg-[#F8FAFC] dark:bg-[#111827] text-[#64748B] dark:text-[#94A3B8] 
                              hover:bg-[#2563EB]/10 hover:text-[#2563EB] dark:hover:bg-[#2563EB]/20 dark:hover:text-[#2563EB]
                              border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40
                              <%= i === 0 ? 'privacy-toc-active' : '' %>">
                        <i class="fas <%= section.icon %> text-[10px] sm:text-xs"></i>
                        <span class="hidden sm:inline"><%= section.title %></span>
                        <span class="sm:hidden"><%= section.title.split(' ').slice(0, 2).join(' ') %></span>
                    </a>
                <% }) %>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- PRIVACY CONTENT                                               -->
<!-- ============================================================ -->
<section class="privacy-content-wrapper py-12 lg:py-16 bg-[#F8FAFC] dark:bg-[#0B1120]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Last Updated Notice -->
        <div class="privacy-reveal bg-white dark:bg-[#111827] rounded-2xl p-4 mb-8 border border-[#E2E8F0] dark:border-[#1E293B] text-center">
            <p class="text-sm text-[#64748B] dark:text-[#94A3B8]">
                <i class="fas fa-info-circle text-[#2563EB] mr-2"></i>
                This Privacy Policy was last updated on <strong class="text-[#0F172A] dark:text-white"><%= lastUpdated %></strong>
            </p>
        </div>

        <!-- Sections -->
        <div class="privacy-sections space-y-6">
            <% sections.forEach((section, i) => { %>
                <div id="privacy-<%= section.id %>" class="privacy-reveal bg-white dark:bg-[#111827] rounded-2xl p-6 sm:p-8 border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 transition-all duration-300 scroll-mt-32"
                     style="transition-delay: <%= i * 40 %>ms">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-[#2563EB]/10 to-[#C9A227]/10 flex items-center justify-center text-[#2563EB]">
                            <i class="fas <%= section.icon %> text-lg"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h2 class="text-xl sm:text-2xl font-bold text-[#0F172A] dark:text-white mb-4">
                                <%= section.title %>
                            </h2>
                            <div class="privacy-prose text-[#64748B] dark:text-[#94A3B8] leading-relaxed">
                                <%- section.content %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Quick Summary -->
        <div class="privacy-reveal mt-8 bg-gradient-to-br from-[#2563EB]/5 to-[#C9A227]/5 dark:from-[#2563EB]/10 dark:to-[#C9A227]/10 rounded-2xl p-6 sm:p-8 border border-[#2563EB]/20 dark:border-[#2563EB]/30">
            <h3 class="text-lg font-bold text-[#0F172A] dark:text-white mb-4 flex items-center gap-2">
                <i class="fas fa-check-circle text-[#22C55E]"></i>
                Quick Summary
            </h3>
            <div class="grid sm:grid-cols-2 gap-4">
                <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E] flex-shrink-0 mt-0.5">
                        <i class="fas fa-check text-xs"></i>
                    </div>
                    <div>
                        <p class="font-semibold text-[#0F172A] dark:text-white text-sm">We Collect</p>
                        <p class="text-xs text-[#64748B] dark:text-[#94A3B8]">Name, email, course data, usage, payment info</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E] flex-shrink-0 mt-0.5">
                        <i class="fas fa-check text-xs"></i>
                    </div>
                    <div>
                        <p class="font-semibold text-[#0F172A] dark:text-white text-sm">We Use For</p>
                        <p class="text-xs text-[#64748B] dark:text-[#94A3B8]">Course delivery, support, analytics, communication</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E] flex-shrink-0 mt-0.5">
                        <i class="fas fa-check text-xs"></i>
                    </div>
                    <div>
                        <p class="font-semibold text-[#0F172A] dark:text-white text-sm">We Share</p>
                        <p class="text-xs text-[#64748B] dark:text-[#94A3B8]">Only with service providers and legal requirements</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E] flex-shrink-0 mt-0.5">
                        <i class="fas fa-check text-xs"></i>
                    </div>
                    <div>
                        <p class="font-semibold text-[#0F172A] dark:text-white text-sm">Your Rights</p>
                        <p class="text-xs text-[#64748B] dark:text-[#94A3B8]">Access, correct, delete, portability, objection</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact CTA -->
        <div class="privacy-reveal mt-8 text-center">
            <div class="bg-[#0F172A] dark:bg-[#0B1120] rounded-2xl p-8 border border-[#1E293B]">
                <h3 class="text-lg font-bold text-white mb-2">Questions About This Policy?</h3>
                <p class="text-sm text-[#94A3B8] mb-4">
                    Our privacy team is here to help. Contact us anytime.
                </p>
                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="mailto:privacy@InstituteHub.org.in" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#2563EB] text-white font-semibold rounded-xl hover:bg-[#1D4ED8] transition-all duration-300">
                        <i class="fas fa-envelope"></i>
                        Email Privacy Team
                    </a>
                    <a href="/contact" class="inline-flex items-center gap-2 px-6 py-2.5 border-2 border-white/20 text-white font-semibold rounded-xl hover:bg-white/10 transition-all duration-300">
                        <i class="fas fa-headset"></i>
                        Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- SCOPED STYLES — Only affects this page                      -->
<!-- ============================================================ -->
<style>
    /* ===== PRIVACY PAGE SPECIFIC STYLES ===== */
    
    /* Hide scrollbar for TOC */
    .privacy-toc-scroll::-webkit-scrollbar { display: none; }
    .privacy-toc-scroll { -ms-overflow-style: none; scrollbar-width: none; }

    /* Reveal animations */
    .privacy-reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), 
                    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .privacy-reveal.privacy-in-view {
        opacity: 1;
        transform: translateY(0);
    }

    /* Scroll margin for sticky TOC */
    .scroll-mt-32 {
        scroll-margin-top: 8rem;
    }

    /* TOC Link Active State */
    .privacy-toc-link.privacy-toc-active {
        background: rgba(37, 99, 235, 0.1) !important;
        color: #2563EB !important;
        border-color: rgba(37, 99, 235, 0.4) !important;
    }
    .dark .privacy-toc-link.privacy-toc-active {
        background: rgba(37, 99, 235, 0.2) !important;
        color: #2563EB !important;
    }

    /* TOC Scroll Animation */
    #privacyTocScroll {
        scroll-behavior: smooth;
    }

    /* Gradient fades for TOC */
    .privacy-toc-fade-left {
        background-image: linear-gradient(to right, rgba(255,255,255,0.95) 0%, transparent 100%);
    }
    .dark .privacy-toc-fade-left {
        background-image: linear-gradient(to right, rgba(11, 17, 32, 0.95) 0%, transparent 100%);
    }
    .privacy-toc-fade-right {
        background-image: linear-gradient(to left, rgba(255,255,255,0.95) 0%, transparent 100%);
    }
    .dark .privacy-toc-fade-right {
        background-image: linear-gradient(to left, rgba(11, 17, 32, 0.95) 0%, transparent 100%);
    }

    /* Privacy prose styles - scoped to privacy page */
    .privacy-prose ul.privacy-list-disc {
        list-style-type: disc !important;
        padding-left: 1.5rem !important;
    }
    .privacy-prose ul.privacy-list-disc li {
        margin-bottom: 0.5rem !important;
        line-height: 1.6 !important;
    }
    .privacy-prose strong {
        color: #0F172A;
    }
    .dark .privacy-prose strong {
        color: #FFFFFF;
    }
    .privacy-prose a {
        color: #2563EB;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .privacy-prose a:hover {
        color: #3B82F6;
    }

    /* Pulse animation for background blobs */
    @keyframes privacyPulse {
        0%, 100% { opacity: 0.1; }
        50% { opacity: 0.2; }
    }
    .privacy-page .animate-pulse {
        animation: privacyPulse 3s ease-in-out infinite;
    }

    /* Sticky TOC shadow */
    .privacy-toc-wrapper {
        transition: box-shadow 0.3s ease;
    }
    .privacy-toc-wrapper.privacy-scrolled {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    @media (prefers-reduced-motion: reduce) {
        .privacy-reveal {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
        #privacyTocScroll {
            scroll-behavior: auto;
        }
    }

    @media (max-width: 640px) {
        .privacy-toc-wrapper {
            position: relative !important;
            top: 0 !important;
        }
        .scroll-mt-32 {
            scroll-margin-top: 4rem;
        }
        .privacy-prose ul.privacy-list-disc {
            padding-left: 1rem !important;
        }
        .privacy-toc-link {
            padding: 0.5rem 0.75rem !important;
            font-size: 10px !important;
        }
        .privacy-toc-fade-left,
        .privacy-toc-fade-right {
            width: 1.5rem !important;
        }
    }
</style>

<!-- ============================================================ -->
<!-- SCOPED SCRIPTS                                                -->
<!-- ============================================================ -->
<script>
    (function() {
        'use strict';

        // Wait for DOM to be ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        function init() {
            // ========== REVEAL ON SCROLL ==========
            const revealEls = document.querySelectorAll('.privacy-reveal');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('privacy-in-view');
                        observer.unobserve(entry.target);
                    }
                });
            }, { 
                threshold: 0.12,
                rootMargin: '0px 0px -20px 0px'
            });
            revealEls.forEach(el => observer.observe(el));

            // ========== STICKY TOC SHADOW ==========
            const toc = document.querySelector('.privacy-toc-wrapper');
            if (toc) {
                window.addEventListener('scroll', function() {
                    if (window.scrollY > 80) {
                        toc.classList.add('privacy-scrolled');
                    } else {
                        toc.classList.remove('privacy-scrolled');
                    }
                });
            }

            // ========== SMOOTH SCROLL FOR ANCHOR LINKS ==========
            document.querySelectorAll('.privacy-toc-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const href = this.getAttribute('href');
                    const target = document.querySelector(href);
                    if (target) {
                        // Update active state
                        document.querySelectorAll('.privacy-toc-link').forEach(l => l.classList.remove('privacy-toc-active'));
                        this.classList.add('privacy-toc-active');
                        
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // ========== ACTIVE SECTION HIGHLIGHT IN TOC ==========
            const sections = document.querySelectorAll('[id^="privacy-"]');
            const tocLinks = document.querySelectorAll('.privacy-toc-link');
            
            if (tocLinks.length > 0) {
                const observerToc = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const id = entry.target.id;
                            tocLinks.forEach(link => {
                                link.classList.remove('privacy-toc-active');
                                if (link.getAttribute('href') === '#' + id) {
                                    link.classList.add('privacy-toc-active');
                                    
                                    // Scroll the TOC to show the active link
                                    const tocScroll = document.getElementById('privacyTocScroll');
                                    if (tocScroll) {
                                        const linkRect = link.getBoundingClientRect();
                                        const containerRect = tocScroll.getBoundingClientRect();
                                        const scrollLeft = link.offsetLeft - containerRect.width / 2 + linkRect.width / 2;
                                        tocScroll.scrollTo({
                                            left: scrollLeft,
                                            behavior: 'smooth'
                                        });
                                    }
                                }
                            });
                        }
                    });
                }, { 
                    threshold: 0.3,
                    rootMargin: '-100px 0px -100px 0px'
                });
                
                sections.forEach(section => {
                    if (section.id) observerToc.observe(section);
                });
            }

            // ========== KEYBOARD NAVIGATION FOR TOC ==========
            document.addEventListener('keydown', function(e) {
                const tocScroll = document.getElementById('privacyTocScroll');
                if (!tocScroll) return;
                
                // Only if TOC is visible and in viewport
                const rect = tocScroll.getBoundingClientRect();
                if (rect.bottom < 0 || rect.top > window.innerHeight) return;
                
                if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                    e.preventDefault();
                    tocScroll.scrollBy({ left: 200, behavior: 'smooth' });
                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    tocScroll.scrollBy({ left: -200, behavior: 'smooth' });
                }
            });
        }
    })();
</script>