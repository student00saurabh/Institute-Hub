            Join a passionate team dedicated to transforming education and empowering learners worldwide.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm text-white/60">
            <span><i class="fas fa-users text-[#C9A227] mr-1"></i> 50+ Team Members</span>
            <span class="w-px h-4 bg-white/20"></span>
            <span><i class="fas fa-globe text-[#C9A227] mr-1"></i> Remote First</span>
            <span class="w-px h-4 bg-white/20"></span>
            <span><i class="fas fa-rocket text-[#C9A227] mr-1"></i> 12+ Open Positions</span>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- STATS SECTION                                                 -->
<!-- ============================================================ -->
<section class="career-stats-wrapper py-12 lg:py-16 bg-white dark:bg-[#0B1120] border-b border-[#E2E8F0] dark:border-[#1E293B]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <% stats.forEach((stat, i) => { %>
                <div class="career-reveal text-center p-5 rounded-2xl bg-[#F8FAFC] dark:bg-[#111827] border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 transition-all duration-300 hover:-translate-y-1"
                     style="transition-delay: <%= i * 80 %>ms">
                    <p class="text-3xl sm:text-4xl font-extrabold text-[#2563EB]"><%= stat.value %><%= stat.suffix %></p>
                    <p class="mt-1 text-sm text-[#64748B] dark:text-[#94A3B8] font-medium"><%= stat.label %></p>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- WHY JOIN US - BENEFITS                                       -->
<!-- ============================================================ -->
<section class="career-benefits-wrapper py-16 lg:py-20 bg-[#F8FAFC] dark:bg-[#0B1120]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 career-reveal">
            <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">Benefits</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-[#0F172A] dark:text-white">
                Why Join <span class="text-[#2563EB]">InstituteHub</span>?
            </h2>
            <p class="mt-3 text-[#64748B] dark:text-[#94A3B8] max-w-2xl mx-auto">
                We believe in creating an environment where you can grow, innovate, and thrive
            </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% benefits.forEach((benefit, i) => { %>
                <div class="career-reveal group bg-white dark:bg-[#111827] rounded-2xl p-6 border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 hover:shadow-xl hover:shadow-[#2563EB]/10 hover:-translate-y-2 transition-all duration-400"
                     style="transition-delay: <%= i * 60 %>ms">
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#2563EB]/10 to-[#C9A227]/10 flex items-center justify-center text-[#2563EB] group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                        <i class="fas <%= benefit.icon %> text-2xl"></i>
                    </div>
                    <h3 class="mt-4 text-lg font-bold text-[#0F172A] dark:text-white"><%= benefit.title %></h3>
                    <p class="mt-2 text-sm text-[#64748B] dark:text-[#94A3B8] leading-relaxed"><%= benefit.desc %></p>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- OUR VALUES                                                    -->
<!-- ============================================================ -->
<section class="career-values-wrapper py-16 lg:py-20 bg-white dark:bg-[#0F172A]/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 career-reveal">
            <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">Culture</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-[#0F172A] dark:text-white">
                Our <span class="text-[#2563EB]">Core Values</span>
            </h2>
            <p class="mt-3 text-[#64748B] dark:text-[#94A3B8] max-w-2xl mx-auto">
                These values guide everything we do and define who we are as a team
            </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% values.forEach((value, i) => { %>
                <div class="career-reveal group bg-[#F8FAFC] dark:bg-[#111827] rounded-2xl p-6 border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 hover:shadow-lg hover:-translate-y-2 transition-all duration-400 text-center"
                     style="transition-delay: <%= i * 80 %>ms">
                    <div class="w-16 h-16 mx-auto rounded-xl bg-gradient-to-br from-[#2563EB] to-[#1D4ED8] flex items-center justify-center text-white text-2xl shadow-lg shadow-[#2563EB]/25 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                        <i class="fas <%= value.icon %>"></i>
                    </div>
                    <h3 class="mt-4 text-lg font-bold text-[#0F172A] dark:text-white"><%= value.title %></h3>
                    <p class="mt-2 text-sm text-[#64748B] dark:text-[#94A3B8] leading-relaxed"><%= value.desc %></p>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- JOB OPENINGS                                                   -->
<!-- ============================================================ -->
<section class="career-jobs-wrapper py-16 lg:py-20 bg-[#F8FAFC] dark:bg-[#0B1120]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10 career-reveal">
            <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">Opportunities</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-[#0F172A] dark:text-white">
                Open <span class="text-[#2563EB]">Positions</span>
            </h2>
            <p class="mt-3 text-[#64748B] dark:text-[#94A3B8] max-w-2xl mx-auto">
                Find the perfect role that matches your skills and career goals
            </p>
        </div>

        <!-- Filters -->
        <div class="career-filters flex flex-wrap items-center gap-4 mb-8 career-reveal">
            <div class="relative flex-1 min-w-[160px]">
                <i class="fas fa-building absolute left-3.5 top-1/2 -translate-y-1/2 text-[#94A3B8] text-sm"></i>
                <select id="careerDepartmentFilter" class="w-full pl-10 pr-8 py-2.5 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] bg-white dark:bg-[#111827] text-[#0F172A] dark:text-white text-sm appearance-none focus:outline-none focus:ring-2 focus:ring-[#2563EB]/40 focus:border-[#2563EB] transition-all duration-300 cursor-pointer">
                    <% departments.forEach(dept => { %>
                        <option value="<%= dept %>"><%= dept %></option>
                    <% }) %>
                </select>
                <i class="fas fa-chevron-down absolute right-3.5 top-1/2 -translate-y-1/2 text-[#94A3B8] text-xs pointer-events-none"></i>
            </div>

            <div class="relative flex-1 min-w-[140px]">
                <i class="fas fa-map-marker-alt absolute left-3.5 top-1/2 -translate-y-1/2 text-[#94A3B8] text-sm"></i>
                <select id="careerLocationFilter" class="w-full pl-10 pr-8 py-2.5 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] bg-white dark:bg-[#111827] text-[#0F172A] dark:text-white text-sm appearance-none focus:outline-none focus:ring-2 focus:ring-[#2563EB]/40 focus:border-[#2563EB] transition-all duration-300 cursor-pointer">
                    <% locations.forEach(loc => { %>
                        <option value="<%= loc %>"><%= loc %></option>
                    <% }) %>
                </select>
                <i class="fas fa-chevron-down absolute right-3.5 top-1/2 -translate-y-1/2 text-[#94A3B8] text-xs pointer-events-none"></i>
            </div>

            <button id="careerResetFilters" class="px-4 py-2.5 text-sm font-medium text-[#2563EB] border border-[#2563EB]/30 rounded-xl hover:bg-[#2563EB]/10 transition-all duration-300">
                <i class="fas fa-rotate-right mr-1.5"></i> Reset
            </button>

            <span id="careerJobCount" class="text-sm text-[#64748B] dark:text-[#94A3B8] font-medium ml-auto">
                <span id="careerResultsCount"><%= jobs.length %></span> positions
            </span>
        </div>

        <!-- Job Listings -->
        <div id="careerJobGrid" class="space-y-4">
            <% jobs.forEach((job, i) => { %>
                <div class="career-job-card career-reveal bg-white dark:bg-[#111827] rounded-2xl p-6 border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 hover:shadow-lg transition-all duration-300"
                     data-department="<%= job.department %>"
                     data-location="<%= job.location %>"
                     data-title="<%= job.title %>"
                     style="transition-delay: <%= i * 40 %>ms">
                    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <h3 class="text-lg font-bold text-[#0F172A] dark:text-white"><%= job.title %></h3>
                                <span class="px-2.5 py-0.5 bg-[#22C55E]/10 text-[#22C55E] text-[10px] font-bold rounded-full"><%= job.type %></span>
                                <span class="px-2.5 py-0.5 bg-[#2563EB]/10 text-[#2563EB] text-[10px] font-bold rounded-full"><%= job.department %></span>
                            </div>
                            <div class="flex flex-wrap items-center gap-3 mt-2 text-sm text-[#64748B] dark:text-[#94A3B8]">
                                <span><i class="fas fa-map-marker-alt text-[#2563EB] mr-1"></i> <%= job.location %></span>
                                <span class="w-1 h-1 rounded-full bg-[#CBD5E1] dark:bg-[#334155]"></span>
                                <span><i class="fas fa-briefcase text-[#2563EB] mr-1"></i> <%= job.experience %></span>
                                <span class="w-1 h-1 rounded-full bg-[#CBD5E1] dark:bg-[#334155]"></span>
                                <span><i class="fas fa-clock text-[#2563EB] mr-1"></i> <%= job.posted %></span>
                            </div>
                            <p class="mt-2 text-sm text-[#64748B] dark:text-[#94A3B8] line-clamp-2"><%= job.description %></p>
                            <div class="flex flex-wrap gap-1.5 mt-3">
                                <% job.tags.forEach(tag => { %>
                                    <span class="px-2 py-0.5 bg-[#F8FAFC] dark:bg-[#1E293B] text-[#64748B] dark:text-[#94A3B8] text-[10px] font-medium rounded-full border border-[#E2E8F0] dark:border-[#1E293B]">
                                        <%= tag %>
                                    </span>
                                <% }) %>
                            </div>
                        </div>
                        <div class="flex-shrink-0 flex items-center gap-3">
                            <button onclick="toggleJobDetails('<%= job.id %>')" class="text-sm font-medium text-[#2563EB] hover:underline whitespace-nowrap">
                                View Details <i class="fas fa-chevron-down text-xs ml-1"></i>
                            </button>
                            <a href="/careers/apply/<%= job.id %>" class="px-5 py-2.5 bg-[#2563EB] text-white text-sm font-semibold rounded-xl hover:bg-[#1D4ED8] transition-all duration-300 hover:scale-105 shadow-md shadow-[#2563EB]/25 whitespace-nowrap">
                                Apply Now
                            </a>
                        </div>
                    </div>

                    <!-- Job Details Expandable -->
                    <div id="careerJobDetails-<%= job.id %>" class="career-job-details hidden mt-4 pt-4 border-t border-[#E2E8F0] dark:border-[#1E293B]">
                        <h4 class="font-semibold text-[#0F172A] dark:text-white mb-2">Requirements</h4>
                        <ul class="list-disc pl-5 space-y-1 text-sm text-[#64748B] dark:text-[#94A3B8]">
                            <% job.requirements.forEach(req => { %>
                                <li><%= req %></li>
                            <% }) %>
                        </ul>
                        <div class="mt-4 flex items-center gap-3">
                            <a href="/careers/apply/<%= job.id %>" class="px-6 py-2.5 bg-[#2563EB] text-white text-sm font-semibold rounded-xl hover:bg-[#1D4ED8] transition-all duration-300">
                                Apply Now
                            </a>
                            <a href="#" class="text-sm text-[#64748B] dark:text-[#94A3B8] hover:text-[#2563EB] transition-colors">
                                <i class="fas fa-share-alt mr-1"></i> Share
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- No Results -->
        <div id="careerNoResults" class="hidden text-center py-16">
            <div class="w-24 h-24 mx-auto rounded-full bg-[#2563EB]/10 flex items-center justify-center text-[#2563EB] text-4xl mb-4">
                <i class="fas fa-search"></i>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] dark:text-white">No positions found</h3>
            <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-2">Try adjusting your filters</p>
            <button onclick="resetCareerFilters()" class="mt-4 px-6 py-2.5 bg-[#2563EB] text-white rounded-xl hover:bg-[#1D4ED8] transition-all duration-300">
                Clear all filters
            </button>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- MEET THE TEAM                                                 -->
<!-- ============================================================ -->
<section class="career-team-wrapper py-16 lg:py-20 bg-white dark:bg-[#0F172A]/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 career-reveal">
            <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">Team</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-[#0F172A] dark:text-white">
                Meet Our <span class="text-[#2563EB]">Leaders</span>
            </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
            <% teamMembers.forEach((member, i) => { %>
                <div class="career-reveal group bg-[#F8FAFC] dark:bg-[#111827] rounded-2xl p-6 border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 hover:shadow-xl transition-all duration-400 text-center"
                     style="transition-delay: <%= i * 80 %>ms">
                    <div class="w-28 h-28 mx-auto rounded-full overflow-hidden border-4 border-[#2563EB] group-hover:scale-105 transition-all duration-300">
                        <img src="<%= member.img %>" alt="<%= member.name %>" class="w-full h-full object-cover">
                    </div>
                    <h3 class="mt-4 text-lg font-bold text-[#0F172A] dark:text-white"><%= member.name %></h3>
                    <p class="text-sm font-semibold text-[#2563EB]"><%= member.role %></p>
                    <p class="mt-2 text-sm text-[#64748B] dark:text-[#94A3B8] italic">"<%= member.quote %>"</p>
                </div>
            <% }) %>
        </div>
    </div>
</section>


