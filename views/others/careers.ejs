<!-- ============================================================ -->
<!-- PAGE HEADER                                                   -->
<!-- ============================================================ -->
<section class="career-page relative overflow-hidden bg-gradient-to-br from-[#0F172A] via-[#0F172A] to-[#2563EB] py-20 lg:py-28 -mt-6">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#C9A227] rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#2563EB] rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#3B82F6] rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <span class="inline-block px-4 py-1.5 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white/90 mb-4 border border-white/20">
            <i class="fas fa-briefcase mr-2"></i> Join Our Team
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-4">
            Build Your <span class="text-[#C9A227]">Career</span> at InstituteHub
        </h1>
