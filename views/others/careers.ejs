<style>
    /* ===== CAREER PAGE SPECIFIC STYLES ===== */
    
    /* Reveal animations */
    .career-reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), 
                    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .career-reveal.career-in-view {
        opacity: 1;
        transform: translateY(0);
    }

    /* Pulse animation for background blobs */
    @keyframes careerPulse {
        0%, 100% { opacity: 0.1; }
        50% { opacity: 0.2; }
    }
    .career-page .animate-pulse {
        animation: careerPulse 3s ease-in-out infinite;
    }

    /* Line clamp for job descriptions */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Job details expand animation */
    .career-job-details {
        animation: careerSlideDown 0.3s ease forwards;
    }

    @keyframes careerSlideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Filter select custom styling */
    .career-filters select {
        cursor: pointer;
    }
    .career-filters select option {
        padding: 8px;
    }

    @media (prefers-reduced-motion: reduce) {
        .career-reveal {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }

    @media (max-width: 640px) {
        .career-filters {
            flex-direction: column;
        }
        .career-filters select {
            width: 100% !important;
        }
        .career-filters .ml-auto {
            margin-left: 0 !important;
            width: 100%;
            text-align: center;
        }
    }
</style>

