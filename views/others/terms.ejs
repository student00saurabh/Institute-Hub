                <% sections.forEach((section, i) => { %>
                    <a href="#terms-<%= section.id %>" 
                       class="terms-toc-link flex-shrink-0 flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 whitespace-nowrap
