<section class="terms-toc-wrapper py-3 bg-white dark:bg-[#0B1120] border-b border-[#E2E8F0] dark:border-[#1E293B] sticky top-16 z-30 backdrop-blur-lg bg-white/95 dark:bg-[#0B1120]/95">
