                              hover:bg-[#2563EB]/10 hover:text-[#2563EB] dark:hover:bg-[#2563EB]/20 dark:hover:text-[#2563EB]
                              border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40
                              <%= i === 0 ? 'terms-toc-active' : '' %>">
                        <i class="fas <%= section.icon %> text-[10px] sm:text-xs"></i>
                        <span class="hidden sm:inline"><%= section.title %></span>
                        <span class="sm:hidden"><%= section.title.split(' ').slice(0, 2).join(' ') %></span>
                    </a>
                <% }) %>
            </div>
        </div>
    </div>
</section>

