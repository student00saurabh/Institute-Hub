<!-- SCOPED STYLES — Only affects this page                      -->
<!-- ============================================================ -->
<style>
    /* ===== TERMS PAGE SPECIFIC STYLES ===== */
    
    /* Hide scrollbar for TOC */
    .terms-toc-scroll::-webkit-scrollbar { display: none; }
    .terms-toc-scroll { -ms-overflow-style: none; scrollbar-width: none; }

    /* Reveal animations */
    .terms-reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), 
                    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .terms-reveal.terms-in-view {
        opacity: 1;
        transform: translateY(0);
    }

    /* Scroll margin for sticky TOC */
    .scroll-mt-32 {
        scroll-margin-top: 8rem;
    }

    /* TOC Link Active State */
    .terms-toc-link.terms-toc-active {
        background: rgba(37, 99, 235, 0.1) !important;
        color: #2563EB !important;
        border-color: rgba(37, 99, 235, 0.4) !important;
    }
    .dark .terms-toc-link.terms-toc-active {
        background: rgba(37, 99, 235, 0.2) !important;
        color: #2563EB !important;
    }

    /* TOC Scroll Animation */
    #termsTocScroll {
        scroll-behavior: smooth;
    }

    /* Gradient fades for TOC */
    .terms-toc-fade-left {
        background-image: linear-gradient(to right, rgba(255,255,255,0.95) 0%, transparent 100%);
    }
    .dark .terms-toc-fade-left {
        background-image: linear-gradient(to right, rgba(11, 17, 32, 0.95) 0%, transparent 100%);
    }
    .terms-toc-fade-right {
        background-image: linear-gradient(to left, rgba(255,255,255,0.95) 0%, transparent 100%);
    }
    .dark .terms-toc-fade-right {
        background-image: linear-gradient(to left, rgba(11, 17, 32, 0.95) 0%, transparent 100%);
    }

    /* Terms prose styles - scoped to terms page */
    .terms-prose ul.terms-list-disc {
        list-style-type: disc !important;
        padding-left: 1.5rem !important;
    }
    .terms-prose ul.terms-list-disc li {
        margin-bottom: 0.5rem !important;
        line-height: 1.6 !important;
    }
    .terms-prose strong {
        color: #0F172A;
    }
    .dark .terms-prose strong {
        color: #FFFFFF;
    }
    .terms-prose a {
        color: #2563EB;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .terms-prose a:hover {
        color: #3B82F6;
    }

    /* Pulse animation for background blobs */
    @keyframes termsPulse {
        0%, 100% { opacity: 0.1; }
        50% { opacity: 0.2; }
    }
    .terms-page .animate-pulse {
        animation: termsPulse 3s ease-in-out infinite;
    }

    /* Sticky TOC shadow */
    .terms-toc-wrapper {
        transition: box-shadow 0.3s ease;
    }
    .terms-toc-wrapper.terms-scrolled {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    @media (prefers-reduced-motion: reduce) {
        .terms-reveal {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
        #termsTocScroll {
            scroll-behavior: auto;
        }
    }

    @media (max-width: 640px) {
        .terms-toc-wrapper {
            position: relative !important;
            top: 0 !important;
        }
        .scroll-mt-32 {
            scroll-margin-top: 4rem;
        }
        .terms-prose ul.terms-list-disc {
            padding-left: 1rem !important;
        }
        .terms-toc-link {
            padding: 0.5rem 0.75rem !important;
            font-size: 10px !important;
        }
        .terms-toc-fade-left,
        .terms-toc-fade-right {
            width: 1.5rem !important;
        }
    }
</style>

<!-- ============================================================ -->
<!-- SCOPED SCRIPTS                                                -->
<!-- ============================================================ -->
<script>
    (function() {
        'use strict';

        // Wait for DOM to be ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        function init() {
            // ========== REVEAL ON SCROLL ==========
            const revealEls = document.querySelectorAll('.terms-reveal');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('terms-in-view');
                        observer.unobserve(entry.target);
                    }
                });
            }, { 
                threshold: 0.12,
                rootMargin: '0px 0px -20px 0px'
            });
            revealEls.forEach(el => observer.observe(el));

            // ========== STICKY TOC SHADOW ==========
            const toc = document.querySelector('.terms-toc-wrapper');
            if (toc) {
                window.addEventListener('scroll', function() {
                    if (window.scrollY > 80) {
                        toc.classList.add('terms-scrolled');
                    } else {
                        toc.classList.remove('terms-scrolled');
                    }
                });
            }

            // ========== SMOOTH SCROLL FOR ANCHOR LINKS ==========
            document.querySelectorAll('.terms-toc-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const href = this.getAttribute('href');
                    const target = document.querySelector(href);
                    if (target) {
                        // Update active state
                        document.querySelectorAll('.terms-toc-link').forEach(l => l.classList.remove('terms-toc-active'));
                        this.classList.add('terms-toc-active');
                        
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // ========== ACTIVE SECTION HIGHLIGHT IN TOC ==========
            const sections = document.querySelectorAll('[id^="terms-"]');
            const tocLinks = document.querySelectorAll('.terms-toc-link');
            
            if (tocLinks.length > 0) {
                const observerToc = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const id = entry.target.id;
                            tocLinks.forEach(link => {
                                link.classList.remove('terms-toc-active');
                                if (link.getAttribute('href') === '#' + id) {
                                    link.classList.add('terms-toc-active');
                                    
                                    // Scroll the TOC to show the active link
                                    const tocScroll = document.getElementById('termsTocScroll');
                                    if (tocScroll) {
                                        const linkRect = link.getBoundingClientRect();
                                        const containerRect = tocScroll.getBoundingClientRect();
                                        const scrollLeft = link.offsetLeft - containerRect.width / 2 + linkRect.width / 2;
                                        tocScroll.scrollTo({
                                            left: scrollLeft,
                                            behavior: 'smooth'
                                        });
                                    }
                                }
                            });
                        }
                    });
                }, { 
                    threshold: 0.3,
                    rootMargin: '-100px 0px -100px 0px'
                });
                
                sections.forEach(section => {
                    if (section.id) observerToc.observe(section);
                });
            }

            // ========== KEYBOARD NAVIGATION FOR TOC ==========
            document.addEventListener('keydown', function(e) {
                const tocScroll = document.getElementById('termsTocScroll');
                if (!tocScroll) return;
                
                // Only if TOC is visible and in viewport
                const rect = tocScroll.getBoundingClientRect();
                if (rect.bottom < 0 || rect.top > window.innerHeight) return;
                
                if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                    e.preventDefault();
                    tocScroll.scrollBy({ left: 200, behavior: 'smooth' });
                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    tocScroll.scrollBy({ left: -200, behavior: 'smooth' });
                }
            });
        }
    })();
</script>