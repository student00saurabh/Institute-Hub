<% layout("/layouts/boilerplate") %>

<section class="py-12 bg-gradient-to-br from-blue-50/50 via-white to-indigo-50/50 dark:from-gray-900 dark:via-gray-800/50 dark:to-gray-900 min-h-[80vh] flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
            <!-- Header -->
            <div class="px-6 py-5 bg-gradient-to-r from-blue-600 to-indigo-600">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center text-white text-2xl">
                        <i class="fas fa-star"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white">Share Your Experience</h2>
                        <p class="text-blue-100 text-sm">Help others make informed decisions</p>
                    </div>
                </div>
            </div>

            <!-- Form -->
            <form id="reviewForm" class="p-6 space-y-5">
                <!-- ✅ This is where token is used -->
                <input type="hidden" id="reviewToken" value="<%= token %>">
                
                <!-- User Info -->
                <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4 border border-blue-200 dark:border-blue-800">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-envelope text-blue-500 dark:text-blue-400"></i>
                        <div>
                            <p class="text-xs text-gray-500 dark:text-gray-400">Reviewing as</p>
                            <p class="font-medium text-gray-800 dark:text-gray-200"><%= review.email %></p>
                        </div>
                    </div>
                </div>

                <!-- Name (readonly) -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                        Your Name
                    </label>
                    <input type="text" 
                           id="reviewName" 
                           value="<%= review.name %>"
                           readonly
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 cursor-not-allowed">
                    <p class="text-xs text-gray-400 mt-1"><i class="fas fa-lock mr-1"></i> Name is verified</p>
                </div>

                <!-- Rating -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Rating <span class="text-red-500">*</span>
                    </label>
                    <div class="flex items-center gap-2" id="ratingStars">
                        <button type="button" class="rating-star text-3xl text-gray-300 hover:text-yellow-400 transition-all" data-value="1">
                            <i class="far fa-star"></i>
                        </button>
                        <button type="button" class="rating-star text-3xl text-gray-300 hover:text-yellow-400 transition-all" data-value="2">
                            <i class="far fa-star"></i>
                        </button>
                        <button type="button" class="rating-star text-3xl text-gray-300 hover:text-yellow-400 transition-all" data-value="3">
                            <i class="far fa-star"></i>
                        </button>
                        <button type="button" class="rating-star text-3xl text-gray-300 hover:text-yellow-400 transition-all" data-value="4">
                            <i class="far fa-star"></i>
                        </button>
                        <button type="button" class="rating-star text-3xl text-gray-300 hover:text-yellow-400 transition-all" data-value="5">
                            <i class="far fa-star"></i>
                        </button>
                        <span id="ratingLabel" class="ml-2 text-sm font-medium text-gray-500 dark:text-gray-400">Select rating</span>
                    </div>
                    <input type="hidden" id="reviewRating" value="0">
                </div>

                <!-- Message -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                        Your Review <span class="text-red-500">*</span>
                    </label>
                    <textarea id="reviewMessage" 
                              rows="4"
                              placeholder="Share your detailed experience with CyberKavach..."
                              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all resize-none"></textarea>
                    <p class="text-xs text-gray-400 mt-1"><span id="messageCount">0</span>/1000 characters</p>
                </div>

                <!-- Response -->
                <div id="formResponse" class="hidden p-4 rounded-xl"></div>

                <!-- Submit -->
                <button type="submit" 
                        id="submitReview"
                        class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-xl transition-all duration-200 shadow-md hover:shadow-lg transform hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2">
                    <i class="fas fa-paper-plane"></i>
                    Submit Review
                </button>

                <p class="text-xs text-center text-gray-400 dark:text-gray-500">
                    <i class="fas fa-shield-alt mr-1"></i>
                    Your review will be reviewed by our team before being published.
                </p>
            </form>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('reviewForm');
    const stars = document.querySelectorAll('.rating-star');
    const ratingInput = document.getElementById('reviewRating');
    const ratingLabel = document.getElementById('ratingLabel');
    const messageInput = document.getElementById('reviewMessage');
    const messageCount = document.getElementById('messageCount');
    const submitBtn = document.getElementById('submitReview');
    const responseDiv = document.getElementById('formResponse');

    let selectedRating = 0;

    stars.forEach(star => {
        star.addEventListener('click', function() {
            const value = parseInt(this.dataset.value);
            selectedRating = value;
            ratingInput.value = value;
            
            stars.forEach(s => {
                const val = parseInt(s.dataset.value);
                if (val <= value) {
                    s.innerHTML = '<i class="fas fa-star"></i>';
                    s.classList.remove('text-gray-300');
                    s.classList.add('text-yellow-400');
                } else {
                    s.innerHTML = '<i class="far fa-star"></i>';
                    s.classList.remove('text-yellow-400');
                    s.classList.add('text-gray-300');
                }
            });

            const labels = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
            ratingLabel.textContent = labels[value] || 'Select rating';
        });
    });

    messageInput.addEventListener('input', function() {
        const count = this.value.length;
        messageCount.textContent = count;
        if (count > 1000) {
            this.value = this.value.substring(0, 1000);
            messageCount.textContent = 1000;
        }
    });

    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const token = document.getElementById('reviewToken').value;
        const rating = parseInt(ratingInput.value);
        const message = messageInput.value.trim();

        if (!rating || rating < 1) {
            showResponse('Please select a rating.', 'error');
            return;
        }

        if (!message || message.length < 10) {
            showResponse('Please provide a detailed review (min 10 characters).', 'error');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
        responseDiv.classList.add('hidden');

        try {
            const response = await fetch(`/review/${token}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ rating, message })
            });

            const data = await response.json();

            if (data.success) {
                showResponse(data.message, 'success');
                form.querySelectorAll('input, textarea, button').forEach(el => {
                    if (el.tagName !== 'BUTTON') el.disabled = true;
                });
                stars.forEach(s => s.style.pointerEvents = 'none');
                submitBtn.innerHTML = '<i class="fas fa-check-circle"></i> Thank You!';
                submitBtn.classList.remove('bg-gradient-to-r', 'from-blue-600', 'to-indigo-600');
                submitBtn.classList.add('bg-green-600');
                
                setTimeout(() => {
                    window.location.href = '/';
                }, 3000);
            } else {
                showResponse(data.message || 'Failed to submit review.', 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Review';
            }
        } catch (error) {
            console.error('Review submission error:', error);
            showResponse('Unable to submit your review. Please try again.', 'error');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Review';
        }
    });

    function showResponse(message, type) {
        responseDiv.classList.remove('hidden', 'text-green-700', 'text-red-700', 'bg-green-50', 'bg-red-50', 
                                    'dark:text-green-400', 'dark:text-red-400', 
                                    'dark:bg-green-900/20', 'dark:bg-red-900/20');
        responseDiv.textContent = message;
        
        if (type === 'success') {
            responseDiv.classList.add('text-green-700', 'bg-green-50', 'dark:text-green-400', 'dark:bg-green-900/20');
        } else {
            responseDiv.classList.add('text-red-700', 'bg-red-50', 'dark:text-red-400', 'dark:bg-red-900/20');
        }
        
        responseDiv.classList.remove('hidden');
    }
});
</script>