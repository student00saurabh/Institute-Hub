<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#C9A227] to-[#B8901E] flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                        </div>
                        Create New Blog
                    </h1>
                    <p class="mt-1 text-gray-600 dark:text-gray-400">
                        Share your knowledge and insights with the community
                    </p>
                </div>
                <div class="mt-4 md:mt-0 flex gap-3">
                    <a href="/blogs" 
                       class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                        <i class="fas fa-arrow-left mr-2"></i> Back to Blogs
                    </a>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6 sm:p-8" data-aos="fade-up" data-aos-duration="600">
            <form 
                action="/blogs" 
                method="POST" 
                class="space-y-6"
                enctype="multipart/form-data"
                id="blogForm"
            >
                <!-- Title -->
                <div>
                    <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Title <span class="text-red-500">*</span>
                    </label>
                    <input
                        type="text"
                        name="title"
                        id="title"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200"
                        placeholder="Enter a compelling blog title..."
                        required
                    >
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i> A clear and engaging title that captures attention
                    </p>
                </div>

                <!-- Category -->
                <div>
                    <label for="category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Category <span class="text-red-500">*</span>
                    </label>
                    <select 
                        name="category" 
                        id="category" 
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none cursor-pointer"
                        required
                    >
                        <option value="">Select a category</option>
                        
                        <!-- 📚 Academic & Education -->
                        <optgroup label="📚 Academic & Education">
                            <option value="School Education">School Education</option>
                            <option value="Higher Education">Higher Education (College/University)</option>
                            <option value="Distance Learning">Distance Learning</option>
                            <option value="Online Education">Online Education</option>
                            <option value="Educational Technology">Educational Technology (EdTech)</option>
                            <option value="Teaching Methods">Teaching Methods & Pedagogy</option>
                            <option value="Curriculum Development">Curriculum Development</option>
                            <option value="Education Policy">Education Policy & Reform</option>
                            <option value="Special Education">Special Education</option>
                            <option value="Early Childhood Education">Early Childhood Education</option>
                        </optgroup>

                        <!-- 🎓 Competitive & Entrance Exams -->
                        <optgroup label="🎓 Competitive & Entrance Exams">
                            <option value="UPSC">UPSC Civil Services</option>
                            <option value="SSC">SSC (Staff Selection Commission)</option>
                            <option value="Banking Exams">Banking Exams (IBPS, SBI, RBI)</option>
                            <option value="Railway Exams">Railway Exams (RRB)</option>
                            <option value="State PSC">State PSC Exams</option>
                            <option value="Defense Exams">Defense Exams (NDA, CDS, AFCAT)</option>
                            <option value="JEE">JEE (Main & Advanced)</option>
                            <option value="NEET">NEET Medical Entrance</option>
                            <option value="GATE">GATE Engineering Entrance</option>
                            <option value="CAT">CAT / MBA Entrance</option>
                            <option value="CLAT">CLAT Law Entrance</option>
                            <option value="NTA Exams">NTA Exams (UGC NET, etc.)</option>
                            <option value="Other Entrance">Other Entrance Exams</option>
                        </optgroup>

                        <!-- 💼 Career & Jobs -->
                        <optgroup label="💼 Career & Jobs">
                            <option value="Job Opportunities">Job Opportunities</option>
                            <option value="Career Advice">Career Advice & Guidance</option>
                            <option value="Interview Tips">Interview Preparation</option>
                            <option value="Resume Writing">Resume & CV Writing</option>
                            <option value="Government Jobs">Government Jobs</option>
                            <option value="Private Jobs">Private Sector Jobs</option>
                            <option value="Internships">Internships & Training</option>
                            <option value="Freelancing">Freelancing & Remote Work</option>
                            <option value="Entrepreneurship">Entrepreneurship & Startups</option>
                            <option value="Career Change">Career Change & Transition</option>
                        </optgroup>

                        <!-- 🏗️ Engineering & Technology -->
                        <optgroup label="🏗️ Engineering & Technology">
                            <option value="Computer Science">Computer Science & IT</option>
                            <option value="Civil Engineering">Civil Engineering</option>
                            <option value="Mechanical Engineering">Mechanical Engineering</option>
                            <option value="Electrical Engineering">Electrical Engineering</option>
                            <option value="Electronics Engineering">Electronics & Communication</option>
                            <option value="Chemical Engineering">Chemical Engineering</option>
                            <option value="Aerospace Engineering">Aerospace Engineering</option>
                            <option value="Biotechnology">Biotechnology</option>
                            <option value="Environmental Engineering">Environmental Engineering</option>
                            <option value="Artificial Intelligence">Artificial Intelligence & ML</option>
                            <option value="Data Science">Data Science & Analytics</option>
                            <option value="Cybersecurity">Cybersecurity</option>
                            <option value="Cloud Computing">Cloud Computing</option>
                            <option value="DevOps">DevOps</option>
                        </optgroup>

                        <!-- 🏥 Health & Medical -->
                        <optgroup label="🏥 Health & Medical">
                            <option value="Medical Education">Medical Education (MBBS, BDS)</option>
                            <option value="Nursing">Nursing</option>
                            <option value="Pharmacy">Pharmacy</option>
                            <option value="Public Health">Public Health</option>
                            <option value="Healthcare Management">Healthcare Management</option>
                            <option value="Ayurveda">Ayurveda & Alternative Medicine</option>
                            <option value="Veterinary">Veterinary Science</option>
                            <option value="Health & Wellness">Health & Wellness</option>
                            <option value="Medical Research">Medical Research</option>
                        </optgroup>

                        <!-- 📊 Business & Management -->
                        <optgroup label="📊 Business & Management">
                            <option value="MBA">MBA & Business Management</option>
                            <option value="Finance">Finance & Accounting</option>
                            <option value="Marketing">Marketing & Sales</option>
                            <option value="Human Resources">Human Resources (HR)</option>
                            <option value="Operations">Operations Management</option>
                            <option value="Business Analytics">Business Analytics</option>
                            <option value="International Business">International Business</option>
                            <option value="Entrepreneurship">Entrepreneurship</option>
                            <option value="Leadership">Leadership & Management</option>
                        </optgroup>

                        <!-- 🎨 Arts & Humanities -->
                        <optgroup label="🎨 Arts & Humanities">
                            <option value="Fine Arts">Fine Arts</option>
                            <option value="Performing Arts">Performing Arts</option>
                            <option value="Literature">Literature & Writing</option>
                            <option value="History">History</option>
                            <option value="Philosophy">Philosophy</option>
                            <option value="Psychology">Psychology</option>
                            <option value="Sociology">Sociology</option>
                            <option value="Political Science">Political Science</option>
                            <option value="Geography">Geography</option>
                            <option value="Languages">Languages & Linguistics</option>
                        </optgroup>

                        <!-- 📰 News & Current Affairs -->
                        <optgroup label="📰 News & Current Affairs">
                            <option value="Latest News">Latest News</option>
                            <option value="Education News">Education News</option>
                            <option value="Exam News">Exam Updates & Notifications</option>
                            <option value="Job News">Job News & Vacancies</option>
                            <option value="Technology News">Technology News</option>
                            <option value="Health News">Health News</option>
                            <option value="Business News">Business & Economy News</option>
                            <option value="World News">World News</option>
                            <option value="Sports News">Sports News</option>
                            <option value="Entertainment News">Entertainment News</option>
                        </optgroup>

                        <!-- 📝 Teaching & Education Profession -->
                        <optgroup label="📝 Teaching & Education Profession">
                            <option value="Teaching Tips">Teaching Tips & Strategies</option>
                            <option value="Classroom Management">Classroom Management</option>
                            <option value="Lesson Planning">Lesson Planning</option>
                            <option value="Teacher Training">Teacher Training & Development</option>
                            <option value="Teaching Exams">Teaching Exams (CTET, UGC NET)</option>
                            <option value="Higher Education Teaching">Higher Education Teaching</option>
                            <option value="Online Teaching">Online Teaching</option>
                            <option value="Educational Resources">Educational Resources & Materials</option>
                        </optgroup>

                        <!-- 🧪 Science & Research -->
                        <optgroup label="🧪 Science & Research">
                            <option value="Physics">Physics</option>
                            <option value="Chemistry">Chemistry</option>
                            <option value="Biology">Biology</option>
                            <option value="Mathematics">Mathematics</option>
                            <option value="Astronomy">Astronomy & Space Science</option>
                            <option value="Environmental Science">Environmental Science</option>
                            <option value="Scientific Research">Scientific Research</option>
                            <option value="Innovation">Innovation & Discovery</option>
                        </optgroup>

                        <!-- 🌐 General Interest -->
                        <optgroup label="🌐 General Interest">
                            <option value="Lifestyle">Lifestyle & Personal Development</option>
                            <option value="Travel">Travel & Exploration</option>
                            <option value="Food">Food & Culinary</option>
                            <option value="Culture">Culture & Heritage</option>
                            <option value="Books">Books & Reading</option>
                            <option value="Movies">Movies & Entertainment</option>
                            <option value="Technology">Technology & Gadgets</option>
                            <option value="Environment">Environment & Sustainability</option>
                            <option value="Social Issues">Social Issues & Awareness</option>
                            <option value="Opinion">Opinion & Editorial</option>
                        </optgroup>

                        <!-- 📝 Other -->
                        <optgroup label="📝 Other">
                            <option value="Others">Others</option>
                        </optgroup>
                    </select>
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-tag mr-1"></i> Choose the most relevant category for your blog
                    </p>
                </div>

                <!-- Short Description -->
                <div>
                    <label for="shortdescription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Short Description <span class="text-red-500">*</span>
                    </label>
                    <textarea
                        name="shortdescription"
                        id="shortdescription"
                        rows="3"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"
                        placeholder="A brief summary of your blog (appears in blog listings)..."
                        required
                    ></textarea>
                    <div class="flex justify-between items-center mt-1.5">
                        <p class="text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-text-height mr-1"></i> 150-200 characters recommended
                        </p>
                        <span id="descCounter" class="text-xs font-medium text-gray-500 dark:text-gray-400">0 characters</span>
                    </div>
                </div>

                <!-- Tags -->
                <div>
                    <label for="tags" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        <i class="fas fa-tags mr-2 text-[#C9A227]"></i> Tags
                        <span class="text-gray-500 dark:text-gray-400 font-normal">(Optional)</span>
                    </label>
                    <input
                        type="text"
                        name="tags"
                        id="tags"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200"
                        placeholder="Enter tags separated by commas (e.g., education, exam, career, technology)"
                    >
                    <div class="flex justify-between items-center mt-1.5">
                        <p class="text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Separate tags with commas. 2-10 tags recommended.
                        </p>
                        <span id="tagCounter" class="text-xs font-medium text-gray-500 dark:text-gray-400">0 tags</span>
                    </div>
                </div>

                <!-- Image Upload -->
                <div class="space-y-4">
                    <div>
                        <label for="image" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            <i class="fas fa-image mr-2 text-[#C9A227]"></i> Featured Image
                            <span class="text-gray-500 dark:text-gray-400 font-normal">(Optional)</span>
                        </label>
                        <div class="relative border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl p-6 hover:border-[#C9A227] dark:hover:border-[#C9A227] transition-colors bg-gray-50 dark:bg-gray-700/30">
                            <input type="file" 
                                   id="image" 
                                   name="image" 
                                   accept="image/*"
                                   class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                                   onchange="previewImage(this)">
                            <div class="text-center">
                                <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <p class="text-sm text-gray-600 dark:text-gray-400">
                                    <span class="font-medium text-[#C9A227] dark:text-[#C9A227]">Click to upload</span> or drag and drop
                                </p>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                    PNG, JPG, GIF up to 5MB (Recommended: 1200×630px)
                                </p>
                            </div>
                        </div>
                        <div id="imagePreviewContainer" class="mt-3 hidden">
                            <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-4 border border-green-200 dark:border-green-800">
                                <div class="flex items-center gap-4 flex-wrap sm:flex-nowrap">
                                    <div class="w-24 h-24 rounded-lg overflow-hidden border border-green-300 dark:border-green-700 bg-white dark:bg-gray-800 flex-shrink-0">
                                        <img id="imagePreview" src="#" alt="Preview" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm text-green-800 dark:text-green-300">
                                            <strong id="fileName"></strong><br>
                                            <span id="fileSize"></span>
                                        </p>
                                        <p class="text-xs text-green-600 dark:text-green-400 mt-1">
                                            <i class="fas fa-check-circle mr-1"></i> This image will appear as the featured image for your blog.
                                        </p>
                                    </div>
                                    <button type="button" onclick="removePreview()" class="text-green-700 dark:text-green-400 hover:text-green-900 dark:hover:text-green-300">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Image Alt Text -->
                    <div>
                        <label for="imageTitle" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            <i class="fas fa-font mr-2 text-[#C9A227]"></i> Image Alt Text
                            <span class="text-gray-500 dark:text-gray-400 font-normal">(Optional)</span>
                        </label>
                        <input
                            type="text"
                            name="imageTitle"
                            id="imageTitle"
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200"
                            placeholder="Describe the image for SEO and accessibility..."
                        >
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Helps with search engines and screen readers.
                        </p>
                    </div>
                </div>

                <!-- Keywords -->
                <div>
                    <label for="Keywords" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        <i class="fas fa-tags mr-2 text-[#C9A227]"></i> Keywords <span class="text-red-500">*</span>
                    </label>
                    <textarea
                        name="Keywords"
                        id="Keywords"
                        rows="2"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"
                        placeholder="Enter keywords separated by commas (e.g., education, exam preparation, career guidance)"
                        required
                    ></textarea>
                    <div class="flex justify-between items-center mt-1.5">
                        <p class="text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Separate keywords with commas. 2-10 keywords recommended.
                        </p>
                        <span id="keywordCounter" class="text-xs font-medium text-gray-500 dark:text-gray-400">0 keywords</span>
                    </div>
                </div>

                <!-- Content Editor -->
                <div>
                    <label for="content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        <i class="fas fa-file-alt mr-2 text-[#C9A227]"></i> Content <span class="text-red-500">*</span>
                    </label>
                    <textarea
                        name="content"
                        id="content"
                        rows="12"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none font-mono text-sm"
                        placeholder="Write your full blog content here... Use HTML formatting"
                        required
                    ></textarea>
                    
                    <!-- Formatting Tools -->
                    <div class="mt-3 bg-gray-50 dark:bg-gray-700/30 rounded-lg p-3 border border-gray-200 dark:border-gray-700">
                        <h5 class="text-xs font-medium text-gray-700 dark:text-gray-300 mb-2 flex items-center">
                            <i class="fas fa-code mr-2 text-[#C9A227]"></i> Formatting Tips:
                        </h5>
                        <div class="flex flex-wrap gap-2 text-xs">
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;h2&gt;Heading&lt;/h2&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;h3&gt;Subheading&lt;/h3&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;b&gt;Bold&lt;/b&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;i&gt;Italic&lt;/i&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;a href="url"&gt;Link&lt;/a&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;ul&gt;&lt;li&gt;List&lt;/li&gt;&lt;/ul&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;ol&gt;&lt;li&gt;Ordered List&lt;/li&gt;&lt;/ol&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;img src="url" alt="text"&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;blockquote&gt;Quote&lt;/blockquote&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;pre&gt;Code block&lt;/pre&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;hr&gt;</code> (Horizontal rule)</span>
                        </div>
                    </div>
                    
                    <div class="flex justify-between items-center mt-1.5">
                        <p class="text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Use HTML tags for formatting your content
                        </p>
                        <span id="contentCounter" class="text-xs font-medium text-gray-500 dark:text-gray-400">0 words</span>
                    </div>
                </div>

                <!-- External Links -->
                <div>
                    <label for="externalLinks" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        <i class="fas fa-link mr-2 text-[#C9A227]"></i> External Links
                        <span class="text-gray-500 dark:text-gray-400 font-normal">(Optional)</span>
                    </label>
                    <textarea
                        name="externalLinks"
                        id="externalLinks"
                        rows="2"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"
                        placeholder="Enter external links (one per line) for references and further reading"
                    ></textarea>
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i> Add reference links, sources, or further reading materials
                    </p>
                </div>

                <!-- Optional Details -->
                <div>
                    <label for="optionalDetails" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        <i class="fas fa-plus-circle mr-2 text-[#C9A227]"></i> Additional Notes
                        <span class="text-gray-500 dark:text-gray-400 font-normal">(Optional)</span>
                    </label>
                    <textarea
                        name="optionalDetails"
                        id="optionalDetails"
                        rows="2"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"
                        placeholder="Any additional details, notes, or internal comments about this blog"
                    ></textarea>
