<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                        </div>
                        Create New Blog
                    </h1>
                    <p class="mt-1 text-gray-600 dark:text-gray-400">
                        Share your knowledge and insights with the cybersecurity community
                    </p>
                </div>
                <div class="mt-4 md:mt-0 flex gap-3">
                    <a href="/blogs" 
                       class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                        <i class="fas fa-arrow-left mr-2"></i> Back to Blogs
                    </a>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6 sm:p-8" data-aos="fade-up" data-aos-duration="600">
            <form 
                action="/blogs" 
                method="POST" 
                class="space-y-6"
                enctype="multipart/form-data"
                id="blogForm"
            >
                <!-- Title -->
                <div>
                    <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Title <span class="text-red-500">*</span>
                    </label>
                    <input
                        type="text"
                        name="title"
                        id="title"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200"
                        placeholder="Enter a compelling blog title..."
                        required
                    >
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i> A clear and engaging title that captures attention
                    </p>
                </div>

                <!-- Category -->
                <div>
                    <label for="category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Category <span class="text-red-500">*</span>
                    </label>
                    <select 
                        name="category" 
                        id="category" 
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 appearance-none cursor-pointer"
                        required
                    >
                        <option value="">Select a category</option>
                        <optgroup label="🔐 Cybersecurity Training">
                            <option value="OSCP">OSCP Preparation</option>
                            <option value="CEH">CEH Certification</option>
                            <option value="CPENT">CPENT Training</option>
                            <option value="RHCSA">RHCSA Certification</option>
                            <option value="CompTIA">CompTIA Security+</option>
                            <option value="CISSP">CISSP Certification</option>
                        </optgroup>
                        <optgroup label="🛡️ Security Operations">
                            <option value="Red Teaming">Red Teaming</option>
                            <option value="Penetration Testing">Penetration Testing</option>
                            <option value="Vulnerability Assessment">Vulnerability Assessment</option>
                            <option value="Incident Response">Incident Response</option>
                            <option value="Digital Forensics">Digital Forensics</option>
                            <option value="OSINT">OSINT</option>
                        </optgroup>
                        <optgroup label="💻 Technical Domains">
                            <option value="Web Security">Web Security</option>
                            <option value="Network Security">Network Security</option>
                            <option value="Cloud Security">Cloud Security</option>
                            <option value="Mobile Security">Mobile Security</option>
                            <option value="Linux Security">Linux Security</option>
                            <option value="DevSecOps">DevSecOps</option>
                            <option value="IoT Security">IoT Security</option>
                            <option value="Blockchain Security">Blockchain Security</option>
                        </optgroup>
                        <optgroup label="📚 Career & Education">
                            <option value="Career">Career Advice</option>
                            <option value="Interview Tips">Interview Preparation</option>
                            <option value="Job Opportunities">Job Opportunities</option>
                            <option value="Certification Guidance">Certification Guidance</option>
                            <option value="Cyber Security Trends">Cyber Security Trends</option>
                        </optgroup>
                        <optgroup label="📰 News & Updates">
                            <option value="News">Industry News</option>
                            <option value="Events">Events & Webinars</option>
                            <option value="Product Updates">Platform Updates</option>
                            <option value="Research">Security Research</option>
                        </optgroup>
                        <optgroup label="📖 Tutorials & Guides">
                            <option value="Tutorial">Tutorials</option>
                            <option value="Lab Guides">Lab Guides</option>
                            <option value="Tool Tutorials">Tool Tutorials</option>
                            <option value="Walkthroughs">CTF Walkthroughs</option>
                            <option value="Cheatsheets">Cheatsheets & References</option>
                        </optgroup>
                        <optgroup label="🧠 Industry Insights">
                            <option value="Expert Insights">Expert Insights</option>
                            <option value="Case Studies">Case Studies</option>
                            <option value="Best Practices">Best Practices</option>
                            <option value="Compliance">Compliance & Governance</option>
                            <option value="Risk Management">Risk Management</option>
                        </optgroup>
                        <optgroup label="📝 Miscellaneous">
                            <option value="Student Stories">Student Success Stories</option>
                            <option value="Community">Community & Networking</option>
                            <option value="Cybersecurity Basics">Cybersecurity Basics</option>
                            <option value="Others">Others</option>
                        </optgroup>
                    </select>
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-tag mr-1"></i> Choose the most relevant category for your blog
                    </p>
                </div>

                <!-- Short Description -->
                <div>
                    <label for="shortdescription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Short Description <span class="text-red-500">*</span>
                    </label>
                    <textarea
                        name="shortdescription"
                        id="shortdescription"
                        rows="3"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 resize-none"
                        placeholder="A brief summary of your blog (appears in blog listings)..."
                        required
                    ></textarea>
                    <div class="flex justify-between items-center mt-1.5">
                        <p class="text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-text-height mr-1"></i> 150-200 characters recommended
                        </p>
                        <span id="descCounter" class="text-xs font-medium text-gray-500 dark:text-gray-400">0 characters</span>
                    </div>
                </div>

                <!-- Image Upload -->
                <div class="space-y-4">
                    <div>
                        <label for="image" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            <i class="fas fa-image mr-2 text-blue-500"></i> Featured Image
                            <span class="text-gray-500 dark:text-gray-400 font-normal">(Optional)</span>
                        </label>
                        <div class="relative border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl p-6 hover:border-blue-400 dark:hover:border-blue-500 transition-colors bg-gray-50 dark:bg-gray-700/30">
                            <input type="file" 
                                   id="image" 
                                   name="image" 
                                   accept="image/*"
                                   class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                                   onchange="previewImage(this)">
                            <div class="text-center">
                                <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <p class="text-sm text-gray-600 dark:text-gray-400">
                                    <span class="font-medium text-blue-600 dark:text-blue-400">Click to upload</span> or drag and drop
                                </p>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                    PNG, JPG, GIF up to 5MB (Recommended: 1200×630px)
                                </p>
                            </div>
                        </div>
                        <div id="imagePreviewContainer" class="mt-3 hidden">
                            <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-4 border border-green-200 dark:border-green-800">
                                <div class="flex items-center gap-4 flex-wrap sm:flex-nowrap">
                                    <div class="w-24 h-24 rounded-lg overflow-hidden border border-green-300 dark:border-green-700 bg-white dark:bg-gray-800 flex-shrink-0">
                                        <img id="imagePreview" src="#" alt="Preview" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm text-green-800 dark:text-green-300">
                                            <strong id="fileName"></strong><br>
                                            <span id="fileSize"></span>
                                        </p>
                                        <p class="text-xs text-green-600 dark:text-green-400 mt-1">
                                            <i class="fas fa-check-circle mr-1"></i> This image will appear as the featured image for your blog.
                                        </p>
                                    </div>
                                    <button type="button" onclick="removePreview()" class="text-green-700 dark:text-green-400 hover:text-green-900 dark:hover:text-green-300">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Image Alt Text -->
                    <div>
                        <label for="imageTitle" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            <i class="fas fa-font mr-2 text-blue-500"></i> Image Alt Text
                            <span class="text-gray-500 dark:text-gray-400 font-normal">(Optional)</span>
                        </label>
                        <input
                            type="text"
                            name="imageTitle"
                            id="imageTitle"
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200"
                            placeholder="Describe the image for SEO and accessibility..."
                        >
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Helps with search engines and screen readers. Example: "Person writing code on laptop"
                        </p>
                    </div>
                </div>

                <!-- Keywords -->
                <div>
                    <label for="Keywords" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        <i class="fas fa-tags mr-2 text-blue-500"></i> Keywords <span class="text-red-500">*</span>
                    </label>
                    <textarea
                        name="Keywords"
                        id="Keywords"
                        rows="2"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 resize-none"
                        placeholder="Enter keywords separated by commas (e.g., cybersecurity, ethical hacking, penetration testing)"
                        required
                    ></textarea>
                    <div class="flex justify-between items-center mt-1.5">
                        <p class="text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Separate keywords with commas. 2-10 keywords recommended.
                        </p>
                        <span id="keywordCounter" class="text-xs font-medium text-gray-500 dark:text-gray-400">0 keywords</span>
                    </div>
                </div>

                <!-- Content Editor -->
                <div>
                    <label for="content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        <i class="fas fa-file-alt mr-2 text-blue-500"></i> Content <span class="text-red-500">*</span>
                    </label>
                    <textarea
                        name="content"
                        id="content"
                        rows="12"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 resize-none font-mono text-sm"
                        placeholder="Write your full blog content here... Use HTML formatting"
                        required
                    ></textarea>
                    
                    <!-- Formatting Tools -->
                    <div class="mt-3 bg-gray-50 dark:bg-gray-700/30 rounded-lg p-3 border border-gray-200 dark:border-gray-700">
                        <h5 class="text-xs font-medium text-gray-700 dark:text-gray-300 mb-2 flex items-center">
                            <i class="fas fa-code mr-2 text-blue-500"></i> Formatting Tips:
                        </h5>
                        <div class="flex flex-wrap gap-2 text-xs">
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;h2&gt;Heading&lt;/h2&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;b&gt;Bold&lt;/b&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;i&gt;Italic&lt;/i&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;a href="url"&gt;Link&lt;/a&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;ul&gt;&lt;li&gt;List&lt;/li&gt;&lt;/ul&gt;</code></span>
                            <span class="bg-gray-200 dark:bg-gray-600 px-2 py-1 rounded text-gray-700 dark:text-gray-300"><code>&lt;img src="url" alt="text"&gt;</code></span>
                        </div>
                    </div>
                    
                    <div class="flex justify-between items-center mt-1.5">
                        <p class="text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Use HTML tags for formatting your content
                        </p>
                        <span id="contentCounter" class="text-xs font-medium text-gray-500 dark:text-gray-400">0 words</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <button type="submit" id="submitBtn"
                        class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-medium py-3 px-6 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        Publish Blog
                    </button>
                    <a href="/blogs"
                        class="flex-1 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 font-medium py-3 px-6 rounded-xl transition-colors duration-200 text-center flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Writing Guidelines -->
        <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 rounded-xl p-6 border border-blue-100 dark:border-blue-800" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-blue-900 dark:text-blue-300">Writing Guidelines</h3>
                    <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Engaging Title</p>
                            <p class="mt-0.5 text-xs opacity-80">Make it interesting and SEO-friendly</p>
                        </div>
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Clear Structure</p>
                            <p class="mt-0.5 text-xs opacity-80">Use headings and paragraphs for readability</p>
                        </div>
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Quality Content</p>
                            <p class="mt-0.5 text-xs opacity-80">Provide value with accurate information</p>
                        </div>
                        <div class="text-sm text-blue-800 dark:text-blue-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-blue-500"></i> Proper Formatting</p>
                            <p class="mt-0.5 text-xs opacity-80">Use the formatting tools for better presentation</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ========== FORM SUBMISSION ==========
    const form = document.getElementById('blogForm');
    const submitBtn = document.getElementById('submitBtn');
    
    if (form && submitBtn) {
        form.addEventListener('submit', function(e) {
            // Validate required fields
            const title = document.getElementById('title').value.trim();
            const category = document.getElementById('category').value;
            const shortDesc = document.getElementById('shortdescription').value.trim();
            const keywords = document.getElementById('Keywords').value.trim();
            const content = document.getElementById('content').value.trim();
            
            let isValid = true;
            
            // Reset errors
            document.querySelectorAll('.border-red-500').forEach(el => {
                el.classList.remove('border-red-500', 'ring-2', 'ring-red-200');
            });
            
            if (!title) {
                document.getElementById('title').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!category) {
                document.getElementById('category').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!shortDesc || shortDesc.length < 20) {
                document.getElementById('shortdescription').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!keywords || keywords.split(',').filter(k => k.trim() !== '').length < 2) {
                document.getElementById('Keywords').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!content || content.length < 100) {
                document.getElementById('content').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            
            if (!isValid) {
                e.preventDefault();
                const firstError = document.querySelector('.border-red-500');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return;
            }
            
            // Show loading state
            if (!submitBtn.disabled) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = `
                    <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    Publishing...
                `;
                submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
            }
        });
    }

    // ========== CHARACTER COUNTERS ==========
    const shortDesc = document.getElementById('shortdescription');
    const descCounter = document.getElementById('descCounter');
    
    if (shortDesc && descCounter) {
        shortDesc.addEventListener('input', function() {
            const length = this.value.length;
            descCounter.textContent = length + ' characters';
            
            if (length >= 150 && length <= 200) {
                descCounter.className = 'text-xs font-medium text-green-600 dark:text-green-400';
            } else if (length > 200) {
                descCounter.className = 'text-xs font-medium text-red-600 dark:text-red-400';
            } else {
                descCounter.className = 'text-xs font-medium text-yellow-600 dark:text-yellow-400';
            }
        });
    }

    const keywordsInput = document.getElementById('Keywords');
    const keywordCounter = document.getElementById('keywordCounter');
    
    if (keywordsInput && keywordCounter) {
        keywordsInput.addEventListener('input', function() {
            const keywords = this.value.split(',').filter(k => k.trim() !== '');
            keywordCounter.textContent = keywords.length + ' keywords';
            
            if (keywords.length >= 2 && keywords.length <= 10) {
                keywordCounter.className = 'text-xs font-medium text-green-600 dark:text-green-400';
            } else if (keywords.length > 10) {
                keywordCounter.className = 'text-xs font-medium text-yellow-600 dark:text-yellow-400';
            } else {
                keywordCounter.className = 'text-xs font-medium text-red-600 dark:text-red-400';
            }
        });
    }

    const contentInput = document.getElementById('content');
    const contentCounter = document.getElementById('contentCounter');
    
    if (contentInput && contentCounter) {
        contentInput.addEventListener('input', function() {
            const words = this.value.trim().split(/\s+/).filter(w => w !== '');
            contentCounter.textContent = words.length + ' words';
            
            if (words.length >= 300 && words.length <= 2000) {
                contentCounter.className = 'text-xs font-medium text-green-600 dark:text-green-400';
            } else if (words.length > 2000) {
                contentCounter.className = 'text-xs font-medium text-yellow-600 dark:text-yellow-400';
            } else {
                contentCounter.className = 'text-xs font-medium text-gray-500 dark:text-gray-400';
            }
        });
    }

    // ========== IMAGE PREVIEW ==========
    window.previewImage = function(input) {
        const previewContainer = document.getElementById('imagePreviewContainer');
        const preview = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        
        if (input.files && input.files[0]) {
            const file = input.files[0];
            
            if (file.size > 5 * 1024 * 1024) {
                alert('File size should be less than 5MB');
                input.value = '';
                previewContainer.classList.add('hidden');
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                fileName.textContent = file.name;
                fileSize.textContent = (file.size / 1024).toFixed(2) + ' KB';
                previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add('hidden');
        }
    };

    window.removePreview = function() {
        const fileInput = document.getElementById('image');
        const previewContainer = document.getElementById('imagePreviewContainer');
        fileInput.value = '';
        previewContainer.classList.add('hidden');
    };
});
</script>

