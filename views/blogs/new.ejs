<script>
document.addEventListener('DOMContentLoaded', function() {
    // ========== FORM SUBMISSION ==========
    const form = document.getElementById('blogForm');
    const submitBtn = document.getElementById('submitBtn');
    
    if (form && submitBtn) {
        form.addEventListener('submit', function(e) {
            // Validate required fields
            const title = document.getElementById('title').value.trim();
            const category = document.getElementById('category').value;
            const shortDesc = document.getElementById('shortdescription').value.trim();
            const keywords = document.getElementById('Keywords').value.trim();
            const content = document.getElementById('content').value.trim();
            
            let isValid = true;
            
            // Reset errors
            document.querySelectorAll('.border-red-500').forEach(el => {
                el.classList.remove('border-red-500', 'ring-2', 'ring-red-200');
            });
            
            if (!title) {
                document.getElementById('title').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!category) {
                document.getElementById('category').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!shortDesc || shortDesc.length < 20) {
                document.getElementById('shortdescription').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!keywords || keywords.split(',').filter(k => k.trim() !== '').length < 2) {
                document.getElementById('Keywords').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            if (!content || content.length < 100) {
                document.getElementById('content').classList.add('border-red-500', 'ring-2', 'ring-red-200');
                isValid = false;
            }
            
            if (!isValid) {
                e.preventDefault();
                const firstError = document.querySelector('.border-red-500');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return;
            }
            
            // Show loading state
            if (!submitBtn.disabled) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = `
                    <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    Publishing...
                `;
                submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
            }
        });
    }

    // ========== CHARACTER COUNTERS ==========
    const shortDesc = document.getElementById('shortdescription');
    const descCounter = document.getElementById('descCounter');
    
    if (shortDesc && descCounter) {
        shortDesc.addEventListener('input', function() {
            const length = this.value.length;
            descCounter.textContent = length + ' characters';
            
            if (length >= 150 && length <= 200) {
                descCounter.className = 'text-xs font-medium text-green-600 dark:text-green-400';
            } else if (length > 200) {
                descCounter.className = 'text-xs font-medium text-red-600 dark:text-red-400';
            } else {
                descCounter.className = 'text-xs font-medium text-yellow-600 dark:text-yellow-400';
            }
        });
    }

    // ========== TAG COUNTER ==========
    const tagsInput = document.getElementById('tags');
    const tagCounter = document.getElementById('tagCounter');
    
    if (tagsInput && tagCounter) {
        tagsInput.addEventListener('input', function() {
            const tags = this.value.split(',').filter(t => t.trim() !== '');
            tagCounter.textContent = tags.length + ' tags';
            
            if (tags.length >= 2 && tags.length <= 10) {
                tagCounter.className = 'text-xs font-medium text-green-600 dark:text-green-400';
            } else if (tags.length > 10) {
                tagCounter.className = 'text-xs font-medium text-yellow-600 dark:text-yellow-400';
            } else {
                tagCounter.className = 'text-xs font-medium text-gray-500 dark:text-gray-400';
            }
        });
    }

    // ========== KEYWORD COUNTER ==========
    const keywordsInput = document.getElementById('Keywords');
    const keywordCounter = document.getElementById('keywordCounter');
    
    if (keywordsInput && keywordCounter) {
        keywordsInput.addEventListener('input', function() {
            const keywords = this.value.split(',').filter(k => k.trim() !== '');
            keywordCounter.textContent = keywords.length + ' keywords';
            
            if (keywords.length >= 2 && keywords.length <= 10) {
                keywordCounter.className = 'text-xs font-medium text-green-600 dark:text-green-400';
            } else if (keywords.length > 10) {
                keywordCounter.className = 'text-xs font-medium text-yellow-600 dark:text-yellow-400';
            } else {
                keywordCounter.className = 'text-xs font-medium text-red-600 dark:text-red-400';
            }
        });
    }

    // ========== CONTENT WORD COUNTER ==========
    const contentInput = document.getElementById('content');
    const contentCounter = document.getElementById('contentCounter');
    
    if (contentInput && contentCounter) {
        contentInput.addEventListener('input', function() {
            const words = this.value.trim().split(/\s+/).filter(w => w !== '');
            contentCounter.textContent = words.length + ' words';
            
            if (words.length >= 300 && words.length <= 2000) {
                contentCounter.className = 'text-xs font-medium text-green-600 dark:text-green-400';
            } else if (words.length > 2000) {
                contentCounter.className = 'text-xs font-medium text-yellow-600 dark:text-yellow-400';
            } else {
                contentCounter.className = 'text-xs font-medium text-gray-500 dark:text-gray-400';
            }
        });
    }

    // ========== IMAGE PREVIEW ==========
    window.previewImage = function(input) {
        const previewContainer = document.getElementById('imagePreviewContainer');
        const preview = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        
        if (input.files && input.files[0]) {
            const file = input.files[0];
            
            if (file.size > 5 * 1024 * 1024) {
                alert('File size should be less than 5MB');
                input.value = '';
                previewContainer.classList.add('hidden');
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                fileName.textContent = file.name;
                fileSize.textContent = (file.size / 1024).toFixed(2) + ' KB';
                previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add('hidden');
        }
    };

    window.removePreview = function() {
        const fileInput = document.getElementById('image');
        const previewContainer = document.getElementById('imagePreviewContainer');
        fileInput.value = '';
        previewContainer.classList.add('hidden');
    };

    // ========== AUTO-GENERATE SLUG ==========
    const titleInput = document.getElementById('title');
    if (titleInput) {
        titleInput.addEventListener('blur', function() {
            // Just a helper - the slug is generated on server side
            // This is just to show users what will happen
            const slug = this.value
                .toLowerCase()
                .trim()
                .replace(/&/g, 'and')
                .replace(/[\s]+/g, '-')
                .replace(/[^\w\-]+/g, '')
                .replace(/\-+/g, '-')
                .replace(/^\-+|\-+$/g, '');
            
            // Show a tooltip or hint
            if (this.value.length > 0) {
                // You can show a small hint if needed
            }
        });
    }
});
</script>

