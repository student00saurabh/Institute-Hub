<% layout("/layouts/boilerplate") %>

<!-- Reading Progress Bar -->
<div id="readingProgress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 z-[60] transition-[width] duration-150" style="width:0%"></div>

<!-- Share Modal -->
<div id="shareModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity dark:bg-gray-900 dark:bg-opacity-80"></div>

  <div class="fixed inset-0 z-10 overflow-y-auto mt-14">
    <div class="flex min-h-[400px] items-center justify-center p-4 text-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-2xl bg-white dark:bg-gray-800 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md">

        <!-- Modal Header -->
        <div class="bg-gradient-to-r from-cyan-600 to-indigo-600 px-6 py-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white">
              <i class="fas fa-share-alt mr-2"></i> Share This Blog
            </h3>
            <button type="button" onclick="closeShareModal()" class="rounded-md text-white hover:text-gray-200 transition-colors">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
        </div>

        <!-- Modal Body -->
        <div class="px-6 py-6">
          <div class="space-y-3">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#1877f2] text-white px-4 py-3 rounded-xl hover:bg-[#1664d4] transition-colors">
              <i class="fab fa-facebook-f text-lg w-6 text-center"></i>
              Share on Facebook
            </a>

            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent('Check out this blog: https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#25D366] text-white px-4 py-3 rounded-xl hover:bg-[#128C7E] transition-colors">
              <i class="fab fa-whatsapp text-lg w-6 text-center"></i>
              Share on WhatsApp
            </a>

            <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent('https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>&text=<%= encodeURIComponent('Check out this blog: ' + blog.title) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#000000] text-white px-4 py-3 rounded-xl hover:bg-[#1a1a1a] transition-colors">
              <i class="fa-brands fa-x-twitter text-lg w-6 text-center"></i>
              Share on X (Twitter)
            </a>

            <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%= encodeURIComponent('https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#0A66C2] text-white px-4 py-3 rounded-xl hover:bg-[#004182] transition-colors">
              <i class="fab fa-linkedin-in text-lg w-6 text-center"></i>
              Share on LinkedIn
            </a>

            <button onclick="copyToClipboard()"
                    id="copyBtn"
                    class="flex items-center gap-3 w-full bg-gradient-to-r from-gray-600 to-gray-700 text-white px-4 py-3 rounded-xl hover:from-gray-700 hover:to-gray-800 transition-all duration-300">
              <i class="far fa-copy text-lg w-6 text-center"></i>
              Copy Link
            </button>
          </div>

          <div class="mt-6 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-xl border border-gray-200 dark:border-gray-600">
            <p class="text-xs text-gray-600 dark:text-gray-400 mb-1">Share this URL:</p>
            <div class="flex items-center gap-2">
              <input type="text"
                     id="shareUrl"
                     value="https://cyberkavach.org.in/blogs/<%= blog.id && blog.id.trim() !== "" ? blog.id : blog._id %>"
                     readonly
                     class="flex-1 text-sm text-gray-700 dark:text-gray-300 bg-transparent border-none focus:outline-none">
              <button onclick="copyToClipboard()" class="text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors">
                <i class="far fa-copy"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="bg-gray-50 dark:bg-gray-700/50 px-6 py-4 rounded-b-2xl">
          <button type="button"
                  onclick="closeShareModal()"
                  class="w-full bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal<%= blog._id %>" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity dark:bg-gray-900 dark:bg-opacity-80"></div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-2xl bg-white dark:bg-gray-800 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md">

        <div class="bg-gradient-to-r from-red-500 to-red-600 px-6 py-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white">
              <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Deletion
            </h3>
            <button type="button" onclick="closeDeleteModal()" class="rounded-md text-white hover:text-gray-200 transition-colors">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
        </div>

        <div class="px-6 py-6">
          <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 dark:bg-red-900/30">
            <i class="fas fa-trash-alt text-red-600 dark:text-red-400 text-xl"></i>
          </div>
          <div class="mt-3 text-center">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              Delete "<%= blog.title %>"?
            </h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              This action cannot be undone. The blog will be permanently deleted.
            </p>
          </div>
        </div>

        <div class="bg-gray-50 dark:bg-gray-700/50 px-6 py-4 flex flex-col sm:flex-row justify-end space-y-2 sm:space-y-0 sm:space-x-3 rounded-b-2xl">
          <button type="button"
                  onclick="closeDeleteModal()"
                  class="px-4 py-2 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors">
            Cancel
          </button>
          <form action="/blogs/<%= blog._id %>?_method=DELETE" method="POST">
            <button type="submit"
                    class="w-full sm:w-auto px-4 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg hover:from-red-600 hover:to-red-700 transition-colors">
              Yes, Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<% if(blog){ %>
 <% if(currUser && !blog.usersSeen.includes(currUser._id) && blog.author && !currUser._id.equals(blog.author._id)){ %>
    <% blog.usersSeen.push(currUser._id); %>
    <% blog.save().catch(err => console.error('Error saving blog views:', err)); %>
  <% } %>

  <%
    // ---- Derived display data (no schema dependency required) ----
    const plainText = (blog.content || "").replace(/<[^>]*>/g, " ");
    const wordCount = plainText.trim().length ? plainText.trim().split(/\s+/).length : 0;
    const readTime = Math.max(1, Math.ceil(wordCount / 200));
    const viewsCount = blog.usersSeen ? blog.usersSeen.length : 0;
    const likesArr = blog.likes || [];
    const isLiked = !!(currUser && likesArr.some(id => id.equals ? id.equals(currUser._id) : String(id) === String(currUser._id)));
    const tagsArr = blog.tags || [];
    const metaDescription = blog.shortdescription || plainText.trim().substring(0, 160);
  %>

<div class="min-h-screen bg-gradient-to-b from-slate-50 to-white dark:from-gray-900 dark:to-gray-950 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">

    <!-- Blocked Alert -->
    <% if(blog.blocked){ %>
      <div class="mb-6 bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-xl p-5 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 mt-0.5">
            <i class="fas fa-ban text-red-600 dark:text-red-400 text-xl"></i>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-red-800 dark:text-red-300">Blog Blocked</h3>
            <p class="text-red-700 dark:text-red-400 mt-1">
              This blog has been <strong>blocked by admin</strong> and may not be visible to regular users.
            </p>
          </div>
        </div>
      </div>
    <% } %>

    <% if(!blog.blocked){ %>

      <!-- SEO: Article structured data -->
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": <%- JSON.stringify(blog.title) %>,
        "description": <%- JSON.stringify(metaDescription) %>,
        "image": <%- JSON.stringify(blog.image && blog.image.url ? blog.image.url : "") %>,
        "datePublished": "<%= new Date(blog.createdAt).toISOString() %>",
        "dateModified": "<%= new Date(blog.updatedAt || blog.createdAt).toISOString() %>",
        "author": { "@type": "Person", "name": <%- JSON.stringify(blog.author ? (blog.author.name || blog.author.username || "Unknown") : "Unknown") %> }
      }
      </script>

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-5 overflow-x-auto whitespace-nowrap" data-aos="fade-up">
        <a href="/blogs" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Blogs</a>
        <i class="fas fa-chevron-right text-[10px] flex-shrink-0"></i>
        <a href="/blogs?category=<%= blog.category %>" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"><%= blog.category %></a>
        <i class="fas fa-chevron-right text-[10px] flex-shrink-0"></i>
        <span class="text-gray-700 dark:text-gray-300 truncate max-w-[220px]"><%= blog.title %></span>
      </nav>

      <div class="lg:grid lg:grid-cols-[60px_minmax(0,1fr)_270px] lg:gap-8 items-start">

        <!-- ============ LEFT ACTION RAIL (desktop) ============ -->
        <aside class="hidden lg:flex lg:flex-col items-center gap-4 sticky top-28">
          <button id="likeBtn"
                  onclick="toggleLike('<%= blog._id %>')"
                  data-liked="<%= isLiked %>"
                  class="group flex flex-col items-center gap-1 w-12 h-12 rounded-2xl border <%= isLiked ? 'border-rose-200 bg-rose-50 dark:bg-rose-900/20 dark:border-rose-800' : 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800' %> hover:shadow-md transition-all duration-200 justify-center">
            <i class="<%= isLiked ? 'fas' : 'far' %> fa-heart <%= isLiked ? 'text-rose-500' : 'text-gray-500 dark:text-gray-400 group-hover:text-rose-500' %> transition-colors"></i>
          </button>
          <span id="likeCount" class="text-xs text-gray-500 dark:text-gray-400 -mt-2"><%= likesArr.length %></span>

          <button id="bookmarkBtn"
                  onclick="toggleBookmark('<%= blog._id %>')"
                  class="group flex items-center justify-center w-12 h-12 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:shadow-md transition-all duration-200">
            <i id="bookmarkIcon" class="far fa-bookmark text-gray-500 dark:text-gray-400 group-hover:text-amber-500 transition-colors"></i>
          </button>

          <button onclick="openShareModal()"
                  class="group flex items-center justify-center w-12 h-12 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:shadow-md transition-all duration-200">
            <i class="fas fa-share-alt text-gray-500 dark:text-gray-400 group-hover:text-blue-500 transition-colors"></i>
          </button>

          <div class="w-8 border-t border-gray-200 dark:border-gray-700"></div>

          <a href="#comments-section"
             class="flex flex-col items-center gap-1 text-gray-400 dark:text-gray-500 hover:text-blue-500 transition-colors">
            <i class="far fa-comment text-lg"></i>
            <span class="text-xs"><%= blog.comments.length %></span>
          </a>

          <div class="flex flex-col items-center gap-1 text-gray-400 dark:text-gray-500">
            <i class="far fa-eye text-lg"></i>
            <span class="text-xs"><%= viewsCount %></span>
          </div>
        </aside>

        <!-- ============ MAIN COLUMN ============ -->
        <div class="min-w-0">

          <!-- Header -->
          <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-cyan-50 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300 text-xs font-bold uppercase tracking-wider rounded-full border border-cyan-200 dark:border-cyan-800">
                  <i class="fas fa-shield-halved text-[11px]"></i>
                  <%= blog.category %>
                </span>
                <% if(blog.adminVerified){ %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-300 text-xs font-semibold rounded-full border border-amber-200 dark:border-amber-800">
                    <i class="fas fa-certificate text-[11px]"></i> Verified
                  </span>
                <% } %>
              </div>

              <div class="flex items-center gap-2">
                <!-- Admin Actions -->
                <% if(currUser && (currUser.role === 'admin' || currUser.role === 'teacher')) { %>
                  <div class="relative group">
                    <button class="inline-flex items-center gap-1.5 px-3 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-all duration-200">
                      <i class="fas fa-cog"></i>
                    </button>
                    <div class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-10">
                      <div class="py-1">
                        <a href="/admin/blogs/<%= blog._id %>" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                          <i class="fas fa-edit text-blue-500"></i> Edit Blog
                        </a>
                        <form action="/blogs/<%= blog._id %>/activate" method="POST" class="block">
                          <button type="submit" class="flex items-center gap-3 w-full px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-<%= blog.isvalid ? 'pause' : 'play' %> text-<%= blog.isvalid ? 'yellow' : 'green' %>-500"></i>
                            <%= blog.isvalid ? 'Unpublish' : 'Publish' %>
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Blog Title -->
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-white mt-5 leading-tight tracking-tight" data-aos="fade-up" data-aos-delay="100">
              <%= blog.title %>
            </h1>

            <% if(blog.shortdescription){ %>
              <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 leading-relaxed" data-aos="fade-up" data-aos-delay="120">
                <%= blog.shortdescription %>
              </p>
            <% } %>

            <!-- Meta Row -->
            <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
              <div class="flex items-center text-gray-600 dark:text-gray-300 text-sm">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-cyan-400 to-indigo-600 flex items-center justify-center text-white font-semibold mr-3 flex-shrink-0">
                  <% if (blog.author) { %>
                    <%= (blog.author.name || blog.author.username || 'U').charAt(0).toUpperCase() %>
                  <% } else { %>
                    <i class="fas fa-user"></i>
                  <% } %>
                </div>
                <div>
                  <% if (blog.author) { %>
                    <span class="font-semibold text-gray-800 dark:text-white block">
                      <%= blog.author.name || blog.author.username || "Unnamed User" %>
                    </span>
                  <% } else { %>
                    <span class="italic text-gray-500 dark:text-gray-400 block">Deleted User</span>
                  <% } %>
                  <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    <span><i class="far fa-clock mr-1"></i><%= new Date(blog.createdAt).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                    <span>&middot;</span>
                    <span><i class="far fa-hourglass-half mr-1"></i><%= readTime %> min read</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-lg text-sm">
                  <i class="far fa-eye"></i>
                  <span><%= viewsCount %></span>
                </span>
                <button onclick="openShareModal()"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 rounded-xl hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-all duration-300">
                  <i class="fas fa-share-alt"></i>
                  <span class="hidden sm:inline">Share</span>
                </button>
              </div>
            </div>

            <!-- Mobile action row (rail equivalent) -->
            <div class="flex lg:hidden items-center gap-3 mt-4">
              <button onclick="toggleLike('<%= blog._id %>')" id="likeBtnMobile" data-liked="<%= isLiked %>"
                      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border <%= isLiked ? 'border-rose-200 bg-rose-50 dark:bg-rose-900/20 dark:border-rose-800 text-rose-600' : 'border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300' %> transition-colors">
                <i class="<%= isLiked ? 'fas' : 'far' %> fa-heart"></i>
                <span id="likeCountMobile" class="text-sm"><%= likesArr.length %></span>
              </button>
              <button onclick="toggleBookmark('<%= blog._id %>')" class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300">
                <i id="bookmarkIconMobile" class="far fa-bookmark"></i>
              </button>
              <a href="#comments-section" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 text-sm">
                <i class="far fa-comment"></i> <%= blog.comments.length %>
              </a>
            </div>

            <!-- Tags -->
            <% if (tagsArr.length) { %>
              <div class="flex flex-wrap gap-2 mt-5">
                <% tagsArr.forEach(tag => { %>
                  <a href="/blogs?tag=<%= encodeURIComponent(tag) %>" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
                    #<%= tag %>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </div>

          <!-- Featured Image -->
          <% if(blog.image && blog.image.url){ %>
            <div class="relative mb-10 rounded-3xl overflow-hidden shadow-2xl ring-1 ring-black/5 border border-gray-200 dark:border-gray-700" data-aos="fade-up" data-aos-delay="150">
              <img
                src="<%= blog.image.url %>"
                alt="<%= blog.imageTitle || 'Blog Image' %>"
                class="w-full h-auto max-h-[500px] object-cover"
                loading="lazy"
                onerror="this.onerror=null; this.src='/images/default-blog.jpg';"
              >
              <% if(blog.imageTitle){ %>
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent px-5 py-3">
                  <p class="text-white text-sm font-medium"><%= blog.imageTitle %></p>
                </div>
              <% } %>
            </div>
          <% } %>

          <!-- Blog Content -->
          <article class="prose prose-lg max-w-none mb-12" data-aos="fade-up" data-aos-delay="200">
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
              <%
                const hasHTML = /<\/?[a-z][\s\S]*>/i.test(blog.content);
              %>
              <% if (hasHTML) { %>
                <div class="text-gray-800 dark:text-gray-200 leading-relaxed space-y-4 blog-content">
                  <%- blog.content %>
                </div>
              <% } else { %>
                <div class="text-gray-800 dark:text-gray-200 leading-relaxed whitespace-pre-line space-y-4 blog-content">
                  <%- blog.content.replace(/\n/g, '<br>') %>
                </div>
              <% } %>
            </div>
          </article>

          <!-- External / further reading links -->
          <% if (blog.externalLinks && blog.externalLinks.length) { %>
            <div class="mb-12 bg-gray-50 dark:bg-gray-800/50 rounded-2xl border border-gray-200 dark:border-gray-700 p-6" data-aos="fade-up">
              <h4 class="font-semibold text-gray-800 dark:text-white mb-3">
                <i class="fas fa-link text-blue-500 mr-2"></i>Further Reading
              </h4>
              <ul class="space-y-2">
                <% blog.externalLinks.forEach(link => { %>
                  <li>
                    <a href="<%= link %>" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 dark:text-blue-400 hover:underline break-all">
                      <i class="fas fa-arrow-up-right-from-square text-xs mr-2"></i><%= link %>
                    </a>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <!-- Bottom engagement bar -->
          <div class="flex items-center justify-between flex-wrap gap-4 mb-10 p-5 bg-gray-50 dark:bg-gray-800/50 rounded-2xl border border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-600 dark:text-gray-400">Found this useful? Let others know.</p>
            <div class="flex items-center gap-3">
              <button onclick="toggleLike('<%= blog._id %>')" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 hover:border-rose-300 hover:text-rose-500 transition-colors">
                <i class="far fa-heart"></i> Like
              </button>
              <button onclick="openShareModal()" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-600 to-indigo-600 text-white text-sm hover:from-cyan-700 hover:to-indigo-700 transition-colors">
                <i class="fas fa-share-alt"></i> Share
              </button>
              
            </div>
          </div>

          <!-- Author Actions -->
          <% if (currUser && blog.author && currUser._id.equals(blog.author._id)) { %>
            <div class="flex flex-wrap gap-3 mb-8 p-6 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-2xl border border-blue-100 dark:border-blue-800" data-aos="fade-up" data-aos-delay="250">
              <div class="flex-1">
                <h4 class="font-semibold text-gray-800 dark:text-white mb-1">
                  <i class="fas fa-crown text-yellow-500 mr-2"></i>Blog Owner Controls
                </h4>
                <p class="text-sm text-gray-600 dark:text-gray-400">Manage your blog post</p>
              </div>
              <div class="flex gap-3 flex-wrap">
                <a href="/blogs/<%= blog._id %>/views"
                   class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors shadow-sm">
                  <i class="fas fa-chart-line"></i>
                  Insights
                </a>
                <a href="/blogs/<%= blog._id %>/edit"
                   class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-gray-700 border border-blue-300 dark:border-blue-700 text-blue-700 dark:text-blue-300 rounded-xl hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors shadow-sm">
                  <i class="fas fa-edit"></i>
                  Edit
                </a>
                <button type="button"
                        onclick="openDeleteModal()"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-xl hover:from-red-600 hover:to-red-700 transition-colors shadow-sm">
                  <i class="fas fa-trash-alt"></i>
                  Delete
                </button>
              </div>
            </div>
          <% } %>

          <!-- Comments Section -->
          <div id="comments-section" class="space-y-8" data-aos="fade-up" data-aos-delay="300">
            <!-- Comment Form -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
                <i class="far fa-comment text-blue-600 dark:text-blue-400 mr-2"></i>
                Leave a Comment
              </h3>

              <% if(currUser){ %>
                <form action="/blogs/<%= blog._id %>/comments" method="POST" class="space-y-4">
                  <textarea
                    id="commentInput"
                    name="text"
                    rows="4"
                    maxlength="1000"
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-blue-500 dark:focus:border-blue-400 transition-colors bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                    placeholder="Share your thoughts, insights, or feedback..."
                    required
                  ></textarea>
                  <div class="flex items-center justify-between">
                    <span class="text-xs text-gray-400 dark:text-gray-500">Max 1000 characters</span>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-medium rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 shadow-lg hover:shadow-xl">
                      <i class="fas fa-paper-plane"></i>
                      Post Comment
                    </button>
                  </div>
                </form>
              <% } else { %>
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-xl p-6">
                  <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 mt-0.5">
                      <i class="fas fa-comment-alt text-yellow-600 dark:text-yellow-400 text-2xl"></i>
                    </div>
                    <div>
                      <h3 class="text-lg font-semibold text-yellow-800 dark:text-yellow-300">Join the Conversation</h3>
                      <p class="text-yellow-700 dark:text-yellow-400 mt-1">
                        Please <a href="/login" class="font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">log in</a> or
                        <a href="/signup" class="font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">create an account</a>
                        to leave a comment and engage with the community.
                      </p>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Comments List -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                  <i class="far fa-comments text-blue-600 dark:text-blue-400 mr-2"></i>
                  Comments (<%= blog.comments.length %>)
                </h3>
              </div>

              <% if (blog.comments.length === 0) { %>
                <div class="text-center py-12">
                  <div class="inline-block p-6 bg-gray-100 dark:bg-gray-700 rounded-2xl mb-4">
                    <i class="fas fa-comment-slash text-4xl text-gray-400 dark:text-gray-500"></i>
                  </div>
                  <h4 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">No comments yet</h4>
                  <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto">
                    Be the first to share your thoughts and start the discussion.
                  </p>
                </div>
              <% } else { %>
                <div class="space-y-6">
                  <% comments.forEach(comment => { %>
                    <div class="group p-5 bg-gray-50 dark:bg-gray-700/30 rounded-xl hover:bg-white dark:hover:bg-gray-700/50 border border-gray-100 dark:border-gray-700 hover:border-blue-200 dark:hover:border-blue-800 transition-all duration-300">
                      <div class="flex items-start justify-between mb-3">
                        <div class="flex items-center gap-3">
                          <div class="w-10 h-10 rounded-full bg-gradient-to-r from-blue-400 to-purple-500 flex items-center justify-center text-white font-medium flex-shrink-0">
                            <% if (comment.user) { %>
                              <%= (comment.user.name || comment.user.username || 'U').charAt(0).toUpperCase() %>
                            <% } else { %>
                              <i class="fas fa-user"></i>
                            <% } %>
                          </div>
                          <div>
                            <h5 class="font-semibold text-gray-800 dark:text-white">
                              <% if (comment.user) { %>
                                <%= comment.user.name || comment.user.username || "Unnamed User" %>
                              <% } else { %>
                                <span class="italic text-gray-500 dark:text-gray-400">Deleted User</span>
                              <% } %>
                            </h5>
                            <div class="flex items-center text-xs text-gray-500 dark:text-gray-400">
                              <i class="far fa-clock mr-1"></i>
                              <%= new Date(comment.createdAt).toLocaleString('en-IN', {
                                timeZone: 'Asia/Kolkata',
                                dateStyle: 'medium',
                                timeStyle: 'short'
                              }) %>
                            </div>
                          </div>
                        </div>

                        <% if(currUser && comment.user && currUser._id.equals(comment.user._id)){ %>
                          <form action="/blogs/<%= blog._id %>/comments/<%= comment._id %>?_method=DELETE"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this comment?');">
                            <button type="submit"
                                    class="text-red-500 hover:text-red-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                              <i class="fas fa-trash-alt"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>

                      <div class="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line">
                        <%- comment.text.replace(/\n/g, '<br>') %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
