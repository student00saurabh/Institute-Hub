<% layout("/layouts/boilerplate") %>

<!-- Reading Progress Bar -->
<div id="readingProgress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-[#C9A227] via-[#E6C35A] to-[#B8901E] z-[60] transition-[width] duration-150" style="width:0%"></div>

<!-- ============================================================ -->
<!-- SHARE MODAL                                                   -->
<!-- ============================================================ -->
<div id="shareModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-500/75 dark:bg-gray-900/80 backdrop-blur-sm transition-opacity"></div>
  <div class="fixed inset-0 z-10 overflow-y-auto mt-14">
    <div class="flex min-h-[400px] items-center justify-center p-4 text-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-2xl bg-white dark:bg-gray-800 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md">

        <div class="bg-gradient-to-r from-[#C9A227] to-[#B8901E] px-6 py-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white">
              <i class="fas fa-share-alt mr-2"></i> Share This Blog
            </h3>
            <button type="button" onclick="closeShareModal()" class="rounded-md text-white hover:text-gray-200 transition-colors">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
        </div>

        <div class="px-6 py-6">
          <div class="space-y-3">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#1877f2] text-white px-4 py-3 rounded-xl hover:bg-[#1664d4] transition-all duration-300 hover:scale-[1.02]">
              <i class="fab fa-facebook-f text-lg w-6 text-center"></i>
              <span>Share on Facebook</span>
            </a>

            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent('Check out this blog: https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#25D366] text-white px-4 py-3 rounded-xl hover:bg-[#128C7E] transition-all duration-300 hover:scale-[1.02]">
              <i class="fab fa-whatsapp text-lg w-6 text-center"></i>
              <span>Share on WhatsApp</span>
            </a>

            <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent('https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>&text=<%= encodeURIComponent('Check out this blog: ' + blog.title) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#000000] text-white px-4 py-3 rounded-xl hover:bg-[#1a1a1a] transition-all duration-300 hover:scale-[1.02]">
              <i class="fa-brands fa-x-twitter text-lg w-6 text-center"></i>
              <span>Share on X</span>
            </a>

            <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%= encodeURIComponent('https://cyberkavach.org.in/blogs/' + (blog.id && blog.id.trim() !== "" ? blog.id : blog._id)) %>"
               target="_blank"
               class="flex items-center gap-3 bg-[#0A66C2] text-white px-4 py-3 rounded-xl hover:bg-[#004182] transition-all duration-300 hover:scale-[1.02]">
              <i class="fab fa-linkedin-in text-lg w-6 text-center"></i>
              <span>Share on LinkedIn</span>
            </a>

            <button onclick="copyToClipboard()"
                    id="copyBtn"
                    class="flex items-center gap-3 w-full bg-gradient-to-r from-[#C9A227] to-[#B8901E] text-white px-4 py-3 rounded-xl hover:from-[#B8901E] hover:to-[#A07A1A] transition-all duration-300 hover:scale-[1.02]">
              <i class="far fa-copy text-lg w-6 text-center"></i>
              <span>Copy Link</span>
            </button>
          </div>

          <div class="mt-6 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-xl border border-gray-200 dark:border-gray-600">
            <p class="text-xs text-gray-600 dark:text-gray-400 mb-1">Share this URL:</p>
            <div class="flex items-center gap-2">
              <input type="text"
                     id="shareUrl"
                     value="https://cyberkavach.org.in/blogs/<%= blog.id && blog.id.trim() !== "" ? blog.id : blog._id %>"
                     readonly
                     class="flex-1 text-sm text-gray-700 dark:text-gray-300 bg-transparent border-none focus:outline-none">
              <button onclick="copyToClipboard()" class="text-gray-500 hover:text-[#C9A227] dark:text-gray-400 dark:hover:text-[#C9A227] transition-colors">
                <i class="far fa-copy"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="bg-gray-50 dark:bg-gray-700/50 px-6 py-4 rounded-b-2xl">
          <button type="button"
                  onclick="closeShareModal()"
                  class="w-full bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================ -->
<!-- DELETE MODAL                                                  -->
<!-- ============================================================ -->
<div id="deleteModal<%= blog._id %>" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-500/75 dark:bg-gray-900/80 backdrop-blur-sm transition-opacity"></div>
  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-2xl bg-white dark:bg-gray-800 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md">

        <div class="bg-gradient-to-r from-red-500 to-red-600 px-6 py-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white">
              <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Deletion
            </h3>
            <button type="button" onclick="closeDeleteModal()" class="rounded-md text-white hover:text-gray-200 transition-colors">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
        </div>

        <div class="px-6 py-6">
          <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 dark:bg-red-900/30">
            <i class="fas fa-trash-alt text-red-600 dark:text-red-400 text-xl"></i>
          </div>
          <div class="mt-3 text-center">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              Delete "<%= blog.title %>"?
            </h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              This action cannot be undone. The blog will be permanently deleted.
            </p>
          </div>
        </div>

        <div class="bg-gray-50 dark:bg-gray-700/50 px-6 py-4 flex flex-col sm:flex-row justify-end space-y-2 sm:space-y-0 sm:space-x-3 rounded-b-2xl">
          <button type="button"
                  onclick="closeDeleteModal()"
                  class="px-4 py-2 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors">
            Cancel
          </button>
          <form action="/blogs/<%= blog._id %>?_method=DELETE" method="POST">
            <button type="submit"
                    class="w-full sm:w-auto px-4 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg hover:from-red-600 hover:to-red-700 transition-colors">
              Yes, Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<% if(blog){ %>
  <% if(currUser && !blog.usersSeen.includes(currUser._id) && blog.author && !currUser._id.equals(blog.author._id)){ %>
    <% blog.usersSeen.push(currUser._id); %>
    <% blog.save().catch(err => console.error('Error saving blog views:', err)); %>
  <% } %>

  <%
    const plainText = (blog.content || "").replace(/<[^>]*>/g, " ");
    const wordCount = plainText.trim().length ? plainText.trim().split(/\s+/).length : 0;
    const readTime = Math.max(1, Math.ceil(wordCount / 200));
    const viewsCount = blog.usersSeen ? blog.usersSeen.length : 0;
    const likesArr = blog.likes || [];
    const isLiked = !!(currUser && likesArr.some(id => id.equals ? id.equals(currUser._id) : String(id) === String(currUser._id)));
    const tagsArr = blog.tags || [];
    const metaDescription = blog.shortdescription || plainText.trim().substring(0, 160);
  %>

<!-- ============================================================ -->
<!-- MAIN CONTENT                                                  -->
<!-- ============================================================ -->
<div class="min-h-screen bg-gradient-to-b from-[#F8FAFC] to-white dark:from-gray-900 dark:to-gray-950 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">

    <!-- Blocked Alert -->
    <% if(blog.blocked){ %>
      <div class="mb-6 bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-xl p-5 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 mt-0.5">
            <i class="fas fa-ban text-red-600 dark:text-red-400 text-xl"></i>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-red-800 dark:text-red-300">Blog Blocked</h3>
            <p class="text-red-700 dark:text-red-400 mt-1">
              This blog has been <strong>blocked by admin</strong> and may not be visible to regular users.
            </p>
          </div>
        </div>
      </div>
    <% } %>

    <% if(!blog.blocked){ %>

      <!-- SEO -->
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": <%- JSON.stringify(blog.title) %>,
        "description": <%- JSON.stringify(metaDescription) %>,
        "image": <%- JSON.stringify(blog.image && blog.image.url ? blog.image.url : "") %>,
        "datePublished": "<%= new Date(blog.createdAt).toISOString() %>",
        "dateModified": "<%= new Date(blog.updatedAt || blog.createdAt).toISOString() %>",
        "author": { "@type": "Person", "name": <%- JSON.stringify(blog.author ? (blog.author.name || blog.author.username || "Unknown") : "Unknown") %> }
      }
      </script>

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6 overflow-x-auto whitespace-nowrap" data-aos="fade-up">
        <a href="/blogs" class="hover:text-[#C9A227] dark:hover:text-[#C9A227] transition-colors">Blogs</a>
        <i class="fas fa-chevron-right text-[10px] flex-shrink-0"></i>
        <a href="/blogs?category=<%= blog.category %>" class="hover:text-[#C9A227] dark:hover:text-[#C9A227] transition-colors"><%= blog.category %></a>
        <i class="fas fa-chevron-right text-[10px] flex-shrink-0"></i>
        <span class="text-gray-700 dark:text-gray-300 truncate max-w-[220px]"><%= blog.title %></span>
      </nav>

      <div class="lg:grid lg:grid-cols-[60px_minmax(0,1fr)_270px] lg:gap-8 items-start">

        <!-- ============ LEFT ACTION RAIL ============ -->
        <aside class="hidden lg:flex lg:flex-col items-center gap-4 sticky top-28">
          <!-- Like Button -->
          <button id="likeBtn"
                  onclick="toggleLike('<%= blog._id %>')"
                  data-liked="<%= isLiked %>"
                  class="group flex flex-col items-center gap-1 w-12 h-12 rounded-2xl border <%= isLiked ? 'border-[#C9A227]/40 bg-[#C9A227]/10 dark:bg-[#C9A227]/20' : 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800' %> hover:shadow-md hover:border-[#C9A227] transition-all duration-200 justify-center">
            <i class="<%= isLiked ? 'fas' : 'far' %> fa-heart <%= isLiked ? 'text-[#C9A227]' : 'text-gray-500 dark:text-gray-400 group-hover:text-[#C9A227]' %> transition-colors text-lg"></i>
          </button>
          <span id="likeCount" class="text-xs font-semibold text-gray-500 dark:text-gray-400 -mt-2"><%= likesArr.length %></span>

          <!-- Bookmark Button -->
          <button id="bookmarkBtn"
                  onclick="toggleBookmark('<%= blog._id %>')"
                  class="group flex items-center justify-center w-12 h-12 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:shadow-md hover:border-[#C9A227] transition-all duration-200">
            <i id="bookmarkIcon" class="far fa-bookmark text-gray-500 dark:text-gray-400 group-hover:text-[#C9A227] transition-colors text-lg"></i>
          </button>

          <!-- Share Button -->
          <button onclick="openShareModal()"
                  class="group flex items-center justify-center w-12 h-12 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:shadow-md hover:border-[#C9A227] transition-all duration-200">
            <i class="fas fa-share-alt text-gray-500 dark:text-gray-400 group-hover:text-[#C9A227] transition-colors"></i>
          </button>

          <div class="w-8 border-t border-gray-200 dark:border-gray-700"></div>

          <!-- Comments -->
          <a href="#comments-section"
             class="flex flex-col items-center gap-1 text-gray-400 dark:text-gray-500 hover:text-[#C9A227] transition-colors">
            <i class="far fa-comment text-lg"></i>
            <span class="text-xs font-medium"><%= blog.comments.length %></span>
          </a>

          <!-- Views -->
          <div class="flex flex-col items-center gap-1 text-gray-400 dark:text-gray-500">
            <i class="far fa-eye text-lg"></i>
            <span class="text-xs font-medium"><%= viewsCount %></span>
          </div>
        </aside>

        <!-- ============ MAIN COLUMN ============ -->
        <div class="min-w-0">

          <!-- Header -->
          <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-2">
                <!-- Category Badge -->
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#C9A227]/10 dark:bg-[#C9A227]/20 text-[#C9A227] dark:text-[#C9A227] text-xs font-bold uppercase tracking-wider rounded-full border border-[#C9A227]/30">
                  <i class="fas fa-tag text-[11px]"></i>
                  <%= blog.category %>
                </span>
                <!-- Verified Badge -->
                <% if(blog.adminVerified){ %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#C9A227]/10 dark:bg-[#C9A227]/20 text-[#C9A227] dark:text-[#C9A227] text-xs font-semibold rounded-full border border-[#C9A227]/30">
                    <i class="fas fa-certificate text-[11px]"></i> Verified
                  </span>
                <% } %>
                <!-- Reading Time -->
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs font-medium rounded-full">
                  <i class="far fa-clock"></i> <%= readTime %> min read
                </span>
              </div>

              <!-- Admin Actions -->
              <% if(currUser && (currUser.role === 'admin' || currUser.role === 'teacher')) { %>
                <div class="relative group">
                  <button class="inline-flex items-center gap-1.5 px-3 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-all duration-200">
                    <i class="fas fa-cog"></i> <span class="hidden sm:inline text-xs">Manage</span>
                  </button>
                  <div class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-10">
                    <div class="py-1">
                      <a href="/blogs/<%= blog._id %>/edit" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <i class="fas fa-edit text-[#C9A227]"></i> Edit Blog
                      </a>
                      <form action="/blogs/<%= blog._id %>/activate" method="POST" class="block">
                        <button type="submit" class="flex items-center gap-3 w-full px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                          <i class="fas fa-<%= blog.isvalid ? 'pause' : 'play' %> text-[#C9A227]"></i>
                          <%= blog.isvalid ? 'Unpublish' : 'Publish' %>
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Title -->
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-white mt-5 leading-tight tracking-tight" data-aos="fade-up" data-aos-delay="100">
              <%= blog.title %>
            </h1>

            <!-- Short Description -->
            <% if(blog.shortdescription){ %>
              <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 leading-relaxed border-l-4 border-[#C9A227] pl-4" data-aos="fade-up" data-aos-delay="120">
                <%= blog.shortdescription %>
              </p>
            <% } %>

            <!-- Author & Meta -->
            <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
              <div class="flex items-center text-gray-600 dark:text-gray-300 text-sm">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C9A227] to-[#B8901E] flex items-center justify-center text-white font-semibold mr-3 flex-shrink-0 shadow-md">
                  <% if (blog.author) { %>
                    <%= (blog.author.name || blog.author.username || 'U').charAt(0).toUpperCase() %>
                  <% } else { %>
                    <i class="fas fa-user"></i>
                  <% } %>
                </div>
                <div>
                  <% if (blog.author) { %>
                    <span class="font-semibold text-gray-800 dark:text-white block">
                      <%= blog.author.name || blog.author.username || "Unnamed User" %>
                    </span>
                  <% } else { %>
                    <span class="italic text-gray-500 dark:text-gray-400 block">Deleted User</span>
                  <% } %>
                  <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    <span><i class="far fa-calendar-alt mr-1"></i><%= new Date(blog.createdAt).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                    <span>&middot;</span>
                    <span><i class="far fa-hourglass-half mr-1"></i><%= readTime %> min read</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-lg text-sm">
                  <i class="far fa-eye"></i>
                  <span><%= viewsCount %></span>
                </span>
                <button onclick="openShareModal()"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-[#C9A227]/10 dark:bg-[#C9A227]/20 text-[#C9A227] border border-[#C9A227]/30 rounded-xl hover:bg-[#C9A227]/20 dark:hover:bg-[#C9A227]/30 transition-all duration-300">
                  <i class="fas fa-share-alt"></i>
                  <span class="hidden sm:inline">Share</span>
                </button>
              </div>
            </div>

            <!-- Mobile Action Row -->
            <div class="flex lg:hidden items-center gap-3 mt-4">
              <button onclick="toggleLike('<%= blog._id %>')" id="likeBtnMobile" data-liked="<%= isLiked %>"
                      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border <%= isLiked ? 'border-[#C9A227]/40 bg-[#C9A227]/10 text-[#C9A227]' : 'border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300' %> transition-colors">
                <i class="<%= isLiked ? 'fas' : 'far' %> fa-heart"></i>
                <span id="likeCountMobile" class="text-sm"><%= likesArr.length %></span>
              </button>
              <button onclick="toggleBookmark('<%= blog._id %>')" class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:border-[#C9A227] hover:text-[#C9A227] transition-colors">
                <i id="bookmarkIconMobile" class="far fa-bookmark"></i>
              </button>
              <a href="#comments-section" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 text-sm hover:border-[#C9A227] hover:text-[#C9A227] transition-colors">
                <i class="far fa-comment"></i> <%= blog.comments.length %>
              </a>
            </div>

            <!-- Tags -->
            <% if (tagsArr.length) { %>
              <div class="flex flex-wrap gap-2 mt-5">
                <% tagsArr.forEach(tag => { %>
                  <a href="/blogs?tag=<%= encodeURIComponent(tag) %>" 
                     class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-[#C9A227]/10 dark:hover:bg-[#C9A227]/20 hover:text-[#C9A227] transition-colors">
                    #<%= tag %>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </div>

          <!-- Featured Image -->
          <% if(blog.image && blog.image.url){ %>
            <div class="relative mb-10 rounded-3xl overflow-hidden shadow-2xl ring-1 ring-black/5 border border-gray-200 dark:border-gray-700" data-aos="fade-up" data-aos-delay="150">
              <img src="<%= blog.image.url %>"
                   alt="<%= blog.imageTitle || 'Blog Image' %>"
                   class="w-full h-auto max-h-[500px] object-cover"
                   loading="lazy"
                   onerror="this.onerror=null; this.src='/images/default-blog.jpg';">
              <% if(blog.imageTitle){ %>
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent px-5 py-3">
                  <p class="text-white text-sm font-medium"><i class="fas fa-camera mr-2"></i><%= blog.imageTitle %></p>
                </div>
              <% } %>
            </div>
          <% } %>

          <!-- Blog Content -->
          <article class="prose prose-lg max-w-none mb-12" data-aos="fade-up" data-aos-delay="200">
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
              <%
                const hasHTML = /<\/?[a-z][\s\S]*>/i.test(blog.content);
              %>
              <% if (hasHTML) { %>
                <div class="text-gray-800 dark:text-gray-200 leading-relaxed space-y-4 blog-content">
                  <%- blog.content %>
                </div>
              <% } else { %>
                <div class="text-gray-800 dark:text-gray-200 leading-relaxed whitespace-pre-line space-y-4 blog-content">
                  <%- blog.content.replace(/\n/g, '<br>') %>
                </div>
              <% } %>
            </div>
          </article>

          <!-- Further Reading Links -->
          <% if (blog.externalLinks && blog.externalLinks.length) { %>
            <div class="mb-12 bg-[#C9A227]/5 dark:bg-[#C9A227]/10 rounded-2xl border border-[#C9A227]/20 p-6" data-aos="fade-up">
              <h4 class="font-semibold text-gray-800 dark:text-white mb-3">
                <i class="fas fa-link text-[#C9A227] mr-2"></i>Further Reading
              </h4>
              <ul class="space-y-2">
                <% blog.externalLinks.forEach(link => { %>
                  <li>
                    <a href="<%= link %>" target="_blank" rel="noopener noreferrer" 
                       class="text-sm text-[#C9A227] hover:underline break-all">
                      <i class="fas fa-arrow-up-right-from-square text-xs mr-2"></i><%= link %>
                    </a>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <!-- Bottom Engagement Bar -->
          <div class="flex items-center justify-between flex-wrap gap-4 mb-10 p-5 bg-[#C9A227]/5 dark:bg-[#C9A227]/10 rounded-2xl border border-[#C9A227]/20">
            <p class="text-sm text-gray-600 dark:text-gray-400">
              <i class="fas fa-heart text-[#C9A227] mr-2"></i>Found this useful? Let others know.
            </p>
            <div class="flex items-center gap-3">
              <button onclick="toggleLike('<%= blog._id %>')" 
                      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 hover:border-[#C9A227] hover:text-[#C9A227] transition-colors">
                <i class="far fa-heart"></i> Like
              </button>
              <button onclick="openShareModal()" 
                      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-[#C9A227] to-[#B8901E] text-white text-sm hover:from-[#B8901E] hover:to-[#A07A1A] transition-colors shadow-md">
                <i class="fas fa-share-alt"></i> Share
              </button>
            </div>
          </div>

          <!-- Author Bio Section -->
          <% if (blog.author) { %>
            <div class="mb-10 p-6 bg-gradient-to-r from-[#C9A227]/5 to-[#C9A227]/10 dark:from-[#C9A227]/10 dark:to-[#C9A227]/20 rounded-2xl border border-[#C9A227]/20" data-aos="fade-up">
              <div class="flex items-start gap-5">
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-[#C9A227] to-[#B8901E] flex items-center justify-center text-white font-bold text-2xl shadow-lg flex-shrink-0">
                  <%= (blog.author.name || blog.author.username || 'U').charAt(0).toUpperCase() %>
                </div>
                <div>
                  <h4 class="font-bold text-gray-900 dark:text-white text-lg">
                    <%= blog.author.name || blog.author.username || "Author" %>
                  </h4>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
                    <i class="fas fa-pen-fancy text-[#C9A227] mr-1"></i> Blog Author
                  </p>
                  <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    Passionate about sharing knowledge and insights with the InstituteHub community.
                  </p>
                  <div class="mt-3 flex gap-3">
                    <a href="/blogs?author=<%= blog.author._id %>" 
                       class="text-xs text-[#C9A227] hover:underline font-medium">
                      <i class="fas fa-book"></i> View all posts
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <!-- Author Actions -->
          <% if (currUser && blog.author && currUser._id.equals(blog.author._id)) { %>
            <div class="flex flex-wrap gap-3 mb-8 p-6 bg-gradient-to-r from-[#C9A227]/10 to-[#C9A227]/5 dark:from-[#C9A227]/20 dark:to-[#C9A227]/10 rounded-2xl border border-[#C9A227]/20" data-aos="fade-up" data-aos-delay="250">
              <div class="flex-1">
                <h4 class="font-semibold text-gray-800 dark:text-white mb-1">
                  <i class="fas fa-crown text-[#C9A227] mr-2"></i>Author Controls
                </h4>
                <p class="text-sm text-gray-600 dark:text-gray-400">Manage your blog post</p>
              </div>
              <div class="flex gap-3 flex-wrap">
                <a href="/blogs/<%= blog._id %>/views"
                   class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-[#C9A227]/10 dark:hover:bg-[#C9A227]/20 hover:border-[#C9A227] transition-colors shadow-sm">
                  <i class="fas fa-chart-line text-[#C9A227]"></i> Insights
                </a>
                <a href="/blogs/<%= blog._id %>/edit"
                   class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-gray-700 border border-[#C9A227]/40 text-[#C9A227] rounded-xl hover:bg-[#C9A227]/10 dark:hover:bg-[#C9A227]/20 transition-colors shadow-sm">
                  <i class="fas fa-edit"></i> Edit
                </a>
                <button type="button"
                        onclick="openDeleteModal()"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-xl hover:from-red-600 hover:to-red-700 transition-colors shadow-sm">
                  <i class="fas fa-trash-alt"></i> Delete
                </button>
              </div>
            </div>
          <% } %>

          <!-- Comments Section -->
          <div id="comments-section" class="space-y-8" data-aos="fade-up" data-aos-delay="300">
            
            <!-- Comment Form -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
                <i class="far fa-comment text-[#C9A227] mr-2"></i> Leave a Comment
              </h3>

              <% if(currUser){ %>
                <form action="/blogs/<%= blog._id %>/comments" method="POST" class="space-y-4">
                  <textarea
                    id="commentInput"
                    name="text"
                    rows="4"
                    maxlength="1000"
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-[#C9A227] dark:focus:border-[#C9A227] transition-colors bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                    placeholder="Share your thoughts, insights, or feedback..."
                    required
                  ></textarea>
                  <div class="flex items-center justify-between">
                    <span class="text-xs text-gray-400 dark:text-gray-500">Max 1000 characters</span>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-[#C9A227] to-[#B8901E] text-white font-medium rounded-xl hover:from-[#B8901E] hover:to-[#A07A1A] transition-all duration-300 shadow-lg hover:shadow-xl">
                      <i class="fas fa-paper-plane"></i>
                      Post Comment
                    </button>
                  </div>
                </form>
              <% } else { %>
                <div class="bg-[#C9A227]/5 dark:bg-[#C9A227]/10 border border-[#C9A227]/30 rounded-xl p-6">
                  <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 mt-0.5">
                      <i class="fas fa-comment-alt text-[#C9A227] text-2xl"></i>
                    </div>
                    <div>
                      <h3 class="text-lg font-semibold text-gray-800 dark:text-white">Join the Conversation</h3>
                      <p class="text-gray-600 dark:text-gray-400 mt-1">
                        Please <a href="/login" class="font-medium text-[#C9A227] hover:text-[#B8901E]">log in</a> or
                        <a href="/signup" class="font-medium text-[#C9A227] hover:text-[#B8901E]">create an account</a>
                        to leave a comment and engage with the community.
                      </p>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Comments List -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                  <i class="far fa-comments text-[#C9A227] mr-2"></i> Comments (<%= blog.comments.length %>)
                </h3>
              </div>

              <% if (blog.comments.length === 0) { %>
                <div class="text-center py-12">
                  <div class="inline-block p-6 bg-[#C9A227]/5 dark:bg-[#C9A227]/10 rounded-2xl mb-4">
                    <i class="fas fa-comment-slash text-4xl text-[#C9A227]"></i>
                  </div>
                  <h4 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">No comments yet</h4>
                  <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto">
                    Be the first to share your thoughts and start the discussion.
                  </p>
                </div>
              <% } else { %>
                <div class="space-y-6">
                  <% comments.forEach(comment => { %>
                    <div class="group p-5 bg-gray-50 dark:bg-gray-700/30 rounded-xl hover:bg-white dark:hover:bg-gray-700/50 border border-gray-100 dark:border-gray-700 hover:border-[#C9A227]/40 transition-all duration-300">
                      <div class="flex items-start justify-between mb-3">
                        <div class="flex items-center gap-3">
                          <div class="w-10 h-10 rounded-full bg-gradient-to-r from-[#C9A227] to-[#B8901E] flex items-center justify-center text-white font-medium flex-shrink-0 shadow-sm">
                            <% if (comment.user) { %>
                              <%= (comment.user.name || comment.user.username || 'U').charAt(0).toUpperCase() %>
                            <% } else { %>
                              <i class="fas fa-user"></i>
                            <% } %>
                          </div>
                          <div>
                            <h5 class="font-semibold text-gray-800 dark:text-white">
                              <% if (comment.user) { %>
                                <%= comment.user.name || comment.user.username || "Unnamed User" %>
                              <% } else { %>
                                <span class="italic text-gray-500 dark:text-gray-400">Deleted User</span>
                              <% } %>
                            </h5>
                            <div class="flex items-center text-xs text-gray-500 dark:text-gray-400">
                              <i class="far fa-clock mr-1"></i>
                              <%= new Date(comment.createdAt).toLocaleString('en-IN', {
                                timeZone: 'Asia/Kolkata',
                                dateStyle: 'medium',
                                timeStyle: 'short'
                              }) %>
                            </div>
                          </div>
                        </div>

                        <% if(currUser && comment.user && currUser._id.equals(comment.user._id)){ %>
                          <form action="/blogs/<%= blog._id %>/comments/<%= comment._id %>?_method=DELETE"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this comment?');">
                            <button type="submit"
                                    class="text-red-500 hover:text-red-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                              <i class="fas fa-trash-alt"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>

                      <div class="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line">
                        <%- comment.text.replace(/\n/g, '<br>') %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Related Blogs -->
          <% if (relatedBlogs && relatedBlogs.length > 0) { %>
            <div class="mt-16" data-aos="fade-up" data-aos-delay="400">
              <div class="flex items-center justify-between mb-8">
                <div>
                  <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">More Reads</span>
                  <h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
                    More in "<%= blog.category %>"
                  </h3>
                </div>
                <a href="/blogs?category=<%= blog.category %>"
                   class="inline-flex items-center gap-2 text-[#C9A227] hover:text-[#B8901E] font-medium transition-colors">
                  View All
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% relatedBlogs.slice(0, 4).forEach(relatedBlog => { %>
                  <div class="group bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden hover:shadow-xl hover:border-[#C9A227]/40 transition-all duration-500 hover:-translate-y-2">
                    <div class="relative h-48 overflow-hidden">
                      <img src="<%= (relatedBlog.image && relatedBlog.image.url) ? relatedBlog.image.url : '/images/default-blog.jpg' %>"
                           alt="<%= relatedBlog.title %>"
                           class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                           loading="lazy">
                      <div class="absolute top-3 left-3">
                        <span class="px-3 py-1 bg-[#C9A227] text-white text-xs font-semibold rounded-full shadow-md">
                          <%= relatedBlog.category %>
                        </span>
                      </div>
                      <div class="absolute bottom-3 right-3 bg-black/50 backdrop-blur-sm px-2.5 py-1 rounded-lg text-white text-xs">
                        <i class="far fa-clock mr-1"></i> <%= Math.max(1, Math.ceil((relatedBlog.content || "").replace(/<[^>]*>/g, " ").trim().split(/\s+/).length / 200)) %> min
                      </div>
                    </div>

                    <div class="p-5">
                      <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 line-clamp-2 group-hover:text-[#C9A227] transition-colors">
                        <a href="/blogs/<%= relatedBlog.id && relatedBlog.id.trim() !== '' ? relatedBlog.id : relatedBlog._id %>">
                          <%= relatedBlog.title %>
                        </a>
                      </h4>
                      <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2">
                        <%= relatedBlog.shortdescription && relatedBlog.shortdescription.length > 120
                            ? relatedBlog.shortdescription.substring(0, 120) + '...'
                            : relatedBlog.shortdescription || 'No description available.' %>
                      </p>

                      <div class="flex items-center justify-between pt-3 border-t border-gray-100 dark:border-gray-700">
                        <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                          <div class="w-6 h-6 rounded-full bg-gradient-to-r from-[#C9A227] to-[#B8901E] flex items-center justify-center text-white text-xs font-medium mr-2 shadow-sm">
                            <% if (relatedBlog.author) { %>
                              <%= (relatedBlog.author.name || relatedBlog.author.username || 'A').charAt(0).toUpperCase() %>
                            <% } else { %>
                              <i class="fas fa-user"></i>
                            <% } %>
                          </div>
                          <span class="truncate max-w-[100px]">
                            <%= relatedBlog.author?.name || relatedBlog.author?.username || 'Unknown' %>
                          </span>
                        </div>

                        <a href="/blogs/<%= relatedBlog.id && relatedBlog.id.trim() !== '' ? relatedBlog.id : relatedBlog._id %>"
                           class="text-sm font-medium text-[#C9A227] hover:text-[#B8901E] flex items-center gap-1 transition-colors">
                          Read
                          <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- ============ RIGHT RAIL ============ -->
        <aside class="hidden lg:block sticky top-28 space-y-5">
          
          <!-- Table of Contents -->
          <div id="tocContainer" class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-md transition-all duration-300">
            <h4 class="text-sm font-bold uppercase tracking-wider text-[#C9A227] mb-3 flex items-center gap-2">
              <i class="fas fa-list-ul"></i> On This Page
            </h4>
            <ul id="tocList" class="space-y-0.5 max-h-[50vh] overflow-y-auto pr-1"></ul>
          </div>

          <!-- Newsletter Subscribe -->
          <div class="bg-gradient-to-br from-[#C9A227] to-[#B8901E] rounded-2xl p-5 text-white shadow-lg hover:shadow-xl transition-all duration-300">
            <h4 class="font-semibold mb-1 flex items-center gap-2">
              <i class="fas fa-bell"></i> Stay Updated
            </h4>
            <p class="text-sm text-white/80 mb-3">Get the latest insights in your inbox.</p>
            <form id="newsletterForm" class="space-y-2" onsubmit="return false;">
              <input type="email"
                     id="newsletterEmail"
                     name="email"
                     required
                     placeholder="you@example.com"
                     class="w-full px-3 py-2 rounded-lg text-sm text-gray-900 placeholder-gray-400 border border-white/30 focus:outline-none focus:ring-2 focus:ring-white/60 bg-white/90">
              <button type="button"
                      id="newsletterBtn"
                      onclick="handleSubscribe(document.getElementById('newsletterEmail').value)"
                      class="inline-flex items-center justify-center w-full px-4 py-2 bg-white text-[#C9A227] text-sm font-semibold rounded-xl hover:bg-white/90 transition-colors disabled:opacity-70 shadow-md">
                Subscribe
              </button>
              <p id="newsletterMsg" class="text-xs mt-1 hidden"></p>
            </form>
          </div>

          <!-- Engagement Card -->
          <% if (currUser) { %>
            <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-md transition-all duration-300">
              <h4 class="font-semibold text-gray-800 dark:text-white mb-1 flex items-center gap-2">
                <i class="far fa-comment-dots text-[#C9A227]"></i>Got thoughts?
              </h4>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Join the discussion below.</p>
              <a href="#comments-section"
                 onclick="setTimeout(() => document.getElementById('commentInput')?.focus(), 400)"
                 class="inline-flex items-center justify-center w-full px-4 py-2 bg-[#C9A227]/10 dark:bg-[#C9A227]/20 text-[#C9A227] text-sm font-semibold rounded-xl hover:bg-[#C9A227]/20 dark:hover:bg-[#C9A227]/30 transition-colors border border-[#C9A227]/30">
                <i class="fas fa-pen mr-2"></i> Write a Comment
              </a>
              <a href="/blogs/saved"
                 class="inline-flex items-center justify-center gap-1.5 w-full px-4 py-2 mt-2 text-sm text-gray-600 dark:text-gray-400 hover:text-[#C9A227] transition-colors">
                <i class="far fa-bookmark text-xs"></i> View Saved Blogs
              </a>
            </div>
          <% } else { %>
            <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-md transition-all duration-300">
              <h4 class="font-semibold text-gray-800 dark:text-white mb-1 flex items-center gap-2">
                <i class="fas fa-user-lock text-[#C9A227]"></i>Join the Conversation
              </h4>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Log in to like, comment, and bookmark.</p>
              <div class="flex gap-2">
                <a href="/login" class="flex-1 inline-flex items-center justify-center px-3 py-2 bg-gradient-to-r from-[#C9A227] to-[#B8901E] text-white text-sm font-semibold rounded-xl hover:from-[#B8901E] hover:to-[#A07A1A] transition-colors shadow-md">
                  Log In
                </a>
                <a href="/signup" class="flex-1 inline-flex items-center justify-center px-3 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-semibold rounded-xl hover:bg-[#C9A227]/10 dark:hover:bg-[#C9A227]/20 hover:border-[#C9A227] transition-colors">
                  Sign Up
                </a>
              </div>
            </div>
          <% } %>

          <!-- Explore Courses CTA -->
          <div class="bg-gradient-to-br from-[#0F172A] to-[#1E293B] rounded-2xl p-5 text-white shadow-lg hover:shadow-xl transition-all duration-300">
            <h4 class="font-semibold mb-1 flex items-center gap-2">
              <i class="fas fa-graduation-cap text-[#C9A227]"></i>Level Up Your Skills
            </h4>
            <p class="text-sm text-white/80 mb-3">Explore our premium courses & certifications.</p>
            <a href="/courses" class="inline-flex items-center justify-center gap-2 w-full px-4 py-2 bg-[#C9A227] text-[#0F172A] text-sm font-semibold rounded-xl hover:bg-[#E6C35A] transition-colors shadow-md">
              Explore Courses <i class="fas fa-arrow-right text-xs"></i>
            </a>
          </div>
        </aside>

      </div>
    <% } %>
  </div>
</div>

<!-- Back to Top Button -->
<button id="backToTop" onclick="window.scrollTo({top:0, behavior:'smooth'})"
        class="fixed bottom-6 right-6 z-40 hidden items-center justify-center w-11 h-11 rounded-full bg-[#C9A227] text-white shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-300">
  <i class="fas fa-arrow-up"></i>
</button>

<% } else { %>
  <!-- Blog Not Found -->
  <div class="min-h-[80vh] flex items-center justify-center bg-gray-50 dark:bg-gray-900 px-4">
    <div class="text-center">
      <div class="inline-block p-6 bg-[#C9A227]/10 dark:bg-[#C9A227]/20 rounded-2xl mb-6">
        <i class="fas fa-exclamation-triangle text-5xl text-[#C9A227]"></i>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Blog Not Found</h1>
      <p class="text-gray-600 dark:text-gray-400 max-w-md mx-auto mb-8">
        The blog you are looking for does not exist or has been deleted.
      </p>
      <a href="/blogs"
         class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-[#C9A227] to-[#B8901E] text-white font-medium rounded-xl hover:from-[#B8901E] hover:to-[#A07A1A] transition-all duration-300 shadow-lg hover:shadow-xl">
        <i class="fas fa-arrow-left"></i> Back to Blogs
      </a>
    </div>
  </div>
<% } %>

<!-- ============================================================ -->
<!-- SUBSCRIBE OTP MODAL                                           -->
<!-- ============================================================ -->
<div id="otpModal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity"></div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4 text-center">
      <div id="otpModalContent" class="relative transform overflow-hidden rounded-2xl bg-white dark:bg-gray-800 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md w-full">

        <!-- Header -->
        <div class="bg-gradient-to-r from-[#C9A227] to-[#B8901E] px-6 py-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <i class="fas fa-envelope"></i> Verify Subscription
            </h3>
            <button type="button" onclick="closeOTPModal()" class="text-white hover:text-gray-200 transition-colors">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
          <p class="text-sm text-white/80 mt-1" id="otpEmailDisplay">Verifying email@example.com</p>
        </div>

        <!-- Body -->
        <div class="px-6 py-6">
          <!-- Status Messages -->
          <div id="otpStatus" class="hidden p-3 rounded-xl mb-4 text-sm"></div>

          <!-- OTP Input -->
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Enter 6-digit OTP sent to your email
              </label>
              <div class="flex gap-2 justify-center">
                <input type="text" id="otp1" maxlength="1" class="otp-input w-12 h-14 text-center text-2xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all" onkeyup="moveOTP(this, 'otp2')">
                <input type="text" id="otp2" maxlength="1" class="otp-input w-12 h-14 text-center text-2xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all" onkeyup="moveOTP(this, 'otp3')">
                <input type="text" id="otp3" maxlength="1" class="otp-input w-12 h-14 text-center text-2xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all" onkeyup="moveOTP(this, 'otp4')">
                <input type="text" id="otp4" maxlength="1" class="otp-input w-12 h-14 text-center text-2xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all" onkeyup="moveOTP(this, 'otp5')">
                <input type="text" id="otp5" maxlength="1" class="otp-input w-12 h-14 text-center text-2xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all" onkeyup="moveOTP(this, 'otp6')">
                <input type="text" id="otp6" maxlength="1" class="otp-input w-12 h-14 text-center text-2xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all" onkeyup="moveOTP(this, null)" onkeydown="handleOTPBackspace(event, 'otp5')">
              </div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 text-center">
                <span id="otpTimer">OTP expires in <span class="font-bold text-[#C9A227]" id="otpTimerCount">10:00</span></span>
              </p>
            </div>

            <!-- Resend -->
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500 dark:text-gray-400">Didn't receive OTP?</span>
              <button id="resendOTPBtn" onclick="resendOTP()" 
                      class="text-[#C9A227] font-semibold hover:text-[#B8901E] transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Resend OTP
              </button>
            </div>
            <p id="resendStatus" class="text-xs text-gray-500 dark:text-gray-400 hidden"></p>

            <!-- Actions -->
            <div class="flex gap-3 mt-4">
              <button type="button" onclick="closeOTPModal()" 
                      class="flex-1 px-4 py-2.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
                Cancel
              </button>
              <button type="button" id="verifyOTPBtn" onclick="verifyOTP()" 
                      class="flex-1 px-4 py-2.5 bg-gradient-to-r from-[#C9A227] to-[#B8901E] text-white font-semibold rounded-xl hover:from-[#B8901E] hover:to-[#A07A1A] transition-all duration-300 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="fas fa-check mr-2"></i> Verify
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================ -->
<!-- SCRIPTS                                                       -->
<!-- ============================================================ -->
<script>
// ============ SHARE MODAL ============
function openShareModal() {
  document.getElementById('shareModal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeShareModal() {
  document.getElementById('shareModal').classList.add('hidden');
  document.body.style.overflow = 'auto';
}

// ============ DELETE MODAL ============
function openDeleteModal() {
  document.getElementById('deleteModal<%= blog && blog._id ? blog._id : "" %>').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeDeleteModal() {
  document.getElementById('deleteModal<%= blog && blog._id ? blog._id : "" %>').classList.add('hidden');
  document.body.style.overflow = 'auto';
}

// ============ COPY TO CLIPBOARD ============
function copyToClipboard() {
  const url = document.getElementById('shareUrl').value;
  const copyBtn = document.getElementById('copyBtn');

  navigator.clipboard.writeText(url).then(() => {
    const originalHTML = copyBtn.innerHTML;
    copyBtn.innerHTML = '<i class="fas fa-check text-lg w-6 text-center"></i> Copied!';
    copyBtn.classList.remove('from-[#C9A227]', 'to-[#B8901E]', 'hover:from-[#B8901E]', 'hover:to-[#A07A1A]');
    copyBtn.classList.add('from-green-500', 'to-green-600', 'hover:from-green-600', 'hover:to-green-700');

    setTimeout(() => {
      copyBtn.innerHTML = originalHTML;
      copyBtn.classList.remove('from-green-500', 'to-green-600', 'hover:from-green-600', 'hover:to-green-700');
      copyBtn.classList.add('from-[#C9A227]', 'to-[#B8901E]', 'hover:from-[#B8901E]', 'hover:to-[#A07A1A]');
    }, 2000);
  }).catch(() => {
    alert('Failed to copy link to clipboard');
  });
}

// ============ CLOSE MODALS ON ESCAPE ============
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeShareModal();
    closeDeleteModal();
  }
});

document.addEventListener('click', (e) => {
  const shareModal = document.getElementById('shareModal');
  const deleteModal = document.getElementById('deleteModal<%= blog && blog._id ? blog._id : "" %>');
  if (shareModal && !shareModal.classList.contains('hidden') && e.target === shareModal) closeShareModal();
  if (deleteModal && !deleteModal.classList.contains('hidden') && e.target === deleteModal) closeDeleteModal();
});

// ============ PREVENT DOUBLE SUBMIT ============
document.querySelectorAll('form').forEach(form => {
  form.addEventListener('submit', function(e) {
    const submitBtn = this.querySelector('button[type="submit"]');
    if (submitBtn && submitBtn.classList.contains('submitting')) {
      e.preventDefault();
      return;
    }
    if (submitBtn) {
      submitBtn.classList.add('submitting');
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Processing...';
    }
  });
});

// ============ LAZY LOAD IMAGES ============
document.querySelectorAll('.blog-content img').forEach(img => {
  img.classList.add('rounded-lg', 'shadow-md', 'my-4');
  img.loading = 'lazy';
});

// ============ READING PROGRESS BAR ============
(function () {
  const bar = document.getElementById('readingProgress');
  if (!bar) return;
  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    bar.style.width = Math.min(100, Math.max(0, progress)) + '%';

    const backToTop = document.getElementById('backToTop');
    if (backToTop) backToTop.classList.toggle('hidden', scrollTop < 400);
    if (backToTop) backToTop.classList.toggle('flex', scrollTop >= 400);
  });
})();

// ============ TABLE OF CONTENTS ============
(function () {
  const content = document.querySelector('.blog-content');
  const tocList = document.getElementById('tocList');
  const tocContainer = document.getElementById('tocContainer');
  if (!content || !tocList) return;

  const headings = content.querySelectorAll('h2, h3, h4');
  if (headings.length < 2) {
    if (tocContainer) tocContainer.classList.add('hidden');
    return;
  }

  const links = [];
  headings.forEach((h, i) => {
    const id = 'toc-section-' + i;
    h.id = id;

    const li = document.createElement('li');
    if (h.tagName === 'H3') li.className = 'pl-3';
    if (h.tagName === 'H4') li.className = 'pl-6';

    const a = document.createElement('a');
    a.href = '#' + id;
    a.textContent = h.textContent;
    a.dataset.target = id;
    a.className = 'toc-link block py-1.5 text-sm text-gray-600 dark:text-gray-400 hover:text-[#C9A227] dark:hover:text-[#C9A227] border-l-2 border-transparent hover:border-[#C9A227] pl-3 -ml-px transition-colors truncate';

    a.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById(id).scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    li.appendChild(a);
    tocList.appendChild(li);
    links.push({ id, el: a });
  });

  const setActive = (id) => {
    links.forEach(l => {
      const active = l.id === id;
      l.el.classList.toggle('text-[#C9A227]', active);
      l.el.classList.toggle('dark:text-[#C9A227]', active);
      l.el.classList.toggle('border-[#C9A227]', active);
      l.el.classList.toggle('font-semibold', active);
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  headings.forEach(h => observer.observe(h));
})();

// ============ LIKE TOGGLE ============
function toggleLike(blogId) {
  const btn = document.getElementById('likeBtn');
  const btnMobile = document.getElementById('likeBtnMobile');
  const countEl = document.getElementById('likeCount');
  const countMobileEl = document.getElementById('likeCountMobile');

  fetch('/blogs/' + blogId + '/like', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
    .then(res => {
      if (!res.ok) throw new Error('Request failed');
      return res.json();
    })
    .then(data => {
      const liked = data.liked;
      const count = data.likesCount;
      if (countEl) countEl.textContent = count;
      if (countMobileEl) countMobileEl.textContent = count;

      [btn, btnMobile].forEach(el => {
        if (!el) return;
        const icon = el.querySelector('i');
        if (liked) {
          icon.classList.remove('far');
          icon.classList.add('fas', 'text-[#C9A227]');
          el.classList.add('border-[#C9A227]/40', 'bg-[#C9A227]/10');
        } else {
          icon.classList.remove('fas', 'text-[#C9A227]');
          icon.classList.add('far');
          el.classList.remove('border-[#C9A227]/40', 'bg-[#C9A227]/10');
        }
      });
    })
    .catch(() => {
      window.location.href = '/login';
    });
}

// ============ BOOKMARK TOGGLE ============
(function () {
  const blogId = "<%= blog && blog._id ? blog._id : '' %>";
  if (!blogId) return;

  const isUserLoggedIn = `<%= currUser ? 'true' : 'false' %>`;
  const icon = document.getElementById('bookmarkIcon');
  const iconMobile = document.getElementById('bookmarkIconMobile');

  const paint = (saved) => {
    [icon, iconMobile].forEach(el => {
      if (!el) return;
      el.classList.toggle('fas', saved);
      el.classList.toggle('far', !saved);
      el.classList.toggle('text-[#C9A227]', saved);
    });
  };

  if (isUserLoggedIn) {
    fetch('/blogs/' + blogId + '/saved-status')
      .then(res => (res.ok ? res.json() : null))
      .then(data => {
        if (data) paint(!!data.saved);
      })
      .catch(() => {});
  }

  window.toggleBookmark = function () {
    if (!isUserLoggedIn) {
      window.location.href = '/login';
      return;
    }

    const currentlySaved = icon ? icon.classList.contains('fas') : iconMobile && iconMobile.classList.contains('fas');
    paint(!currentlySaved);

    fetch('/blogs/' + blogId + '/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
      .then(res => {
        if (!res.ok) throw new Error('Request failed');
        return res.json();
      })
      .then(data => {
        paint(!!data.saved);
      })
      .catch(() => {
        paint(currentlySaved);
        window.location.href = '/login';
      });
  };
})();


// ============================================================ //
// SUBSCRIBE OTP MODAL HANDLER                                   //
// ============================================================ //

let otpEmail = '';
let otpTimerInterval = null;
let otpCooldown = false;

// ── Open OTP Modal ──
function openOTPModal(email) {
  otpEmail = email;
  document.getElementById('otpEmailDisplay').textContent = `Verifying ${email}`;
  document.getElementById('otpModal').classList.remove('hidden');
  document.getElementById('otpModal').classList.add('flex');
  document.body.style.overflow = 'hidden';
  
  // Clear OTP inputs
  for (let i = 1; i <= 6; i++) {
    const input = document.getElementById(`otp${i}`);
    if (input) {
      input.value = '';
    }
  }
  setTimeout(() => document.getElementById('otp1')?.focus(), 100);
  
  // Hide status
  const status = document.getElementById('otpStatus');
  if (status) status.classList.add('hidden');
  
  // Reset resend button
  const resendBtn = document.getElementById('resendOTPBtn');
  if (resendBtn) {
    resendBtn.disabled = true;
    resendBtn.textContent = 'Resend OTP';
  }
  
  // Start timer
  startOTPTimer(10);
}

// ── Close OTP Modal ──
function closeOTPModal() {
  document.getElementById('otpModal').classList.add('hidden');
  document.getElementById('otpModal').classList.remove('flex');
  document.body.style.overflow = 'auto';
  if (otpTimerInterval) {
    clearInterval(otpTimerInterval);
    otpTimerInterval = null;
  }
}

// ── OTP Input Navigation ──
function moveOTP(current, nextId) {
  if (current.value.length === 1 && nextId) {
    const next = document.getElementById(nextId);
    if (next) next.focus();
  }
}

function handleOTPBackspace(event, prevId) {
  if (event.key === 'Backspace' && event.target.value === '' && prevId) {
    const prev = document.getElementById(prevId);
    if (prev) {
      prev.focus();
      prev.select();
    }
  }
}

// ── OTP Timer ──
function startOTPTimer(minutes) {
  let totalSeconds = minutes * 60;
  const timerDisplay = document.getElementById('otpTimerCount');
  const resendBtn = document.getElementById('resendOTPBtn');
  
  if (otpTimerInterval) clearInterval(otpTimerInterval);
  
  if (resendBtn) resendBtn.disabled = true;
  updateTimerDisplay(totalSeconds);
  
  otpTimerInterval = setInterval(() => {
    totalSeconds--;
    updateTimerDisplay(totalSeconds);
    
    if (totalSeconds <= 0) {
      clearInterval(otpTimerInterval);
      otpTimerInterval = null;
      if (resendBtn) {
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend OTP';
      }
      if (timerDisplay) timerDisplay.textContent = 'Expired';
    }
  }, 1000);
}

function updateTimerDisplay(seconds) {
  const mins = Math.floor(seconds / 60);
  const secs = seconds % 60;
  const timerDisplay = document.getElementById('otpTimerCount');
  if (timerDisplay) {
    timerDisplay.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }
}

// ── Verify OTP ──
async function verifyOTP() {
  // Get OTP from inputs
  let otp = '';
  for (let i = 1; i <= 6; i++) {
    const input = document.getElementById(`otp${i}`);
    if (input) otp += input.value;
  }
  
  if (otp.length !== 6) {
    showOTPStatus('Please enter all 6 digits of the OTP.', 'error');
    return;
  }
  
  const btn = document.getElementById('verifyOTPBtn');
  if (!btn) return;
  
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Verifying...';
  
  try {
    const response = await fetch('/api/verify-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: otpEmail, otp: otp })
    });
    
    const data = await response.json();
    
    if (data.success) {
      showOTPStatus('🎉 ' + data.message, 'success');
      setTimeout(() => {
        closeOTPModal();
        showToast('✅ Successfully subscribed to newsletter!', 'success');
      }, 1500);
    } else {
      showOTPStatus(data.message, 'error');
      if (data.expired) {
        const resendBtn = document.getElementById('resendOTPBtn');
        if (resendBtn) resendBtn.disabled = false;
      }
      if (data.attemptsRemaining !== undefined) {
        showOTPStatus(`${data.message} (${data.attemptsRemaining} attempts remaining)`, 'error');
      }
    }
  } catch (error) {
    showOTPStatus('Unable to verify OTP. Please try again.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-check mr-2"></i> Verify';
  }
}

// ── Resend OTP ──
async function resendOTP() {
  const btn = document.getElementById('resendOTPBtn');
  const status = document.getElementById('resendStatus');
  
  if (!btn) return;
  
  btn.disabled = true;
  btn.textContent = 'Sending...';
  if (status) {
    status.classList.remove('hidden');
    status.textContent = 'Sending new OTP...';
    status.className = 'text-xs text-gray-500 dark:text-gray-400';
  }
  
  try {
    const response = await fetch('/api/resend-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: otpEmail })
    });
    
    const data = await response.json();
    
    if (data.success) {
      if (status) {
        status.textContent = '✅ ' + data.message;
        status.className = 'text-xs text-green-600 dark:text-green-400';
      }
      startOTPTimer(10);
      // Clear OTP inputs
      for (let i = 1; i <= 6; i++) {
        const input = document.getElementById(`otp${i}`);
        if (input) input.value = '';
      }
      setTimeout(() => document.getElementById('otp1')?.focus(), 100);
    } else {
      if (status) {
        status.textContent = '❌ ' + data.message;
        status.className = 'text-xs text-red-600 dark:text-red-400';
      }
      if (data.cooldownSeconds) {
        btn.textContent = `Wait ${data.cooldownSeconds}s`;
        setTimeout(() => {
          btn.textContent = 'Resend OTP';
          btn.disabled = false;
        }, data.cooldownSeconds * 1000);
        return;
      } else {
        btn.disabled = false;
        btn.textContent = 'Resend OTP';
      }
    }
  } catch (error) {
    if (status) {
      status.textContent = '❌ Unable to resend OTP. Please try again.';
      status.className = 'text-xs text-red-600 dark:text-red-400';
    }
    btn.disabled = false;
    btn.textContent = 'Resend OTP';
  }
}

// ── Show OTP Status ──
function showOTPStatus(message, type) {
  const statusEl = document.getElementById('otpStatus');
  if (!statusEl) return;
  
  statusEl.classList.remove('hidden', 'bg-green-50', 'dark:bg-green-900/20', 'text-green-700', 'dark:text-green-300', 'bg-red-50', 'dark:bg-red-900/20', 'text-red-700', 'dark:text-red-300', 'bg-yellow-50', 'dark:bg-yellow-900/20', 'text-yellow-700', 'dark:text-yellow-300');
  statusEl.textContent = message;
  
  if (type === 'success') {
    statusEl.classList.add('bg-green-50', 'dark:bg-green-900/20', 'text-green-700', 'dark:text-green-300');
  } else if (type === 'error') {
    statusEl.classList.add('bg-red-50', 'dark:bg-red-900/20', 'text-red-700', 'dark:text-red-300');
  } else {
    statusEl.classList.add('bg-yellow-50', 'dark:bg-yellow-900/20', 'text-yellow-700', 'dark:text-yellow-300');
  }
}

// ── Toast Notification ──
function showToast(message, type = 'success') {
  // Remove existing toast
  const existing = document.querySelector('.toast-notification');
  if (existing) existing.remove();
  
  const toast = document.createElement('div');
  const colors = {
    success: 'bg-emerald-500',
    error: 'bg-red-500',
    warning: 'bg-amber-500',
    info: 'bg-blue-500'
  };
  const icons = {
    success: 'fa-check-circle',
    error: 'fa-exclamation-circle',
    warning: 'fa-triangle-exclamation',
    info: 'fa-info-circle'
  };
  
  toast.className = `toast-notification fixed bottom-6 left-1/2 -translate-x-1/2 z-[9999] px-6 py-4 ${colors[type] || colors.success} text-white rounded-2xl shadow-2xl flex items-center gap-3 transform transition-all duration-500 translate-y-20 opacity-0 max-w-[90%] sm:max-w-md`;
  toast.innerHTML = `
    <i class="fas ${icons[type] || icons.success} text-xl"></i>
    <span class="font-medium text-sm">${message}</span>
    <button onclick="this.parentElement.remove()" class="text-white/70 hover:text-white transition-colors ml-2">
      <i class="fas fa-times"></i>
    </button>
  `;
  document.body.appendChild(toast);
  
  requestAnimationFrame(() => {
    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
  });
  
  setTimeout(() => {
    toast.classList.remove('translate-y-0', 'opacity-100');
    toast.classList.add('translate-y-20', 'opacity-0');
    setTimeout(() => toast.remove(), 500);
  }, 5000);
}

// ── Subscribe Button Click ──
async function handleSubscribe(email) {
  if (!email) {
    showToast('Please enter your email address.', 'warning');
    return;
  }
  
  const btn = document.getElementById('newsletterBtn');
  if (!btn) return;
  
  btn.disabled = true;
  const originalText = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Sending...';
  
  try {
    const response = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email })
    });
    
    const data = await response.json();
    
    if (data.success) {
      openOTPModal(email);
      showToast('📧 OTP sent to your email!', 'success');
    } else {
      if (data.hasPendingOtp) {
        openOTPModal(email);
        showToast('📧 OTP already sent. Check your email.', 'info');
      } else {
        showToast(data.message, 'error');
      }
    }
  } catch (error) {
    showToast('Unable to process subscription. Please try again.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalText || '<i class="fas fa-paper-plane mr-2"></i> Subscribe';
  }
}

// ── Close OTP Modal on outside click ──
document.addEventListener('click', (e) => {
  const otpModal = document.getElementById('otpModal');
  const otpContent = document.getElementById('otpModalContent');
  if (otpModal && !otpModal.classList.contains('hidden') && otpContent && !otpContent.contains(e.target)) {
    closeOTPModal();
  }
});
</script>

