</div>

<!-- Back to top -->
<button id="backToTop" onclick="window.scrollTo({top:0, behavior:'smooth'})"
        class="fixed bottom-6 right-6 z-40 hidden items-center justify-center w-11 h-11 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 shadow-lg hover:scale-105 transition-transform">
  <i class="fas fa-arrow-up"></i>
</button>

<% } else { %>
  <!-- Blog Not Found -->
  <div class="min-h-[80vh] flex items-center justify-center bg-gray-50 dark:bg-gray-900 px-4">
    <div class="text-center">
      <div class="inline-block p-6 bg-red-100 dark:bg-red-900/30 rounded-2xl mb-6">
        <i class="fas fa-exclamation-triangle text-5xl text-red-500 dark:text-red-400"></i>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Blog Not Found</h1>
      <p class="text-gray-600 dark:text-gray-400 max-w-md mx-auto mb-8">
        The blog you are looking for does not exist or has been deleted.
      </p>
      <a href="/blogs"
         class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-medium rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 shadow-lg hover:shadow-xl">
        <i class="fas fa-arrow-left"></i>
        Back to Blogs
      </a>
    </div>
  </div>
<% } %>

<script>
// ---------------- Share Modal ----------------
function openShareModal() {
  document.getElementById('shareModal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeShareModal() {
  document.getElementById('shareModal').classList.add('hidden');
  document.body.style.overflow = 'auto';
}

// ---------------- Delete Modal ----------------
function openDeleteModal() {
  document.getElementById('deleteModal<%= blog && blog._id ? blog._id : "" %>').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeDeleteModal() {
  document.getElementById('deleteModal<%= blog && blog._id ? blog._id : "" %>').classList.add('hidden');
  document.body.style.overflow = 'auto';
}

// ---------------- Copy to Clipboard ----------------
function copyToClipboard() {
  const url = document.getElementById('shareUrl').value;
  const copyBtn = document.getElementById('copyBtn');

  navigator.clipboard.writeText(url).then(() => {
    const originalHTML = copyBtn.innerHTML;
    copyBtn.innerHTML = '<i class="fas fa-check text-lg w-6 text-center"></i> Copied!';
    copyBtn.classList.remove('from-gray-600', 'to-gray-700', 'hover:from-gray-700', 'hover:to-gray-800');
    copyBtn.classList.add('from-green-500', 'to-green-600', 'hover:from-green-600', 'hover:to-green-700');

    setTimeout(() => {
      copyBtn.innerHTML = originalHTML;
      copyBtn.classList.remove('from-green-500', 'to-green-600', 'hover:from-green-600', 'hover:to-green-700');
      copyBtn.classList.add('from-gray-600', 'to-gray-700', 'hover:from-gray-700', 'hover:to-gray-800');
    }, 2000);
  }).catch(err => {
    console.error('Failed to copy: ', err);
    alert('Failed to copy link to clipboard');
  });
}

// ---------------- Close modals on Escape / outside click ----------------
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeShareModal();
    closeDeleteModal();
  }
});
document.addEventListener('click', (e) => {
  const shareModal = document.getElementById('shareModal');
  const deleteModal = document.getElementById('deleteModal<%= blog && blog._id ? blog._id : "" %>');
  if (shareModal && !shareModal.classList.contains('hidden') && e.target === shareModal) closeShareModal();
  if (deleteModal && !deleteModal.classList.contains('hidden') && e.target === deleteModal) closeDeleteModal();
});

// ---------------- Prevent double form submission ----------------
document.querySelectorAll('form').forEach(form => {
  form.addEventListener('submit', function(e) {
    const submitBtn = this.querySelector('button[type="submit"]');
    if (submitBtn && submitBtn.classList.contains('submitting')) {
      e.preventDefault();
      return;
    }
    if (submitBtn) {
      submitBtn.classList.add('submitting');
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Processing...';
    }
  });
});

// ---------------- Lazy-load + style images inside blog content ----------------
document.querySelectorAll('.blog-content img').forEach(img => {
  img.classList.add('rounded-lg', 'shadow-md', 'my-4');
  img.loading = 'lazy';
});

// ---------------- Reading progress bar ----------------
(function () {
  const bar = document.getElementById('readingProgress');
  if (!bar) return;
  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    bar.style.width = Math.min(100, Math.max(0, progress)) + '%';

    const backToTop = document.getElementById('backToTop');
    if (backToTop) backToTop.classList.toggle('hidden', scrollTop < 400);
    if (backToTop) backToTop.classList.toggle('flex', scrollTop >= 400);
  });
})();

// ---------------- Auto-generated Table of Contents ----------------
(function () {
  const content = document.querySelector('.blog-content');
  const tocList = document.getElementById('tocList');
  const tocContainer = document.getElementById('tocContainer');
  if (!content || !tocList) return;

  const headings = content.querySelectorAll('h2, h3');
  if (headings.length < 2) {
    if (tocContainer) tocContainer.classList.add('hidden');
    return;
  }

  const links = [];
  headings.forEach((h, i) => {
    const id = 'toc-section-' + i;
    h.id = id;

    const li = document.createElement('li');
    if (h.tagName === 'H3') li.className = 'pl-3';

    const a = document.createElement('a');
    a.href = '#' + id;
    a.textContent = h.textContent;
    a.dataset.target = id;
    a.className = 'toc-link block py-1.5 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 border-l-2 border-transparent hover:border-blue-400 pl-3 -ml-px transition-colors truncate';

    a.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById(id).scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    li.appendChild(a);
    tocList.appendChild(li);
    links.push({ id, el: a });
  });

  const setActive = (id) => {
    links.forEach(l => {
      const active = l.id === id;
      l.el.classList.toggle('text-blue-600', active);
      l.el.classList.toggle('dark:text-blue-400', active);
      l.el.classList.toggle('border-blue-500', active);
      l.el.classList.toggle('font-semibold', active);
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  headings.forEach(h => observer.observe(h));
})();

// ---------------- Like toggle ----------------
function toggleLike(blogId) {
  const btn = document.getElementById('likeBtn');
  const btnMobile = document.getElementById('likeBtnMobile');
  const countEl = document.getElementById('likeCount');
  const countMobileEl = document.getElementById('likeCountMobile');

  fetch('/blogs/' + blogId + '/like', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
    .then(res => {
      if (!res.ok) throw new Error('Request failed');
      return res.json();
    })
    .then(data => {
      const liked = data.liked;
      const count = data.likesCount;
      if (countEl) countEl.textContent = count;
      if (countMobileEl) countMobileEl.textContent = count;

      [btn, btnMobile].forEach(el => {
        if (!el) return;
        const icon = el.querySelector('i');
        if (liked) {
          icon.classList.remove('far');
          icon.classList.add('fas', 'text-rose-500');
          el.classList.add('border-rose-200', 'bg-rose-50');
        } else {
          icon.classList.remove('fas', 'text-rose-500');
          icon.classList.add('far');
          el.classList.remove('border-rose-200', 'bg-rose-50');
        }
      });
    })
    .catch(() => {
      window.location.href = '/login';
    });
}

// ---------------- Newsletter Subscribe (sidebar) ----------------
(function () {
  const form = document.getElementById('newsletterForm');
  if (!form) return;

  const emailInput = document.getElementById('newsletterEmail');
  const btn = document.getElementById('newsletterBtn');
  const msg = document.getElementById('newsletterMsg');

  const showMsg = (text, ok) => {
    msg.textContent = text;
    msg.classList.remove('hidden', 'text-emerald-200', 'text-rose-200');
    msg.classList.add(ok ? 'text-emerald-200' : 'text-rose-200');
  };

  form.addEventListener('submit', function () {
    const email = emailInput.value.trim();
    if (!email) return;

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Subscribing...';

    fetch('/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    })
      .then(res => res.json().then(data => ({ status: res.status, data })))
      .then(({ data }) => {
        showMsg(data.message, data.success);
        if (data.success) {
          emailInput.value = '';
        }
      })
      .catch(() => {
        showMsg('Something went wrong. Please try again.', false);
      })
      .finally(() => {
        btn.disabled = false;
        btn.textContent = originalText;
      });
  });
})();

// ---------------- Bookmark (synced with account via /save & /saved-status) ----------------
(function () {
  const blogId = "<%= blog && blog._id ? blog._id : '' %>";
  if (!blogId) return;

  const isUserLoggedIn = `<%= currUser ? 'true' : 'false' %>`;
  const icon = document.getElementById('bookmarkIcon');
  const iconMobile = document.getElementById('bookmarkIconMobile');

  const paint = (saved) => {
    [icon, iconMobile].forEach(el => {
      if (!el) return;
      el.classList.toggle('fas', saved);
      el.classList.toggle('far', !saved);
      el.classList.toggle('text-amber-500', saved);
    });
  };

  // On load, check saved status only if logged in
  if (isUserLoggedIn) {
    fetch('/blogs/' + blogId + '/saved-status')
      .then(res => (res.ok ? res.json() : null))
      .then(data => {
        if (data) paint(!!data.saved);
      })
      .catch(() => {});
  }

  window.toggleBookmark = function () {
    if (!isUserLoggedIn) {
      window.location.href = '/login';
      return;
    }

    // Optimistic toggle
    const currentlySaved = icon
      ? icon.classList.contains('fas')
      : iconMobile && iconMobile.classList.contains('fas');
    paint(!currentlySaved);

    fetch('/blogs/' + blogId + '/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
      .then(res => {
        if (!res.ok) throw new Error('Request failed');
        return res.json();
      })
      .then(data => {
        paint(!!data.saved);
      })
      .catch(() => {
        // revert on failure
        paint(currentlySaved);
        window.location.href = '/login';
      });
  };
})();

</script>

