            <h4 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
              <i class="fas fa-list-ul mr-2 text-blue-500"></i>On This Page
            </h4>
            <ul id="tocList" class="space-y-0.5 max-h-[50vh] overflow-y-auto pr-1"></ul>
          </div>

          <!-- Newsletter Subscribe (works via existing POST /subscribe API) -->
          <div class="bg-gradient-to-br from-cyan-600 to-indigo-600 rounded-2xl p-5 text-white shadow-sm">
            <h4 class="font-semibold mb-1"><i class="fas fa-bell mr-2"></i>Stay Updated</h4>
            <p class="text-sm text-white/80 mb-3">Get the latest cybersecurity insights in your inbox.</p>
            <form id="newsletterForm" class="space-y-2" onsubmit="return false;">
              <input type="email"
                     id="newsletterEmail"
                     name="email"
                     required
                     placeholder="you@example.com"
                     class="w-full px-3 py-2 rounded-lg text-sm text-gray-900 placeholder-gray-400 border border-white/20 focus:outline-none focus:ring-2 focus:ring-white/60">
              <button type="submit"
                      id="newsletterBtn"
                      class="inline-flex items-center justify-center w-full px-4 py-2 bg-white text-indigo-700 text-sm font-semibold rounded-xl hover:bg-white/90 transition-colors disabled:opacity-70">
                Subscribe
              </button>
              <p id="newsletterMsg" class="text-xs mt-1 hidden"></p>
            </form>
          </div>

          <!-- Engagement card: login CTA or quick-comment nudge -->
          <% if (currUser) { %>
            <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
              <h4 class="font-semibold text-gray-800 dark:text-white mb-1">
                <i class="far fa-comment-dots text-blue-500 mr-2"></i>Got thoughts?
              </h4>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Join the discussion below and share your view.</p>
              <a href="#comments-section"
                 onclick="setTimeout(() => document.getElementById('commentInput')?.focus(), 400)"
                 class="inline-flex items-center justify-center w-full px-4 py-2 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-sm font-semibold rounded-xl hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors">
                Write a Comment
              </a>
              <a href="/blogs/saved"
                 class="inline-flex items-center justify-center gap-1.5 w-full px-4 py-2 mt-2 text-sm text-gray-600 dark:text-gray-400 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
                <i class="far fa-bookmark text-xs"></i> View Saved Blogs
              </a>
            </div>
          <% } else { %>
            <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
              <h4 class="font-semibold text-gray-800 dark:text-white mb-1">
                <i class="fas fa-user-lock text-amber-500 mr-2"></i>Join the Conversation
              </h4>
