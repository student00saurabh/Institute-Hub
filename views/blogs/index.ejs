<!-- STYLES                                                        -->
<!-- ============================================================ -->
<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .reveal-up { opacity: 0; transform: translateY(28px); transition: opacity 0.7s cubic-bezier(0.4,0,0.2,1), transform 0.7s cubic-bezier(0.4,0,0.2,1); }
    .reveal-up.in-view { opacity: 1; transform: translateY(0); }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @keyframes savePop {
        0% { transform: scale(1); }
        40% { transform: scale(1.25); }
        100% { transform: scale(1); }
    }
    .save-pop i { animation: savePop 0.35s ease; }

    /* Sticky filter bar */
    .sticky {
        transition: box-shadow 0.3s ease;
    }
    .sticky.scrolled {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    /* Blog card transition */
    .blog-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-up { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    @media (max-width: 640px) {
        .sticky {
            position: relative !important;
            top: 0 !important;
        }
    }
</style>

<!-- ============================================================ -->
<!-- SCRIPTS                                                       -->
<!-- ============================================================ -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        'use strict';

        // ========== BLOG FILTER SYSTEM ==========
        const searchInput = document.getElementById('blogSearch');
        const categoryFilter = document.getElementById('blogCategoryFilter');
        const sortFilter = document.getElementById('blogSort');
        const resetBtn = document.getElementById('resetBlogFilters');
        const blogGrid = document.getElementById('blogGrid');
        const noResults = document.getElementById('blogNoResults');
        const blogCountSpan = document.getElementById('blogResultsCount');
        const loadMoreBtn = document.getElementById('loadMoreBlogs');
        const clearFiltersBtn = document.getElementById('clearBlogFilters');

        let visibleBlogs = [];
        let currentPage = 1;
        const blogsPerPage = 6;

        function getFilteredBlogs() {
            const search = searchInput.value.toLowerCase().trim();
            const category = categoryFilter.value;
            const sort = sortFilter.value;

            const cards = document.querySelectorAll('.blog-card');
            let visible = [];

            cards.forEach(card => {
                const title = card.dataset.title || '';
                const cardCategory = card.dataset.category || '';
                const author = card.dataset.author || '';
                const tags = card.dataset.tags || '';
                const views = parseInt(card.dataset.views) || 0;
                const date = parseInt(card.dataset.date) || 0;

                let show = true;

                // Search filter
                if (search) {
                    const searchable = `${title} ${author} ${tags}`.toLowerCase();
                    if (!searchable.includes(search)) {
                        show = false;
                    }
                }

                // Category filter
                if (category !== 'All Categories' && cardCategory !== category) {
                    show = false;
                }

                if (show) {
                    visible.push({
                        element: card,
                        views: views,
                        date: date,
                        title: title
                    });
                }
            });

            // Sort
            switch(sort) {
                case 'newest':
                    visible.sort((a, b) => b.date - a.date);
                    break;
                case 'popular':
                    visible.sort((a, b) => b.views - a.views);
                    break;
                case 'trending':
                    visible.sort((a, b) => {
                        // Trending = high views + recent
                        const scoreA = a.views / (Date.now() - a.date) * 1000000;
                        const scoreB = b.views / (Date.now() - b.date) * 1000000;
                        return scoreB - scoreA;
                    });
                    break;
                default:
                    break;
            }

            return visible;
        }

        function updateBlogDisplay() {
            const filtered = getFilteredBlogs();
            visibleBlogs = filtered;

            // Hide all cards first
            document.querySelectorAll('.blog-card').forEach(card => {
                card.style.display = 'none';
            });

            // Show filtered cards
            const start = 0;
            const end = currentPage * blogsPerPage;
            const toShow = filtered.slice(start, end);

            toShow.forEach(item => {
                item.element.style.display = 'block';
            });

            // Update count
            blogCountSpan.textContent = filtered.length;

            // Show/hide no results
            if (filtered.length === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }

            // Show/hide load more
            if (filtered.length > currentPage * blogsPerPage) {
                loadMoreBtn.classList.remove('hidden');
            } else {
                loadMoreBtn.classList.add('hidden');
            }

            // Update active filters
            updateBlogActiveFilters();
        }

        function updateBlogActiveFilters() {
            const container = document.getElementById('blogActiveFilters');
            const filters = [];

            if (categoryFilter.value !== 'All Categories') {
                filters.push(categoryFilter.value);
            }
            if (searchInput.value.trim()) {
                filters.push(`"${searchInput.value.trim()}"`);
            }

            let html = '<span class="text-sm text-[#64748B] dark:text-[#94A3B8]">Active filters:</span>';
            if (filters.length === 0) {
                html += '<span class="text-sm text-[#64748B] dark:text-[#94A3B8]">None</span>';
            } else {
                filters.forEach(filter => {
                    html += `
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#2563EB]/10 text-[#2563EB] text-xs font-medium rounded-full">
                            ${filter}
                            <button class="hover:text-[#EF4444] transition-colors" onclick="removeBlogFilter('${filter}')">
                                <i class="fas fa-times text-[10px]"></i>
                            </button>
                        </span>
                    `;
                });
            }
            container.innerHTML = html;
        }

        // Remove filter (called from active filter chips)
        window.removeBlogFilter = function(filter) {
            if (categoryFilter.value === filter) {
                categoryFilter.value = 'All Categories';
            }
            if (searchInput.value.trim() === filter.replace(/"/g, '')) {
                searchInput.value = '';
            }
            currentPage = 1;
            updateBlogDisplay();
        };

        // Event listeners
        searchInput.addEventListener('input', function() {
            currentPage = 1;
            updateBlogDisplay();
        });

        categoryFilter.addEventListener('change', function() {
            currentPage = 1;
            updateBlogDisplay();
        });

        sortFilter.addEventListener('change', function() {
            currentPage = 1;
            updateBlogDisplay();
        });

        resetBtn.addEventListener('click', function() {
            searchInput.value = '';
            categoryFilter.value = 'All Categories';
            sortFilter.value = 'newest';
            currentPage = 1;
            updateBlogDisplay();
        });

        clearFiltersBtn.addEventListener('click', function() {
            resetBtn.click();
        });

        // Load More
        loadMoreBtn.addEventListener('click', function() {
            currentPage++;
            updateBlogDisplay();
        });

        // ========== SAVE BLOG FUNCTION ==========
        window.toggleSaveBlog = function(btn, evt) {
            if (evt) { evt.preventDefault(); evt.stopPropagation(); }
            const icon = btn.querySelector('i');
            const isSaved = icon.classList.contains('fas');

            icon.classList.toggle('fas', !isSaved);
            icon.classList.toggle('far', isSaved);
            btn.style.color = isSaved ? '' : '#C9A227';
            
            btn.classList.remove('save-pop');
            void btn.offsetWidth;
            btn.classList.add('save-pop');
        };

        // ========== NEWSLETTER SUBSCRIPTION ==========
        window.subscribeBlogNewsletter = function() {
            const email = document.getElementById('blogNewsletterEmail');
            const btn = event.target;
            
            if (!email.value || !email.value.includes('@')) {
                email.classList.add('border-[#EF4444]');
                setTimeout(() => email.classList.remove('border-[#EF4444]'), 2000);
                return;
            }

            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Subscribing...';
            btn.disabled = true;

            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-check mr-2"></i> Subscribed!';
                btn.classList.add('bg-[#22C55E]');
                email.value = '';
                setTimeout(() => {
                    btn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i> Subscribe';
                    btn.disabled = false;
                    btn.classList.remove('bg-[#22C55E]');
                }, 2000);
            }, 1500);
        };

        // ========== REVEAL ON SCROLL ==========
        const revealEls = document.querySelectorAll('.reveal-up');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        revealEls.forEach(el => observer.observe(el));

        // ========== INIT ==========
        updateBlogDisplay();

        // Sticky filter bar shadow on scroll
        const filterBar = document.querySelector('.sticky');
        if (filterBar) {
            window.addEventListener('scroll', function() {
                if (window.scrollY > 80) {
                    filterBar.classList.add('scrolled');
                } else {
                    filterBar.classList.remove('scrolled');
                }
            });
        }
    });
</script>