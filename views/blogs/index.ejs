<% layout("/layouts/boilerplate") %>

<%
  // ============================================================
  // ✅ HELPER FUNCTIONS
  // ============================================================
  function buildPaginationUrl(page, search, category, tag) {
      const params = new URLSearchParams();
      if (page && page > 1) params.set('page', page);
      if (search) params.set('q', search);
      if (category && category !== 'All Categories') params.set('category', category);
      if (tag) params.set('tag', tag);
      return params.toString();
  }
%>

<!-- ============================================================ -->
<!-- PAGE HEADER                                                   -->
<!-- ============================================================ -->
<section class="relative overflow-hidden bg-gradient-to-br from-[#0F172A] via-[#0F172A] to-[#2563EB] py-16 lg:py-20 -mt-6">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#C9A227] rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#2563EB] rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <span class="inline-block px-4 py-1.5 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white/90 mb-4 border border-white/20">
            <i class="fas fa-blog mr-2"></i> Insights & Stories
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-4">
            <span class="text-[#C9A227]">Blog</span> & Articles
        </h1>
        <p class="text-lg sm:text-xl text-white/80 max-w-2xl mx-auto">
            Stay updated with the latest trends, tutorials, and insights from industry experts
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm text-white/60">
            <span><i class="fas fa-newspaper text-[#C9A227] mr-1"></i> <%= totalBlogs || allBlogs.length %> Articles</span>
            <span class="w-px h-4 bg-white/20"></span>
            <span><i class="fas fa-users text-[#C9A227] mr-1"></i> <%= (allBlogs.reduce((sum, b) => sum + (b.views || 0), 0) || 25000).toLocaleString() %>+ Readers</span>
            <span class="w-px h-4 bg-white/20"></span>
            <span><i class="fas fa-tags text-[#C9A227] mr-1"></i> <%= blogCategories.length - 1 %> Categories</span>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- FEATURED BLOG — Hero Article                                 -->
<!-- ============================================================ -->
<% if (featuredBlog) { %>
<section class="py-12 lg:py-16 bg-white dark:bg-[#0B1120]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-5 gap-8 reveal-up">
            <!-- Featured Article -->
            <div class="lg:col-span-3 group relative rounded-2xl overflow-hidden bg-[#F8FAFC] dark:bg-[#111827] border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 transition-all duration-500">
                <div class="relative h-full overflow-hidden">
                    <img src="<%= featuredBlog.img %>" alt="<%= featuredBlog.title %>" class="w-full h-[320px] object-cover group-hover:scale-110 transition-transform duration-700">
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0F172A]/80 via-[#0F172A]/20 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6">
                        <span class="inline-block px-3 py-1 bg-[#2563EB] text-white text-xs font-bold rounded-full mb-3">
                            <i class="fas fa-star mr-1"></i> Featured
                        </span>
                        <span class="inline-block px-3 py-1 bg-[#C9A227] text-white text-xs font-bold rounded-full mb-3 ml-2">
                            <%= featuredBlog.category || 'General' %>
                        </span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight group-hover:text-[#C9A227] transition-colors">
                            <a href="/blogs/<%= featuredBlog.id || featuredBlog._id %>"><%= featuredBlog.title %></a>
                        </h2>
                        <div class="flex flex-wrap items-center gap-4 mt-3 text-sm text-white/70">
                            <span><i class="fas fa-user mr-1"></i> <%= featuredBlog.author || 'Anonymous' %></span>
                            <span><i class="fas fa-calendar mr-1"></i> <%= featuredBlog.date || 'Recent' %></span>
                            <span><i class="fas fa-clock mr-1"></i> <%= featuredBlog.readTime || '5 min read' %></span>
                            <span><i class="far fa-eye mr-1"></i> <%= (featuredBlog.views || 0).toLocaleString() %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar: Trending / Quick Reads -->
            <div class="lg:col-span-2 space-y-4">
                <h3 class="text-sm font-bold text-[#0F172A] dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fas fa-fire text-[#C9A227]"></i> Trending Now
                </h3>
                <div class="space-y-3">
                    <% (trendingBlogs || []).slice(0, 4).forEach((blog, idx) => { %>
                        <a href="/blogs/<%= blog.id || blog._id %>" class="group flex items-start gap-4 p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#111827] border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 transition-all duration-300 hover:-translate-y-0.5">
                            <div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden">
                                <img src="<%= blog.img %>" alt="<%= blog.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy">
                            </div>
                            <div class="flex-1 min-w-0">
                                <span class="text-[10px] font-bold text-[#2563EB] uppercase"><%= blog.category || 'General' %></span>
                                <h4 class="text-sm font-semibold text-[#0F172A] dark:text-white line-clamp-2 group-hover:text-[#2563EB] transition-colors">
                                    <%= blog.title %>
                                </h4>
                                <div class="flex items-center gap-2 mt-1 text-[10px] text-[#64748B] dark:text-[#94A3B8]">
                                    <span><i class="far fa-eye mr-0.5"></i> <%= (blog.views || 0).toLocaleString() %></span>
                                    <span><i class="far fa-comment mr-0.5"></i> <%= blog.comments || 0 %></span>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</section>
<% } %>

<!-- ============================================================ -->
<!-- BLOG FILTER & SEARCH                                         -->
<!-- ============================================================ -->
<section class="py-6 lg:py-8 bg-white dark:bg-[#0F172A]/40 border-b border-[#E2E8F0] dark:border-[#1E293B] sticky top-16 z-30 backdrop-blur-lg bg-white/90 dark:bg-[#0F172A]/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <form action="/blogs" method="GET" id="blogFilterForm">
            <div class="flex flex-col md:flex-row md:items-center gap-4">
                
                <!-- Search -->
                <div class="relative flex-1 min-w-[200px]">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-[#94A3B8] text-sm"></i>
                    <input type="text" 
                           name="q" 
                           value="<%= search %>"
                           placeholder="Search articles, topics, authors..." 
                           class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] bg-[#F8FAFC] dark:bg-[#111827] text-[#0F172A] dark:text-white placeholder-[#94A3B8] text-sm focus:outline-none focus:ring-2 focus:ring-[#2563EB]/40 focus:border-[#2563EB] transition-all duration-300">
                </div>

                <!-- Category Filter -->
                <div class="relative min-w-[160px]">
                    <i class="fas fa-tag absolute left-3.5 top-1/2 -translate-y-1/2 text-[#94A3B8] text-sm"></i>
                    <select name="category" class="filter-select w-full pl-10 pr-8 py-2.5 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] bg-[#F8FAFC] dark:bg-[#111827] text-[#0F172A] dark:text-white text-sm appearance-none focus:outline-none focus:ring-2 focus:ring-[#2563EB]/40 focus:border-[#2563EB] transition-all duration-300 cursor-pointer">
                        <% blogCategories.forEach(cat => { %>
                            <option value="<%= cat %>" <%= cat === category ? 'selected' : '' %>><%= cat %></option>
                        <% }) %>
                    </select>
                    <i class="fas fa-chevron-down absolute right-3.5 top-1/2 -translate-y-1/2 text-[#94A3B8] text-xs pointer-events-none"></i>
                </div>

                <!-- Reset -->
                <a href="/blogs" class="px-4 py-2.5 text-sm font-medium text-[#2563EB] border border-[#2563EB]/30 rounded-xl hover:bg-[#2563EB]/10 transition-all duration-300 whitespace-nowrap">
                    <i class="fas fa-rotate-right mr-1.5"></i> Reset
                </a>

                <!-- Results Count -->
                <span class="text-sm text-[#64748B] dark:text-[#94A3B8] whitespace-nowrap font-medium">
                    <span id="blogCount"><%= totalBlogs || allBlogs.length %></span> articles
                </span>
            </div>
        </form>
    </div>
</section>

<!-- ============================================================ -->
<!-- BLOG GRID                                                     -->
<!-- ============================================================ -->
<section class="py-12 lg:py-16 bg-[#F8FAFC] dark:bg-[#0B1120]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Active Filters -->
        <div id="blogActiveFilters" class="flex flex-wrap items-center gap-2 mb-6 reveal-up">
            <span class="text-sm text-[#64748B] dark:text-[#94A3B8]">Active filters:</span>
            <% const activeFilters = []; %>
            <% if (category && category !== 'All Categories') activeFilters.push({ key: 'category', value: category }); %>
            <% if (search) activeFilters.push({ key: 'q', value: `"${search}"` }); %>
            <% if (tag) activeFilters.push({ key: 'tag', value: `#${tag}` }); %>
            
            <% if (activeFilters.length === 0) { %>
                <span class="text-sm text-[#64748B] dark:text-[#94A3B8]">None</span>
            <% } else { %>
                <% activeFilters.forEach(f => { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#2563EB]/10 text-[#2563EB] text-xs font-medium rounded-full">
                        <%= f.value %>
                        <a href="/blogs?<%= buildPaginationUrl(1, f.key === 'q' ? '' : search, f.key === 'category' ? '' : category, f.key === 'tag' ? '' : tag) %>" 
                           class="hover:text-[#EF4444] transition-colors">
                            <i class="fas fa-times text-[10px]"></i>
                        </a>
                    </span>
                <% }) %>
            <% } %>
        </div>

        <!-- Blog Grid -->
        <div id="blogGrid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (allBlogs && allBlogs.length > 0) { %>
                <% allBlogs.forEach((blog, i) => { %>
                    <article class="group reveal-up bg-white dark:bg-[#111827] rounded-2xl overflow-hidden border border-[#E2E8F0] dark:border-[#1E293B] hover:border-[#2563EB]/40 hover:shadow-xl hover:shadow-[#2563EB]/10 hover:-translate-y-2 transition-all duration-400 blog-card"
                             data-id="<%= blog.id || blog._id %>"
                             data-category="<%= blog.category %>"
                             data-title="<%= blog.title.toLowerCase() %>"
                             data-author="<%= blog.author.toLowerCase() %>"
                             data-tags="<%= blog.tags ? blog.tags.join(',') : '' %>"
                             data-views="<%= blog.views || 0 %>"
                             data-date="<%= blog.date ? new Date(blog.date).getTime() : Date.now() %>"
                             style="transition-delay: <%= (i % 3) * 60 %>ms">
                        
                        <div class="relative overflow-hidden h-52">
                            <a href="/blogs/<%= blog.id || blog._id %>" class="block w-full h-full">
                                <img src="<%= blog.img %>" alt="<%= blog.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy">
                            </a>
                            <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                                <span class="px-2.5 py-1 bg-[#2563EB] text-white text-[10px] font-bold rounded-lg shadow">
                                    <%= blog.category || 'General' %>
                                </span>
                                <% if ((blog.views || 0) > 3000) { %>
                                    <span class="px-2.5 py-1 bg-[#C9A227] text-white text-[10px] font-bold rounded-lg shadow">
                                        <i class="fas fa-fire mr-0.5"></i> Trending
                                    </span>
                                <% } %>
                                <% if ((blog.likes || 0) > 100) { %>
                                    <span class="px-2.5 py-1 bg-[#EF4444] text-white text-[10px] font-bold rounded-lg shadow">
                                        <i class="fas fa-heart mr-0.5"></i> Popular
                                    </span>
                                <% } %>
                            </div>
                            <button type="button" onclick="toggleSaveBlog(this, event)" data-blog-id="<%= blog.id || blog._id %>" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 dark:bg-[#0B1120]/90 backdrop-blur flex items-center justify-center text-[#64748B] hover:text-[#C9A227] shadow transition-all duration-300">
                                <i class="far fa-bookmark text-xs"></i>
                            </button>
                            <div class="absolute bottom-3 left-3 flex items-center gap-3 text-white text-[10px] bg-black/40 backdrop-blur px-2.5 py-1 rounded-lg w-fit">
                                <span><i class="far fa-eye mr-0.5"></i> <%= (blog.views || 0).toLocaleString() %></span>
                                <span class="w-px h-3 bg-white/30"></span>
                                <span><i class="far fa-comment mr-0.5"></i> <%= blog.comments || 0 %></span>
                                <span class="w-px h-3 bg-white/30"></span>
                                <span><i class="far fa-clock mr-0.5"></i> <%= blog.readTime || '5 min read' %></span>
                                <span class="w-px h-3 bg-white/30"></span>
                                <span><i class="fas fa-heart mr-0.5 text-[#EF4444]"></i> <%= blog.likes || 0 %></span>
                            </div>
                        </div>

                        <div class="p-5">
                            <div class="flex items-center gap-2 text-[10px] text-[#64748B] dark:text-[#94A3B8]">
                                <span><i class="far fa-calendar mr-0.5"></i> <%= blog.date || 'Recent' %></span>
                                <span class="w-1 h-1 rounded-full bg-[#CBD5E1] dark:bg-[#334155]"></span>
                                <span>by <%= blog.author || 'Anonymous' %></span>
                            </div>

                            <h3 class="mt-2 text-base font-bold text-[#0F172A] dark:text-white leading-snug line-clamp-2 min-h-[3rem] group-hover:text-[#2563EB] transition-colors">
                                <a href="/blogs/<%= blog.id || blog._id %>"><%= blog.title %></a>
                            </h3>

                            <p class="mt-2 text-sm text-[#64748B] dark:text-[#94A3B8] line-clamp-2"><%= blog.excerpt || 'Read more about this topic...' %></p>

                            <!-- Tags -->
                            <% if (blog.tags && blog.tags.length > 0) { %>
                                <div class="mt-3 flex flex-wrap gap-1.5">
                                    <% blog.tags.slice(0, 3).forEach(tag => { %>
                                        <span class="px-2 py-0.5 bg-[#2563EB]/10 text-[#2563EB] text-[9px] font-medium rounded-full">
                                            #<%= tag %>
                                        </span>
                                    <% }) %>
                                    <% if (blog.tags.length > 3) { %>
                                        <span class="px-2 py-0.5 text-[#64748B] text-[9px] font-medium">+<%= blog.tags.length - 3 %> more</span>
                                    <% } %>
                                </div>
                            <% } %>

                            <div class="mt-4 pt-4 border-t border-[#E2E8F0] dark:border-[#1E293B] flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-[10px] font-bold shadow"
                                         style="background: linear-gradient(135deg, <%= i % 2 === 0 ? '#2563EB, #1D4ED8' : '#C9A227, #B8901E' %>);">
                                        <%= blog.authorImg || blog.author?.charAt(0) || 'A' %>
                                    </div>
                                    <span class="text-xs font-medium text-[#0F172A] dark:text-white"><%= blog.author || 'Anonymous' %></span>
                                </div>
                                <a href="/blogs/<%= blog.id || blog._id %>" class="text-xs font-semibold text-[#2563EB] hover:underline flex items-center gap-1">
                                    Read More <i class="fas fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <!-- No Results -->
                <div class="col-span-full text-center py-16">
                    <div class="w-24 h-24 mx-auto rounded-full bg-[#2563EB]/10 flex items-center justify-center text-[#2563EB] text-4xl mb-4">
                        <i class="fas fa-search"></i>
                    </div>
                    <h3 class="text-xl font-bold text-[#0F172A] dark:text-white">No articles found</h3>
                    <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-2">Try adjusting your filters or search query</p>
                    <a href="/blogs" class="mt-4 inline-block px-6 py-2.5 bg-[#2563EB] text-white rounded-xl hover:bg-[#1D4ED8] transition-all duration-300">
                        Clear all filters
                    </a>
                </div>
            <% } %>
        </div>

        <!-- ============================================================ -->
        <!-- PAGINATION                                                    -->
        <!-- ============================================================ -->
        <% if (totalPages > 1) { %>
        <div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 reveal-up">
            <p class="text-sm text-[#64748B] dark:text-[#94A3B8]">
                Showing <span class="font-medium text-[#0F172A] dark:text-white"><%= ((currentPage - 1) * limit) + 1 %></span> 
                to <span class="font-medium text-[#0F172A] dark:text-white"><%= Math.min(currentPage * limit, totalBlogs || allBlogs.length) %></span> 
                of <span class="font-medium text-[#0F172A] dark:text-white"><%= totalBlogs || allBlogs.length %></span> articles
            </p>
            
            <div class="flex items-center gap-1.5">
                <!-- Previous Page -->
                <% if (hasPrevPage) { %>
                    <a href="/blogs?<%= buildPaginationUrl(currentPage - 1, search, category, tag) %>" 
                       class="px-4 py-2 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] text-[#0F172A] dark:text-white hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB] transition-all duration-300">
                        <i class="fas fa-chevron-left text-xs"></i>
                    </a>
                <% } else { %>
                    <span class="px-4 py-2 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] text-[#94A3B8] cursor-not-allowed opacity-50">
                        <i class="fas fa-chevron-left text-xs"></i>
                    </span>
                <% } %>

                <!-- Page Numbers -->
                <% 
                    let startPage = Math.max(1, currentPage - 2);
                    let endPage = Math.min(totalPages, currentPage + 2);
                    
                    if (endPage - startPage < 4) {
                        if (startPage === 1) endPage = Math.min(5, totalPages);
                        else if (endPage === totalPages) startPage = Math.max(1, totalPages - 4);
                    }
                %>
                
                <% if (startPage > 1) { %>
                    <a href="/blogs?<%= buildPaginationUrl(1, search, category, tag) %>" 
                       class="px-3.5 py-2 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] text-[#0F172A] dark:text-white hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB] transition-all duration-300 text-sm font-medium">
                        1
                    </a>
                    <% if (startPage > 2) { %>
                        <span class="px-2 text-[#94A3B8]">…</span>
                    <% } %>
                <% } %>

                <% for (let p = startPage; p <= endPage; p++) { %>
                    <a href="/blogs?<%= buildPaginationUrl(p, search, category, tag) %>" 
                       class="px-3.5 py-2 rounded-xl border transition-all duration-300 text-sm font-medium
                              <%= p === currentPage ? 
                                  'bg-[#2563EB] text-white border-[#2563EB] shadow-lg shadow-[#2563EB]/25' : 
                                  'border-[#E2E8F0] dark:border-[#1E293B] text-[#0F172A] dark:text-white hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB]' %>">
                        <%= p %>
                    </a>
                <% } %>

                <% if (endPage < totalPages) { %>
                    <% if (endPage < totalPages - 1) { %>
                        <span class="px-2 text-[#94A3B8]">…</span>
                    <% } %>
                    <a href="/blogs?<%= buildPaginationUrl(totalPages, search, category, tag) %>" 
                       class="px-3.5 py-2 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] text-[#0F172A] dark:text-white hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB] transition-all duration-300 text-sm font-medium">
                        <%= totalPages %>
                    </a>
                <% } %>

                <!-- Next Page -->
                <% if (hasNextPage) { %>
                    <a href="/blogs?<%= buildPaginationUrl(currentPage + 1, search, category, tag) %>" 
                       class="px-4 py-2 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] text-[#0F172A] dark:text-white hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB] transition-all duration-300">
                        <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                <% } else { %>
                    <span class="px-4 py-2 rounded-xl border border-[#E2E8F0] dark:border-[#1E293B] text-[#94A3B8] cursor-not-allowed opacity-50">
                        <i class="fas fa-chevron-right text-xs"></i>
                    </span>
                <% } %>
            </div>
        </div>
        <% } %>
    </div>
</section>

<!-- ============================================================ -->
<!-- POPULAR TAGS SECTION                                         -->
<!-- ============================================================ -->
<% if (popularTags && popularTags.length > 0) { %>
<section class="py-12 lg:py-16 bg-white dark:bg-[#0F172A]/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 reveal-up">
            <span class="text-xs font-bold tracking-widest text-[#C9A227] uppercase">Explore</span>
            <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#0F172A] dark:text-white">
                Popular <span class="text-[#2563EB]">Tags</span>
            </h2>
        </div>

        <div class="flex flex-wrap justify-center gap-3 reveal-up">
            <% popularTags.slice(0, 15).forEach(tag => { %>
                <a href="/blogs?tag=<%= encodeURIComponent(tag) %>" 
                   class="group px-4 py-2 rounded-full border border-[#E2E8F0] dark:border-[#1E293B] text-sm text-[#64748B] dark:text-[#94A3B8] hover:bg-[#2563EB] hover:text-white hover:border-[#2563EB] transition-all duration-300 hover:shadow-lg hover:shadow-[#2563EB]/25">
                    #<%= tag %>
                </a>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<!-- ============================================================ -->
<!-- NEWSLETTER CTA                                                -->
<!-- ============================================================ -->
<section class="py-16 lg:py-20 bg-[#0F172A] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-1/4 w-[500px] h-[500px] rounded-full bg-[#2563EB] blur-[100px]"></div>
        <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] rounded-full bg-[#C9A227] blur-[100px]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 mb-6">
            <i class="fas fa-envelope-open-text text-[#C9A227]"></i>
