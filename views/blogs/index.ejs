            <button onclick="subscribeBlogNewsletter()" class="px-8 py-3.5 rounded-xl bg-gradient-to-r from-[#2563EB] to-[#1D4ED8] hover:from-[#3B82F6] hover:to-[#2563EB] text-white font-semibold transition-all duration-300 hover:scale-105 shadow-lg shadow-[#2563EB]/25">
                <i class="fas fa-paper-plane mr-2"></i> Subscribe
