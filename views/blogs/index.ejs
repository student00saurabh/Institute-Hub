        <div class="absolute top-0 left-1/4 w-[500px] h-[500px] rounded-full bg-[#2563EB] blur-[100px]"></div>
        <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] rounded-full bg-[#C9A227] blur-[100px]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 mb-6">
            <i class="fas fa-envelope-open-text text-[#C9A227]"></i>
            <span class="text-white/90 text-sm font-medium">Stay Updated</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
            Subscribe to Our <span class="text-[#C9A227]">Newsletter</span>
        </h2>
        <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
