        let otp = '';
        for (let i = 1; i <= 6; i++) {
            const el = document.getElementById(`footerOtp${i}`);
            if (el) otp += el.value;
        }
        if (otp.length !== 6) {
            showFooterOtpStatus('Please enter all 6 digits.', 'error');
