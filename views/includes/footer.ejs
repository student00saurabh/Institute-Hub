    // ── INITIAL GREETING ──
    function initChat() {
        let greeting = `Hi${hasName ? ' ' + escapeHtml(currUser.name.split(' ')[0]) : ''} 👋 I'm the InstituteHub Assistant. Pick a topic below, or type your question — I can even look up a specific course or blog for you.`;
        
        // Check subscription status for logged-in user
        if (isLoggedIn && hasEmail) {
            fetch(`/api/subscription-status?email=${encodeURIComponent(currUser.email)}`)
                .then(res => res.json())
                .then(data => {
                    if (data.exists && data.isVerified) {
                        greeting += `\n\n✅ You're already subscribed to our newsletter!`;
                        addBotMessage(greeting.replace(/\n/g, '<br>'));
                        renderChips(MAIN_MENU);
                    } else if (data.exists && !data.isVerified) {
                        addBotMessage(greeting.replace(/\n/g, '<br>'));
                        offerPendingSubscriptionOptions(currUser.email);
                    } else {
                        addBotMessage(greeting.replace(/\n/g, '<br>'));
                        renderChips(MAIN_MENU);
                    }
                })
                .catch(() => {
                    addBotMessage(greeting.replace(/\n/g, '<br>'));
                    renderChips(MAIN_MENU);
                });
        } else {
            addBotMessage(greeting.replace(/\n/g, '<br>'));
            renderChips(MAIN_MENU);
        }
    }
});
</script>

