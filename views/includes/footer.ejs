            </div>`;
        messagesEl.appendChild(wrap);
        scrollToBottom();
        
        let totalSeconds = 600;
        const timerDisplay = document.getElementById('cbOtpTimerCount');
        const resendBtn = document.getElementById('cbResendOtpBtn');
        if (resendBtn) resendBtn.disabled = true;
        const timerInterval = setInterval(() => {
            totalSeconds--;
            const mins = Math.floor(totalSeconds / 60);
            const secs = totalSeconds % 60;
            if (timerDisplay) timerDisplay.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            if (totalSeconds <= 0) {
                clearInterval(timerInterval);
                if (resendBtn) { resendBtn.disabled = false; resendBtn.textContent = 'Resend OTP'; }
                if (timerDisplay) timerDisplay.textContent = 'Expired';
            }
        }, 1000);
        
        // Auto-advance to verify when all digits are filled
        const checkAllFilled = () => {
            let filled = true;
            for (let i = 1; i <= 6; i++) {
                const el = document.getElementById(`cbOtp${i}`);
                if (!el || el.value.length === 0) { filled = false; break; }
            }
            if (filled) {
                const verifyBtn = document.getElementById('cbVerifyOtpBtn');
                if (verifyBtn && !verifyBtn.disabled) {
                    setTimeout(() => verifyBtn.click(), 300);
                }
            }
        };

        // Add input listeners for auto-verify
        for (let i = 1; i <= 6; i++) {
            const el = document.getElementById(`cbOtp${i}`);
            if (el) {
                el.addEventListener('input', checkAllFilled);
            }
        }
        
        document.getElementById('cbVerifyOtpBtn').addEventListener('click', async function() {
            let otp = '';
            for (let i = 1; i <= 6; i++) {
                const input = document.getElementById(`cbOtp${i}`);
                if (input) otp += input.value;
            }
            if (otp.length !== 6) {
                const err = document.getElementById('cbOtpError');
                showFormError(err, 'Please enter all 6 digits.');
                return;
            }
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifying...';
            try {
                const res = await fetch('/api/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, otp: otp })
                });
                const data = await res.json();
                if (data.success) {
                    removeActiveForm();
                    addBotMessage(`🎉 ${data.message}`);
                    renderChips(MAIN_MENU);
                } else {
                    const err = document.getElementById('cbOtpError');
                    showFormError(err, data.message || 'Invalid OTP.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check"></i> Verify OTP';
                }
            } catch (error) {
                const err = document.getElementById('cbOtpError');
                showFormError(err, 'Unable to verify OTP.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Verify OTP';
            }
        });
    }

