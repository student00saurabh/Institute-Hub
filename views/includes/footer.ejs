    function showFooterResponse(msg, type) {
        if (!footerResponseEl) return;
        footerResponseEl.textContent = msg;
        footerResponseEl.className = 'footer-newsletter-response mt-2 text-xs font-medium ' +
            (type === 'error' ? 'text-red-400' : type === 'success' ? 'text-green-400' : 'text-[#93C5FD]');
