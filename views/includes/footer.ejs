        const btn = document.getElementById('footerVerifyOTPBtn');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Verifying...';
        try {
            const res = await fetch('/api/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: footerPendingEmail, otp })
            });
            const data = await res.json().catch(() => ({}));
            if (data.success) {
                if (footerOtpTimerInterval) clearInterval(footerOtpTimerInterval);
                window.closeFooterOTPModal();
                showFooterResponse(data.message || 'Subscribed successfully! Welcome aboard 🎉', 'success');
