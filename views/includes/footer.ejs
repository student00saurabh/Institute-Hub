    color: var(--chip-color);
    border: 1px solid color-mix(in srgb, var(--chip-color) 30%, white);
    transition: all 0.2s ease;
    animation: cb-msg-in 0.3s ease forwards;
}
.dark .cb-chip { background: color-mix(in srgb, var(--chip-color) 20%, #0B1120); }
.cb-chip:hover { transform: translateY(-2px); box-shadow: 0 4px 12px color-mix(in srgb, var(--chip-color) 35%, transparent); }
.cb-chip:active { transform: scale(0.95); }
.cb-chip-alt {
    background: linear-gradient(135deg, #2563EB, #1D4ED8);
    color: #fff; border: none;
}
.cb-chip-alt:hover { box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4); }

.cb-mini-chip {
