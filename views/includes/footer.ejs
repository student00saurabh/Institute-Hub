                               class="cb-otp-input w-10 h-10 text-center text-xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all"
                               inputmode="numeric" pattern="[0-9]"
                               oninput="handleCbOtpInput(this, 'cbOtp6')"
                               onfocus="this.select()">
                        <input type="text" id="cbOtp6" maxlength="1" 
                               class="cb-otp-input w-10 h-10 text-center text-xl font-bold border-2 border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-[#C9A227] focus:ring-2 focus:ring-[#C9A227]/40 focus:outline-none transition-all"
                               inputmode="numeric" pattern="[0-9]"
                               oninput="handleCbOtpInput(this, null)"
                               onfocus="this.select()">
                    </div>
