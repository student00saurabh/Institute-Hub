        const status = document.getElementById('footerOtpStatus');
        const resendStatus = document.getElementById('footerResendStatus');
        if (emailDisplay) emailDisplay.textContent = `Verifying ${email}`;
        if (status) { status.classList.add('hidden'); status.textContent = ''; }
        if (resendStatus) { resendStatus.classList.add('hidden'); resendStatus.textContent = ''; }
        ['footerOtp1', 'footerOtp2', 'footerOtp3', 'footerOtp4', 'footerOtp5', 'footerOtp6'].forEach(id => {
