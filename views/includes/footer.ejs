</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    // ---------- Server-provided user context ----------
    const currUser = <%- JSON.stringify(currUser || null) %>;
    const isLoggedIn = !!currUser;
    const hasName = !!(currUser && currUser.name && currUser.name.trim().length > 0);
    const hasEmail = !!(currUser && currUser.email && currUser.email.trim().length > 0);
    const hasMobile = !!(currUser && currUser.mobile && currUser.mobile.trim().length > 0);
    const hasAllDetails = isLoggedIn && hasName && hasEmail && hasMobile;

    const BOT_AVATAR = '<img src="/images/logo.png" alt="InstituteHub" class="logo-img w-full h-full object-contain dark:[filter:brightness(1.15)_contrast(1.15)_drop-shadow(0_0_6px_rgba(255,255,255,0.28))]">';

    const CONTACT = {
        phone: '+91 9310643303',
        phoneHref: '+919310643303',
        email: 'info@InstituteHub.org.in',
        address: 'Delhi, India',
        page: '/contact'
    };

    // ---------- FAQ knowledge base ----------
    const faqData = [
        {
            id: 'courses', label: 'Courses & Programs', icon: 'fa-graduation-cap', color: '#2563EB',
            keywords: ['course', 'courses', 'program', 'programs', 'training', 'skill', 'learn'],
            answer: "We offer industry-ready programs in <b>Full Stack Development, Data Science, Cloud &amp; DevOps</b> and <b>UI/UX Design</b> — each with hands-on projects, live mentorship and a portfolio-ready capstone.",
            followUps: ['fees', 'demo']
        },
        {
            id: 'fees', label: 'Fees & Batches', icon: 'fa-tags', color: '#22C55E',
            keywords: ['fee', 'fees', 'price', 'cost', 'batch', 'timing', 'schedule', 'emi'],
            answer: "Fees vary by course and track (weekday / weekend / self-paced), and EMI options are available. Share the course you're interested in and our team will send the exact fee structure and upcoming batch dates.",
            followUps: ['courses', 'demo']
        },
        {
            id: 'certification', label: 'Certification', icon: 'fa-certificate', color: '#7C3AED',
            keywords: ['certificate', 'certification', 'certified'],
            answer: "Every course ends with an industry-recognised certificate, and select tracks include globally-valid certification exam vouchers at no extra cost.",
            followUps: ['courses', 'placement']
        },
        {
            id: 'placement', label: 'Placement Support', icon: 'fa-briefcase', color: '#06B6D4',
            keywords: ['placement', 'job', 'career', 'hire', 'internship'],
            answer: "We provide resume reviews, mock interviews and access to our hiring-partner network once you complete a course — many learners get interview calls before their batch even ends.",
            followUps: ['courses', 'corporate']
        },
        {
            id: 'corporate', label: 'Corporate Training', icon: 'fa-building', color: '#F59E0B',
            keywords: ['corporate', 'company', 'team training', 'enterprise', 'bulk'],
            answer: "We design custom corporate training tracks for teams of any size, with flexible timing and progress dashboards for managers. Tell us your team size and goals and we'll tailor a proposal.",
            followUps: ['contact']
        },
        {
            id: 'demo', label: 'Book a Free Demo', icon: 'fa-laptop', color: '#EF4444',
            keywords: ['demo', 'trial', 'free class'],
            answer: "You can book a free demo class for any course — it's a great way to meet the instructor and see the teaching style before enrolling.",
            followUps: ['contact']
        },
        {
            id: 'mode', label: 'Online / Offline', icon: 'fa-chalkboard-user', color: '#0EA5E9',
            keywords: ['online', 'offline', 'mode', 'live class', 'classroom', 'in person', 'remote'],
            answer: "Most of our courses are available in <b>live online</b> as well as <b>in-person classroom</b> mode — you can pick whichever suits you at checkout, or switch batches later if needed.",
            followUps: ['courses', 'fees']
        },
        {
            id: 'payment', label: 'Payment Options', icon: 'fa-credit-card', color: '#059669',
            keywords: ['payment', 'pay', 'upi', 'card', 'installment', 'installments', 'emi options'],
            answer: "We accept UPI, debit/credit cards, net banking and no-cost EMI on select courses — payment is quick and secure right from the course page.",
            followUps: ['fees']
        },
        {
            id: 'refund', label: 'Refund Policy', icon: 'fa-rotate-left', color: '#DC2626',
            keywords: ['refund', 'cancel', 'cancellation', 'money back'],
            answer: "If you're not satisfied within the first few sessions, you can request a refund as per our refund policy — reach out to our support team and they'll guide you through it.",
            followUps: ['contact']
        },
        {
            id: 'trainers', label: 'Trainers & Faculty', icon: 'fa-chalkboard-teacher', color: '#9333EA',
            keywords: ['trainer', 'trainers', 'faculty', 'instructor', 'mentor', 'teacher'],
            answer: "All our trainers are working industry professionals with real hands-on experience — not just theory — so you learn what's actually used on the job.",
            followUps: ['courses', 'placement']
        },
        {
            id: 'material', label: 'Study Material', icon: 'fa-book-open', color: '#0891B2',
            keywords: ['material', 'notes', 'resources', 'recordings', 'access'],
            answer: "You get lifetime access to recorded sessions, notes, assignments and project files for every course you enrol in.",
            followUps: ['courses']
        },
        {
            id: 'contact', label: 'Contact Us', icon: 'fa-headset', color: '#C9A227',
            keywords: ['contact', 'reach', 'phone', 'call', 'email', 'address', 'talk to someone', 'support'],
            isContact: true,
            followUps: []
        }
    ];
    const MAIN_MENU = ['courses', 'fees', 'mode', 'certification', 'placement', 'trainers', 'payment', 'corporate', 'contact'];

    // ---------- DOM refs ----------
    const toggleBtn = document.getElementById('chatbotToggle');
    const iconOpen = document.getElementById('cbIconOpen');
    const iconClose = document.getElementById('cbIconClose');
    const badge = document.getElementById('cbBadge');
    const win = document.getElementById('chatbotWindow');
    const minimizeBtn = document.getElementById('chatbotMinimize');
    const messagesEl = document.getElementById('chatbotMessages');
    const chipsEl = document.getElementById('chatbotQuickReplies');
    chipsEl.addEventListener('wheel', function (e) {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            e.preventDefault();
            chipsEl.scrollLeft += e.deltaY;
        }
    }, { passive: false });
    const inputForm = document.getElementById('chatbotInputForm');
    const inputEl = document.getElementById('chatbotInput');

    let initialized = false;
    let isOpen = false;

    // ---------- open / close ----------
    function openChat() {
        win.classList.remove('hidden');
        requestAnimationFrame(() => {
            win.classList.remove('opacity-0', 'translate-y-4', 'scale-95');
        });
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        badge.classList.add('hidden');
        isOpen = true;
        if (!initialized) { initChat(); initialized = true; }
        setTimeout(() => inputEl.focus(), 250);
        scrollToBottom();
    }
    function closeChat() {
        win.classList.add('opacity-0', 'translate-y-4', 'scale-95');
        setTimeout(() => win.classList.add('hidden'), 300);
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        isOpen = false;
    }
    toggleBtn.addEventListener('click', () => isOpen ? closeChat() : openChat());
    minimizeBtn.addEventListener('click', closeChat);

    // ---------- message rendering ----------
    function scrollToBottom() {
        requestAnimationFrame(() => { messagesEl.scrollTop = messagesEl.scrollHeight; });
    }

    function addBotMessage(html) {
        const wrap = document.createElement('div');
        wrap.className = 'cb-msg cb-msg-bot';
        wrap.innerHTML = `
            <div class="cb-avatar">${BOT_AVATAR}</div>
            <div class="cb-bubble cb-bubble-bot">${html}</div>`;
        messagesEl.appendChild(wrap);
        scrollToBottom();
        return wrap;
    }

    function addUserMessage(text) {
        const wrap = document.createElement('div');
        wrap.className = 'cb-msg cb-msg-user';
        wrap.innerHTML = `<div class="cb-bubble cb-bubble-user">${escapeHtml(text)}</div>`;
        messagesEl.appendChild(wrap);
        scrollToBottom();
    }

    function showTyping() {
        const wrap = document.createElement('div');
        wrap.className = 'cb-msg cb-msg-bot';
        wrap.id = 'cbTyping';
        wrap.innerHTML = `
            <div class="cb-avatar">${BOT_AVATAR}</div>
            <div class="cb-bubble cb-bubble-bot cb-typing"><span></span><span></span><span></span></div>`;
        messagesEl.appendChild(wrap);
        scrollToBottom();
        return wrap;
    }

    function escapeHtml(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    function respondWithDelay(renderFn, delay = 650) {
        const typing = showTyping();
        setTimeout(() => {
            typing.remove();
            renderFn();
        }, delay);
    }

    // ---------- quick reply chips ----------
    function renderChips(ids, extra) {
        chipsEl.innerHTML = '';
        ids.forEach(id => {
            const faq = faqData.find(f => f.id === id);
            if (!faq) return;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'cb-chip';
            btn.style.setProperty('--chip-color', faq.color);
            btn.innerHTML = `<i class="fas ${faq.icon}"></i><span>${faq.label}</span>`;
            btn.addEventListener('click', () => handleFaqSelect(id));
            chipsEl.appendChild(btn);
        });
        if (extra) {
            extra.forEach(chip => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'cb-chip cb-chip-alt';
                btn.innerHTML = `<i class="fas ${chip.icon}"></i><span>${chip.label}</span>`;
                btn.addEventListener('click', chip.onClick);
                chipsEl.appendChild(btn);
            });
        }
    }

    function mainMenuChip() {
        return { icon: 'fa-list-ul', label: 'Main Menu', onClick: () => renderChips(MAIN_MENU) };
    }

    function handleFaqSelect(id, userLabelOverride) {
        const faq = faqData.find(f => f.id === id);
        if (!faq) return;
        addUserMessage(userLabelOverride || faq.label);
        chipsEl.innerHTML = '';
        respondWithDelay(() => {
            if (faq.isContact) {
                renderContactAnswer();
            } else {
                addBotMessage(faq.answer);
                const chips = [...(faq.followUps || [])];
                renderChips(chips, [mainMenuChip()]);
            }
        });
    }

    function renderContactAnswer() {
        addBotMessage(`
            <p class="mb-3">Here's the best way to reach us — or send a message directly and our team will get back to you within 24 hours.</p>
            <div class="cb-contact-card">
                <a href="tel:${CONTACT.phoneHref}" class="cb-contact-row">
                    <span class="cb-contact-ic" style="--c:#2563EB"><i class="fas fa-phone"></i></span>
                    <span>${CONTACT.phone}</span>
                </a>
                <a href="mailto:${CONTACT.email}" class="cb-contact-row">
                    <span class="cb-contact-ic" style="--c:#22C55E"><i class="fas fa-envelope"></i></span>
                    <span>${CONTACT.email}</span>
                </a>
                <div class="cb-contact-row cb-contact-row-static">
                    <span class="cb-contact-ic" style="--c:#C9A227"><i class="fas fa-map-marker-alt"></i></span>
                    <span>${CONTACT.address}</span>
                </div>
                <a href="${CONTACT.page}" class="cb-contact-page-btn">
                    <i class="fas fa-arrow-up-right-from-square"></i> Visit Contact Page
                </a>
            </div>`);
        renderChips([], [
            { icon: 'fa-paper-plane', label: 'Send us a message', onClick: () => startLeadFlow() },
            mainMenuChip()
        ]);
    }

    // ---------- free-text matching ----------
    function matchFaq(text) {
        const lower = text.toLowerCase();
        let best = null, bestScore = 0;
        faqData.forEach(faq => {
            faq.keywords.forEach(kw => {
                if (lower.includes(kw)) {
                    const score = kw.length;
                    if (score > bestScore) { bestScore = score; best = faq; }
                }
            });
        });
        return best;
    }

    function wait(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }

    // Friendly greeting detector
    function isGreeting(text) {
        const t = text.trim().toLowerCase();
        const greetings = ['hi', 'hii', 'hiii', 'hiiii', 'hello', 'helo', 'hey', 'heya', 'yo',
            'namaste', 'namaskar', 'good morning', 'good afternoon', 'good evening', 'good night',
            'morning', 'gm', 'whats up', "what's up", 'sup', 'kaise ho', 'kaisi ho', 'kya haal hai', 'hlo'];
        return greetings.some(g => t === g || t.startsWith(g + ' ') || t.startsWith(g + '!') || t.startsWith(g + ','));
    }
    function pickGreetingReply() {
        const namePart = hasName ? ' ' + escapeHtml(currUser.name.split(' ')[0]) : '';
        const replies = [
            `Hello${namePart}! 👋 How can I help you today — courses, fees, or something else?`,
            `Hi${namePart}! Good to see you 😊 What would you like to know?`,
            `Hey${namePart}! I'm here to help — pick a topic below or ask me anything.`
        ];
        return replies[Math.floor(Math.random() * replies.length)];
    }

    // Basic disrespectful-language guard — extend this list for your audience as needed.
    const ABUSIVE_WORDS = ['stupid', 'idiot', 'nonsense', 'useless', 'bakwas', 'bakwaas', 'bewakoof', 'pagal'];
    function containsAbusiveLanguage(text) {
        const lower = text.toLowerCase();
        return ABUSIVE_WORDS.some(w => new RegExp('\\b' + w + '\\b', 'i').test(lower));
    }

    // Live search across courses & blogs — same data source as the site search bar
    function renderSearchResults(items, query) {
        const cardsHtml = items.map(item => {
            const accent = item.type === 'course' ? '#2563EB' : '#7C3AED';
            const icon = item.icon || (item.type === 'course' ? 'fa-graduation-cap' : 'fa-blog');
            const badge = item.badge || (item.type === 'course' ? 'Course' : 'Blog');
            return `
                <a href="${item.url}" class="cb-result-card" style="--rc:${accent}">
                    <span class="cb-result-ic"><i class="fas ${icon}"></i></span>
                    <span class="cb-result-info">
                        <span class="cb-result-title">${item.title}</span>
                        <span class="cb-result-badge">${badge}</span>
                    </span>
                    <i class="fas fa-chevron-right cb-result-arrow"></i>
                </a>`;
        }).join('');
        addBotMessage(`<p class="mb-3">Here's what I found for "<b>${escapeHtml(query)}</b>":</p><div class="cb-result-list">${cardsHtml}</div>`);
        renderChips([], [mainMenuChip()]);
    }

    function renderNoMatch(query) {
        addBotMessage(`I couldn't find a course or blog matching "<b>${escapeHtml(query)}</b>". Want me to pass this on to our support team?`);
        renderChips([], [
            { icon: 'fa-paper-plane', label: 'Send as a message', onClick: () => startLeadFlow(query) },
            mainMenuChip()
        ]);
    }

    async function handleFreeText(text) {
        // Priority 1 — the listed quick-reply questions/answers always win first
        const match = matchFaq(text);
        if (match) {
            respondWithDelay(() => {
                if (match.isContact) {
                    renderContactAnswer();
                } else {
                    addBotMessage(match.answer);
                    renderChips(match.followUps || [], [mainMenuChip()]);
                }
            });
            return;
        }

        // Priority 2 — greetings
        if (isGreeting(text)) {
            respondWithDelay(() => {
                addBotMessage(pickGreetingReply());
                renderChips(MAIN_MENU);
            });
            return;
        }

        // Priority 3 — keep the conversation respectful
        if (containsAbusiveLanguage(text)) {
            respondWithDelay(() => {
                addBotMessage("Let's keep our chat friendly and respectful 🙏 I'm happy to help — pick a topic below or ask me about a course or blog.");
                renderChips(MAIN_MENU);
            });
            return;
        }

        // Priority 4 — search courses & blogs, same as the site search bar
        const typing = showTyping();
        const startedAt = Date.now();
        try {
            const res = await fetch('/api/search?q=' + encodeURIComponent(text));
            const data = await res.json().catch(() => ({}));
            const elapsed = Date.now() - startedAt;
            if (elapsed < 500) await wait(500 - elapsed);
            typing.remove();
            const items = (data.results || []).filter(r => r.type === 'course' || r.type === 'blog');
            if (items.length > 0) {
                renderSearchResults(items, text);
            } else {
                renderNoMatch(text);
            }
        } catch (err) {
            typing.remove();
            renderNoMatch(text);
        }
    }

    inputForm.addEventListener('submit', function (e) {
        e.preventDefault();
        const text = inputEl.value.trim();
        if (!text) return;
        inputEl.value = '';
        addUserMessage(text);
        chipsEl.innerHTML = '';
        handleFreeText(text);
    });

    // ---------- initial greeting ----------
    function initChat() {
        addBotMessage(`Hi${hasName ? ' ' + escapeHtml(currUser.name.split(' ')[0]) : ''} 👋 I'm the InstituteHub Assistant. Pick a topic below, or type your question — I can even look up a specific course or blog for you.`);
        renderChips(MAIN_MENU);
    }

    // ================================================================
    // LEAD CAPTURE FLOW (details -> message compose -> submit)
    // ================================================================
    function removeActiveForm() {
        const el = document.getElementById('cbActiveForm');
        if (el) el.remove();
    }

    function startLeadFlow(prefillMessage) {
        chipsEl.innerHTML = '';
        if (hasAllDetails) {
            respondWithDelay(() => renderComposeBox(prefillMessage));
        } else if (isLoggedIn && !hasMobile) {
            respondWithDelay(() => renderMobileOnlyForm(prefillMessage));
        } else {
            respondWithDelay(() => renderDetailsForm(prefillMessage));
        }
    }

    function renderDetailsForm(prefillMessage) {
        removeActiveForm();
        const wrap = document.createElement('div');
        wrap.className = 'cb-msg cb-msg-bot';
        wrap.id = 'cbActiveForm';
        wrap.innerHTML = `
            <div class="cb-avatar">${BOT_AVATAR}</div>
            <div class="cb-bubble cb-bubble-bot w-full">
                <p class="mb-3">First, a few quick details so our team can reach you:</p>
                <input id="cbName" type="text" placeholder="Full name" value="${currUser && currUser.name ? escapeHtml(currUser.name) : ''}" class="cb-input mb-2">
                <input id="cbEmail" type="email" placeholder="Email address" value="${currUser && currUser.email ? escapeHtml(currUser.email) : ''}" class="cb-input mb-2">
                <input id="cbMobile" type="tel" placeholder="10-digit mobile number" value="${currUser && currUser.mobile ? escapeHtml(currUser.mobile) : ''}" class="cb-input mb-2">
                <div id="cbFormError" class="cb-form-error hidden"></div>
                <button id="cbDetailsContinue" type="button" class="cb-cta-btn"><i class="fas fa-arrow-right"></i> Continue</button>
            </div>`;
        messagesEl.appendChild(wrap);
        scrollToBottom();

        document.getElementById('cbDetailsContinue').addEventListener('click', function () {
            const name = document.getElementById('cbName').value.trim();
            const email = document.getElementById('cbEmail').value.trim();
            const mobile = document.getElementById('cbMobile').value.trim();
            const err = document.getElementById('cbFormError');
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            const phoneRegex = /^[0-9]{10}$/;
            if (!name) { showFormError(err, 'Please enter your full name.'); return; }
            if (!email || !emailRegex.test(email)) { showFormError(err, 'Please enter a valid email address.'); return; }
            if (!mobile || !phoneRegex.test(mobile.replace(/\D/g, ''))) { showFormError(err, 'Please enter a valid 10-digit mobile number.'); return; }
            leadData.name = name; leadData.email = email; leadData.mobile = mobile;
            addUserMessage(`${name} · ${email} · ${mobile}`);
            removeActiveForm();
            respondWithDelay(() => renderComposeBox(prefillMessage));
        });
    }

    function renderMobileOnlyForm(prefillMessage) {
        removeActiveForm();
        const wrap = document.createElement('div');
        wrap.className = 'cb-msg cb-msg-bot';
        wrap.id = 'cbActiveForm';
        wrap.innerHTML = `
            <div class="cb-avatar">${BOT_AVATAR}</div>
            <div class="cb-bubble cb-bubble-bot w-full">
                <p class="mb-3">We just need your mobile number to reach you — everything else is already on file.</p>
                <input id="cbMobileOnly" type="tel" placeholder="10-digit mobile number" class="cb-input mb-2">
                <div id="cbFormError2" class="cb-form-error hidden"></div>
                <button id="cbMobileContinue" type="button" class="cb-cta-btn"><i class="fas fa-arrow-right"></i> Continue</button>
            </div>`;
        messagesEl.appendChild(wrap);
        scrollToBottom();

        document.getElementById('cbMobileContinue').addEventListener('click', function () {
            const mobile = document.getElementById('cbMobileOnly').value.trim();
            const err = document.getElementById('cbFormError2');
            const phoneRegex = /^[0-9]{10}$/;
            if (!mobile || !phoneRegex.test(mobile.replace(/\D/g, ''))) { showFormError(err, 'Please enter a valid 10-digit mobile number.'); return; }
            leadData.mobile = mobile;
            addUserMessage(mobile);
            removeActiveForm();
            respondWithDelay(() => renderComposeBox(prefillMessage));
        });
    }

    function showFormError(el, msg) {
        el.textContent = msg;
        el.classList.remove('hidden');
    }

    const quickSubjects = [
        { subject: 'Demo Request', text: "I'd like to request a demo class. Please share the schedule and details." },
        { subject: 'Course Information', text: 'Please share detailed course information, duration and fees.' },
        { subject: 'Corporate Training', text: 'We are looking for corporate training for our team — please share a proposal.' }
    ];

    function renderComposeBox(prefillMessage) {
        removeActiveForm();
        const wrap = document.createElement('div');
        wrap.className = 'cb-msg cb-msg-bot';
        wrap.id = 'cbActiveForm';
        wrap.innerHTML = `
            <div class="cb-avatar">${BOT_AVATAR}</div>
            <div class="cb-bubble cb-bubble-bot w-full">
                <p class="mb-3">Great — what would you like to say? Pick a suggestion or type your own message.</p>
                <div class="flex flex-wrap gap-1.5 mb-2" id="cbQuickSubjects"></div>
                <select id="cbSubject" class="cb-input mb-2">
                    <option value="General Inquiry">General Inquiry</option>
                    <option value="Course Information">Course Information</option>
                    <option value="Corporate Training">Corporate Training</option>
                    <option value="Technical Support">Technical Support</option>
                    <option value="Partnership Opportunities">Partnership Opportunities</option>
                    <option value="Demo Request">Demo Request</option>
                </select>
                <textarea id="cbMessage" rows="3" placeholder="Type your message..." class="cb-input resize-none">${prefillMessage ? escapeHtml(prefillMessage) : ''}</textarea>
                <div id="cbFormError3" class="cb-form-error hidden"></div>
                <button id="cbSendMessage" type="button" class="cb-cta-btn mt-2"><i class="fas fa-paper-plane"></i> Send Message</button>
            </div>`;
        messagesEl.appendChild(wrap);
        scrollToBottom();

        const chipsHolder = wrap.querySelector('#cbQuickSubjects');
        quickSubjects.forEach(q => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'cb-mini-chip';
            b.textContent = q.subject;
            b.addEventListener('click', () => {
                document.getElementById('cbSubject').value = q.subject;
                document.getElementById('cbMessage').value = q.text;
            });
            chipsHolder.appendChild(b);
        });

        document.getElementById('cbSendMessage').addEventListener('click', function () {
            const message = document.getElementById('cbMessage').value.trim();
            const subject = document.getElementById('cbSubject').value;
            const err = document.getElementById('cbFormError3');
            if (!message || message.length < 5) { showFormError(err, 'Please write a message (at least 5 characters).'); return; }
            if (message.length > 1000) { showFormError(err, 'Message cannot exceed 1000 characters.'); return; }

            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';

            submitLead({
                userId: (currUser && currUser._id) || null,
                name: leadData.name || (currUser && currUser.name) || '',
                email: leadData.email || (currUser && currUser.email) || '',
                mobile: leadData.mobile || (currUser && currUser.mobile) || '',
                subject: subject,
                message: message,
                type: 'chatbot'
            }, err, btn);
        });
    }

    const leadData = {};

    async function submitLead(payload, errEl, btn) {
        try {
            const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (res.ok && result.success) {
                removeActiveForm();
                addBotMessage(`<i class="fas fa-circle-check text-[#22C55E] mr-1"></i> ${result.message || "Message sent! Our team will get back to you within 24 hours."}`);
                renderChips(MAIN_MENU);
            } else {
                showFormError(errEl, result.message || 'Failed to send message. Please try again.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Message';
            }
        } catch (err) {
            showFormError(errEl, 'Unable to send message right now. Please try again later.');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Message';
        }
    }
});
</script>

