/* ---------- Contact card ---------- */
.cb-contact-card { display: flex; flex-direction: column; gap: 6px; }
.cb-contact-row {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: 10px;
    background: #F8FAFC; transition: background 0.2s ease;
