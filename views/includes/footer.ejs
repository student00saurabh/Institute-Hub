            </div>
            <div class="min-w-0">
                <p class="text-white font-bold text-sm leading-tight truncate">InstituteHub Assistant</p>
                <p class="text-[#93C5FD] text-[11px] flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 bg-[#22C55E] rounded-full animate-pulse shrink-0"></span>
