    window.closeFooterOTPModal = function () {
        const modal = document.getElementById('footerOtpModal');
        if (modal) modal.classList.add('hidden');
        if (footerOtpTimerInterval) clearInterval(footerOtpTimerInterval);
    };

    function startFooterOtpTimer() {
        if (footerOtpTimerInterval) clearInterval(footerOtpTimerInterval);
        let totalSeconds = 600;
        const timerDisplay = document.getElementById('footerOtpTimerCount');
        const resendBtn = document.getElementById('footerResendOTPBtn');
        if (resendBtn) resendBtn.disabled = true;
        if (timerDisplay) timerDisplay.textContent = '10:00';
        footerOtpTimerInterval = setInterval(() => {
            totalSeconds--;
            const mins = Math.floor(totalSeconds / 60);
            const secs = totalSeconds % 60;
            if (timerDisplay) timerDisplay.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            if (totalSeconds <= 0) {
                clearInterval(footerOtpTimerInterval);
                if (timerDisplay) timerDisplay.textContent = 'Expired';
                if (resendBtn) resendBtn.disabled = false;
            }
        }, 1000);
        // Enable resend after 60 seconds
        setTimeout(() => { if (resendBtn) resendBtn.disabled = false; }, 60000);
    }

