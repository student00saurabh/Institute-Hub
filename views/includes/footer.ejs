        <input id="chatbotInput" type="text" autocomplete="off" placeholder="Type your question..."
               class="flex-1 px-4 py-2.5 text-sm bg-[#F1F5F9] dark:bg-[#1E293B] border border-transparent focus:border-[#2563EB] rounded-full text-[#0F172A] dark:text-white placeholder-[#94A3B8] dark:placeholder-[#64748B] focus:outline-none transition-all">
        <button type="submit" id="chatbotSendBtn" aria-label="Send"
                class="w-10 h-10 shrink-0 rounded-full bg-gradient-to-r from-[#2563EB] to-[#1D4ED8] hover:from-[#3B82F6] hover:to-[#2563EB] text-white flex items-center justify-center hover:scale-105 active:scale-95 transition-transform shadow-lg shadow-[#2563EB]/30">
            <i class="fas fa-paper-plane text-sm"></i>
        </button>
