}
.dark .cb-contact-row { background: #0F172A; color: #E2E8F0; }
a.cb-contact-row:hover { background: #EFF6FF; }
.cb-contact-row-static { cursor: default; }
.cb-contact-ic {
    width: 26px; height: 26px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--c) 15%, white);
    color: var(--c); font-size: 12px; flex-shrink: 0;
}
.cb-contact-page-btn {
    margin-top: 4px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 9px; border-radius: 10px;
    font-size: 12.5px; font-weight: 700; color: #fff;
    background: linear-gradient(135deg, #C9A227, #B8901E);
    transition: all 0.2s ease;
}
.cb-contact-page-btn:hover { box-shadow: 0 4px 14px rgba(201, 162, 39, 0.4); transform: translateY(-1px); }

/* ---------- Course / blog search result cards ---------- */
.cb-result-list { display: flex; flex-direction: column; gap: 6px; }
.cb-result-card {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: 10px;
    background: #F8FAFC; border: 1px solid #E2E8F0;
    transition: all 0.2s ease;
}
.dark .cb-result-card { background: #0F172A; border-color: #1E293B; }
.cb-result-card:hover { background: color-mix(in srgb, var(--rc) 8%, white); border-color: color-mix(in srgb, var(--rc) 35%, white); transform: translateX(2px); }
.cb-result-ic {
    width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--rc) 15%, white); color: var(--rc); font-size: 12px;
}
.cb-result-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
