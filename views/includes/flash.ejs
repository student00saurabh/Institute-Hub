<style>
@keyframes slideDownFade {
  0% {
    opacity: 0;
    transform: translateY(-20px) scale(0.95);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes fadeOut {
  0% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateY(-10px) scale(0.95);
  }
}

.flash-message {
  animation: slideDownFade 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.flash-message.fade-out {
  animation: fadeOut 0.5s ease-in forwards;
}

/* Add smooth transition for removal */
.flash-message {
  transition: opacity 0.5s ease, transform 0.5s ease;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-dismiss flash messages after specified time
  const flashMessages = document.querySelectorAll('.flash-message[data-auto-dismiss]');
  
  flashMessages.forEach(function(message) {
    const delay = parseInt(message.getAttribute('data-auto-dismiss')) || 5000;
    
    // Start the timer
    const timerId = setTimeout(function() {
      // Add fade-out class to trigger animation
      message.classList.add('fade-out');
      
      // Remove the element after animation completes
      setTimeout(function() {
        if (message.parentNode) {
          message.remove();
        }
      }, 500); // Match the fadeOut animation duration
    }, delay);
    
    // Store timer ID on the element so we can clear it if user closes manually
    message.dataset.timerId = timerId;
    
    // Clear timer if user manually closes
    const closeBtn = message.querySelector('button');
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        const timerId = message.dataset.timerId;
        if (timerId) {
          clearTimeout(parseInt(timerId));
        }
        // Use the same fade-out animation
        message.classList.add('fade-out');
        setTimeout(function() {
          if (message.parentNode) {
            message.remove();
          }
        }, 500);
      });
    }
  });
});
</script>