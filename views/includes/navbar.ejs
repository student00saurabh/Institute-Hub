    animation: slideDown 0.3s ease forwards;
}

#searchOverlay.hidden {
    display: none;
}

/* ====== FIX: No hover underline on active links ====== */
.nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(to right, #2563EB, #C9A227);
    transition: all 0.3s ease;
    transform: translateX(-50%);
