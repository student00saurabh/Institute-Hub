}

/* Only show hover underline for non-active links */
.nav-link:not(.active):hover::after {
    width: 60%;
}

/* Active link has no hover underline */
.nav-link.active::after {
    display: none !important;
}

/* Dark mode adjustments */
.dark .nav-link:not(.active)::after {
    background: linear-gradient(to right, #3B82F6, #E6C35A);
}

/* ====== FIX: Login link no underline ====== */
.login-link::after {
    display: none !important;
}

.login-link {
    position: relative;
}

/* ====== SEARCH RESULTS BACKGROUND ====== */
#searchResults {
    background: transparent;
}

#resultsList {
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
}

.dark #resultsList {
    background: #111827;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

/* ====== SCROLLBAR STYLING ====== */
#searchResults::-webkit-scrollbar,
#mobileSearchResults::-webkit-scrollbar {
    width: 4px;
}

#searchResults::-webkit-scrollbar-track,
#mobileSearchResults::-webkit-scrollbar-track {
    background: transparent;
}

#searchResults::-webkit-scrollbar-thumb,
#mobileSearchResults::-webkit-scrollbar-thumb {
    background: #CBD5E1;
    border-radius: 2px;
}

.dark #searchResults::-webkit-scrollbar-thumb,
.dark #mobileSearchResults::-webkit-scrollbar-thumb {
    background: #475569;
}

/* ====== LINE CLAMP ====== */
.line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* ====== MOBILE SIDEBAR ====== */
#sidebarPanel {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

#sidebarOverlay {
    transition: opacity 0.3s ease;
}

#sidebarPanel a:hover {
    transform: translateX(4px);
}

/* ====== THEME TOGGLE ICONS ====== */
#themeToggle i {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ====== USER DROPDOWN ====== */
.user-dropdown {
    transform-origin: top right;
}

/* ====== RESPONSIVE SEARCH ====== */
@media (max-width: 768px) {
    #searchOverlay .max-w-2xl {
        max-width: 100%;
        padding: 0.75rem 1rem;
    }
}

.logo-img {
    transition: .3s;

    filter:
        /* White Outline */
        drop-shadow(1px 0 0 rgba(255,255,255,.95))
        drop-shadow(-1px 0 0 rgba(255,255,255,.95))
        drop-shadow(0 1px 0 rgba(255,255,255,.95))
        drop-shadow(0 -1px 0 rgba(255,255,255,.95))

        /* Soft White Glow */
        drop-shadow(0 0 4px rgba(255,255,255,.6))

        /* Gold Glow */
        drop-shadow(0 0 12px rgba(243,191,20,.65))

        /* Outer Glow */
        drop-shadow(0 0 18px rgba(243,191,20,.35)) !important;
}
