<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8" data-aos="fade-up">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-pink-600 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                        </svg>
                    </div>
                    Manage Blogs
                </h1>
                <p class="mt-1 text-gray-600 dark:text-gray-400">
                    Create, edit, and manage all blog posts on the platform
                </p>
            </div>
            <div class="mt-4 md:mt-0 flex flex-wrap gap-3">
                <a href="/blogs/new" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-medium rounded-xl transition-all duration-200 shadow-md hover:shadow-lg">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Create New Blog
                </a>
                <a href="/admin/dashboard" class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                    Back to Dashboard
                </a>
            </div>
        </div>

        <!-- Stats Summary -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6" data-aos="fade-up" data-aos-duration="600">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Blogs</p>
                <p class="text-xl font-bold text-gray-900 dark:text-white"><%= totalBlogs || 0 %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Published</p>
                <p class="text-xl font-bold text-green-600 dark:text-green-400">
                    <%= blogs ? blogs.filter(b => b.isvalid).length : 0 %>
                </p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Draft</p>
                <p class="text-xl font-bold text-yellow-600 dark:text-yellow-400">
                    <%= blogs ? blogs.filter(b => !b.isvalid).length : 0 %>
                </p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Blocked</p>
                <p class="text-xl font-bold text-red-600 dark:text-red-400">
                    <%= blogs ? blogs.filter(b => b.blocked).length : 0 %>
                </p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Views</p>
                <p class="text-xl font-bold text-purple-600 dark:text-purple-400">
                    <%= blogs ? blogs.reduce((sum, b) => sum + (b.usersSeen?.length || 0), 0) : 0 %>
                </p>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
            <form action="/admin/blogs" method="GET" class="flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input type="text" 
                               name="search" 
                               value="<%= search %>"
                               placeholder="Search blogs by title, description, or category..." 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 focus:border-transparent transition-all duration-200">
                    </div>
                </div>
                <div class="flex gap-3">
                    <select name="filter" class="px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 focus:border-transparent transition-all duration-200">
                        <option value="all" <%= filter === 'all' ? 'selected' : '' %>>All Blogs</option>
                        <option value="valid" <%= filter === 'valid' ? 'selected' : '' %>>Published</option>
                        <option value="invalid" <%= filter === 'invalid' ? 'selected' : '' %>>Draft</option>
                        <option value="blocked" <%= filter === 'blocked' ? 'selected' : '' %>>Blocked</option>
                        <option value="unblocked" <%= filter === 'unblocked' ? 'selected' : '' %>>Unblocked</option>
                    </select>
                    <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-medium rounded-xl transition-all duration-200 shadow-md hover:shadow-lg">
                        <i class="fas fa-search mr-1"></i> Filter
                    </button>
                    <a href="/admin/blogs" class="px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200 text-sm font-medium">
                        Reset
                    </a>
                </div>
            </form>
        </div>

        <!-- Results Info -->
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <p class="text-sm text-gray-500 dark:text-gray-400">
                Showing <span class="font-medium text-gray-700 dark:text-gray-300"><%= blogs ? blogs.length : 0 %></span> blogs
                <span class="text-gray-400">of</span>
                <span class="font-medium text-gray-700 dark:text-gray-300"><%= totalBlogs || 0 %></span>
                total
            </p>
            <% if (search) { %>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Search: "<span class="font-medium text-gray-700 dark:text-gray-300"><%= search %></span>"
                </p>
            <% } %>
            <% if (filter && filter !== 'all') { %>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Filter: <span class="font-medium text-gray-700 dark:text-gray-300"><%= filter %></span>
                </p>
            <% } %>
        </div>

        <!-- Blogs Table -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm" data-aos="fade-up" data-aos-duration="600" data-aos-delay="200">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30">
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Blog</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Views</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Author</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        <% if (blogs && blogs.length > 0) { %>
                            <% blogs.forEach(blog => { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <img src="<%= blog.image?.url || 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=50&auto=format&fit=crop' %>" 
                                                 alt="<%= blog.title %>" 
                                                 class="w-10 h-10 rounded-lg object-cover flex-shrink-0">
                                            <div>
                                                <p class="font-medium text-gray-900 dark:text-white text-sm"><%= blog.title %></p>
                                                <p class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-xs"><%= blog.shortdescription || '' %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                                        <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
                                            <%= blog.category || 'Uncategorized' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-wrap gap-1">
                                            <!-- Valid/Invalid Badge -->
                                            <span class="px-2 py-1 text-xs font-medium rounded-full <%= blog.isvalid ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>">
                                                <%= blog.isvalid ? 'Published' : 'Draft' %>
                                            </span>
                                            
                                            <!-- Blocked Badge -->
                                            <% if (blog.blocked) { %>
                                                <span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">
                                                    <i class="fas fa-ban mr-0.5"></i>Blocked
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                                        <%= blog.usersSeen?.length || 0 %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                                        <%= blog.author?.name || 'Unknown' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                                        <%= moment(blog.createdAt).format('DD MMM YYYY') %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-end gap-1">
                                            <!-- View Details -->
                                            <a href="/blogs/<%= blog.id || blog._id %>" 
                                               class="p-1.5 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 text-blue-600 dark:text-blue-400 transition-colors" 
                                               title="View Details">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                                </svg>
                                            </a>
                                            
                                            <!-- Edit -->
                                            <a href="/blogs/<%= blog._id %>/edit" 
                                               class="p-1.5 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400 transition-colors" 
                                               title="Edit Blog">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                </svg>
                                            </a>
                                            
                                            <div class="w-px h-6 bg-gray-200 dark:bg-gray-700 mx-1"></div>
                                            
                                            <!-- Toggle Valid (Publish/Unpublish) - Uses PATCH -->
                                            <form action="/blogs/<%= blog._id %>?_method=PATCH" method="POST" class="inline" onsubmit="return confirm(`Are you sure you want to <%= blog.isvalid ? 'unpublish' : 'publish' %> this blog?`)">
                                                <input type="hidden" name="_method" value="PATCH">
                                                <button type="submit" 
                                                        class="p-1.5 rounded-lg hover:bg-green-50 dark:hover:bg-green-900/20 transition-colors <%= blog.isvalid ? 'text-green-600 dark:text-green-400' : 'text-gray-400 dark:text-gray-500' %>"
                                                        title="<%= blog.isvalid ? 'Unpublish' : 'Publish' %> Blog">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= blog.isvalid ? 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' : 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' %>"></path>
                                                    </svg>
                                                </button>
                                            </form>
                                            
                                            <!-- Viewers -->
                                            <a href="/blogs/<%= blog._id %>/views" 
                                               class="p-1.5 rounded-lg hover:bg-cyan-50 dark:hover:bg-cyan-900/20 text-cyan-600 dark:text-cyan-400 transition-colors"
                                               title="View Viewers">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                                </svg>
                                            </a>
                                            
                                            <div class="w-px h-6 bg-gray-200 dark:bg-gray-700 mx-1"></div>
                                            
                                            <!-- Delete - Uses DELETE with method override -->
                                            <form action="/blogs/<%= blog._id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete `<%= blog.title %>`? This action cannot be undone.')">
                                                <input type="hidden" name="_method" value="DELETE">
                                                <button type="submit" 
                                                        class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-red-600 dark:text-red-400 transition-colors"
                                                        title="Delete Blog">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                                    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                                        <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                                        </svg>
                                    </div>
                                    <p class="text-sm font-medium">No blogs found</p>
                                    <p class="text-xs mt-1">Create your first blog post to get started</p>
                                    <a href="/blogs/new" class="inline-block mt-4 px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white text-sm font-medium rounded-lg transition-all duration-200">
                                        Create New Blog
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="mt-6 flex items-center justify-center gap-2 flex-wrap" data-aos="fade-up" data-aos-duration="600" data-aos-delay="300">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %><%= filter && filter !== 'all' ? '&filter=' + filter : '' %>" 
                       class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-purple-50 dark:hover:bg-purple-900/20 hover:text-purple-600 dark:hover:text-purple-400 transition-all duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                    </a>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="px-4 py-2 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold"><%= i %></span>
                    <% } else if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 2) { %>
                        <a href="?page=<%= i %><%= search ? '&search=' + search : '' %><%= filter && filter !== 'all' ? '&filter=' + filter : '' %>" 
                           class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-purple-50 dark:hover:bg-purple-900/20 hover:text-purple-600 dark:hover:text-purple-400 transition-all duration-200">
                            <%= i %>
                        </a>
                    <% } else if (i === 2 && currentPage > 4) { %>
                        <span class="px-2 text-gray-400">...</span>
                    <% } else if (i === totalPages - 1 && currentPage < totalPages - 3) { %>
                        <span class="px-2 text-gray-400">...</span>
                    <% } %>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %><%= filter && filter !== 'all' ? '&filter=' + filter : '' %>" 
                       class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-purple-50 dark:hover:bg-purple-900/20 hover:text-purple-600 dark:hover:text-purple-400 transition-all duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>



<script>
// ============ AUTO-SUBMIT ON FILTER CHANGE ============
document.addEventListener('DOMContentLoaded', function() {
    const filterSelect = document.querySelector('select[name="filter"]');
    if (filterSelect) {
        filterSelect.addEventListener('change', function() {
            this.closest('form').submit();
        });
    }

    // Auto dismiss notifications after 5 seconds
    const notifications = document.querySelectorAll('.notification-toast');
    notifications.forEach(notification => {
        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transform = 'translateX(100px)';
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 300);
        }, 5000);
    });
});
</script>

<style>
    /* Notification animation */
    .notification-toast {
        animation: slideIn 0.3s ease forwards;
    }
    
    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(100%);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Button hover effects */
    .hover\:bg-green-50:hover {
        background-color: rgba(34, 197, 94, 0.1);
    }
    .hover\:bg-red-50:hover {
        background-color: rgba(239, 68, 68, 0.1);
    }
    .hover\:bg-purple-50:hover {
        background-color: rgba(168, 85, 247, 0.1);
    }
    .hover\:bg-cyan-50:hover {
        background-color: rgba(6, 182, 212, 0.1);
    }
    .hover\:bg-indigo-50:hover {
        background-color: rgba(99, 102, 241, 0.1);
    }
</style>