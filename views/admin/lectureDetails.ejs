<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
        
        <!-- Breadcrumb -->
        <nav class="flex mb-6 text-sm">
            <ol class="inline-flex items-center gap-2">
                <li><a href="/admin/dashboard" class="text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-colors">Dashboard</a></li>
                <li><i class="fas fa-chevron-right text-gray-400 text-xs"></i></li>
                <li><a href="/admin/lectures" class="text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-colors">Lectures</a></li>
                <li><i class="fas fa-chevron-right text-gray-400 text-xs"></i></li>
                <li class="text-gray-700 dark:text-gray-300 font-medium truncate max-w-[200px]"><%= lecture.title %></li>
            </ol>
        </nav>

        <!-- Lecture Details -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
            
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white"><%= lecture.title %></h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        <span class="px-2 py-0.5 rounded-full bg-<%= lecture.isPublished !== false ? 'green' : 'yellow' %>-100 dark:bg-<%= lecture.isPublished !== false ? 'green' : 'yellow' %>-900/30 text-<%= lecture.isPublished !== false ? 'green' : 'yellow' %>-700 dark:text-<%= lecture.isPublished !== false ? 'green' : 'yellow' %>-300 text-xs">
                            <%= lecture.isPublished !== false ? 'Published' : 'Draft' %>
                        </span>
                        <span class="ml-2">Topic: <span class="font-medium"><%= lecture.topic || 'General' %></span></span>
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/admin/lectures/<%= lecture._id %>/edit" 
                       class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition-colors">
                        <i class="fas fa-edit mr-2"></i> Edit
                    </a>
                    <form action="/admin/lectures/<%= lecture._id %>/toggle-publish" method="POST" class="inline">
                        <input type="hidden" name="_method" value="PATCH">
                        <button type="submit" 
                                class="px-4 py-2 <%= lecture.isPublished !== false ? 'bg-yellow-600 hover:bg-yellow-700' : 'bg-green-600 hover:bg-green-700' %> text-white rounded-lg transition-colors">
                            <i class="fas <%= lecture.isPublished !== false ? 'fa-eye-slash' : 'fa-eye' %> mr-2"></i>
                            <%= lecture.isPublished !== false ? 'Unpublish' : 'Publish' %>
                        </button>
                    </form>
                </div>
            </div>

            <div class="p-6">
                <!-- Info Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3">Basic Information</h4>
                        <div class="space-y-3">
                            <div>
                                <p class="text-xs text-gray-400">Title</p>
                                <p class="text-sm text-gray-900 dark:text-white"><%= lecture.title %></p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Description</p>
                                <p class="text-sm text-gray-700 dark:text-gray-300"><%= lecture.description || 'No description' %></p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Topic</p>
                                <p class="text-sm text-gray-900 dark:text-white"><%= lecture.topic || 'General' %></p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Difficulty</p>
                                <p class="text-sm text-gray-900 dark:text-white capitalize"><%= lecture.difficulty || 'Beginner' %></p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3">Media & Access</h4>
                        <div class="space-y-3">
                            <div>
                                <p class="text-xs text-gray-400">Type</p>
                                <p class="text-sm text-gray-900 dark:text-white capitalize"><%= lecture.type || 'Video' %></p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Video Provider</p>
                                <p class="text-sm text-gray-900 dark:text-white"><%= lecture.video?.provider || 'Not set' %></p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Duration</p>
                                <p class="text-sm text-gray-900 dark:text-white"><%= lecture.video?.duration ? Math.floor(lecture.video.duration / 60) + ':' + (lecture.video.duration % 60).toString().padStart(2, '0') : 'Not set' %></p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Access</p>
                                <p class="text-sm <%= lecture.isFree ? 'text-green-600' : 'text-gray-900 dark:text-white' %>">
                                    <%= lecture.isFree ? 'Free for all' : 'Paid (enrollment required)' %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Courses Using This Lecture -->
                <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
                    <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-4">
                        Courses Using This Lecture (<%= lecture.courses?.length || 0 %>)
                    </h4>
                    <% if (lecture.courses && lecture.courses.length > 0) { %>
                        <div class="space-y-2">
                            <% lecture.courses.forEach(c => { %>
                                <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/30 rounded-lg">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900 dark:text-white">
                                            <%= c.courseId?.title || 'Unknown Course' %>
                                        </p>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">
                                            Section: <span class="font-medium"><%= c.section || 'General' %></span>
                                            • Order: <span class="font-medium"><%= c.order || 0 %></span>
                                        </p>
                                    </div>
                                    <a href="/courses/<%= c.courseId?._id %>" 
                                       class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors text-sm">
                                        View Course <i class="fas fa-arrow-right ml-1"></i>
                                    </a>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-sm text-gray-500 dark:text-gray-400">This lecture is not currently used in any course.</p>
                    <% } %>
                </div>

                <!-- Resources -->
                <% if (lecture.resources && lecture.resources.length > 0) { %>
                    <div class="border-t border-gray-200 dark:border-gray-700 pt-6 mt-6">
                        <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-4">Resources (<%= lecture.resources.length %>)</h4>
                        <div class="space-y-2">
                            <% lecture.resources.forEach(resource => { %>
                                <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/30 rounded-lg">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900 dark:text-white"><%= resource.title %></p>
                                        <p class="text-xs text-gray-500 dark:text-gray-400 capitalize"><%= resource.type || 'Other' %></p>
                                    </div>
                                    <a href="<%= resource.url %>" target="_blank" 
                                       class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors text-sm">
                                        <i class="fas fa-external-link-alt"></i>
                                    </a>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Admin Actions -->
                <div class="border-t border-gray-200 dark:border-gray-700 pt-6 mt-6">
                    <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-4">Admin Actions</h4>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="window.location.href='/admin/lectures/<%= lecture._id %>/edit'" 
                                class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition-colors">
                            <i class="fas fa-edit mr-2"></i> Edit Lecture
                        </button>
                        <button onclick="window.location.href='/admin/lectures/<%= lecture._id %>/duplicate'" 
                                class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition-colors">
                            <i class="fas fa-copy mr-2"></i> Duplicate
                        </button>
                        <button onclick="deleteLecture('<%= lecture._id %>')" 
                                class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors">
                            <i class="fas fa-trash mr-2"></i> Delete Lecture
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back Button -->
        <div class="mt-6">
            <a href="/admin/lectures" class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                <i class="fas fa-arrow-left"></i> Back to Lectures
            </a>
        </div>
    </div>
</div>

<script>
function deleteLecture(id) {
    if (!confirm('Are you sure you want to delete this lecture? This action cannot be undone.')) return;
    
    fetch(`/admin/lectures/${id}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            window.location.href = '/admin/lectures';
        } else {
            alert(data.message || 'Failed to delete lecture');
        }
    })
    .catch(err => {
        console.error('Error:', err);
        alert('Failed to delete lecture');
    });
}
</script>