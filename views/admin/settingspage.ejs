<!-- Toast Notification Container -->
<div id="toastContainer" class="fixed top-4 right-4 z-50 space-y-3"></div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tab switching with animation
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');
    
    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            const tabId = this.dataset.tab;
            
            // Update tab styles with animation
            tabs.forEach(t => {
                t.classList.remove('active');
            });
            this.classList.add('active');
            
            // Show content with fade animation
            contents.forEach(c => {
                c.classList.add('hidden');
                c.style.opacity = '0';
            });
            const target = document.getElementById('tab-' + tabId);
            target.classList.remove('hidden');
            setTimeout(() => {
                target.style.opacity = '1';
            }, 50);
        });
    });

    // Search functionality
    const searchInput = document.getElementById('settingsSearch');
    searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        const tabs = document.querySelectorAll('.tab-btn');
        
        tabs.forEach(tab => {
            const text = tab.textContent.toLowerCase();
            if (query === '' || text.includes(query)) {
                tab.style.display = '';
            } else {
                tab.style.display = 'none';
            }
        });
    });
});

// ============================================================
// TOAST NOTIFICATIONS
// ============================================================
function showToast(message, type = 'success') {
    const container = document.getElementById('toastContainer');
    const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
    };
    
    const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-circle',
        info: 'fa-info-circle'
    };
    
    const toast = document.createElement('div');
    toast.className = `toast-item ${colors[type]} text-white px-5 py-3 rounded-lg shadow-lg flex items-center gap-3 animate-slideIn`;
    toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="hover:text-gray-200">
            <i class="fas fa-times"></i>
        </button>
    `;
    
    container.appendChild(toast);
    
    // Auto remove after 5 seconds
    setTimeout(() => {
        if (toast.parentElement) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(100%)';
            setTimeout(() => toast.remove(), 300);
        }
    }, 5000);
}

// ============================================================
// COMMON FUNCTIONS
// ============================================================

// Remove item
function removeItem(btn, className) {
    const item = btn.closest('.' + className);
    if (item) {
        item.style.opacity = '0';
        item.style.transform = 'scale(0.95)';
        setTimeout(() => {
            item.remove();
            showToast('Item removed successfully', 'success');
        }, 200);
    }
}

// Expand/Collapse all tabs
function expandAll() {
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('hidden'));
    showToast('All sections expanded', 'info');
}

function collapseAll() {
    document.querySelectorAll('.tab-content').forEach((c, index) => {
        if (index > 0) c.classList.add('hidden');
    });
    showToast('All sections collapsed', 'info');
}

// Refresh settings
function refreshSettings() {
    showToast('Refreshing appSettings...', 'info');
    setTimeout(() => {
        location.reload();
    }, 500);
}

