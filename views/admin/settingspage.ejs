<% layout("/layouts/boilerplate") %>

<style>
    /* Custom Styles */
    .settings-card {
        transition: all 0.3s ease;
    }
    .settings-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }
    .dark .settings-card:hover {
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    }
    
    .tab-btn {
        position: relative;
        transition: all 0.3s ease;
    }
    .tab-btn::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: #2563EB;
        transition: width 0.3s ease;
    }
    .tab-btn.active::after {
        width: 100%;
    }
    .tab-btn.active {
        color: #2563EB;
        font-weight: 600;
    }
    .dark .tab-btn.active {
        color: #60A5FA;
    }
    
    .form-input {
        transition: all 0.3s ease;
        border: 2px solid #E5E7EB;
    }
    .form-input:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        outline: none;
    }
    .dark .form-input {
        border-color: #374151;
        background: #1F2937;
        color: #F3F4F6;
    }
    .dark .form-input:focus {
        border-color: #60A5FA;
        box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
    }
    
    .item-card {
        animation: slideIn 0.3s ease;
    }
    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        min-width: 300px;
        max-width: 500px;
        animation: slideInRight 0.5s ease;
    }
    @keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    .badge-pulse {
        animation: pulse 2s infinite;
    }
    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
    
    .image-preview {
        transition: all 0.3s ease;
        border: 2px dashed #E5E7EB;
    }
    .image-preview:hover {
        border-color: #2563EB;
        background: rgba(37, 99, 235, 0.05);
    }
    .dark .image-preview {
        border-color: #374151;
    }
    .dark .image-preview:hover {
        border-color: #60A5FA;
        background: rgba(96, 165, 250, 0.05);
    }
    
    .stat-counter {
        font-variant-numeric: tabular-nums;
    }
    
    /* Toggle Switch */
    .toggle-checkbox:checked + .toggle-label {
        background: #2563EB;
    }
    .toggle-checkbox:checked + .toggle-label .toggle-dot {
        transform: translateX(100%);
        background: white;
    }
    .toggle-label {
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .toggle-dot {
        transition: all 0.3s ease;
    }
</style>

<div class="min-h-screen py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header with Stats -->
        <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-blue-500/30">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">App Settings</h1>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Manage your application configuration</p>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-4 py-2 rounded-lg">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Last updated: <%= moment(appSettings.lastUpdatedAt).format('DD MMM YYYY, hh:mm A') %>
                </div>
                <button onclick="refreshSettings()" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors">
                    <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Quick Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Total Sections</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">8</p>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Social Links</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= appSettings.socialLinks ? appSettings.socialLinks.length : 0 %></p>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">FAQs</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= appSettings.faqs ? appSettings.faqs.length : 0 %></p>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Offices</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= appSettings.offices ? appSettings.offices.length : 0 %></p>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search & Filter Bar -->
        <div class="mb-6 flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" id="settingsSearch" placeholder="Search settings sections..." class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <svg class="absolute left-3 top-3 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <div class="flex gap-2">
                <button onclick="expandAll()" class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors text-sm font-medium text-gray-700 dark:text-gray-300">
                    <i class="fas fa-expand mr-2"></i> Expand All
                </button>
                <button onclick="collapseAll()" class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors text-sm font-medium text-gray-700 dark:text-gray-300">
                    <i class="fas fa-compress mr-2"></i> Collapse All
                </button>
            </div>
        </div>

        <!-- Tabs Navigation with Icons -->
        <div class="mb-6 overflow-x-auto">
            <nav class="flex flex-nowrap gap-1 border-b border-gray-200 dark:border-gray-700 pb-0.5" id="settingsTabs">
                <button type="button" class="tab-btn active px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="hero">
                    <i class="fas fa-home mr-2 text-blue-500"></i> Hero
                    <span class="ml-1 text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-2 py-0.5 rounded-full">1</span>
                </button>
                <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="contact">
                    <i class="fas fa-address-card mr-2 text-green-500"></i> Contact
                </button>
                <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="social">
                    <i class="fas fa-share-alt mr-2 text-purple-500"></i> Social
                    <span class="ml-1 text-xs bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-2 py-0.5 rounded-full"><%= appSettings.socialLinks ? appSettings.socialLinks.length : 0 %></span>
                </button>
                <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="offices">
                    <i class="fas fa-building mr-2 text-orange-500"></i> Offices
                    <span class="ml-1 text-xs bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 px-2 py-0.5 rounded-full"><%= appSettings.offices ? appSettings.offices.length : 0 %></span>
                </button>
                <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="hours">
                    <i class="fas fa-clock mr-2 text-teal-500"></i> Hours
                </button>
                <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="faqs">
                    <i class="fas fa-question-circle mr-2 text-red-500"></i> FAQs
                    <span class="ml-1 text-xs bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 px-2 py-0.5 rounded-full"><%= appSettings.faqs ? appSettings.faqs.length : 0 %></span>
                </button>
                <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="stats">
                    <i class="fas fa-chart-bar mr-2 text-indigo-500"></i> Stats
                </button>
                <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" data-tab="features">
                    <i class="fas fa-star mr-2 text-yellow-500"></i> Features
                    <span class="ml-1 text-xs bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 px-2 py-0.5 rounded-full"><%= appSettings.features ? appSettings.features.length : 0 %></span>
                </button>
            </nav>
        </div>

        <!-- Tab Contents -->
        <div class="space-y-4">
            
            <!-- HERO TAB -->
            <div id="tab-hero" class="tab-content">
                <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden settings-card">
                    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-700/30 dark:to-gray-700/20">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                    <i class="fas fa-home text-blue-600 dark:text-blue-400"></i>
                                    Hero Section
                                </h3>
                                <p class="text-sm text-gray-600 dark:text-gray-400">Customize the homepage hero section</p>
                            </div>
                            <span class="text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-3 py-1 rounded-full">Active</span>
                        </div>
                    </div>
                    <form action="/admin/settings/hero" method="POST" enctype="multipart/form-data" class="p-6">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    <i class="fas fa-heading text-blue-500 mr-1"></i> Heading
                                </label>
                                <input type="text" name="heading" value="<%= appSettings.hero?.heading || '' %>" class="form-input w-full px-4 py-2.5 rounded-lg bg-gray-50 dark:bg-gray-700" placeholder="Enter main heading">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    <i class="fas fa-tag text-blue-500 mr-1"></i> Badge Text
                                </label>
                                <input type="text" name="badgeText" value="<%= appSettings.hero?.badgeText || '' %>" class="form-input w-full px-4 py-2.5 rounded-lg bg-gray-50 dark:bg-gray-700" placeholder="#1 Learning Platform">
                            </div>
                        </div>
                        <div class="mt-4">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                <i class="fas fa-align-left text-blue-500 mr-1"></i> Subheading
                            </label>
                            <textarea name="subheading" rows="3" class="form-input w-full px-4 py-2.5 rounded-lg bg-gray-50 dark:bg-gray-700" placeholder="Enter subheading"><%= appSettings.hero?.subheading || '' %></textarea>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    <i class="fas fa-hand-pointer text-blue-500 mr-1"></i> CTA Text
                                </label>
                                <input type="text" name="ctaText" value="<%= appSettings.hero?.ctaText || '' %>" class="form-input w-full px-4 py-2.5 rounded-lg bg-gray-50 dark:bg-gray-700" placeholder="Explore Courses">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    <i class="fas fa-link text-blue-500 mr-1"></i> CTA Link
                                </label>
                                <input type="text" name="ctaLink" value="<%= appSettings.hero?.ctaLink || '' %>" class="form-input w-full px-4 py-2.5 rounded-lg bg-gray-50 dark:bg-gray-700" placeholder="/courses">
                            </div>
                        </div>
                        <div class="mt-4 flex items-center gap-6">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <div class="relative">
                                    <input type="checkbox" name="showStats" <%= appSettings.hero?.showStats !== false ? 'checked' : '' %> class="sr-only peer">
                                    <div class="w-11 h-6 bg-gray-200 dark:bg-gray-600 rounded-full peer peer-checked:bg-blue-600 transition-colors"></div>
                                    <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full transition-transform peer-checked:translate-x-5"></div>
                                </div>
                                <span class="text-sm text-gray-700 dark:text-gray-300">Show Statistics</span>
                            </label>
                        </div>
                        <div class="mt-4">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                <i class="fas fa-image text-blue-500 mr-1"></i> Background Image
                            </label>
                            <% if (appSettings.hero?.backgroundImage?.url) { %>
                                <div class="mb-3 image-preview p-4 rounded-lg">
                                    <img src="<%= appSettings.hero.backgroundImage.url %>" alt="Hero Background" class="h-40 w-auto rounded-lg object-cover border border-gray-200 dark:border-gray-600">
                                </div>
                            <% } %>
                            <input type="file" name="backgroundImage" accept="image/*" class="form-input w-full px-4 py-2.5 rounded-lg bg-gray-50 dark:bg-gray-700">
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Recommended: 1920x1080px, max 2MB</p>
                        </div>
                        <div class="mt-6 flex gap-3">
                            <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-lg transition-all shadow-md hover:shadow-lg flex items-center gap-2">
                                <i class="fas fa-save"></i> Update Hero
                            </button>
                            <button type="reset" class="px-6 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-all">
                                <i class="fas fa-undo"></i> Reset
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- CONTACT TAB -->
            <div id="tab-contact" class="tab-content hidden">
                <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden settings-card">
                    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-green-50 to-emerald-50 dark:from-gray-700/30 dark:to-gray-700/20">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                    <i class="fas fa-address-card text-green-600 dark:text-green-400"></i>
                                    Contact Information
                                </h3>
                                <p class="text-sm text-gray-600 dark:text-gray-400">Update contact details displayed on the site</p>
                            </div>
                        </div>
                    </div>
                    <form action="/admin/settings/contact" method="POST" class="p-6">
                        <div class="space-y-5">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                                    <i class="fas fa-map-marker-alt text-green-500 mr-1"></i> Address
                                </label>
                                <input type="text" name="address" value="<%= appSettings.contact?.address || '' %>" class="form-input w-full px-4 py-2.5 rounded-lg bg-gray-50 dark:bg-gray-700" placeholder="Full address">
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
