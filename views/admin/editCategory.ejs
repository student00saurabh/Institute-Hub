<script>
document.addEventListener('DOMContentLoaded', function() {
    // Icon preview on selection change
    const iconSelect = document.getElementById('icon');
    const iconPreview = document.querySelector('#iconPreview i');
    
    if (iconSelect && iconPreview) {
        iconSelect.addEventListener('change', function() {
            const iconClass = this.value || 'fa-shield-alt';
            iconPreview.className = `fas ${iconClass}`;
        });
    }

    // Color preview on selection change
    const colorSelect = document.getElementById('color');
    const colorPreview = document.getElementById('colorPreview');
    const colorName = document.getElementById('colorName');
    
    const colorMap = {
        'blue': { bg: 'bg-blue-500', name: 'Blue' },
        'indigo': { bg: 'bg-indigo-500', name: 'Indigo' },
        'purple': { bg: 'bg-purple-500', name: 'Purple' },
        'pink': { bg: 'bg-pink-500', name: 'Pink' },
        'red': { bg: 'bg-red-500', name: 'Red' },
        'orange': { bg: 'bg-orange-500', name: 'Orange' },
        'yellow': { bg: 'bg-yellow-500', name: 'Yellow' },
        'green': { bg: 'bg-green-500', name: 'Green' },
        'teal': { bg: 'bg-teal-500', name: 'Teal' },
        'cyan': { bg: 'bg-cyan-500', name: 'Cyan' },
        'gray': { bg: 'bg-gray-500', name: 'Gray' }
    };

    if (colorSelect && colorPreview && colorName) {
        // Initial preview
        const initialColor = colorSelect.value || 'blue';
        const initialColorInfo = colorMap[initialColor] || colorMap['blue'];
        colorPreview.className = `inline-block w-6 h-6 rounded-full ${initialColorInfo.bg} border border-gray-300 dark:border-gray-600`;
        colorName.textContent = initialColorInfo.name;

        // Update on change
        colorSelect.addEventListener('change', function() {
            const colorValue = this.value || 'blue';
            const colorInfo = colorMap[colorValue] || colorMap['blue'];
            colorPreview.className = `inline-block w-6 h-6 rounded-full ${colorInfo.bg} border border-gray-300 dark:border-gray-600`;
            colorName.textContent = colorInfo.name;
        });
    }
});
</script>

