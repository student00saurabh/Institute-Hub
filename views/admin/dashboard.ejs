<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                            </svg>
                        </div>
                        Admin Dashboard
                    </h1>
                    <p class="mt-1 text-gray-600 dark:text-gray-400">
                        Manage your CyberKavach platform efficiently
                    </p>
                </div>
                <div class="mt-4 md:mt-0 flex items-center gap-3">
                    <span class="text-sm text-gray-500 dark:text-gray-400">
                        <i class="far fa-calendar-alt mr-1"></i>
                        <%= new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </span>
                </div>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-8" data-aos="fade-up" data-aos-duration="600">
            <!-- Total Users -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Users</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= stats.totalUsers || 0 %></p>
                        <p class="text-xs text-green-600 dark:text-green-400 mt-1">
                            <i class="fas fa-arrow-up"></i> <%= stats.userGrowth || 0 %>% growth
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Total Courses -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Courses</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= stats.totalCourses || 0 %></p>
                        <p class="text-xs text-green-600 dark:text-green-400 mt-1">
                            <i class="fas fa-arrow-up"></i> <%= stats.courseGrowth || 12 %>% growth
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Pending Actions -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Pending Actions</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= stats.pendingActions || 0 %></p>
                        <p class="text-xs text-yellow-600 dark:text-yellow-400 mt-1">
                            <i class="fas fa-clock"></i> Needs attention
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center">
                        <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Total Blogs -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Blogs</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= stats.totalBlogs || 0 %></p>
                        <p class="text-xs text-green-600 dark:text-green-400 mt-1">
                            <i class="fas fa-arrow-up"></i> <%= stats.blogGrowth || 8 %>% growth
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center">
                        <svg class="w-6 h-6 text-pink-600 dark:text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 mb-8" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
            <!-- Manage Courses -->
            <a href="/admin/courses" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Manage Courses</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Create, edit, delete</p>
            </a>

            <!-- Manage Course Categories -->
            <a href="/admin/categories" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                    </svg>
                </div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">Manage Categories</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Create, edit, organize</p>
            </a>

            <!-- Manage Blogs -->
            <a href="/admin/blogs" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-pink-600 dark:text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                    </svg>
                </div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-pink-600 dark:group-hover:text-pink-400 transition-colors">Manage Blogs</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Create, edit, publish</p>
            </a>

            <!-- Manage Users -->
            <a href="/admin/users" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">Manage Users</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">View, block, delete</p>
            </a>

            <!-- Manage Reviews - NEW CARD -->
    <a href="/admin/reviews" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
        <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform relative">
            <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
            </svg>
            <!-- Pending Badge -->
            <% if (stats && stats.pendingReviews > 0) { %>
                <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center shadow-lg">
                    <%= stats.pendingReviews %>
                </span>
            <% } %>
        </div>
        <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">Manage Reviews</h4>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">View, approve, manage</p>
    </a>

    <!-- Course Ratings Card - Add to Quick Actions Grid -->
<a href="/admin/course-ratings" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
    <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform relative">
        <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
        </svg>
        <!-- Pending/Total Badge -->
        <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center shadow-lg">
            <%= stats.totalCourses || 0 %>
        </span>
    </div>
    <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">Course Ratings</h4>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">View, manage ratings</p>
</a>


            <!-- Contact Submissions -->
            <a href="/admin/contacts" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-yellow-600 dark:group-hover:text-yellow-400 transition-colors">Contact Submissions</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">View, respond, delete</p>
            </a>

            <!-- Subscribers -->
            <a href="/admin/subscribers" class="group bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-4 text-center hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 4h-4"></path>
                    </svg>
                </div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">Subscribers</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Manage newsletter</p>
            </a>
        </div>

        <!-- Recent Activity & Users -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" data-aos="fade-up" data-aos-duration="600" data-aos-delay="200">
            
            <!-- Recent Users -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                    </div>
                    Recent Users
                </h3>
                <div class="space-y-3">
                    <% if (recentUsers && recentUsers.length > 0) { %>
                        <% recentUsers.slice(0, 5).forEach(user => { %>
                            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/30 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white text-xs font-bold">
                                        <%= user.name?.charAt(0).toUpperCase() || 'U' %>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900 dark:text-white"><%= user.name || 'Unknown' %></p>
                                        <p class="text-xs text-gray-500 dark:text-gray-400"><%= user.email %></p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <a href="/admin/users/<%= user._id %>" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors" title="View Details">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-center text-gray-500 dark:text-gray-400 py-4">No recent users</p>
                    <% } %>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <a href="/admin/users" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
                        View All Users →
                    </a>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center">
                        <svg class="w-4 h-4 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    Recent Activity
                </h3>
                <div class="space-y-3">
                    <% if (recentActivities && recentActivities.length > 0) { %>
                        <% recentActivities.slice(0, 5).forEach(activity => { %>
                            <div class="flex items-start gap-3 p-3 bg-gray-50 dark:bg-gray-700/30 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0
                                    <% if (activity.type === 'user') { %>bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400<% } 
                                    else if (activity.type === 'course') { %>bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400<% } 
                                    else if (activity.type === 'blog') { %>bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-400<% } 
                                    else if (activity.type === 'contact') { %>bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400<% } 
                                    else { %>bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400<% } %>">
                                    <% if (activity.type === 'user') { %>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                    <% } else if (activity.type === 'course') { %>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                        </svg>
                                    <% } else if (activity.type === 'blog') { %>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                                        </svg>
                                    <% } else { %>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                        </svg>
                                    <% } %>
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm text-gray-800 dark:text-gray-200"><%= activity.title %></p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400"><%= activity.description %></p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
                                        <%= moment(activity.timestamp).fromNow() %>
                                    </p>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-center text-gray-500 dark:text-gray-400 py-4">No recent activity</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Recent Courses -->
        <div class="mt-6 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm" data-aos="fade-up" data-aos-duration="600" data-aos-delay="300">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
                    <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                Recent Courses
            </h3>
            <div class="space-y-3">
                <% if (courses && courses.length > 0) { %>
                    <% courses.slice(0, 5).forEach(course => { %>
                        <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/30 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <div class="flex items-center gap-3">
                                <img src="<%= course.image?.url || 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=50&auto=format&fit=crop' %>" 
                                     alt="<%= course.title %>" 
                                     class="w-10 h-10 rounded-lg object-cover">
                                <div>
                                    <p class="text-sm font-medium text-gray-900 dark:text-white"><%= course.title %></p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">
                                        <span class="text-green-600 dark:text-green-400">₹<%= course.price || 0 %></span>
                                        • <%= course.students?.length || 0 %> students
                                        <% if (course.categoryName) { %>
                                            <span class="ml-2 px-2 py-0.5 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full text-[10px]">
                                                <%= course.categoryName %>
                                            </span>
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs px-2 py-1 rounded-full <%= course.isActive ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' %>">
                                    <%= course.isActive ? 'Active' : 'Inactive' %>
                                </span>
                                <a href="/courses/<%= course._id %>/edit" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors" title="Edit Course">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-center text-gray-500 dark:text-gray-400 py-4">No courses available</p>
                <% } %>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                <a href="/admin/courses" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
                    View All Courses →
                </a>
            </div>
        </div>

        <!-- Pending Contacts & Subscribers Quick View -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6" data-aos="fade-up" data-aos-duration="600" data-aos-delay="400">
            <!-- Pending Contacts -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center">
                        <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    Pending Contacts
                </h3>
                <div class="space-y-2">
                    <% if (pendingContacts && pendingContacts.length > 0) { %>
                        <% pendingContacts.slice(0, 3).forEach(contact => { %>
                            <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-700/30 rounded-lg">
                                <div>
                                    <p class="text-sm font-medium text-gray-900 dark:text-white"><%= contact.name %></p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400"><%= contact.subject %></p>
                                </div>
                                <a href="/admin/contacts" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">View</a>
                            </div>
                        <% }) %>
                        <% if (pendingContacts.length > 3) { %>
                            <p class="text-xs text-gray-500 dark:text-gray-400 text-center pt-2">
                                +<%= pendingContacts.length - 3 %> more pending contacts
                            </p>
                        <% } %>
                    <% } else { %>
                        <p class="text-center text-gray-500 dark:text-gray-400 py-2">No pending contacts</p>
                    <% } %>
                </div>
                <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                    <a href="/admin/contacts" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
                        View All Contacts →
                    </a>
                </div>
            </div>

            <!-- Pending Subscribers -->
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                        <svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 4h-4"></path>
                        </svg>
                    </div>
                    Pending Subscribers
                </h3>
                <div class="space-y-2">
                    <% if (pendingSubscribers && pendingSubscribers.length > 0) { %>
                        <% pendingSubscribers.slice(0, 3).forEach(sub => { %>
                            <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-700/30 rounded-lg">
                                <p class="text-sm font-medium text-gray-900 dark:text-white"><%= sub.email %></p>
                                <a href="/admin/subscribers" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">Manage</a>
                            </div>
                        <% }) %>
                        <% if (pendingSubscribers.length > 3) { %>
                            <p class="text-xs text-gray-500 dark:text-gray-400 text-center pt-2">
                                +<%= pendingSubscribers.length - 3 %> more pending subscribers
                            </p>
                        <% } %>
                    <% } else { %>
                        <p class="text-center text-gray-500 dark:text-gray-400 py-2">No pending subscribers</p>
                    <% } %>
                </div>
                <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                    <a href="/admin/subscribers" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium transition-colors">
                        View All Subscribers →
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Stats card hover effect */
    .bg-white\/80, .bg-gray-800\/80 {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    /* Smooth icon scaling */
    .group:hover .w-12.h-12 {
        transform: scale(1.1);
    }
    
    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 6px;
    }
    ::-webkit-scrollbar-track {
        background: transparent;
    }
    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    .dark ::-webkit-scrollbar-thumb {
        background: #475569;
    }
</style>