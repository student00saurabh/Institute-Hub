<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-indigo-600 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                    </div>
                    Manage Teachers
                </h1>
                <p class="mt-1 text-gray-600 dark:text-gray-400">Manage instructors and their courses</p>
            </div>
            <div class="mt-4 md:mt-0 flex items-center gap-3">
                <span class="text-sm text-gray-500 dark:text-gray-400">
                    <i class="far fa-calendar-alt mr-1"></i>
                    <%= new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </span>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Teachers</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= totalTeachers %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Active</p>
                <p class="text-2xl font-bold text-green-600 dark:text-green-400">
                    <%= teachers.filter(t => t.isActive !== false).length %>
                </p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Blocked</p>
                <p class="text-2xl font-bold text-red-600 dark:text-red-400">
                    <%= teachers.filter(t => t.isBlocked === true).length %>
                </p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Courses</p>
                <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">
                    <%= teachers.reduce((sum, t) => sum + (t.courseCount || 0), 0) %>
                </p>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6">
            <form action="/admin/teachers" method="GET" class="flex flex-col sm:flex-row gap-4">
                <div class="flex-1 relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" 
                           name="search" 
                           value="<%= search %>"
                           placeholder="Search teachers by name or email..."
                           class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                    <i class="fas fa-search mr-2"></i> Search
                </button>
                <a href="/admin/teachers" class="px-6 py-2 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors text-center">
                    <i class="fas fa-times mr-2"></i> Reset
                </a>
            </form>
        </div>

        <!-- Teachers Table -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Teacher</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Courses</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Joined</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        <% if (teachers && teachers.length > 0) { %>
                            <% teachers.forEach(teacher => { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-500 flex items-center justify-center text-white font-bold text-sm">
                                                <%= teacher.name?.charAt(0).toUpperCase() || 'T' %>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-900 dark:text-white"><%= teacher.name || 'Unknown' %></p>
                                                <% if (teacher.role === 'admin') { %>
                                                    <span class="text-xs px-2 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full">Admin</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="text-sm text-gray-600 dark:text-gray-400"><%= teacher.email %></span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="text-sm font-medium text-blue-600 dark:text-blue-400"><%= teacher.courseCount || 0 %></span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex flex-col gap-1">
                                            <span class="text-xs px-2 py-1 rounded-full inline-block w-fit 
                                                <%= teacher.isActive !== false ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300' %>">
                                                <%= teacher.isActive !== false ? 'Active' : 'Inactive' %>
                                            </span>
                                            <% if (teacher.isBlocked) { %>
                                                <span class="text-xs px-2 py-1 rounded-full inline-block w-fit bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">
                                                    Blocked
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                        <%= moment(teacher.createdAt).format('DD MMM YYYY') %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <a href="/admin/teachers/<%= teacher._id %>" 
                                               class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors"
                                               title="View Details">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                                </svg>
                                            </a>
                                            
                                            <!-- Toggle Role -->
                                            <form action="/admin/teachers/<%= teacher._id %>/toggle-role" method="POST" class="inline">
                                                <input type="hidden" name="_method" value="PATCH">
                                                <button type="submit" 
                                                        class="<%= teacher.role === 'admin' ? 'text-red-600 dark:text-red-400 hover:text-red-800' : 'text-purple-600 dark:text-purple-400 hover:text-purple-800' %> transition-colors"
                                                        title="<%= teacher.role === 'admin' ? 'Remove admin role' : 'Make teacher' %>">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l3 3-3 3"></path>
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 12h-6"></path>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                                    <div class="flex flex-col items-center gap-2">
                                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                        </svg>
                                        <p>No teachers found</p>
                                        <p class="text-sm">Try adjusting your search or filters</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        Showing <span class="font-medium"><%= ((currentPage - 1) * 20) + 1 %></span> 
                        to <span class="font-medium"><%= Math.min(currentPage * 20, totalTeachers) %></span> 
                        of <span class="font-medium"><%= totalTeachers %></span> teachers
                    </p>
                    <div class="flex items-center gap-2">
                        <% if (currentPage > 1) { %>
                            <a href="?<%= buildPaginationUrl(currentPage - 1, search) %>" 
                               class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        <% } %>
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <% if (p === currentPage) { %>
                                <span class="px-4 py-2 rounded-lg bg-blue-600 text-white"><%= p %></span>
                            <% } else if (p === 1 || p === totalPages || Math.abs(p - currentPage) <= 2) { %>
                                <a href="?<%= buildPaginationUrl(p, search) %>" 
                                   class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                    <%= p %>
                                </a>
                            <% } else if (p === 2 || p === totalPages - 1) { %>
                                <span class="px-2 text-gray-400">…</span>
                            <% } %>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="?<%= buildPaginationUrl(currentPage + 1, search) %>" 
                               class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%
  function buildPaginationUrl(page, search) {
      const params = new URLSearchParams();
      if (page && page > 1) params.set('page', page);
      if (search) params.set('search', search);
      return params.toString();
  }
%>