%>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8" data-aos="fade-up">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#C9A227] to-[#B8901E] flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                        </div>
                        Create Category
                    </h1>
                    <p class="mt-1 text-gray-600 dark:text-gray-400">
                        Add a new course category to organize your courses
                    </p>
                </div>
                <div class="mt-4 md:mt-0">
                    <a href="/admin/categories" 
                       class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                        <i class="fas fa-arrow-left mr-2"></i> Back to Categories
                    </a>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6 sm:p-8" data-aos="fade-up" data-aos-duration="600">
            <form action="/admin/categories" method="POST" class="space-y-6">
                
                <!-- Category Name -->
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Category Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="name" name="name" required
                           placeholder="e.g., Web Development, Data Science, Cybersecurity"
                           class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i> Unique name for the category (2-50 characters)
                    </p>
                </div>

                <!-- Category Group -->
                <div>
                    <label for="categoryGroup" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Category Group <span class="text-red-500">*</span>
                    </label>
                    <select id="categoryGroup" name="categoryGroup" required
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none cursor-pointer">
                        <option value="">Select a group</option>
                        <% CATEGORY_GROUPS.forEach(group => { %>
                            <option value="<%= group.name %>" 
                                    data-icon="<%= group.icon %>"
                                    data-color="<%= group.color %>">
                                <i class="fas <%= group.icon %>"></i> <%= group.name %>
                            </option>
                        <% }) %>
                    </select>
                    <div id="groupDescription" class="mt-2 p-3 bg-gray-50 dark:bg-gray-700/30 rounded-lg border border-gray-200 dark:border-gray-700 hidden">
                        <p class="text-sm text-gray-600 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1 text-[#C9A227]"></i>
                            <span id="groupDescText"></span>
                        </p>
                    </div>
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i> Select the group this category belongs to
                    </p>
                </div>

                <!-- Description -->
                <div>
                    <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                        Description
                    </label>
                    <textarea id="description" name="description" rows="3"
                              placeholder="Brief description of this category..."
                              class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 resize-none"></textarea>
                    <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i> Short description (max 200 characters)
                    </p>
                </div>

                <!-- Icon & Color -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Icon Dropdown -->
                    <div>
                        <label for="icon" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Icon <span class="text-red-500">*</span>
                        </label>
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-[#C9A227]/10 dark:bg-[#C9A227]/20 flex items-center justify-center text-[#C9A227] dark:text-[#C9A227] text-xl flex-shrink-0" id="iconPreview">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <select id="icon" name="icon" 
                                    class="flex-1 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none cursor-pointer">
                                <% const iconGroups = [...new Set(AVAILABLE_ICONS.map(i => i.group))]; %>
                                <% iconGroups.forEach(group => { %>
                                    <optgroup label="<%= group %>">
                                        <% AVAILABLE_ICONS.filter(i => i.group === group).forEach(icon => { %>
                                            <option value="<%= icon.value %>">
                                                <%= icon.label %>
                                            </option>
                                        <% }) %>
                                    </optgroup>
                                <% }) %>
                            </select>
                        </div>
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Select an icon that represents this category
                        </p>
                    </div>

                    <!-- Color Dropdown with Preview -->
                    <div>
                        <label for="color" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Color <span class="text-red-500">*</span>
                        </label>
                        <div class="flex items-center gap-3">
                            <div id="colorPreview" class="w-12 h-12 rounded-xl border-2 border-gray-300 dark:border-gray-600 flex-shrink-0" style="background-color: #2563EB;">
                            </div>
                            <select id="color" name="color"
                                    class="flex-1 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200 appearance-none cursor-pointer">
                                <option value="blue" style="background-color:#2563EB;color:white;">🔵 Blue</option>
                                <option value="indigo" style="background-color:#4F46E5;color:white;">🟣 Indigo</option>
                                <option value="purple" style="background-color:#7C3AED;color:white;">🟣 Purple</option>
                                <option value="pink" style="background-color:#DB2777;color:white;">🩷 Pink</option>
                                <option value="red" style="background-color:#EF4444;color:white;">🔴 Red</option>
                                <option value="orange" style="background-color:#F97316;color:white;">🟠 Orange</option>
                                <option value="yellow" style="background-color:#EAB308;color:white;">🟡 Yellow</option>
                                <option value="green" style="background-color:#22C55E;color:white;">🟢 Green</option>
                                <option value="teal" style="background-color:#14B8A6;color:white;">🟢 Teal</option>
                                <option value="cyan" style="background-color:#06B6D4;color:white;">🟦 Cyan</option>
                                <option value="gray" style="background-color:#6B7280;color:white;">⚪ Gray</option>
                            </select>
                        </div>
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">
                            <i class="fas fa-info-circle mr-1"></i> Select a color for the category badge
                        </p>
                    </div>
                </div>

                <!-- Display Order & Active -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="displayOrder" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Display Order
                        </label>
                        <input type="number" id="displayOrder" name="displayOrder" value="0" min="0" step="1"
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#C9A227] dark:focus:ring-[#C9A227] focus:border-transparent transition-all duration-200">
                        <div class="mt-2 p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
                            <p class="text-xs text-blue-800 dark:text-blue-300">
                                <i class="fas fa-info-circle mr-1"></i> 
                                <strong>Order Guide:</strong>
                            </p>
                            <ul class="text-xs text-blue-700 dark:text-blue-300 mt-1 space-y-0.5 list-disc list-inside">
                                <li><strong>0</strong> - First position (appears at the top)</li>
                                <li><strong>1, 2, 3...</strong> - Subsequent positions</li>
                                <li><strong>Higher numbers</strong> - Appear later in the list</li>
                                <li class="text-yellow-600 dark:text-yellow-400">💡 Tip: Use increments of 10 (e.g., 10, 20, 30) to easily insert new categories later</li>
                            </ul>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                            Status
                        </label>
                        <div class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30">
                            <input type="checkbox" id="isActive" name="isActive" checked
                                   class="w-5 h-5 rounded border-gray-300 dark:border-gray-600 text-[#C9A227] focus:ring-[#C9A227] dark:focus:ring-[#C9A227]">
                            <label for="isActive" class="text-sm font-medium text-gray-700 dark:text-gray-300">
                                Active
                            </label>
                            <p class="text-xs text-gray-500 dark:text-gray-400 ml-2">
                                Inactive categories won't appear in dropdowns
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <button type="submit"
                            class="flex-1 bg-gradient-to-r from-[#C9A227] to-[#B8901E] hover:from-[#B8901E] hover:to-[#A07A1A] text-white font-medium py-3.5 px-6 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Create Category
                    </button>
                    <a href="/admin/categories"
                       class="flex-1 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 font-medium py-3.5 px-6 rounded-xl transition-colors duration-200 text-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Help Tips -->
        <div class="mt-6 bg-[#C9A227]/10 dark:bg-[#C9A227]/20 rounded-xl p-6 border border-[#C9A227]/30" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[#C9A227]/20 dark:bg-[#C9A227]/30 flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#C9A227]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-gray-900 dark:text-white">Category Management Tips</h3>
                    <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="text-sm text-gray-700 dark:text-gray-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-[#C9A227]"></i> Meaningful Names</p>
                            <p class="mt-0.5 text-xs opacity-70">Use clear, descriptive category names</p>
                        </div>
                        <div class="text-sm text-gray-700 dark:text-gray-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-[#C9A227]"></i> Icon Selection</p>
                            <p class="mt-0.5 text-xs opacity-70">Choose icons that represent the category well</p>
                        </div>
                        <div class="text-sm text-gray-700 dark:text-gray-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-[#C9A227]"></i> Order Matters</p>
                            <p class="mt-0.5 text-xs opacity-70">Set display order for logical grouping (0 = first)</p>
                        </div>
                        <div class="text-sm text-gray-700 dark:text-gray-300">
                            <p class="font-medium"><i class="fas fa-check-circle mr-1.5 text-[#C9A227]"></i> Active Status</p>
                            <p class="mt-0.5 text-xs opacity-70">Deactivate unused categories instead of deleting</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ── Category Group Description ──
    const groupSelect = document.getElementById('categoryGroup');
    const groupDesc = document.getElementById('groupDescription');
    const groupDescText = document.getElementById('groupDescText');
    
    const groupDescriptions = {
        'Academic & Education': 'School, college, university, online education, and academic programs',
        'Competitive & Entrance Exams': 'UPSC, SSC, Banking, JEE, NEET, GATE, CAT, CLAT and other entrance exams',
        'Career & Jobs': 'Job opportunities, career advice, interview tips, resume writing',
        'Engineering & Technology': 'Computer Science, Civil, Mechanical, AI, Data Science, Cybersecurity',
        'Health & Medical': 'Medical education, nursing, pharmacy, public health, healthcare',
        'Business & Management': 'MBA, Finance, Marketing, HR, Operations, Business Analytics',
        'Arts & Humanities': 'Fine arts, literature, history, philosophy, psychology, languages',
        'News & Current Affairs': 'Latest news, education news, job news, technology, sports, entertainment',
        'Teaching & Education Profession': 'Teaching tips, classroom management, teacher training, lesson planning',
        'Science & Research': 'Physics, Chemistry, Biology, Mathematics, Astronomy, Research',
        'General Interest': 'Lifestyle, travel, food, culture, books, movies, technology, environment',
        'Other': 'Other categories that don\'t fit in any specific group'
    };

    if (groupSelect) {
        groupSelect.addEventListener('change', function() {
            const selectedGroup = this.value;
            if (selectedGroup && groupDescriptions[selectedGroup]) {
                groupDesc.classList.remove('hidden');
                groupDescText.textContent = groupDescriptions[selectedGroup];
            } else {
                groupDesc.classList.add('hidden');
            }
        });
    }

    // ── Icon preview on selection change ──
    const iconSelect = document.getElementById('icon');
    const iconPreview = document.querySelector('#iconPreview i');
    
    if (iconSelect && iconPreview) {
        iconSelect.addEventListener('change', function() {
            const iconClass = this.value || 'fa-shield-alt';
            iconPreview.className = `fas ${iconClass}`;
        });
    }

    // ── Color preview on selection change ──
    const colorSelect = document.getElementById('color');
    const colorPreview = document.getElementById('colorPreview');
    
    const colorMap = {
        'blue': '#2563EB',
        'indigo': '#4F46E5',
        'purple': '#7C3AED',
        'pink': '#DB2777',
        'red': '#EF4444',
        'orange': '#F97316',
        'yellow': '#EAB308',
        'green': '#22C55E',
        'teal': '#14B8A6',
        'cyan': '#06B6D4',
        'gray': '#6B7280'
    };

    if (colorSelect && colorPreview) {
        colorSelect.addEventListener('change', function() {
            const colorValue = this.value || 'blue';
            colorPreview.style.backgroundColor = colorMap[colorValue] || '#2563EB';
        });
    }
});
</script>

