<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8" data-aos="fade-up">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                    Manage Courses
                </h1>
                <p class="mt-1 text-gray-600 dark:text-gray-400">
                    Create, edit, and manage all courses on the platform
                </p>
            </div>
            <div class="mt-4 md:mt-0 flex flex-wrap gap-3">
                <a href="/courses/new" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-medium rounded-xl transition-all duration-200 shadow-md hover:shadow-lg">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Add New Course
                </a>
                <a href="/admin/dashboard" class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                    Back to Dashboard
                </a>
            </div>
        </div>

        <!-- Stats Summary -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6" data-aos="fade-up" data-aos-duration="600">
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Courses</p>
                <p class="text-xl font-bold text-gray-900 dark:text-white"><%= totalCourses || 0 %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Active</p>
                <p class="text-xl font-bold text-green-600 dark:text-green-400">
                    <%= courses ? courses.filter(c => c.isActive).length : 0 %>
                </p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Inactive</p>
                <p class="text-xl font-bold text-red-600 dark:text-red-400">
                    <%= courses ? courses.filter(c => !c.isActive).length : 0 %>
                </p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Popular</p>
                <p class="text-xl font-bold text-yellow-600 dark:text-yellow-400">
                    <%= courses ? courses.filter(c => c.isPopular).length : 0 %>
                </p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Students</p>
                <p class="text-xl font-bold text-purple-600 dark:text-purple-400">
                    <%= courses ? courses.reduce((sum, c) => sum + (c.students?.length || 0), 0) : 0 %>
                </p>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6" data-aos="fade-up" data-aos-duration="600" data-aos-delay="100">
            <form action="/admin/courses" method="GET" class="flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input type="text" 
                               name="search" 
                               value="<%= search %>"
                               placeholder="Search courses by title, description, or type..." 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                    </div>
                </div>
                <div class="flex gap-3">
                    <select name="filter" class="px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200">
                        <option value="all" <%= filter === 'all' ? 'selected' : '' %>>All Courses</option>
                        <option value="active" <%= filter === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="inactive" <%= filter === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        <option value="popular" <%= filter === 'popular' ? 'selected' : '' %>>Popular</option>
                        <option value="navbar" <%= filter === 'navbar' ? 'selected' : '' %>>In Navbar</option>
                        <option value="homepage" <%= filter === 'homepage' ? 'selected' : '' %>>On Homepage</option>
                    </select>
                    <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-medium rounded-xl transition-all duration-200 shadow-md hover:shadow-lg">
                        <i class="fas fa-search mr-1"></i> Filter
                    </button>
                    <a href="/admin/courses" class="px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200 text-sm font-medium">
                        Reset
                    </a>
                </div>
            </form>
        </div>

        <!-- Results Info -->
        <div class="flex items-center justify-between mb-4">
            <p class="text-sm text-gray-500 dark:text-gray-400">
                Showing <span class="font-medium text-gray-700 dark:text-gray-300"><%= courses ? courses.length : 0 %></span> courses
                <span class="text-gray-400">of</span>
                <span class="font-medium text-gray-700 dark:text-gray-300"><%= totalCourses || 0 %></span>
                total
            </p>
            <% if (search) { %>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Search: "<span class="font-medium text-gray-700 dark:text-gray-300"><%= search %></span>"
                </p>
            <% } %>
            <% if (filter && filter !== 'all') { %>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Filter: <span class="font-medium text-gray-700 dark:text-gray-300"><%= filter %></span>
                </p>
            <% } %>
        </div>

        <!-- Courses Table -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm" data-aos="fade-up" data-aos-duration="600" data-aos-delay="200">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30">
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Course</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Price</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Students</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Teacher</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        <% if (courses && courses.length > 0) { %>
                            <% courses.forEach(course => { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <img src="<%= course.image?.url || 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=50&auto=format&fit=crop' %>" 
                                                 alt="<%= course.title %>" 
                                                 class="w-10 h-10 rounded-lg object-cover flex-shrink-0">
                                            <div>
                                                <p class="font-medium text-gray-900 dark:text-white text-sm"><%= course.title %></p>
                                                <p class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-xs"><%= course.shortDescription || '' %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                                        <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
                                            <%= course.courceType || 'Course' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-sm font-semibold text-gray-900 dark:text-white">
                                        ₹<%= course.price || 0 %>
                                        <% if (course.actualPrice && course.actualPrice > course.price) { %>
                                            <span class="text-xs text-gray-400 dark:text-gray-500 line-through block">₹<%= course.actualPrice %></span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-wrap gap-1">
                                            <!-- Active/Inactive Badge -->
                                            <span class="px-2 py-1 text-xs font-medium rounded-full <%= course.isActive ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300' %>">
                                                <%= course.isActive ? 'Active' : 'Inactive' %>
                                            </span>
                                            
                                            <!-- Popular Badge -->
                                            <% if (course.isPopular) { %>
                                                <span class="px-2 py-1 text-xs font-medium rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300">
                                                    <i class="fas fa-fire mr-0.5"></i>Popular
                                                </span>
                                            <% } %>
                                            
                                            <!-- Navbar Badge -->
                                            <% if (course.showInNavbar) { %>
                                                <span class="px-2 py-1 text-xs font-medium rounded-full bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300">
                                                    <i class="fas fa-bars mr-0.5"></i>Navbar
                                                </span>
                                            <% } %>
                                            
                                            <!-- Homepage Badge -->
                                            <% if (course.addInHomePage) { %>
                                                <span class="px-2 py-1 text-xs font-medium rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300">
                                                    <i class="fas fa-home mr-0.5"></i>Homepage
                                                </span>
                                            <% } %>
                                            
                                            <!-- Level Badge -->
                                            <span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400">
                                                <%= course.courseLevel || 'Beginner' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                                        <%= course.students?.length || 0 %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                                        <%= course.teacher?.name || 'Not Assigned' %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-end gap-1">
                                            <!-- View Details -->
                                            <a href="/courses/<%= course._id %>" 
                                               class="p-1.5 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 text-blue-600 dark:text-blue-400 transition-colors" 
                                               title="View Details">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                                </svg>
                                            </a>
                                            
                                            <!-- Edit -->
                                            <a href="/courses/<%= course._id %>/edit" 
                                               class="p-1.5 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400 transition-colors" 
                                               title="Edit Course">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                </svg>
                                            </a>
                                            
                                            <div class="w-px h-6 bg-gray-200 dark:bg-gray-700 mx-1"></div>
                                            
                                            <!-- Toggle Active -->
                                            <button onclick="toggleActive('<%= course._id %>')" 
                                                    class="p-1.5 rounded-lg hover:bg-green-50 dark:hover:bg-green-900/20 transition-colors <%= course.isActive ? 'text-green-600 dark:text-green-400' : 'text-gray-400 dark:text-gray-500' %>"
                                                    title="<%= course.isActive ? 'Deactivate' : 'Activate' %> Course">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= course.isActive ? 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' : 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' %>"></path>
                                                </svg>
                                            </button>
                                            
                                            <!-- Toggle Popular -->
                                            <button onclick="togglePopular('<%= course._id %>')" 
                                                    class="p-1.5 rounded-lg hover:bg-yellow-50 dark:hover:bg-yellow-900/20 transition-colors <%= course.isPopular ? 'text-yellow-500 dark:text-yellow-400' : 'text-gray-400 dark:text-gray-500' %>"
                                                    title="<%= course.isPopular ? 'Remove from Popular' : 'Make Popular' %>">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                                                </svg>
                                            </button>
                                            
                                            <!-- Toggle Navbar -->
                                            <button onclick="toggleNavbar('<%= course._id %>')" 
                                                    class="p-1.5 rounded-lg hover:bg-cyan-50 dark:hover:bg-cyan-900/20 transition-colors <%= course.showInNavbar ? 'text-cyan-600 dark:text-cyan-400' : 'text-gray-400 dark:text-gray-500' %>"
                                                    title="<%= course.showInNavbar ? 'Remove from Navbar' : 'Add to Navbar' %>">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                                                </svg>
                                            </button>
                                            
                                            <!-- Toggle Homepage -->
                                            <button onclick="toggleHomepage('<%= course._id %>')" 
                                                    class="p-1.5 rounded-lg hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-colors <%= course.addInHomePage ? 'text-purple-600 dark:text-purple-400' : 'text-gray-400 dark:text-gray-500' %>"
                                                    title="<%= course.addInHomePage ? 'Remove from Homepage' : 'Add to Homepage' %>">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                                                </svg>
                                            </button>
                                            
                                            <div class="w-px h-6 bg-gray-200 dark:bg-gray-700 mx-1"></div>
                                            
                                            <!-- Delete -->
                                            <button onclick="deleteCourse('<%= course._id %>', '<%= course.title %>')" 
                                                    class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-red-600 dark:text-red-400 transition-colors"
                                                    title="Delete Course">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                                    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                                        <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                        </svg>
                                    </div>
                                    <p class="text-sm font-medium">No courses found</p>
                                    <p class="text-xs mt-1">Create your first course to get started</p>
                                    <a href="/courses/new" class="inline-block mt-4 px-4 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-sm font-medium rounded-lg transition-all duration-200">
                                        Add New Course
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="mt-6 flex items-center justify-center gap-2 flex-wrap" data-aos="fade-up" data-aos-duration="600" data-aos-delay="300">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %><%= filter && filter !== 'all' ? '&filter=' + filter : '' %>" 
                       class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                    </a>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="px-4 py-2 rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold"><%= i %></span>
                    <% } else if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 2) { %>
                        <a href="?page=<%= i %><%= search ? '&search=' + search : '' %><%= filter && filter !== 'all' ? '&filter=' + filter : '' %>" 
                           class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200">
                            <%= i %>
                        </a>
                    <% } else if (i === 2 && currentPage > 4) { %>
                        <span class="px-2 text-gray-400">...</span>
                    <% } else if (i === totalPages - 1 && currentPage < totalPages - 3) { %>
                        <span class="px-2 text-gray-400">...</span>
                    <% } %>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %><%= filter && filter !== 'all' ? '&filter=' + filter : '' %>" 
                       class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<script>
// ============ TOGGLE FUNCTIONS ============

// Toggle Active Status
function toggleActive(id) {
    if (!confirm('Are you sure you want to toggle the active status of this course?')) return;
    
    fetch(`/courses/${id}`, {
        method: 'PATCH',
        headers: {
            'Content-Type': 'application/json',
        },
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification(data.message || 'Status updated!', 'success');
            setTimeout(() => window.location.reload(), 1000);
        } else {
            showNotification(data.message || 'Failed to update', 'error');
        }
    })
    .catch(error => {
        showNotification('An error occurred', 'error');
        console.error('Error:', error);
    });
}

