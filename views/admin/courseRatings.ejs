<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8" data-aos="fade-up">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-600 to-orange-600 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                        </svg>
                    </div>
                    Course Ratings
                </h1>
                <p class="mt-1 text-gray-600 dark:text-gray-400">
                    Manage all course ratings and reviews
                </p>
            </div>
            <a href="/admin/dashboard" class="mt-4 md:mt-0 px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                Back to Dashboard
            </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" data-aos="fade-up" data-aos-duration="600">
            <div class="bg-white/80 dark:bg-gray-800/80 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Ratings</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.totalRatings || 0 %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Courses with Ratings</p>
                <p class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= stats.coursesWithRatings || 0 %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Average Rating</p>
                <p class="text-2xl font-bold text-yellow-600 dark:text-yellow-400"><%= stats.averageRating ? stats.averageRating.toFixed(1) : 0 %></p>
            </div>
            <div class="bg-white/80 dark:bg-gray-800/80 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Courses</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.totalCourses || 0 %></p>
            </div>
        </div>

        <!-- Filter -->
        <div class="bg-white/80 dark:bg-gray-800/80 rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6">
            <form action="/admin/course-ratings" method="GET" class="flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Filter by Course</label>
                    <select name="courseId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <option value="">All Courses</option>
                        <% allCourses.forEach(course => { %>
                            <option value="<%= course._id %>" <%= courseId === course._id.toString() ? 'selected' : '' %>>
                                <%= course.title %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 text-white font-medium rounded-xl transition-all duration-200">
                    <i class="fas fa-filter mr-1"></i> Filter
                </button>
                <a href="/admin/course-ratings" class="px-6 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                    Reset
                </a>
            </form>
        </div>

        <!-- Ratings Table -->
        <div class="bg-white/80 dark:bg-gray-800/80 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm" data-aos="fade-up" data-aos-duration="600">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Course</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">User</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Rating</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Review</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        <% if (ratings && ratings.length > 0) { %>
                            <% ratings.forEach(rating => { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <a href="/admin/courses/<%= rating.courseId %>" class="font-medium text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                                            <%= rating.courseTitle %>
                                        </a>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">
                                            <i class="fas fa-chalkboard-teacher mr-1"></i> <%= rating.teacher?.name || 'Unknown' %>
                                        </p>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="font-medium text-gray-900 dark:text-white">
                                            <%= rating.user?.name || 'Anonymous' %>
                                        </p>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">
                                            <%= rating.user?.email || 'No email' %>
                                        </p>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-1">
                                            <span class="font-bold text-yellow-500"><%= rating.rating %></span>
                                            <span class="text-gray-400 dark:text-gray-500">/ 5</span>
                                            <div class="flex items-center gap-0.5 ml-2">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <i class="fas fa-star text-[10px] <%= i <= rating.rating ? 'text-yellow-400' : 'text-gray-300 dark:text-gray-600' %>"></i>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="text-gray-600 dark:text-gray-300 max-w-[200px] line-clamp-2">
                                            <%= rating.review || 'No review provided' %>
                                        </p>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                                        <%= moment(rating.createdAt).format('DD MMM YYYY') %>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <button onclick="deleteRating('<%= rating._id %>')" 
                                                class="px-3 py-1.5 text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900/50 rounded-lg transition-all duration-200">
                                            <i class="fas fa-trash mr-1"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                                    <i class="fas fa-star text-2xl block mb-2"></i>
                                    No ratings found
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="mt-6 flex items-center justify-center gap-2 flex-wrap">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %><%= courseId ? '&courseId=' + courseId : '' %>" 
                       class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-amber-50 dark:hover:bg-amber-900/20 hover:text-amber-600 dark:hover:text-amber-400 transition-all duration-200">
                        <i class="fas fa-chevron-left text-xs"></i>
                    </a>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="px-4 py-2 rounded-lg bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold"><%= i %></span>
                    <% } else if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 2) { %>
                        <a href="?page=<%= i %><%= courseId ? '&courseId=' + courseId : '' %>" 
                           class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-amber-50 dark:hover:bg-amber-900/20 hover:text-amber-600 dark:hover:text-amber-400 transition-all duration-200">
                            <%= i %>
                        </a>
                    <% } else if (i === 2 && currentPage > 4) { %>
                        <span class="px-2 text-gray-400">…</span>
                    <% } else if (i === totalPages - 1 && currentPage < totalPages - 3) { %>
                        <span class="px-2 text-gray-400">…</span>
                    <% } %>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %><%= courseId ? '&courseId=' + courseId : '' %>" 
                       class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-amber-50 dark:hover:bg-amber-900/20 hover:text-amber-600 dark:hover:text-amber-400 transition-all duration-200">
                        <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<!-- ============================================================ -->
<!-- DELETE RATING MODAL                                          -->
<!-- ============================================================ -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl max-w-md w-full border border-gray-200 dark:border-gray-700 transform transition-all duration-300 scale-95 opacity-0" id="deleteModalContent">
        <div class="p-6 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                <svg class="w-8 h-8 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Delete Rating</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
                Are you sure you want to delete this rating? This action cannot be undone.
            </p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeDeleteModal()" class="px-6 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200">
                    Cancel
                </button>
                <button onclick="confirmDelete()" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition-all duration-200 shadow-md hover:shadow-lg">
                    <i class="fas fa-trash mr-1"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let deleteId = null;

function deleteRating(id) {
    deleteId = id;
    const modal = document.getElementById('deleteModal');
    const content = document.getElementById('deleteModalContent');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
        content.classList.remove('scale-95', 'opacity-0');
        content.classList.add('scale-100', 'opacity-100');
    }, 10);
}

function closeDeleteModal() {
    const modal = document.getElementById('deleteModal');
    const content = document.getElementById('deleteModalContent');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
        modal.style.display = 'none';
        document.body.style.overflow = 'auto';
    }, 300);
}

function confirmDelete() {
    if (!deleteId) return;
    
    fetch(`/admin/course-ratings/${deleteId}`, {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            closeDeleteModal();
            location.reload();
        } else {
            alert(data.message || 'Failed to delete rating');
        }
    })
    .catch(err => {
        console.error('Error:', err);
        alert('An error occurred');
    });
}

// Close modal on outside click
document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeDeleteModal();
    }
});

// Close on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeDeleteModal();
    }
});
</script>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    #deleteModal {
        animation: modalFadeIn 0.3s ease forwards;
    }
    
    @keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>