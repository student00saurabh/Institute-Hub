<% layout("/layouts/boilerplate") %>

<div class="min-h-[90vh] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Page Header -->
        <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-600 to-blue-600 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    Manage Lectures
                </h1>
                <p class="mt-1 text-gray-600 dark:text-gray-400">Create, edit, and organize course lectures</p>
            </div>
            <div class="mt-4 md:mt-0 flex items-center gap-3">
                <a href="/admin/lectures/new" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    New Lecture
                </a>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Lectures</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= totalLectures || 0 %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Published</p>
                <p class="text-2xl font-bold text-green-600 dark:text-green-400">
                    <%= lectures?.filter(l => l.isPublished !== false).length || 0 %>
                </p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Draft</p>
                <p class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">
                    <%= lectures?.filter(l => l.isPublished === false).length || 0 %>
                </p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
                <p class="text-sm text-gray-500 dark:text-gray-400">Free Lectures</p>
                <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">
                    <%= lectures?.filter(l => l.isFree === true).length || 0 %>
                </p>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6">
            <form action="/admin/lectures" method="GET" class="flex flex-col sm:flex-row gap-4">
                <div class="flex-1 relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" 
                           name="search" 
                           value="<%= search %>"
                           placeholder="Search lectures by title..."
                           class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div class="relative">
                    <select name="topic" class="w-full sm:w-48 py-2 px-4 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">All Topics</option>
                        <% if (topics && topics.length > 0) { %>
                            <% topics.forEach(t => { %>
                                <option value="<%= t %>" <%= topic === t ? 'selected' : '' %>><%= t %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="relative">
                    <select name="status" class="w-full sm:w-48 py-2 px-4 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">All Status</option>
                        <option value="published" <%= status === 'published' ? 'selected' : '' %>>Published</option>
                        <option value="draft" <%= status === 'draft' ? 'selected' : '' %>>Draft</option>
                    </select>
                </div>
                <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                    <i class="fas fa-filter mr-2"></i> Apply
                </button>
                <a href="/admin/lectures" class="px-6 py-2 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors text-center">
                    <i class="fas fa-times mr-2"></i> Reset
                </a>
            </form>
        </div>

        <!-- Lectures Table -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Title</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Topic</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Courses</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Created</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        <% if (lectures && lectures.length > 0) { %>
                            <% lectures.forEach(lecture => { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-cyan-100 dark:bg-cyan-900/30 flex items-center justify-center text-cyan-600 dark:text-cyan-400">
                                                <i class="fas fa-file-video"></i>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-900 dark:text-white truncate max-w-[200px]">
                                                    <%= lecture.title %>
                                                </p>
                                                <p class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-[150px]">
                                                    <%= lecture.description?.substring(0, 50) || 'No description' %>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="text-xs px-2 py-1 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
                                            <%= lecture.topic || 'General' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="text-xs px-2 py-1 rounded-full 
                                            <%= lecture.type === 'video' ? 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300' :
                                              lecture.type === 'quiz' ? 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' :
                                              lecture.type === 'assignment' ? 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300' :
                                              'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300' %>">
                                            <%= lecture.type || 'Video' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="text-sm text-gray-600 dark:text-gray-400">
                                            <%= lecture.courses?.length || 0 %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col gap-1">
                                            <span class="text-xs px-2 py-1 rounded-full inline-block w-fit 
                                                <%= lecture.isPublished !== false ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300' %>">
                                                <%= lecture.isPublished !== false ? 'Published' : 'Draft' %>
                                            </span>
                                            <% if (lecture.isFree) { %>
                                                <span class="text-xs px-2 py-1 rounded-full inline-block w-fit bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
                                                    Free
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                                        <%= moment(lecture.createdAt).format('DD MMM YYYY') %>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <a href="/admin/lectures/<%= lecture._id %>" 
                                               class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors"
                                               title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/admin/lectures/<%= lecture._id %>/edit" 
                                               class="text-amber-600 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 transition-colors"
                                               title="Edit Lecture">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/admin/lectures/<%= lecture._id %>/toggle-publish" method="POST" class="inline">
                                                <input type="hidden" name="_method" value="PATCH">
                                                <button type="submit" 
                                                        class="<%= lecture.isPublished !== false ? 'text-green-600 dark:text-green-400 hover:text-green-800' : 'text-yellow-600 dark:text-yellow-400 hover:text-yellow-800' %> transition-colors"
                                                        title="<%= lecture.isPublished !== false ? 'Unpublish' : 'Publish' %>">
                                                    <i class="fas <%= lecture.isPublished !== false ? 'fa-eye' : 'fa-eye-slash' %>"></i>
                                                </button>
                                            </form>
                                            <button onclick="deleteLecture('<%= lecture._id %>')" 
                                                    class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors"
                                                    title="Delete Lecture">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                                    <div class="flex flex-col items-center gap-2">
                                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                        </svg>
                                        <p>No lectures found</p>
                                        <p class="text-sm">Create your first lecture to get started</p>
                                        <a href="/admin/lectures/new" class="mt-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                                            <i class="fas fa-plus mr-2"></i> Create Lecture
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        Showing <span class="font-medium"><%= ((currentPage - 1) * 20) + 1 %></span> 
                        to <span class="font-medium"><%= Math.min(currentPage * 20, totalLectures) %></span> 
                        of <span class="font-medium"><%= totalLectures %></span> lectures
                    </p>
                    <div class="flex items-center gap-2">
                        <% if (currentPage > 1) { %>
                            <a href="?<%= buildPaginationUrl(currentPage - 1, search, topic, status) %>" 
                               class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        <% } %>
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <% if (p === currentPage) { %>
                                <span class="px-4 py-2 rounded-lg bg-blue-600 text-white"><%= p %></span>
                            <% } else if (p === 1 || p === totalPages || Math.abs(p - currentPage) <= 2) { %>
                                <a href="?<%= buildPaginationUrl(p, search, topic, status) %>" 
                                   class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                    <%= p %>
                                </a>
                            <% } else if (p === 2 || p === totalPages - 1) { %>
                                <span class="px-2 text-gray-400">…</span>
                            <% } %>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="?<%= buildPaginationUrl(currentPage + 1, search, topic, status) %>" 
                               class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%
  function buildPaginationUrl(page, search, topic, status) {
      const params = new URLSearchParams();
      if (page && page > 1) params.set('page', page);
      if (search) params.set('search', search);
      if (topic) params.set('topic', topic);
      if (status) params.set('status', status);
      return params.toString();
  }
%>

<script>
function deleteLecture(id) {
    if (!confirm('Are you sure you want to delete this lecture? This action cannot be undone.')) return;
    
    fetch(`/admin/lectures/${id}`, {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.message || 'Failed to delete lecture');
        }
    })
    .catch(err => {
        console.error('Error:', err);
        alert('Failed to delete lecture');
    });
}
</script>