<% layout("layouts/boilerplate") %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    Login Activity
                </h1>
                <p class="mt-1 text-gray-600 dark:text-gray-400">
                    Monitor user login sessions, device information, and security events
                </p>
            </div>
            <div class="mt-4 md:mt-0 flex flex-wrap gap-3">
                <a href="/admin/dashboard" class="px-5 py-2.5 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-200 text-sm font-medium">
                    Back to Dashboard
                </a>
                <button onclick="window.location.reload()" class="px-5 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-medium rounded-xl transition-all duration-200 shadow-md hover:shadow-lg text-sm">
                    <i class="fas fa-sync-alt mr-2"></i> Refresh
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 mb-6">
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Logins</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= stats.totalLogins || 0 %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400">Active Sessions</p>
                <p class="text-2xl font-bold text-green-600 dark:text-green-400"><%= stats.activeSessions || 0 %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400">Failed Attempts</p>
                <p class="text-2xl font-bold text-red-600 dark:text-red-400"><%= stats.failedLogins || 0 %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400">Registered Users</p>
                <p class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= stats.uniqueUsers || 0 %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400">Unknown Emails</p>
                <p class="text-2xl font-bold text-orange-600 dark:text-orange-400"><%= stats.uniqueEmails || 0 %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400">Countries</p>
                <p class="text-2xl font-bold text-purple-600 dark:text-purple-400"><%= stats.uniqueCountries || 0 %></p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-4 border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400">Devices</p>
                <p class="text-2xl font-bold text-yellow-600 dark:text-yellow-400"><%= stats.uniqueDevices || 0 %></p>
            </div>
        </div>

        <!-- Bulk Delete Actions -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 mb-6">
            <div class="flex flex-wrap items-center gap-4">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Bulk Actions:</span>
                <button onclick="bulkDelete('all-failed')" class="px-4 py-2 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-900/50 transition-colors text-sm">
                    <i class="fas fa-trash mr-1"></i> Delete All Failed
                </button>
                <button onclick="bulkDelete('non-existent-users')" class="px-4 py-2 bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded-lg hover:bg-orange-200 dark:hover:bg-orange-900/50 transition-colors text-sm">
                    <i class="fas fa-trash mr-1"></i> Delete Unknown Users
                </button>
                <button onclick="bulkDelete('older-than-30-days')" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors text-sm">
                    <i class="fas fa-trash mr-1"></i> Delete Older than 30 Days
                </button>
                <button onclick="bulkDelete('all')" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors text-sm">
                    <i class="fas fa-trash mr-1"></i> Delete All Records
                </button>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 mb-6">
            <form method="GET" class="flex flex-wrap gap-4 items-end">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Search</label>
                    <input type="text" name="user" value="<%= query.user || '' %>" 
                           placeholder="Name, Email or IP..." 
                           class="px-3 py-2 w-48 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Device</label>
                    <select name="device" class="px-3 py-2 w-32 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                        <option value="">All</option>
                        <option value="desktop" <%= query.device === 'desktop' ? 'selected' : '' %>>Desktop</option>
                        <option value="mobile" <%= query.device === 'mobile' ? 'selected' : '' %>>Mobile</option>
                        <option value="tablet" <%= query.device === 'tablet' ? 'selected' : '' %>>Tablet</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Status</label>
                    <select name="status" class="px-3 py-2 w-32 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                        <option value="">All</option>
                        <option value="success" <%= query.status === 'success' ? 'selected' : '' %>>Success</option>
                        <option value="failed" <%= query.status === 'failed' ? 'selected' : '' %>>Failed</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Country</label>
                    <input type="text" name="country" value="<%= query.country || '' %>" 
                           placeholder="Country..." 
                           class="px-3 py-2 w-32 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                </div>
                <div>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors">
                        <i class="fas fa-filter mr-2"></i> Filter
                    </button>
                    <a href="/admin/login-activity" class="px-4 py-2 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors ml-2">
                        <i class="fas fa-times mr-2"></i> Clear
                    </a>
                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 dark:bg-gray-700/50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                <input type="checkbox" id="selectAll" onchange="toggleAllCheckboxes()" class="rounded border-gray-300 dark:border-gray-600">
                            </th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">User</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Login Time</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Device</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Browser / OS</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Network</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Location</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Duration</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">IP</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Risk</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        <% if (activities && activities.length > 0) { %>
                            <% activities.forEach(activity => { 
                                const isUnknownUser = !activity.user && activity.attemptedEmail;
                            %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors <%= isUnknownUser ? 'bg-orange-50/50 dark:bg-orange-900/10' : '' %>">
                                    <td class="px-4 py-3">
                                        <input type="checkbox" class="row-checkbox rounded border-gray-300 dark:border-gray-600" value="<%= activity._id %>">
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded-full <%= isUnknownUser ? 'bg-orange-500' : 'bg-gradient-to-br from-indigo-500 to-purple-500' %> flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                                <% if (activity.user) { %>
                                                    <%= activity.user?.name?.charAt(0) || 'U' %>
                                                <% } else if (activity.attemptedEmail) { %>
                                                    <i class="fas fa-question"></i>
                                                <% } else { %>
                                                    U
                                                <% } %>
                                            </div>
                                            <div>
                                                <% if (activity.user) { %>
                                                    <p class="text-sm font-medium text-gray-900 dark:text-white"><%= activity.user?.name || 'Deleted User' %></p>
                                                    <p class="text-xs text-gray-500 dark:text-gray-400"><%= activity.user?.email || '' %></p>
                                                <% } else if (activity.attemptedEmail) { %>
                                                    <p class="text-sm font-medium text-orange-600 dark:text-orange-400">
                                                        <i class="fas fa-user-slash mr-1"></i> Unknown User
                                                    </p>
                                                    <p class="text-xs text-orange-500 dark:text-orange-400"><%= activity.attemptedEmail %></p>
                                                <% } else { %>
                                                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Unknown</p>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
    <div><%= moment(activity.loginTime).tz('Asia/Kolkata').format('DD MMM YYYY') %></div>
    <div class="text-xs text-gray-400"><%= moment(activity.loginTime).tz('Asia/Kolkata').format('h:mm A') %></div>
</td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                            <%= activity.status === 'success' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300' : 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300' %>">
                                            <%= activity.status === 'success' ? '✅ Success' : '❌ Failed' %>
                                        </span>
                                        <% if(activity.isActive) { %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300">
                                                Active
                                            </span>
                                        <% } %>
                                        <% if(isUnknownUser) { %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300">
                                                Unknown
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
                                        <div class="flex items-center gap-1.5">
                                            <% if (activity.deviceType === 'mobile') { %>
                                                <i class="fas fa-mobile-alt text-gray-400"></i>
                                            <% } else if (activity.deviceType === 'tablet') { %>
                                                <i class="fas fa-tablet-alt text-gray-400"></i>
                                            <% } else { %>
                                                <i class="fas fa-desktop text-gray-400"></i>
                                            <% } %>
                                            <span class="capitalize"><%= activity.deviceType || 'Unknown' %></span>
                                        </div>
                                        <% if (activity.deviceModel && activity.deviceModel !== 'Unknown') { %>
                                            <div class="text-xs text-gray-400"><%= activity.deviceModel %></div>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
                                        <div><%= activity.browser || 'Unknown' %></div>
                                        <div class="text-xs text-gray-400"><%= activity.os || 'Unknown' %></div>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
                                        <span class="px-2 py-0.5 rounded-full text-xs font-medium 
                                            <%= activity.networkType === 'WiFi' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300' : '' %>
                                            <%= activity.networkType === '5G' ? 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300' : '' %>
                                            <%= activity.networkType === '4G' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300' : '' %>
                                            <%= activity.networkType === 'Ethernet' ? 'bg-gray-100 text-gray-800 dark:bg-gray-700/50 dark:text-gray-300' : '' %>
                                        ">
                                            <i class="fas <%= activity.networkType === 'WiFi' ? 'fa-wifi' : 
                                                         activity.networkType === 'Ethernet' ? 'fa-network-wired' : 
                                                         'fa-signal' %> mr-1"></i>
                                            <%= activity.networkType || 'Unknown' %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
                                        <div class="flex items-center gap-1.5">
                                            <i class="fas fa-map-marker-alt text-indigo-400"></i>
                                            <div>
                                                <div><%= activity.locationDisplay || 'Unknown' %></div>
                                                <% if (activity.location?.isp && activity.location.isp !== 'Unknown') { %>
                                                    <div class="text-xs text-gray-400"><%= activity.location.isp %></div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
                                        <%= activity.durationFormatted || '-' %>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                                        <span class="font-mono text-xs"><%= activity.ipAddress || 'Unknown' %></span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <% const risk = activity.security?.riskScore || 0; %>
                                        <div class="flex items-center gap-2">
                                            <div class="w-16 h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                                <div class="h-full rounded-full 
                                                    <%= risk < 30 ? 'bg-green-500' : risk < 60 ? 'bg-yellow-500' : 'bg-red-500' %>" 
                                                    style="width: <%= risk %>%">
                                                </div>
                                            </div>
                                            <span class="text-xs font-medium 
                                                <%= risk < 30 ? 'text-green-600 dark:text-green-400' : 
                                                   risk < 60 ? 'text-yellow-600 dark:text-yellow-400' : 
                                                   'text-red-600 dark:text-red-400' %>">
                                                <%= risk %>%
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <button onclick="deleteRecord('<%= activity._id %>')" 
                                                class="p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-red-600 dark:text-red-400 transition-colors"
                                                title="Delete Record">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="12" class="px-4 py-12 text-center text-gray-500 dark:text-gray-400">
                                    <i class="fas fa-inbox text-3xl mb-3 block text-gray-300 dark:text-gray-600"></i>
                                    <p class="text-sm font-medium">No login activity found</p>
                                    <p class="text-xs mt-1">Try adjusting your search or filter</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Selected Actions -->
            <div id="selectedActions" class="hidden px-4 py-3 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30 flex items-center justify-between">
                <span id="selectedCount" class="text-sm text-gray-600 dark:text-gray-300">0 records selected</span>
                <button onclick="deleteSelected()" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors text-sm">
                    <i class="fas fa-trash mr-1"></i> Delete Selected
                </button>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between flex-wrap gap-2">
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        Showing page <span class="font-medium"><%= currentPage %></span> of <span class="font-medium"><%= totalPages %></span>
                        (<span class="font-medium"><%= total %></span> records)
                    </p>
                    <div class="flex gap-2">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %><%= query.user ? '&user=' + query.user : '' %><%= query.device ? '&device=' + query.device : '' %><%= query.status ? '&status=' + query.status : '' %><%= query.country ? '&country=' + query.country : '' %>" 
                               class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                <i class="fas fa-chevron-left mr-1"></i> Previous
                            </a>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %><%= query.user ? '&user=' + query.user : '' %><%= query.device ? '&device=' + query.device : '' %><%= query.status ? '&status=' + query.status : '' %><%= query.country ? '&country=' + query.country : '' %>" 
                               class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                Next <i class="fas fa-chevron-right ml-1"></i>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
// ============================================================
// SELECT ALL CHECKBOXES
// ============================================================
function toggleAllCheckboxes() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.row-checkbox');
    checkboxes.forEach(cb => cb.checked = selectAll.checked);
    updateSelectedActions();
}

// ============================================================
// UPDATE SELECTED ACTIONS
// ============================================================
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.row-checkbox').forEach(cb => {
        cb.addEventListener('change', updateSelectedActions);
    });
});

function updateSelectedActions() {
    const checkboxes = document.querySelectorAll('.row-checkbox:checked');
    const count = checkboxes.length;
    const actions = document.getElementById('selectedActions');
    const countEl = document.getElementById('selectedCount');
    
    if (count > 0) {
        actions.classList.remove('hidden');
        countEl.textContent = `${count} record${count > 1 ? 's' : ''} selected`;
    } else {
        actions.classList.add('hidden');
    }
}

// ============================================================
// DELETE SINGLE RECORD
// ============================================================
function deleteRecord(id) {
    if (!confirm('Are you sure you want to delete this login activity record?')) return;
    
    fetch(`/admin/login-activity/${id}`, {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert(data.message || 'Failed to delete record');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while deleting the record');
    });
}

// ============================================================
// DELETE SELECTED RECORDS
// ============================================================
function deleteSelected() {
    const checkboxes = document.querySelectorAll('.row-checkbox:checked');
    if (checkboxes.length === 0) return;
    
    if (!confirm(`Are you sure you want to delete ${checkboxes.length} record(s)?`)) return;
    
    const ids = Array.from(checkboxes).map(cb => cb.value);
    
    fetch('/admin/login-activity/bulk-delete', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ ids })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert(data.message || 'Failed to delete records');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while deleting records');
    });
}

// ============================================================
// BULK DELETE BY FILTER
// ============================================================
function bulkDelete(filter) {
    const messages = {
        'all-failed': 'Delete ALL failed login attempts?',
        'non-existent-users': 'Delete ALL attempts from unknown users?',
        'older-than-30-days': 'Delete ALL records older than 30 days?',
        'all': '⚠️ Delete ALL login activity records? This action cannot be undone!'
    };
    
    if (!confirm(messages[filter])) return;
    
    fetch('/admin/login-activity/bulk-delete', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ filter })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert(data.message || 'Failed to delete records');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while deleting records');
    });
}
</script>