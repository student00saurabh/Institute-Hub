<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .reveal-up { opacity: 0; transform: translateY(28px); transition: opacity 0.7s cubic-bezier(0.4,0,0.2,1), transform 0.7s cubic-bezier(0.4,0,0.2,1); }
    .reveal-up.in-view { opacity: 1; transform: translateY(0); }
    .reveal-delay-1.in-view { transition-delay: 0.1s; }
    .reveal-delay-2.in-view { transition-delay: 0.2s; }

    @keyframes blobFloat {
        0%, 100% { transform: translate(0,0) scale(1); }
        50% { transform: translate(20px,-20px) scale(1.08); }
    }
    .blob { animation: blobFloat 10s ease-in-out infinite; }
    .blob-delay { animation-delay: 3s; }

    @keyframes floatY {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    .float-anim { animation: floatY 4s ease-in-out infinite; }
    .float-anim-delay { animation-delay: 1.5s; }

    @keyframes pulseDot {
        0% { box-shadow: 0 0 0 0 rgba(37,99,235,0.5); }
        70% { box-shadow: 0 0 0 8px rgba(37,99,235,0); }
        100% { box-shadow: 0 0 0 0 rgba(37,99,235,0); }
    }
    .pulse-dot { animation: pulseDot 1.8s infinite; }

    @keyframes marqueeScroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    .marquee { animation: marqueeScroll 38s linear infinite; }
    .marquee:hover { animation-play-state: paused; }

    .btn-shine::after {
        content: '';
        position: absolute; top: 0; left: -75%;
        width: 50%; height: 100%;
        background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
        transform: skewX(-20deg);
        transition: left 0.6s ease;
    }
    .btn-shine:hover::after { left: 130%; }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Swipe hint on mobile categories */
    @keyframes swipeNudge {
        0%, 100% { transform: translateX(0); opacity: 1; }
        50% { transform: translateX(4px); opacity: 0.6; }
    }
    .swipe-hint-arrow { animation: swipeNudge 1.2s ease-in-out infinite; }
    #catSwipeHint { transition: opacity 0.4s ease; }

    /* Save / bookmark button tactile feedback */
    @keyframes savePop {
        0% { transform: scale(1); }
        40% { transform: scale(1.25); }
        100% { transform: scale(1); }
    }
    .save-pop i { animation: savePop 0.35s ease; }

    @media (prefers-reduced-motion: reduce) {
        .swipe-hint-arrow, .save-pop i { animation: none !important; }
    }

    @media (prefers-reduced-motion: reduce) {
        .blob, .float-anim, .marquee, .pulse-dot { animation: none !important; }
        .reveal-up { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    @media (max-width: 640px) {
        .marquee { animation-duration: 26s; }
    }
</style>

<!-- ============================================================ -->
<!-- SCRIPTS                                                       -->
<!-- ============================================================ -->
<script>
    // Horizontal scroll
    function scrollByAmount(id, amount) {
        const el = document.getElementById(id);
        if (el) el.scrollBy({ left: amount, behavior: 'smooth' });
    }

    // Save / bookmark toggle — used on course cards (heart) and blog cards (bookmark)
    function toggleSave(btn, evt) {
        if (evt) { evt.preventDefault(); evt.stopPropagation(); }
        const icon = btn.querySelector('i');
        const isSaved = icon.classList.contains('fas');

        icon.classList.toggle('fas', !isSaved);
        icon.classList.toggle('far', isSaved);

        const activeColor = icon.classList.contains('fa-bookmark') ? '#C9A227' : '#EF4444';
        btn.style.color = isSaved ? '' : activeColor;

        // Small pop animation for tactile feedback
        btn.classList.remove('save-pop');
        void btn.offsetWidth; // restart animation
        btn.classList.add('save-pop');
    }

    // Enroll button — flips to a confirmed "Enrolled" state
    function handleEnroll(btn) {
        if (btn.dataset.enrolled === 'true') return;
        btn.dataset.enrolled = 'true';
        btn.innerHTML = '<i class="fas fa-check mr-1"></i> Enrolled';
        btn.classList.remove('bg-[#2563EB]', 'hover:bg-[#1D4ED8]', 'shadow-[#2563EB]/25', 'bg-[#C9A227]', 'hover:bg-[#B8901E]', 'shadow-[#C9A227]/25');
        btn.classList.add('bg-[#22C55E]', 'shadow-[#22C55E]/25', 'cursor-default');
    }

    // Hide the mobile "Swipe" hint on categories once the user has scrolled
    document.addEventListener('DOMContentLoaded', () => {
        const catScroll = document.getElementById('catScroll');
        const swipeHint = document.getElementById('catSwipeHint');
        if (catScroll && swipeHint) {
            catScroll.addEventListener('scroll', () => {
                swipeHint.style.opacity = '0';
                swipeHint.style.pointerEvents = 'none';
            }, { once: true, passive: true });
        }
    });

    // Offer Slider
    let currentOffer = 0;
    const totalOffers = `<%= offers.length %>`;

    function updateOfferSlider() {
        const track = document.getElementById('offerTrack');
        const dots = document.querySelectorAll('.offer-dot');
        if (!track) return;
        
        track.style.transform = `translateX(-${currentOffer * 100}%)`;
        
        dots.forEach((dot, index) => {
            if (index === currentOffer) {
                dot.classList.add('w-6', 'bg-[#C9A227]');
                dot.classList.remove('w-2', 'bg-white/50');
            } else {
                dot.classList.remove('w-6', 'bg-[#C9A227]');
                dot.classList.add('w-2', 'bg-white/50');
            }
        });
    }

    function changeOffer(direction) {
        currentOffer = (currentOffer + direction + totalOffers) % totalOffers;
        updateOfferSlider();
        resetAutoSlide();
    }

    function goToOffer(index) {
        currentOffer = index;
        updateOfferSlider();
        resetAutoSlide();
    }

    // Auto-slide
    let autoSlideInterval;

    function startAutoSlide() {
        autoSlideInterval = setInterval(() => {
            currentOffer = (currentOffer + 1) % totalOffers;
            updateOfferSlider();
        }, 5000);
    }

    function resetAutoSlide() {
        clearInterval(autoSlideInterval);
        startAutoSlide();
    }

    // Reveal on scroll
    document.addEventListener('DOMContentLoaded', () => {
        // Start auto-slide
        startAutoSlide();

        // Reveal observer
        const revealEls = document.querySelectorAll('.reveal-up');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        revealEls.forEach(el => observer.observe(el));

        // Counters
        const counters = document.querySelectorAll('.counter');
        const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                const target = parseInt(el.dataset.target, 10);
                const suffix = el.dataset.suffix || '';
                const duration = 1400;
                const start = performance.now();
                function tick(now) {
                    const progress = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.floor(eased * target) + suffix;
                    if (progress < 1) requestAnimationFrame(tick);
                    else el.textContent = target + suffix;
                }
                requestAnimationFrame(tick);
                counterObserver.unobserve(el);
            });
        }, { threshold: 0.4 });
        counters.forEach(el => counterObserver.observe(el));
    });

    // Testimonial pagination
    const reviewTrack = document.getElementById('reviewTrack');
    const totalReviews = `<%= reviews.length %>`;
    let reviewCardWidth = 0;

    function computeCardWidth() {
        const firstCard = reviewTrack?.children[0];
        if (firstCard) {
            const style = getComputedStyle(reviewTrack);
            const gap = parseFloat(style.columnGap || style.gap || 24);
            reviewCardWidth = firstCard.getBoundingClientRect().width + gap;
        }
    }
    window.addEventListener('load', computeCardWidth);
    window.addEventListener('resize', computeCardWidth);

    function jumpToReview(index) {
        if (!reviewTrack) return;
        reviewTrack.style.animation = 'none';
        reviewTrack.style.transform = `translateX(-${index * reviewCardWidth}px)`;

        document.querySelectorAll('.review-dot').forEach((dot, i) => {
            if (i === index) {
                dot.classList.add('w-8', 'bg-[#2563EB]');
                dot.classList.remove('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
            } else {
                dot.classList.remove('w-8', 'bg-[#2563EB]');
                dot.classList.add('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
            }
        });

        clearTimeout(window.__reviewResume);
        window.__reviewResume = setTimeout(() => {
            reviewTrack.style.transform = '';
            reviewTrack.style.animation = '';
        }, 3500);
    }

    // Auto-advance dots
    (function autoCycleDots() {
        let current = 0;
        setInterval(() => {
            current = (current + 1) % totalReviews;
            document.querySelectorAll('.review-dot').forEach((dot, i) => {
                if (i === current) {
                    dot.classList.add('w-8', 'bg-[#2563EB]');
                    dot.classList.remove('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
                } else {
                    dot.classList.remove('w-8', 'bg-[#2563EB]');
                    dot.classList.add('w-2', 'bg-[#CBD5E1]', 'dark:bg-[#334155]');
                }
            });
        }, 38000 / totalReviews);
    })();
</script>