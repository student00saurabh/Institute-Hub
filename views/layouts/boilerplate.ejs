<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title><%= meta.title %></title>

  <link rel="manifest" href="/manifest.json">
  
  <!-- Primary Meta Tags -->
  <meta name="title" content="<%= meta.title %>" />
  <meta name="description" content="<%= meta.description %>" />
  <meta name="keywords" content="<%= meta.keywords %>" />
  <meta name="author" content="InstituteHub" />
  <meta name="robots" content="index, follow" />
  <meta name="language" content="English" />
  <meta name="revisit-after" content="7 days" />
  
  <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= meta.canonical || requestUrl %>" />
  <meta property="og:title" content="<%= meta.title %>" />
  <meta property="og:description" content="<%= meta.description %>" />
  <meta property="og:image" content="<%= meta.image ? meta.image.replace('/upload/', '/upload/f_auto,q_auto/') : 'https://institute-hub-7wsi.onrender.com/images/logo.png' %>" />
  <meta property="og:site_name" content="InstituteHub" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="<%= meta.canonical || requestUrl %>" />
  <meta property="twitter:title" content="<%= meta.title %>" />
  <meta property="twitter:description" content="<%= meta.description %>" />
  <meta property="twitter:image" content="<%= meta.image ? meta.image.replace('/upload/', '/upload/f_auto,q_auto,w_1200,h_630,c_fill/') : 'https://institute-hub-7wsi.onrender.com/images/logo.png' %>" />

  <!-- Favicons -->
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
  <link rel="manifest" href="/images/site.webmanifest" />
  <link rel="mask-icon" href="/images/safari-pinned-tab.svg" color="#2563EB" />
  <meta name="msapplication-TileColor" content="#0F172A" />
  <meta name="theme-color" content="#0F172A" />

  <link rel="canonical" href="<%= meta.canonical || requestUrl %>" />

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;400;600;700;800&display=swap" rel="stylesheet" />

  <!-- AOS Animation -->
  <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

  <!-- Compiled CSS -->
  <link rel="stylesheet" href="/css/output.css" />

  <!-- Smooth Theme Transition -->
  <style>
    html, body {
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    
    /* InstituteHub Theme Colors - Tailwind Extensions */
    .bg-primary-navy { background-color: #0F172A; }
    .bg-royal-blue { background-color: #2563EB; }
    .bg-premium-gold { background-color: #C9A227; }
    .text-royal-blue { color: #2563EB; }
    .text-premium-gold { color: #C9A227; }
    .border-royal-blue { border-color: #2563EB; }
    .border-premium-gold { border-color: #C9A227; }
    
    /* Scrollbar Styling */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #F8FAFC; }
    ::-webkit-scrollbar-thumb { background: #2563EB; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #1D4ED8; }
    .dark ::-webkit-scrollbar-track { background: #0B1120; }
    .dark ::-webkit-scrollbar-thumb { background: #3B82F6; }
    .dark ::-webkit-scrollbar-thumb:hover { background: #2563EB; }

    /* Selection Color */
    ::selection {
      background: #2563EB;
      color: #FFFFFF;
    }
    ::-moz-selection {
      background: #2563EB;
      color: #FFFFFF;
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Dark Mode Detection -->
  <script>
    if (localStorage.theme === "dark") {
      document.documentElement.classList.add("dark");
    } else if (localStorage.theme === "light") {
      document.documentElement.classList.remove("dark");
    } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      document.documentElement.classList.add("dark");
    }
  </script>

  <!-- Service Worker -->
  <script>
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("/service-worker.js");
    }
  </script>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YP04N0626F"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-YP04N0626F');
  </script>

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": "InstituteHub",
        "url": "https://institute-hub-7wsi.onrender.com",
        "logo": "https://institute-hub-7wsi.onrender.com/images/logo.png",
        "description": "India's premier training and certification platform for professionals. 500+ courses, 340+ expert mentors, and verified certificates.",
        "email": "student001599@gmail.com",
        "telephone": "+91-9310643303",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Delhi",
          "addressCountry": "India"
        },
        "sameAs": [
          "https://linkedin.com/company/institutehub",
          "https://twitter.com/institutehub",
          "https://youtube.com/@institutehub"
        ]
      },
      {
        "@type": "WebSite",
        "url": "https://institute-hub-7wsi.onrender.com",
        "name": "<%= meta.title %>",
        "description": "<%= meta.description %>",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://institute-hub-7wsi.onrender.com/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://institute-hub-7wsi.onrender.com"
          }
        ]
      }
    ]
  }
  </script>

</head>

<body class="font-sans bg-[#F8FAFC] dark:bg-[#0B1120] text-[#0F172A] dark:text-white transition-colors duration-300">

  <!-- Navbar -->
  <%- include("../includes/navbar.ejs") %>

  <!-- Flash Messages + Page Content -->
  <main class="w-full min-h-screen">
    <%- include("../includes/flash.ejs") %>
    <%- body %>
  </main>

  <!-- Footer -->
  <%- include("../includes/footer.ejs") %>

  <!-- AOS -->
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script>
    AOS.init({ once: true, duration: 700, easing: "ease-out-cubic" });
  </script>

  <!-- App Script -->
  <script src="/js/script.js"></script>

  <!-- Lazy Loading Images -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("img").forEach(img => {
        if (!img.hasAttribute("loading")) {
          img.setAttribute("loading", "lazy");
        }
        if (!img.hasAttribute("decoding")) {
          img.setAttribute("decoding", "async");
        }
      });
    });
  </script>

</body>
</html>