<% layout("/layouts/boilerplate") %>

<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/50 dark:border-gray-700/50 p-8" data-aos="fade-up" data-aos-duration="600">
            
            <!-- Brand Logo -->
            <div class="flex justify-center mb-6">
                <a href="/" class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-12 h-12">
                        <img 
                            src="/images/logo1.png"
                            class="w-12 h-12 object-contain drop-shadow-lg hover:rotate-3 transition-transform duration-300"
                            alt="CyberKavach Logo"
                        >
                    </div>
                    <div>
                        <span class="text-2xl font-extrabold tracking-tight">
                            <span class="text-blue-700 dark:text-blue-400">Cyber</span>
                            <span class="text-indigo-600 dark:text-indigo-400">Kavach</span>
                        </span>
                        <p class="text-xs text-gray-500 dark:text-gray-400 -mt-1">Secure Email Verification</p>
                    </div>
                </a>
            </div>

            <!-- Title -->
            <div class="text-center mb-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                    Verify Your Email
                </h2>

                <!-- Flash Messages from Server -->
                <% if (typeof success !== 'undefined' && success && success.length) { %>
                    <p class="mt-2 text-sm text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20 px-4 py-2 rounded-lg border border-green-200 dark:border-green-800">
                        <%= success %>
                    </p>
                <% } %>

                <% if (typeof error !== 'undefined' && error && error.length) { %>
                    <p class="mt-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 px-4 py-2 rounded-lg border border-red-200 dark:border-red-800">
                        <%= error %>
                    </p>
                <% } %>

                <% if (typeof warning !== 'undefined' && warning && warning.length) { %>
                    <p class="mt-2 text-sm text-yellow-600 dark:text-yellow-400 bg-yellow-50 dark:bg-yellow-900/20 px-4 py-2 rounded-lg border border-yellow-200 dark:border-yellow-800">
                        <%= warning %>
                    </p>
                <% } %>

                <% if (typeof info !== 'undefined' && info && info.length) { %>
                    <p class="mt-2 text-sm text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20 px-4 py-2 rounded-lg border border-blue-200 dark:border-blue-800">
                        <%= info %>
                    </p>
                <% } %>

                <% if (typeof primary !== 'undefined' && primary && primary.length) { %>
                    <p class="mt-2 text-sm text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/20 px-4 py-2 rounded-lg border border-indigo-200 dark:border-indigo-800">
                        <%= primary %>
                    </p>
                <% } %>

                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                    A 6-digit One-Time Password (OTP) has been sent to your registered email address.
                </p>
            </div>

            <!-- OTP Form -->
            <form action="/verify/<%= user._id %>" method="POST" class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5 text-center">
                        Enter OTP
                    </label>

                    <input
                        type="text"
                        name="otp"
                        maxlength="6"
                        inputmode="numeric"
                        pattern="[0-9]{6}"
                        required
                        placeholder="● ● ● ● ● ●"
                        class="w-full px-4 py-3 text-center text-xl tracking-widest rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200"
                        autofocus
                    />
                </div>

                <!-- Verify Button -->
                <button
                    type="submit"
                    id="verifyBtn"
                    class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-blue-500/30 dark:shadow-blue-500/20 transition-all duration-300 transform hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                    Verify Email
                </button>
            </form>

            <!-- Divider -->
            <div class="my-6 border-t border-gray-200 dark:border-gray-700"></div>

            <!-- Resend Section -->
            <div class="text-center">
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                    Didn't receive the OTP?
                </p>

                <form
                    id="resendForm"
                    action="/verify/<%= user._id %>/resend"
                    method="POST"
                    class="inline-block"
                >
                    <button
                        id="resendBtn"
                        type="submit"
                        class="px-6 py-2 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 text-blue-600 dark:text-blue-400 font-medium rounded-lg border border-gray-200 dark:border-gray-600 shadow-sm hover:shadow transition-all duration-200"
                    >
                        Resend OTP
                    </button>
                </form>

                <p id="timer" class="mt-3 text-xs text-gray-500 dark:text-gray-400"></p>
            </div>

            <!-- Back to Login -->
            <div class="mt-4 text-center">
                <a href="/login" class="text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Back to Login
                </a>
            </div>
        </div>

        <!-- Trust Text -->
        <p class="mt-6 text-center text-xs text-gray-500 dark:text-gray-400">
            CyberKavach uses secure verification to protect your account.
        </p>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const resendBtn = document.getElementById('resendBtn');
    const timerEl = document.getElementById('timer');
    const verifyBtn = document.getElementById('verifyBtn');
    const otpInput = document.querySelector('input[name="otp"]');

    // Auto-focus on OTP input
    if (otpInput) {
        setTimeout(() => otpInput.focus(), 500);
    }

    // Resend OTP with timer
    if (resendBtn) {
        resendBtn.addEventListener('click', function(e) {
            // Start timer after click
            setTimeout(startTimer, 300);
        });
    }

    function startTimer() {
        let countdown = 60;
        resendBtn.disabled = true;
        resendBtn.innerText = `Resend OTP (${countdown}s)`;
        timerEl.innerText = "Please wait before requesting a new OTP.";

        const timer = setInterval(() => {
            countdown--;
            resendBtn.innerText = `Resend OTP (${countdown}s)`;

            if (countdown <= 0) {
                clearInterval(timer);
                resendBtn.disabled = false;
                resendBtn.innerText = "Resend OTP";
                timerEl.innerText = "";
            }
        }, 1000);
    }

    // Form submission loading state
    const form = document.querySelector('form');
    if (form && verifyBtn) {
        form.addEventListener('submit', function() {
            const otp = otpInput.value.trim();
            
            if (!otp || otp.length !== 6) {
                return;
            }

            verifyBtn.disabled = true;
            verifyBtn.innerHTML = `
                <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                Verifying...
            `;
            verifyBtn.classList.add('opacity-70', 'cursor-not-allowed');
        });
    }

    // Auto-scroll to flash messages
    const flashMessages = document.querySelector('.text-red-600, .text-green-600, .text-yellow-600, .text-blue-600, .text-indigo-600');
    if (flashMessages) {
        setTimeout(() => {
            flashMessages.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 300);
    }
});
</script>

<style>
    /* Logo hover animation */
    @keyframes float-slow {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-6px) rotate(3deg); }
    }
    
    img:hover {
        animation: float-slow 2s ease-in-out infinite;
    }

    /* OTP Input Styles */
    input[name="otp"]:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .dark input[name="otp"]:focus {
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
    }

    /* Smooth transitions */
    button, input, a {
        transition: all 0.2s ease;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 6px;
    }
    ::-webkit-scrollbar-track {
        background: transparent;
    }
    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    .dark ::-webkit-scrollbar-thumb {
        background: #475569;
    }
</style>